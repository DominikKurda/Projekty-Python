          </div>{% endif %}
        </article>""", role=role, en=en, pl=pl, tts=tts) for role, en, pl in dialogue["turns"])
        dialogue_html = render_template_string(r"""
        <section class="card dialogue">
          <span class="eyebrow">Dialog sytuacyjny</span><h2>{{ dialogue.title }}</h2><p class="sub">{{ dialogue.description }}</p>
