        <article class="dialogue-line {{ 'you' if role == 'Ty' else '' }}" data-dialogue-text="{{ en }}" data-role="{{ role }}">
          <div class="dialogue-role">{{ role }}</div>
          <div class="dialogue-en">{{ en }} {{ tts(en)|safe }}</div>
          <div class="dialogue-pl">{{ pl }}</div>
          {% if role == 'Ty' %}<div class="practice-actions" style="align-items:flex-start;max-width:none;margin-top:9px">
            <button class="btn small secondary practice-btn" type="button" data-practice="{{ en }}">🎤 Powiedz swoją kwestię</button>
