@app.post('/progress/<int:pid>')
def part_status(pid):
    state = request.form.get('status')
    if pid not in PART_OWNER or state not in STATUS: abort(400)
    with PROGRESS_LOCK:
        progress = read_progress()
        progress['parts'][str(pid)] = state
        write_progress(progress)
    return redirect(url_for('course_lesson_page',lid=PART_OWNER[pid],part=pid))

@app.post('/practice/phrase')
def phrase_action():
    key = request.form.get('key')
    if key not in PHRASE_INDEX: abort(400)
    action = request.form.get('action')
    with PROGRESS_LOCK:
        if action == 'difficult':
            progress = read_progress()
            if key in progress['difficult']: progress['difficult'].remove(key)
            else: progress['difficult'].append(key)
            write_progress(progress)
        elif action == 'dictionary':
            words = load_words()
            p = PHRASE_INDEX[key]
            if (norm(p['en']),norm(p['pl'])) not in {(norm(w.en),norm(w.pl)) for w in words.values()}:
                wid = 'w'+uuid4().hex[:10]
                words[wid] = Word(wid, p['en'], p['pl'], tags=['kurs'], created_at=now_iso())
                save_words(words)
            flash('Zwrot jest w słowniku.')
        else: abort(400)
    back = request.form.get('return_to','')
    if not (re.fullmatch(r'/course/\d+(?:\?part=\d+)?',back) or back=='/review'): back=url_for('course_home')
    return redirect(back)

