PROGRESS_FILE = Path(os.environ.get('ENGLISH_TRAINER_PROGRESS', DATA_FILE.with_name('learning_progress.json')))
PROGRESS_LOCK = threading.RLock()
STATUS = {'todo':'Do nauki', 'practice':'Ćwiczę', 'done':'Umiem'}

def read_progress():
    if not PROGRESS_FILE.exists():
        return {'parts':{}, 'difficult':[], 'last':None}
    try:
        data = json.loads(PROGRESS_FILE.read_text(encoding='utf-8'))
        if not isinstance(data, dict) or not isinstance(data.get('parts'), dict) or not isinstance(data.get('difficult'), list):
            raise ValueError('Nieprawidłowa struktura')
        return data
    except (ValueError, OSError) as exc:
        raise RuntimeError('Nie można odczytać learning_progress.json. Zachowaj plik i sprawdź jego zawartość.') from exc

def write_progress(data):
    PROGRESS_FILE.parent.mkdir(parents=True, exist_ok=True)
    temp = PROGRESS_FILE.with_suffix('.tmp')
    temp.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding='utf-8')
    temp.replace(PROGRESS_FILE)

def phrase_key(p):
    return hashlib.sha256((norm(p['en'])+'|'+norm(p['pl'])).encode()).hexdigest()[:20]

