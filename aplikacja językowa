def course_lesson(lesson_id: int, module: str, order: int, title: str, goal: str, phrases: list) -> dict:
    module_data = next(item for item in COURSE_MODULES if item["id"] == module)
    return {
        "id": lesson_id, "module": module, "module_number": module_data["number"],
        "order": order, "title": title, "level": module_data["level"], "goal": goal,
        "required_phrases": phrases,
    }


