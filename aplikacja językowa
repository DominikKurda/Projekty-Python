    word_id = "w" + uuid4().hex[:10]
    words[word_id] = Word(word_id, en, pl, request.form.get("example", "").strip(), request.form.get("notes", "").strip(),
                          [tag.strip() for tag in request.form.get("tags", "").split(",") if tag.strip()], now_iso())
    save_words(words)
    flash("Zwrot został dodany do słownika.")
    return redirect(url_for("words_page"))


@app.route("/words")
def words_page():
    words = load_words()
    query, selected_tag = request.args.get("q", "").strip(), request.args.get("tag", "").strip()
    items = sorted(words.values(), key=lambda item: item.created_at, reverse=True)
    if query:
        needle = query.casefold()
        items = [w for w in items if needle in " ".join((w.en, w.pl, w.example, w.notes)).casefold()]
    if selected_tag:
        items = [w for w in items if selected_tag in w.tags]
    all_tags = sorted({tag for word in words.values() for tag in word.tags})
    cards = "".join(render_template_string(r"""<article class="card word"><div><div class="word-en">{{ w.en }} {{ tts(w.en)|safe }}</div><div class="translation">{{ w.pl }}</div>{% if w.tags %}<div style="margin-top:8px">{% for tag in w.tags %}<span class="tag">{{ tag }}</span>{% endfor %}</div>{% endif %}{% if w.example %}<p class="sub"><b>Przykład:</b> {{ w.example }}</p>{% endif %}{% if w.notes %}<p class="sub"><b>Notatka:</b> {{ w.notes }}</p>{% endif %}</div><div class="actions"><a class="btn small secondary" href="{{ url_for('edit_word', wid=w.id) }}">Edytuj</a><form method="post" action="{{ url_for('delete_word', wid=w.id) }}" onsubmit="return confirm('Usunąć ten zwrot?')"><button class="btn small danger">Usuń</button></form></div></article>""", w=w, tts=tts) for w in items)
    body = render_template_string(r"""<div class="section-head"><div><span class="eyebrow">Twoja baza</span><h1>Słownik <span class="badge">{{ count }} zwrotów</span></h1></div><a class="btn" href="{{ url_for('home') }}">+ Dodaj zwrot</a></div><section class="card"><form method="get"><div class="form-grid"><div class="field"><label>Szukaj</label><input name="q" value="{{ query }}" placeholder="Angielski, polski, przykład..."></div><div class="field"><label>Tag</label><select name="tag"><option value="">Wszystkie tagi</option>{% for tag in tags %}<option {{ 'selected' if tag == selected_tag else '' }}>{{ tag }}</option>{% endfor %}</select></div></div><div class="actions"><button class="btn">Filtruj</button><a class="btn secondary" href="{{ url_for('words_page') }}">Wyczyść</a></div></form></section><div class="stack" style="margin-top:16px">{{ cards|safe if cards else '<div class="card empty">Nie znaleziono żadnych zwrotów.</div>'|safe }}</div>""", count=len(items), query=query, selected_tag=selected_tag, tags=all_tags, cards=cards)
    return render(body, "Słownik")


@app.route("/words/<wid>/edit", methods=["GET", "POST"])
def edit_word(wid: str):
    words = load_words()
    word = words.get(wid)
    if not word:
        flash("Nie znaleziono zwrotu.", "err")
        return redirect(url_for("words_page"))
    if request.method == "POST":
        en, pl = request.form.get("en", "").strip(), request.form.get("pl", "").strip()
        if not en or not pl:
            flash("Angielski i polski są wymagane.", "err")
        else:
            word.en, word.pl = en, pl
            word.example, word.notes = request.form.get("example", "").strip(), request.form.get("notes", "").strip()
            word.tags = [tag.strip() for tag in request.form.get("tags", "").split(",") if tag.strip()]
            save_words(words)
            flash("Zmiany zostały zapisane.")
            return redirect(url_for("words_page"))
    body = render_template_string(r"""<div class="section-head"><div><span class="eyebrow">Słownik</span><h1>Edytuj zwrot</h1></div></div><section class="card"><form method="post"><div class="form-grid"><div class="field"><label>Angielski</label><input name="en" value="{{ w.en }}" required></div><div class="field"><label>Polski</label><input name="pl" value="{{ w.pl }}" required></div><div class="field"><label>Tagi</label><input name="tags" value="{{ w.tags|join(', ') }}"></div><div class="field"><label>Przykład</label><input name="example" value="{{ w.example }}"></div><div class="field full"><label>Notatki</label><textarea name="notes">{{ w.notes }}</textarea></div></div><div class="actions"><button class="btn">Zapisz zmiany</button><a class="btn secondary" href="{{ url_for('words_page') }}">Anuluj</a></div></form></section>""", w=word)
    return render(body, "Edycja")


@app.post("/words/<wid>/delete")
def delete_word(wid: str):
    words = load_words()
    if words.pop(wid, None):
        save_words(words)
        flash("Zwrot został usunięty.")
    return redirect(url_for("words_page"))


@app.route("/lessons")
def lessons_list():
    words = load_words()
    levels_html = ""
    level_titles = {"A1": "Podstawy", "A2": "Podróże", "A2/B1": "Komunikacja i praca"}
    for level in ("A1", "A2", "A2/B1"):
        modules_html = ""
        for module in [item for item in COURSE_MODULES if item["level"] == level]:
            module_lessons = sorted(
                (lesson for lesson in LESSONS if lesson["module"] == module["id"]),
                key=lambda lesson: lesson["order"],
            )
            cards = []
            known_in_module = 0
            phrases_in_module = 0
            completed_lessons = 0
            for lesson in module_lessons:
                missing = missing_phrases(words, lesson)
                total = len(lesson["required_phrases"])
                known = total - len(missing)
                phrases_in_module += total
                known_in_module += known
                completed_lessons += int(not missing)
                cards.append(render_template_string(r"""
                <article class="card lesson">
                  <div class="lesson-number">{{ order }}</div>
                  <div>
                    <div><span class="badge">{{ level }} · {{ module_number }}.{{ order }}</span></div>
                    <h3 style="margin-top:7px">{{ lesson.title }}</h3>
                    <p class="sub">{{ lesson.goal }}</p>
                    <div class="progress"><i style="width:{{ percent }}%"></i></div>
                    <div class="meta"><span>{{ known }}/{{ total }} zwrotów w słowniku</span><span>{{ percent }}%</span></div>
                  </div>
                  <div class="actions"><a class="btn small" href="{{ url_for('lesson_view', lesson_id=lesson.id) }}">Otwórz</a></div>
                </article>""", lesson=lesson, level=level, module_number=module["number"], order=lesson["order"],
                    total=total, known=known, percent=round(known / total * 100)))
            module_percent = round(known_in_module / phrases_in_module * 100) if phrases_in_module else 0
            modules_html += render_template_string(r"""
            <section style="margin-top:22px">
              <div class="card" style="background:linear-gradient(135deg,#f8faff,#f1f3ff)">
                <div style="display:flex;justify-content:space-between;gap:18px;align-items:center;flex-wrap:wrap">
                  <div>
                    <span class="eyebrow">Moduł {{ module.number }}</span>
                    <h2>{{ module.title }}</h2>
                    <p class="sub">{{ module.description }}</p>
                  </div>
                  <div style="text-align:right"><strong style="font-size:25px">{{ percent }}%</strong><div class="sub">{{ completed }}/{{ count }} lekcji ukończonych</div></div>
                </div>
                <div class="progress" style="margin-top:14px"><i style="width:{{ percent }}%"></i></div>
              </div>
              <div class="stack" style="margin-top:12px">{{ cards|join|safe }}</div>
            </section>""", module=module, percent=module_percent, completed=completed_lessons,
                count=len(module_lessons), cards=cards)
        levels_html += render_template_string(r"""
        <section style="margin-top:34px">
          <div class="section-head" style="margin-bottom:0"><div><span class="eyebrow">Poziom {{ level }}</span><h2>{{ title }}</h2></div></div>
          {{ modules|safe }}
        </section>""", level=level, title=level_titles[level], modules=modules_html)
    body = render_template_string(r"""
    <div class="section-head"><div><span class="eyebrow">Program nauki</span><h1>Lekcje</h1><p class="sub">Najpierw wybierz poziom i moduł, a następnie realizuj krótkie lekcje po kolei.</p></div></div>
    {{ levels|safe }}""", levels=levels_html)
    return render(body, "Lekcje")


@app.route("/lesson/<int:lesson_id>")
def lesson_view(lesson_id: int):
    lesson = next((item for item in LESSONS if item["id"] == lesson_id), None)
    if not lesson:
        flash("Nie znaleziono lekcji.", "err")
        return redirect(url_for("lessons_list"))
    words = load_words()
    existing = {(norm(w.en), norm(w.pl)) for w in words.values()}
    rows = "".join(render_template_string(r"""
