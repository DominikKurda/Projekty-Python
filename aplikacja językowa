# Czytelny program kursu. Zachowujemy zwroty ze starszej wersji, ale układamy je
# w krótsze lekcje, moduły i poziomy. Tekstowe dane modułu są również używane
# do zbudowania widoku postępu na stronie /lessons.
_OLD_LESSONS = {lesson["id"]: lesson for lesson in LESSONS}


def old_phrases(lesson_id: int, start: int | None = None, stop: int | None = None) -> list:
    return _OLD_LESSONS[lesson_id]["required_phrases"][start:stop]


def new_phrases(*items: tuple[str, str]) -> list:
    return [phrase(en, pl) for en, pl in items]


