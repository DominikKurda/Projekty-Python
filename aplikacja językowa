        'turns': [('Kasjer', 'Good evening. How can I help you?', 'Dobry wieczór. W czym mogę pomóc?'),
                  ('Ty', "I'd like two tickets for the six-thirty film, please.", 'Poproszę dwa bilety na film o szóstej trzydzieści.'),
                  ('Kasjer',
                   "I'm sorry, that showing is sold out. There are seats at nine-thirty.",
                   'Przykro mi, na ten seans nie ma już biletów. Są miejsca na dziewiątą trzydzieści.'),
                  ('Ty', "That's fine. Are there two seats together?", 'W porządku. Czy są dwa miejsca obok siebie?'),
                  ('Kasjer', 'Yes, in the middle of row five.', 'Tak, pośrodku piątego rzędu.'),
                  ('Ty', "I'll take them. How much is the total?", 'Wezmę je. Ile wynosi suma?'),
                  ('Kasjer', 'Twenty pounds. Here are your tickets. Enjoy the film!', 'Dwadzieścia funtów. Oto bilety. Miłego seansu!'),
                  ('Ty', 'Thank you. Which screen is it in?', 'Dziękuję. W której sali jest seans?'),
                  ('Kasjer', "It's on screen three, just down the corridor.", 'W sali numer trzy, kawałek dalej korytarzem.'),
                  ('Ty', 'Thanks!', 'Dziękuję!')]},
 2004: {'title': 'Pogoda a plany na dzień',
        'task': 'Zmień prognozę i zaproponuj odpowiednią aktywność.',
        'turns': [('Znajomy', "What's the weather like outside?", 'Jaka jest pogoda na zewnątrz?'),
                  ('Ty', "It's cloudy and quite windy.", 'Jest pochmurno i dość wietrznie.'),
                  ('Znajomy', 'Do you think it will rain?', 'Myślisz, że będzie padać?'),
                  ('Ty', 'Yes, according to the forecast, it will rain this afternoon.', 'Tak, według prognozy po południu będzie padać.'),
                  ('Znajomy', 'Shall we go for a walk now, then?', 'To może pójdziemy na spacer teraz?'),
                  ('Ty', "Good idea. I'll take a jacket and an umbrella.", 'Dobry pomysł. Wezmę kurtkę i parasol.'),
                  ('Znajomy', "Let's meet outside in ten minutes.", 'Spotkajmy się na zewnątrz za dziesięć minut.'),
                  ('Ty', 'All right. See you in a moment.', 'Dobrze. Do zobaczenia za chwilę.')]},
 3001: {'title': 'Kawa na wynos',
        'task': 'Zamów inny napój i zmień rozmiar lub dodatki.',
        'turns': [('Barista', 'Good morning. What can I get for you?', 'Dzień dobry. Co podać?'),
                  ('Ty', "I'd like a cappuccino, please.", 'Poproszę cappuccino.'),
                  ('Barista', 'What size would you like?', 'Jaki rozmiar wybierasz?'),
                  ('Ty', 'Medium, please. Do you have oat milk?', 'Średni, proszę. Czy macie mleko owsiane?'),
                  ('Barista', 'Yes, we do. Is that for here or to take away?', 'Tak. Na miejscu czy na wynos?'),
                  ('Ty', 'To take away, please. No sugar.', 'Na wynos, proszę. Bez cukru.'),
                  ('Barista', "That's four pounds. You can tap your card here.", 'To cztery funty. Możesz przyłożyć kartę tutaj.'),
                  ('Ty', 'Thank you. Could I have the receipt, please?', 'Dziękuję. Czy mogę prosić o paragon?')]},
 3002: {'title': 'Posiłek w restauracji',
        'task': 'Zmień danie i poproś o zamianę dodatku.',
        'turns': [('Kelner', 'Good evening. A table for how many people?', 'Dobry wieczór. Stolik dla ilu osób?'),
                  ('Ty', 'A table for two, please.', 'Stolik dla dwóch osób, proszę.'),
                  ('Kelner',
                   'Of course. Here are the menus. What would you like to drink?',
                   'Oczywiście. Oto menu. Czego chcecie się napić?'),
                  ('Ty', 'Two glasses of water, please. What do you recommend?', 'Dwie szklanki wody, proszę. Co polecasz?'),
                  ('Kelner',
                   'The grilled chicken is very popular. It comes with chips.',
                   'Grillowany kurczak jest bardzo popularny. Podajemy go z frytkami.'),
                  ('Ty', "I'll have that. Could I have rice instead of chips?", 'Poproszę to danie. Czy mogę dostać ryż zamiast frytek?'),
                  ('Kelner', 'Certainly. And for the other person?', 'Oczywiście. A dla drugiej osoby?'),
                  ('Ty', 'The vegetable pasta, please.', 'Poproszę makaron z warzywami.'),
                  ('Kelner', 'Was everything all right with your meal?', 'Czy wszystko było w porządku z posiłkiem?'),
                  ('Ty', 'Yes, it was delicious. Could we have the bill, please?', 'Tak, było pyszne. Czy możemy prosić o rachunek?')]},
 3003: {'title': 'Zamówienie z dostawą',
        'task': 'Zmień potrawę, adres i sposób płatności. Adres w dialogu jest przykładowy.',
        'turns': [('Pracownik restauracji',
                   'Hello, Green Kitchen. What would you like to order?',
                   'Dzień dobry, Green Kitchen. Co chcesz zamówić?'),
                  ('Ty', "I'd like chicken with rice and a vegetable soup, please.", 'Poproszę kurczaka z ryżem i zupę warzywną.'),
                  ('Pracownik restauracji', 'Is that for collection or delivery?', 'Z odbiorem czy z dostawą?'),
                  ('Ty', 'Delivery, please. Could I have the sauce separately?', 'Z dostawą, proszę. Czy mogę dostać sos osobno?'),
                  ('Pracownik restauracji', "Of course. What's the delivery address?", 'Oczywiście. Jaki jest adres dostawy?'),
                  ('Ty', 'Fifteen Green Street, flat twelve.', 'Green Street piętnaście, mieszkanie dwanaście.'),
                  ('Pracownik restauracji',
                   "That's eighteen pounds including delivery. It will take about forty minutes.",
                   'To osiemnaście funtów razem z dostawą. Potrwa to około czterdziestu minut.'),
                  ('Ty', "That's fine. Can I pay by card on delivery?", 'W porządku. Czy mogę zapłacić kartą przy odbiorze?'),
                  ('Pracownik restauracji',
                   "Yes. So that's chicken with rice, sauce separately, and one vegetable soup.",
                   'Tak. Czyli kurczak z ryżem, sos osobno i jedna zupa warzywna.'),
                  ('Ty', "That's correct. Thank you.", 'Zgadza się. Dziękuję.')]},
 3004: {'title': 'Brakujący produkt w dostawie',
        'task': 'Zgłoś inny problem i poproś o konkretne rozwiązanie.',
        'turns': [('Pracownik restauracji', 'Hello, Green Kitchen. How can I help?', 'Dzień dobry, Green Kitchen. W czym mogę pomóc?'),
                  ('Ty',
                   "I've just received my order, but one item is missing.",
                   'Właśnie otrzymałem zamówienie, ale brakuje jednego produktu.'),
                  ('Pracownik restauracji',
                   "I'm sorry about that. What's your order number?",
                   'Przepraszam za to. Jaki jest numer zamówienia?'),
                  ('Ty', "It's two four six. The soup is missing.", 'Dwa cztery sześć. Brakuje zupy.'),
                  ('Pracownik restauracji', 'Let me check. Yes, I can see it on your order.', 'Już sprawdzam. Tak, widzę ją w zamówieniu.'),
                  ('Ty', 'Could you send it, please?', 'Czy możecie ją dostarczyć?'),
                  ('Pracownik restauracji',
                   "Of course. We'll deliver it in about fifteen minutes at no extra charge.",
                   'Oczywiście. Dostarczymy ją za około piętnaście minut bez dodatkowej opłaty.'),
                  ('Ty', 'Thank you for sorting that out.', 'Dziękuję za rozwiązanie problemu.')]},
 4001: {'title': 'Wybór lotu',
        'task': 'Zmień kierunek, termin i rodzaj biletu. Ceny są przykładowe.',
        'turns': [('Konsultant', 'Hello. Where would you like to fly?', 'Dzień dobry. Dokąd chcesz polecieć?'),
                  ('Ty', "I'd like to book a flight to London.", 'Chciałbym zarezerwować lot do Londynu.'),
                  ('Konsultant', 'When would you like to travel?', 'Kiedy chcesz podróżować?'),
                  ('Ty', 'Next Friday. Is there a direct flight?', 'W przyszły piątek. Czy jest lot bezpośredni?'),
                  ('Konsultant',
                   'Yes, at ten in the morning. Would you like a return ticket?',
                   'Tak, o dziesiątej rano. Czy chcesz bilet w obie strony?'),
                  ('Ty',
                   'Yes, returning on Monday. Is checked baggage included?',
                   'Tak, z powrotem w poniedziałek. Czy bagaż rejestrowany jest wliczony?'),
                  ('Konsultant',
                   'No, but you can add one suitcase for an extra fee.',
                   'Nie, ale możesz dodać jedną walizkę za dodatkową opłatą.'),
                  ('Ty', 'Please add it. What is the total price?', 'Proszę ją dodać. Jaka jest łączna cena?'),
                  ('Konsultant', "It's one hundred and eighty pounds.", 'Sto osiemdziesiąt funtów.'),
                  ('Ty', "That works for me. I'd like to book it.", 'Odpowiada mi to. Chciałbym zarezerwować ten lot.')]},
 4002: {'title': 'Odprawa przy stanowisku',
        'task': 'Zmień liczbę bagaży i wybierz miejsce przy przejściu.',
        'turns': [('Pracownik odprawy', 'Good morning. May I see your passport, please?', 'Dzień dobry. Czy mogę zobaczyć paszport?'),
                  ('Ty', 'Of course. Here it is.', 'Oczywiście. Proszę.'),
                  ('Pracownik odprawy', 'How many bags are you checking in?', 'Ile bagaży nadajesz?'),
                  ('Ty', 'One suitcase. I also have a small backpack.', 'Jedną walizkę. Mam też mały plecak.'),
                  ('Pracownik odprawy',
                   'Please put the suitcase on the scales. Would you like a window or an aisle seat?',
                   'Proszę położyć walizkę na wadze. Wolisz miejsce przy oknie czy przy przejściu?'),
                  ('Ty', 'A window seat, please.', 'Przy oknie, proszę.'),
                  ('Pracownik odprawy',
                   "Here's your boarding pass. Boarding starts at nine fifteen at gate twelve.",
                   'Oto karta pokładowa. Wejście na pokład zaczyna się o dziewiątej piętnaście przy bramce dwanaście.'),
                  ('Ty', 'Thank you. Where is security?', 'Dziękuję. Gdzie jest kontrola bezpieczeństwa?'),
                  ('Pracownik odprawy', 'Go straight ahead and follow the signs.', 'Idź prosto i kieruj się znakami.'),
                  ('Ty', 'Thank you for your help.', 'Dziękuję za pomoc.')]},
 4003: {'title': 'Pomoc na pokładzie',
        'task': 'Zmień numer miejsca i poproś o inny napój.',
        'turns': [('Członek załogi',
                   'Welcome aboard. May I see your boarding pass?',
                   'Witamy na pokładzie. Czy mogę zobaczyć kartę pokładową?'),
                  ('Ty', 'Here it is. Where is seat fourteen A?', 'Oto ona. Gdzie jest miejsce czternaście A?'),
                  ('Członek załogi', "It's a window seat, a few rows further down.", 'To miejsce przy oknie, kilka rzędów dalej.'),
                  ('Ty', 'Thank you. Can I put my bag here?', 'Dziękuję. Czy mogę położyć tutaj torbę?'),
                  ('Członek załogi',
                   'Please put the small bag under the seat in front of you.',
                   'Proszę umieścić małą torbę pod siedzeniem przed tobą.'),
                  ('Ty', 'All right. Could I have some water, please?', 'Dobrze. Czy mogę prosić o wodę?'),
                  ('Członek załogi',
                   'Of course. Please fasten your seatbelt for take-off.',
                   'Oczywiście. Proszę zapiąć pasy na czas startu.'),
                  ('Ty', 'Certainly. Thank you.', 'Oczywiście. Dziękuję.')]},
 4004: {'title': 'Zagubiona walizka',
        'task': 'Opisz walizkę innym kolorem i podaj, gdzie się zatrzymujesz.',
        'turns': [('Pracownik punktu bagażowego', 'Hello. How can I help you?', 'Dzień dobry. W czym mogę pomóc?'),
                  ('Ty', "My suitcase hasn't arrived. I've checked the carousel.", 'Moja walizka nie dotarła. Sprawdziłem taśmę bagażową.'),
                  ('Pracownik punktu bagażowego',
                   "I'm sorry to hear that. May I see your baggage receipt?",
                   'Przykro mi to słyszeć. Czy mogę zobaczyć potwierdzenie nadania bagażu?'),
                  ('Ty', 'Yes, here it is.', 'Tak, proszę.'),
                  ('Pracownik punktu bagażowego', 'Could you describe your suitcase?', 'Czy możesz opisać walizkę?'),
                  ('Ty', "It's black, with a red ribbon on the handle.", 'Jest czarna, z czerwoną wstążką na uchwycie.'),
                  ('Pracownik punktu bagażowego',
                   'Thank you. Please fill in this form with your contact details and hotel address.',
                   'Dziękuję. Proszę wpisać w tym formularzu dane kontaktowe i adres hotelu.'),
                  ('Ty', 'Of course. How can I check for updates?', 'Oczywiście. Jak mogę sprawdzać nowe informacje?'),
                  ('Pracownik punktu bagażowego',
                   'Use this reference number on our tracking page.',
                   'Użyj tego numeru sprawy na naszej stronie do śledzenia bagażu.'),
                  ('Ty', "Thank you. I'll keep the reference number.", 'Dziękuję. Zachowam numer sprawy.')]},
 5001: {'title': 'Zameldowanie w hotelu',
        'task': 'Zmień nazwisko i długość pobytu, następnie zapytaj o wymeldowanie.',
        'turns': [('Recepcjonista', 'Good evening. Do you have a reservation?', 'Dobry wieczór. Czy masz rezerwację?'),
                  ('Ty', 'Yes, under the name Kurda.', 'Tak, na nazwisko Kurda.'),
                  ('Recepcjonista',
                   'I have it here. Three nights in a double room, correct?',
                   'Mam ją tutaj. Trzy noce w pokoju dwuosobowym, zgadza się?'),
                  ('Ty', "Yes, that's right. Is breakfast included?", 'Tak, zgadza się. Czy śniadanie jest wliczone?'),
                  ('Recepcjonista',
                   "Yes. It's served from seven to ten in the dining room.",
                   'Tak. Podajemy je od siódmej do dziesiątej w jadalni.'),
                  ('Ty', 'Great. What time is check-out?', 'Świetnie. O której jest wymeldowanie?'),
                  ('Recepcjonista',
                   'By eleven. Here is your key. Your room is on the second floor.',
                   'Do jedenastej. Oto klucz. Pokój jest na drugim piętrze.'),
                  ('Ty', 'Thank you. Could you tell me the Wi-Fi password?', 'Dziękuję. Czy możesz podać mi hasło do Wi-Fi?'),
                  ('Recepcjonista', "It's printed on your key card holder.", 'Jest wydrukowane na etui karty do pokoju.'),
                  ('Ty', 'Thank you for your help.', 'Dziękuję za pomoc.')]},
 5002: {'title': 'Wizyta w muzeum',
        'task': 'Zapytaj o inną atrakcję i zmień liczbę biletów.',
        'turns': [('Pracownik informacji', 'Hello. What would you like to visit today?', 'Dzień dobry. Co chcesz dzisiaj zwiedzić?'),
                  ('Ty',
                   "I'm interested in the city museum. Is it open today?",
                   'Interesuje mnie muzeum miejskie. Czy jest dzisiaj otwarte?'),
                  ('Pracownik informacji',
                   'Yes, until six. The last entry is at five.',
                   'Tak, do szóstej. Ostatnie wejście jest o piątej.'),
                  ('Ty', 'Can I buy tickets here?', 'Czy mogę kupić bilety tutaj?'),
                  ('Pracownik informacji', 'Yes. How many would you like?', 'Tak. Ile biletów chcesz kupić?'),
                  ('Ty',
                   'Two adult tickets, please. Is an audio guide included?',
                   'Dwa bilety dla dorosłych, proszę. Czy audioprzewodnik jest wliczony?'),
                  ('Pracownik informacji',
                   "No, it's three pounds extra per person. Would you like one?",
                   'Nie, kosztuje dodatkowo trzy funty za osobę. Czy chcesz jeden?'),
                  ('Ty',
                   'Yes, one please. Could you show me the museum on the map?',
                   'Tak, jeden, proszę. Czy możesz pokazać mi muzeum na mapie?'),
                  ('Pracownik informacji',
                   "Of course. It's here, opposite the library.",
                   'Oczywiście. Jest tutaj, naprzeciwko biblioteki.'),
                  ('Ty', "Thank you. That's very helpful.", 'Dziękuję. To bardzo pomocne.')]},
 5003: {'title': 'Umawianie spotkania',
        'task': 'Zaproponuj inną aktywność i ustal czas oraz miejsce.',
        'turns': [('Znajomy', 'Are you free on Saturday afternoon?', 'Czy masz czas w sobotę po południu?'),
                  ('Ty', 'I think so. What do you have in mind?', 'Chyba tak. Co masz na myśli?'),
                  ('Znajomy', 'Would you like to go to the cinema?', 'Czy chcesz pójść do kina?'),
                  ('Ty', "I'd like to, but I don't want to stay out late.", 'Chętnie, ale nie chcę wracać późno.'),
                  ('Znajomy', "There's a showing at four. Would that work for you?", 'Jest seans o czwartej. Czy ta godzina ci odpowiada?'),
                  ('Ty', "Yes, that's perfect. Where shall we meet?", 'Tak, idealnie. Gdzie się spotkamy?'),
                  ('Znajomy', 'Outside the cinema at quarter to four.', 'Przed kinem za piętnaście czwarta.'),
                  ('Ty', 'Great. See you there!', 'Świetnie. Do zobaczenia na miejscu!')]},
 5004: {'title': 'Wspomnienia z Wenecji',
        'task': 'Opowiedz o innym miejscu. Dodaj jedną zaletę i jedną wadę wyjazdu.',
        'turns': [('Znajomy', 'How was your holiday in Venice?', 'Jak minęły twoje wakacje w Wenecji?'),
                  ('Ty',
                   'It was lovely. I really enjoyed walking along the canals.',
                   'Było wspaniale. Bardzo podobały mi się spacery wzdłuż kanałów.'),
                  ('Znajomy', 'What was the best part?', 'Co było najlepsze?'),
                  ('Ty', 'The views from the bridges were amazing.', 'Widoki z mostów były niesamowite.'),
                  ('Znajomy', 'Was it very crowded?', 'Czy było bardzo tłoczno?'),
                  ('Ty',
                   'Yes, especially in the main square. I preferred the quieter streets.',
                   'Tak, zwłaszcza na głównym placu. Wolałem spokojniejsze uliczki.'),
                  ('Znajomy', 'I think smaller places are more relaxing.', 'Myślę, że mniejsze miejscowości są bardziej relaksujące.'),
                  ('Ty',
                   "I see your point, but I'd still like to visit Venice again.",
                   'Rozumiem twój punkt widzenia, ale i tak chciałbym znów odwiedzić Wenecję.')]},
 6001: {'title': 'Opisywanie projektów w CV',
        'task': 'Opisz własny projekt testowy i narzędzie, którego rzeczywiście używasz.',
        'turns': [('Rekruter',
                   'Could you tell me about your testing experience?',
                   'Czy możesz opowiedzieć o swoim doświadczeniu w testowaniu?'),
                  ('Ty',
                   "I don't have commercial experience yet, but I work on my own projects.",
                   'Nie mam jeszcze doświadczenia komercyjnego, ale pracuję nad własnymi projektami.'),
                  ('Rekruter', 'What have you tested?', 'Co testowałeś?'),
                  ('Ty',
                   "I've tested login forms, shopping baskets and bank transfers in demo applications.",
                   'Testowałem formularze logowania, koszyki i przelewy bankowe w aplikacjach demonstracyjnych.'),
                  ('Rekruter', 'Which tools do you use?', 'Jakich narzędzi używasz?'),
                  ('Ty',
                   'I use Playwright for automated tests and Postman for API tests.',
                   'Używam Playwrighta do testów automatycznych i Postmana do testów API.'),
                  ('Rekruter', 'Could you share an example of your work?', 'Czy możesz pokazać przykład swojej pracy?'),
                  ('Ty',
                   'Yes. I can send you a link to my GitHub repository.',
                   'Tak. Mogę wysłać link do mojego repozytorium na GitHubie.')]},
 6002: {'title': 'Pytanie o ofertę Junior QA',
        'task': 'Zapytaj o pracę zdalną, wymagane doświadczenie i następny krok.',
        'turns': [('Rekruter',
                   'Hello. Are you interested in our junior QA position?',
                   'Dzień dobry. Czy interesuje cię nasze stanowisko Junior QA?'),
                  ('Ty', "Yes. I'm looking for my first job in testing.", 'Tak. Szukam pierwszej pracy w testowaniu.'),
                  ('Rekruter', 'Have you worked as a tester before?', 'Czy wcześniej pracowałeś jako tester?'),
                  ('Ty',
                   'Not commercially, but I have practical experience from my own projects.',
                   'Nie komercyjnie, ale mam praktyczne doświadczenie z własnych projektów.'),
                  ('Rekruter',
                   "That's useful. What would you like to know about the role?",
                   'To przydatne. Czego chcesz się dowiedzieć o tym stanowisku?'),
                  ('Ty',
                   'Is remote work possible, and is student status required?',
                   'Czy możliwa jest praca zdalna i czy wymagany jest status studenta?'),
                  ('Rekruter',
                   "For this role, remote work is possible and student status isn't required.",
                   'Na tym stanowisku możliwa jest praca zdalna i status studenta nie jest wymagany.'),
                  ('Ty', 'Thank you. Where can I send my CV?', 'Dziękuję. Gdzie mogę wysłać CV?'),
                  ('Rekruter',
                   'Please apply through the form on our careers page.',
                   'Proszę aplikować przez formularz na naszej stronie z ofertami pracy.'),
                  ('Ty', "Great, I'll do that. Thank you for the information.", 'Świetnie, tak zrobię. Dziękuję za informacje.')]},
 6003: {'title': 'Rozmowa o sposobie testowania',
        'task': 'Odpowiedz własnymi słowami, jak sprawdziłbyś formularz logowania.',
        'turns': [('Rekruter', 'Why would you like to work in QA?', 'Dlaczego chcesz pracować w QA?'),
                  ('Ty',
                   'I enjoy finding problems and understanding how applications work.',
                   'Lubię znajdować problemy i rozumieć, jak działają aplikacje.'),
                  ('Rekruter', 'How would you test a login form?', 'Jak przetestowałbyś formularz logowania?'),
                  ('Ty',
                   "I'd check valid and invalid credentials, empty fields and error messages.",
                   'Sprawdziłbym poprawne i niepoprawne dane logowania, puste pola i komunikaty błędów.'),
                  ('Rekruter', 'What would you do if a requirement was unclear?', 'Co zrobiłbyś, gdyby wymaganie było niejasne?'),
                  ('Ty',
                   "I'd ask for clarification before deciding what the expected result should be.",
                   'Poprosiłbym o wyjaśnienie, zanim ustaliłbym, jaki powinien być oczekiwany wynik.'),
                  ('Rekruter', 'Good. Do you have any questions for us?', 'Dobrze. Czy masz do nas jakieś pytania?'),
                  ('Ty',
                   'Yes. How do junior testers get support from the team?',
                   'Tak. Jakie wsparcie od zespołu otrzymują młodsi testerzy?')]},
 6004: {'title': 'Rozmowa o znalezionym błędzie',
        'task': 'Opisz własny błąd: kroki, wynik rzeczywisty i oczekiwany.',
        'turns': [('Programista',
                   'You mentioned a bug in the login form. What happens?',
                   'Wspomniałeś o błędzie w formularzu logowania. Co się dzieje?'),
                  ('Ty',
                   'When I enter a valid email and leave the password empty, the page shows a server error.',
                   'Kiedy wpisuję poprawny e-mail i zostawiam puste hasło, strona pokazuje błąd serwera.'),
                  ('Programista', 'What should happen instead?', 'Co powinno się wydarzyć zamiast tego?'),
                  ('Ty',
                   'It should show a message asking the user to enter a password.',
                   'Powinien pojawić się komunikat proszący użytkownika o wpisanie hasła.'),
                  ('Programista', 'Can you reproduce it every time?', 'Czy możesz odtworzyć ten błąd za każdym razem?'),
                  ('Ty',
                   "Yes. I've added the steps and a screenshot to the bug report.",
