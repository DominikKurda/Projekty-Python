def seed_words() -> Dict[str, Word]:
    seed = []
    for lesson in LESSONS[:4]:
        seed.extend((p["en"], p["pl"], [f"lesson{lesson['id']}"]) for p in lesson["required_phrases"])
    return {f"w{i:04d}": Word(f"w{i:04d}", en, pl, tags=tags, created_at=now_iso())
            for i, (en, pl, tags) in enumerate(seed, 1)}


def save_words(words: Dict[str, Word]) -> None:
    DATA_FILE.parent.mkdir(parents=True, exist_ok=True)
    temporary = DATA_FILE.with_suffix(".tmp")
    temporary.write_text(json.dumps({"words": [word.to_dict() for word in words.values()]}, ensure_ascii=False, indent=2), encoding="utf-8")
    temporary.replace(DATA_FILE)


def load_words() -> Dict[str, Word]:
    if not DATA_FILE.exists():
        words = seed_words()
        save_words(words)
        return words
    try:
        raw = json.loads(DATA_FILE.read_text(encoding="utf-8"))
        words = {item.get("id", ""): Word.from_dict(item) for item in raw.get("words", []) if item.get("id")}
        return words
    except (OSError, json.JSONDecodeError, TypeError) as error:
        raise RuntimeError(f"Nie można odczytać pliku danych: {DATA_FILE}") from error


def missing_phrases(words: Dict[str, Word], lesson: dict) -> list:
    existing = {(norm(w.en), norm(w.pl)) for w in words.values()}
    return [p for p in lesson["required_phrases"] if (norm(p["en"]), norm(p["pl"])) not in existing]


