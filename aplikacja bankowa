def get_transfer_limits(user_id: int):
    db = get_db()
    db.execute(
        """INSERT OR IGNORE INTO transfer_limits
        (user_id, single_limit_cents, daily_limit_cents, updated_at)
        VALUES (?, 500000, 1000000, ?)""",
        (user_id, now_iso()),
    )
    db.commit()
    return db.execute('SELECT * FROM transfer_limits WHERE user_id = ?', (user_id,)).fetchone()


def direct_transfers_today(user_id: int) -> int:
    return get_db().execute(
        """SELECT COALESCE(SUM(amount_cents), 0) FROM transactions
        WHERE user_id = ? AND kind = 'debit' AND counterparty_account LIKE 'PL%'
        AND substr(created_at, 1, 10) = ?""",
        (user_id, date.today().isoformat()),
    ).fetchone()[0] + wallet_transfers_today(user_id)


def recipient_name_matches(value: str, recipient) -> bool:
    supplied = normalize_assistant_text(re.sub(r'[^A-Za-zĄĆĘŁŃÓŚŹŻąćęłńóśźż -]', '', value))
    expected = normalize_assistant_text(f"{recipient['first_name']} {recipient['last_name']}")
    reverse = normalize_assistant_text(f"{recipient['last_name']} {recipient['first_name']}")
    return supplied in {expected, reverse}


@app.route('/transfer-limits', methods=['GET', 'POST'])
@login_required
def transfer_limits():
    user = financial_user()
    limits = get_transfer_limits(user['id'])
    if request.method == 'POST':
        single = parse_amount(request.form.get('single_limit', ''))
        daily = parse_amount(request.form.get('daily_limit', ''))
        error = None
        if not valid_csrf():
            error = 'Sesja formularza wygasła. Spróbuj ponownie.'
        elif single is None or daily is None:
            error = 'Podaj poprawne limity większe od 0 zł.'
        elif single > daily:
            error = 'Limit pojedynczego przelewu nie może być większy od limitu dziennego.'
        if single > 100000000 or daily > 100000000:
            error = 'Maksymalny limit wynosi 1 000 000 zł.'
        if error:
            flash(error, 'error')
        else:
            db = get_db()
            db.execute(
                """UPDATE transfer_limits SET single_limit_cents = ?,
                daily_limit_cents = ?, updated_at = ? WHERE user_id = ?""",
                (single, daily, now_iso(), user['id']),
            )
            add_notification(user['id'], 'Limity przelewów zmienione',
                             f"Limit pojedynczy: {money(single)}, dzienny: {money(daily)}.", 'security')
            db.commit()
            flash('Limity przelewów zostały zapisane.', 'success')
