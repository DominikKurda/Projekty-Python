    request_accounts = db.execute(
        """SELECT u.id, u.first_name, u.last_name, u.account_number
        FROM users u JOIN user_access a ON a.user_id = u.id
        WHERE u.id != ? AND a.role = 'customer'
          AND (? = '' OR (u.first_name || ' ' || u.last_name) LIKE ? COLLATE NOCASE
                       OR u.account_number LIKE ?)
        ORDER BY u.first_name COLLATE NOCASE, u.last_name COLLATE NOCASE
        LIMIT 25""",
        (user['id'], payer_query, payer_pattern, payer_account_pattern),
    ).fetchall()
    selected_payer_user_id = None
    if request.method == 'GET':
        selected_payer_user_id = request.args.get('payer_user', type=int)
        if selected_payer_user_id is not None:
            selected_payer = db.execute(
                """SELECT u.id, u.account_number
                FROM users u JOIN user_access a ON a.user_id = u.id
                WHERE u.id = ? AND u.id != ? AND a.role = 'customer'""",
                (selected_payer_user_id, user['id']),
            ).fetchone()
            if selected_payer is None:
                flash('Nie znaleziono wybranego konta osoby płacącej.', 'error')
                selected_payer_user_id = None
            else:
                values['payer_account'] = selected_payer['account_number']
    if request.method == 'POST':
        error = None
        amount = parse_amount(values['amount'])
        payer_account = normalize_account_number(values['payer_account'])
        if not valid_csrf():
            error = 'Sesja formularza wygasła. Odśwież stronę i spróbuj ponownie.'
        elif account_validation_error(payer_account):
            error = account_validation_error(payer_account)
        elif amount is None:
            error = 'Podaj poprawną kwotę prośby większą od 0 zł.'
        elif not values['title'] or len(values['title']) > 140:
            error = 'Podaj tytuł prośby (maksymalnie 140 znaków).'
        payer = None
        if error is None:
            payer = db.execute(
                'SELECT * FROM users WHERE account_number = ?', (payer_account,)
            ).fetchone()
            if payer is None:
                error = 'W wersji demo możesz wysłać prośbę tylko do użytkownika NovaBank.'
