@app.route('/wallet/transfer',methods=['GET','POST'])
@login_required
def wallet_transfer():
    db=get_db();user=current_user();uid=user['id']
    currency_limits=get_wallet_currency_limits(uid)
    selected=request.values.get('currency','EUR')
    if selected not in EXCHANGE_CURRENCIES: selected='EUR'
    recipients=db.execute("""SELECT u.id,u.first_name,u.last_name,u.account_number FROM users u
        JOIN user_access a ON a.user_id=u.id WHERE u.id!=? AND u.account_type='personal'
        AND u.activation_status='active' AND a.role='customer' AND a.locked=0 ORDER BY u.first_name,u.last_name""",(uid,)).fetchall()
    values={key:request.form.get(key,'').strip() for key in ('recipient_id','amount','title')}
    if request.method=='POST':
        if not valid_csrf(): abort(400)
        try:
            if request.form.get('confirmation'):
                payload=wallet_decode(request.form['confirmation'],'transfer')
                currency=wallet_currency(payload['currency']);amount=payload['amount'];recipient_id=payload['recipient_id'];title=payload['title']
                equivalent=int(payload['pln_equivalent'])
                rate=Decimal(payload['rate']);rate_date=payload['rate_date'];rate_checked_at=payload.get('rate_checked_at','')
                if not rate.is_finite() or rate <= 0 or equivalent <= 0:
                    raise ValueError('Podsumowanie przelewu wygasło. Otwórz formularz ponownie.')
            else:
                currency=wallet_currency(request.form.get('currency'));amount=wallet_amount(values['amount'],currency)
                if not re.fullmatch(r'[0-9]{1,18}', values['recipient_id']):
                    raise ValueError('Wybierz odbiorcę z listy użytkowników NovaBanku.')
                recipient_id=int(values['recipient_id']);title=values['title']
            if not title or len(title)>140: raise ValueError('Podaj tytuł przelewu (maksymalnie 140 znaków).')
            recipient=db.execute("""SELECT u.* FROM users u JOIN user_access a ON a.user_id=u.id
                WHERE u.id=? AND u.id!=? AND u.account_type='personal' AND u.activation_status='active'
                AND a.role='customer' AND a.locked=0""",(recipient_id,uid)).fetchone()
            if recipient is None: raise ValueError('Wybierz aktywnego odbiorcę NovaBanku.')
            limits=get_transfer_limits(uid)
            if not request.form.get('confirmation'):
                # Przelew może być pierwszą operacją po uruchomieniu aplikacji.
                # Pobierz kurs, jeśli lokalny cache nie został jeszcze zapełniony.
                snapshot=nbp_snapshot(refresh=True)
                pair=snapshot['rates'].get(currency)
                if not pair or not snapshot['available']:
                    raise ValueError('Brak zapisanego kursu do sprawdzenia limitu w PLN. Otwórz kantor i odśwież kursy.')
                rate=(pair[0]+pair[1])/2
                equivalent=int((Decimal(amount)*rate).quantize(Decimal('1'),rounding=ROUND_HALF_UP))
                rate_date=snapshot['date'];rate_checked_at=snapshot['checked_at'] or ''
            currency_limit=currency_limits[currency]['transfer_daily_limit_cents']
            currency_used=wallet_currency_usage(uid,currency,'transfer')
            if amount>currency_limit or currency_used+amount>currency_limit:
                raise ValueError('Przekroczono dzienny limit przelewów w '+currency+'. Pozostało: '+wallet_money(max(0,currency_limit-currency_used),currency)+'.')
            if not request.form.get('confirmation'):
                if wallet_balance(uid,currency)<amount: raise ValueError('Brak środków w portfelu '+currency+'.')
                # direct_transfers_today uwzględnia już przelewy walutowe.
                global_daily_used=direct_transfers_today(uid)
                if equivalent>limits['single_limit_cents'] or global_daily_used+equivalent>limits['daily_limit_cents']:
                    raise ValueError('Przekroczono limit przelewów w przeliczeniu na PLN.')
                confirmation=wallet_token('transfer',currency=currency,amount=amount,recipient_id=recipient_id,title=title,pln_equivalent=equivalent,rate=str(rate),rate_date=rate_date,rate_checked_at=rate_checked_at)
                balance_before=wallet_balance(uid,currency)
                return page('Potwierdź przelew walutowy',r'''
