            flash('Decyzja pozytywna — środki są już na rachunku.' if status == 'approved' else 'Decyzja negatywna. Szczegóły znajdziesz przy wniosku.', 'success' if status == 'approved' else 'error')
            return redirect(url_for('loans'))
    applications = get_db().execute(
