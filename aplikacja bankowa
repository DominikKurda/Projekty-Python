        db.execute('DELETE FROM card_backgrounds WHERE user_id = ?', (user['id'],))
        db.commit()
        flash('Zdjęcie karty zostało usunięte. Przywrócono wybrany motyw.', 'success')
        return redirect(url_for('cards'))
    if action != 'upload':
        abort(400)
    upload = request.files.get('photo')
    try:
        if upload is None or not upload.filename:
            raise ValueError('Wybierz zdjęcie karty.')
        raw = upload.read(5 * 1024 * 1024 + 1)
        if len(raw) > 5 * 1024 * 1024:
            raise ValueError('Zdjęcie może mieć maksymalnie 5 MB.')
        with warnings.catch_warnings():
            warnings.simplefilter('error', Image.DecompressionBombWarning)
            with Image.open(BytesIO(raw)) as source:
                if source.format not in ('JPEG', 'PNG', 'WEBP'):
                    raise ValueError('Obsługiwane formaty to JPG, PNG i WebP.')
                if source.width * source.height > 16_000_000:
                    raise ValueError('Zdjęcie może mieć maksymalnie 16 milionów pikseli.')
                source.load()
                cropped = ImageOps.fit(ImageOps.exif_transpose(source).convert('RGB'),
                                       (960, 605), method=Image.Resampling.LANCZOS)
                clean = Image.new('RGB', (960, 605))
                clean.paste(cropped)
                buffer = BytesIO()
                clean.save(buffer, format='JPEG', quality=88, optimize=True)
        db.execute('''INSERT INTO card_backgrounds(user_id, image, updated_at)
            VALUES (?, ?, ?) ON CONFLICT(user_id) DO UPDATE SET
            image = excluded.image, updated_at = excluded.updated_at''',
            (user['id'], buffer.getvalue(), now_iso()))
        db.commit()
    except ValueError as exc:
        flash(str(exc), 'error')
    except (UnidentifiedImageError, OSError, Image.DecompressionBombError, Image.DecompressionBombWarning):
        flash('Nie można odczytać zdjęcia. Wybierz poprawny plik JPG, PNG lub WebP.', 'error')
    else:
        flash('Zdjęcie karty zostało zapisane.', 'success')
    return redirect(url_for('cards'))


@app.post('/cards/reveal')
@login_required
def reveal_card_details():
    """Returns generated demo card details only after password confirmation."""
    if not valid_csrf():
        abort(400)
    user = current_user()
    if user is None or not check_password_hash(user['password_hash'], request.form.get('password', '')):
        response = Response(json.dumps({'error': 'Hasło jest nieprawidłowe.'}), status=401,
                            mimetype='application/json')
    else:
        number = visa_card_number(user['id'])
        expiry = f"12/{(date.today().year + 3) % 100:02d}"
        grouped = ' '.join(number[index:index + 4] for index in range(0, 16, 4))
        response = Response(json.dumps({'number': grouped, 'expiry': expiry,
                                        'cvv': visa_cvv(user['id'])}),
                            status=200, mimetype='application/json')
    response.headers['Cache-Control'] = 'no-store, no-cache, must-revalidate, max-age=0'
    response.headers['Pragma'] = 'no-cache'
    response.headers['X-Content-Type-Options'] = 'nosniff'
    return response


