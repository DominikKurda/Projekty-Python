def login_device_label(user_agent: str) -> str:
    """Tworzy krótki opis urządzenia na podstawie nagłówka przeglądarki."""
    agent = (user_agent or '').lower()
    if 'edg/' in agent:
        browser = 'Microsoft Edge'
    elif 'firefox/' in agent:
        browser = 'Firefox'
    elif 'chrome/' in agent or 'crios/' in agent:
        browser = 'Google Chrome'
    elif 'safari/' in agent:
        browser = 'Safari'
    else:
        browser = 'Inna przeglądarka'

    if 'windows' in agent:
        system = 'Windows'
    elif 'android' in agent:
        system = 'Android'
    elif 'iphone' in agent or 'ipad' in agent:
        system = 'iOS'
    elif 'mac os' in agent or 'macintosh' in agent:
        system = 'macOS'
    elif 'linux' in agent:
        system = 'Linux'
    else:
        system = 'Nieznany system'
    return f'{browser} · {system}'


def record_login_event(user_id: int, event_type: str) -> bool:
    """Zapisuje zdarzenie i zwraca True przy logowaniu z nowego urządzenia."""
    db = get_db()
    raw_agent = (request.headers.get('User-Agent') or 'Nieznana przeglądarka')[:500]
    ip_address = (request.remote_addr or 'Nieznany adres')[:100]
    device = login_device_label(raw_agent)
    new_device = False
    if event_type == 'success':
        had_success = db.execute(
            "SELECT 1 FROM login_history WHERE user_id = ? AND event_type = 'success' LIMIT 1",
            (user_id,),
        ).fetchone()
        known_device = db.execute(
            """SELECT 1 FROM login_history
            WHERE user_id = ? AND event_type = 'success' AND device_label = ? LIMIT 1""",
            (user_id, device),
        ).fetchone()
        new_device = had_success is not None and known_device is None
    db.execute(
        """INSERT INTO login_history
        (user_id, event_type, ip_address, user_agent, device_label, created_at)
        VALUES (?, ?, ?, ?, ?, ?)""",
        (user_id, event_type, ip_address, raw_agent, device, now_iso()),
    )
    if new_device:
        add_notification(
            user_id,
            'Nowe logowanie do NovaBank',
            f'Wykryto logowanie z nowego urządzenia: {device}, adres IP: {ip_address}.',
            'security',
        )
    db.commit()
    return new_device


