@app.route('/exchange', methods=['GET', 'POST'])
@login_required
def exchange():
    user = current_user()
    if user is None:
        clear_session_preserving_language()
        return redirect(url_for('login'))
    db = get_db()
    snapshot = nbp_snapshot(refresh=not request.form.get('confirmation'))
    display_rates = {code: snapshot['rates'].get(code, (Decimal('0'), Decimal('0'))) for code in EXCHANGE_CURRENCIES}
    values = {'currency': request.args.get('currency', 'EUR'), 'direction': request.args.get('direction', 'buy'), 'amount': ''}
    if values['currency'] not in EXCHANGE_CURRENCIES:
        values['currency'] = 'EUR'
    if values['direction'] not in ('buy', 'sell'):
        values['direction'] = 'buy'
    draft_serializer = URLSafeTimedSerializer(app.secret_key, salt='exchange-draft')
    draft_token = request.form.get('draft_token', '') or draft_serializer.dumps(
        {'user': user['id'], 'nonce': secrets.token_urlsafe(32)})
    status = 200
    if request.method == 'POST':
        values = {key: request.form.get(key, '') for key in values}
        error = None
        amount = None
        if not valid_csrf():
            error = 'Nieprawidłowy token CSRF. Odśwież stronę i spróbuj ponownie.'
            status = 400
        elif values['currency'] not in EXCHANGE_CURRENCIES or values['direction'] not in ('buy', 'sell'):
            error = 'Wybierz poprawną walutę i rodzaj wymiany.'
        else:
            raw = values['amount'].strip().replace(',', '.')
            if not re.fullmatch(r'[0-9]{1,7}(?:\.[0-9]{1,2})?', raw):
                error = 'Podaj kwotę waluty z maksymalnie dwoma miejscami po przecinku.'
            else:
                amount = int(Decimal(raw) * 100)
                if not 1 <= amount <= 100_000_000:
                    error = 'Kwota waluty musi wynosić od 0,01 do 1 000 000.'
        if error is None:
            currency, direction = values['currency'], values['direction']
            quote_source = 'NBP-A-DEMO' if currency in NBP_TABLE_A_CURRENCIES else 'NBP'
            quote_meta = snapshot.get('currency_meta', {}).get(currency, {})
            serializer = URLSafeTimedSerializer(app.secret_key, salt='exchange-confirmation')
            confirmation = request.form.get('confirmation', '')
            if confirmation:
                try:
                    payload = serializer.loads(confirmation, max_age=1800)
                    if any(payload.get(k) != v for k, v in {'user': user['id'], 'currency': currency, 'direction': direction, 'amount': amount, 'source': quote_source}.items()):
                        raise BadSignature('Zmienione dane wymiany')
                    rate = Decimal(payload['rate'])
                    date.fromisoformat(payload['rate_date'])
                    if not rate.is_finite() or not Decimal('0') < rate <= Decimal('1000') or not payload.get('nonce'):
                        raise BadSignature('Niepoprawny kurs')
                except (BadSignature, SignatureExpired, ValueError, KeyError, TypeError, InvalidOperation):
                    flash('Potwierdzenie wygasło lub dane uległy zmianie. Rozpocznij wymianę ponownie.', 'error')
                    return redirect(url_for('exchange'))
            else:
                if currency not in snapshot['rates']:
                    flash('Brak kursów NBP. Połącz się z internetem i odśwież kantor. Nie wykonano wymiany.', 'error')
                    return redirect(url_for('exchange'))
                rate = snapshot['rates'][currency][1 if direction == 'buy' else 0]
            pln = int((Decimal(amount) * rate).quantize(Decimal('1'), rounding=ROUND_HALF_UP))
            if pln < 1:
                flash('Kwota rozliczenia musi wynosić co najmniej 0,01 zł.', 'error')
                return redirect(url_for('exchange'))
            if not confirmation:
                try:
                    draft = draft_serializer.loads(draft_token, max_age=1800)
