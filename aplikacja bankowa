            "warning",
        )


def next_month(value: date) -> date:
    year = value.year + (1 if value.month == 12 else 0)
    month = 1 if value.month == 12 else value.month + 1
    return date(year, month, min(value.day, calendar.monthrange(year, month)[1]))


def add_months(value: date, months: int) -> date:
    result = value
    for _ in range(months):
        result = next_month(result)
    return result


def calculate_deposit_interest(principal_cents: int, months: int, annual_rate: Decimal) -> int:
    interest = (
        Decimal(principal_cents)
        * annual_rate
        / Decimal("100")
        * Decimal(months)
        / Decimal("12")
    )
    return int(interest.quantize(Decimal("1"), rounding=ROUND_HALF_UP))


def following_execution(value: date, recurrence: str) -> date | None:
    if recurrence == "weekly":
        return value + timedelta(days=7)
    if recurrence == "monthly":
        return next_month(value)
    return None


def process_due_scheduled_transfers(user_id: int) -> None:
    """Realizuje oczekujące przelewy przy wejściu zalogowanego użytkownika do aplikacji."""
    db = get_db()
    today = date.today()
    due = db.execute(
        """SELECT * FROM scheduled_transfers
        WHERE user_id = ? AND status = 'active' AND next_execution <= ?
        ORDER BY next_execution, id""",
        (user_id, today.isoformat()),
    ).fetchall()

    for item in due:
        recipient = db.execute(
            "SELECT * FROM users WHERE account_number = ?",
            (item["account_number"],),
        ).fetchone()
        sender = db.execute("SELECT * FROM users WHERE id = ?", (user_id,)).fetchone()
        if recipient is None or recipient["id"] == user_id:
            db.execute(
                "UPDATE scheduled_transfers SET status = 'paused' WHERE id = ?",
                (item["id"],),
            )
            add_notification(
                user_id,
                "Przelew cykliczny wstrzymany",
                f"Nie można odnaleźć odbiorcy przelewu „{item['title']}”.",
                "warning",
            )
            db.commit()
            continue
        if sender["balance_cents"] < item["amount_cents"]:
            db.execute(
                "UPDATE scheduled_transfers SET status = 'paused' WHERE id = ?",
                (item["id"],),
            )
            add_notification(
                user_id,
                "Brak środków na przelew",
                f"Przelew „{item['title']}” został wstrzymany. Wymagana kwota: {money(item['amount_cents'])}.",
                "warning",
            )
            db.commit()
            continue

        limits = get_transfer_limits(user_id)
        used_today = direct_transfers_today(user_id)
        if (item['amount_cents'] > limits['single_limit_cents']
                or used_today + item['amount_cents'] > limits['daily_limit_cents']):
            db.execute(
                "UPDATE scheduled_transfers SET status = 'paused' WHERE id = ?",
                (item['id'],),
            )
            add_notification(
                user_id, 'Przelew cykliczny wstrzymany',
                f"Przelew „{item['title']}” przekracza ustawiony limit przelewów.",
                'warning',
            )
            db.commit()
            continue

        stamp = now_iso()
        try:
            db.execute("BEGIN IMMEDIATE")
            changed = db.execute(
                "UPDATE users SET balance_cents = balance_cents - ? WHERE id = ? AND balance_cents >= ?",
                (item["amount_cents"], user_id, item["amount_cents"]),
            )
            if changed.rowcount != 1:
                raise ValueError("Brak wystarczających środków.")
            db.execute(
                "UPDATE users SET balance_cents = balance_cents + ? WHERE id = ?",
                (item["amount_cents"], recipient["id"]),
            )
            debit = db.execute(
                """INSERT INTO transactions
                (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
                VALUES (?, 'debit', ?, ?, ?, ?, ?)""",
                (user_id, item["amount_cents"], item["title"], item["recipient"], item["account_number"], stamp),
            )
            credit = db.execute(
                """INSERT INTO transactions
                (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
                VALUES (?, 'credit', ?, ?, ?, ?, ?)""",
                (
                    recipient["id"], item["amount_cents"], item["title"],
                    f"{sender['first_name']} {sender['last_name']}", sender["account_number"], stamp,
                ),
            )
            scheduled_day = date.fromisoformat(item["next_execution"])
            next_day = following_execution(scheduled_day, item["recurrence"])
            if next_day is None:
                db.execute(
                    "UPDATE scheduled_transfers SET status = 'completed', last_executed_at = ? WHERE id = ?",
                    (stamp, item["id"]),
                )
            else:
                while next_day <= today:
                    next_day = following_execution(next_day, item["recurrence"])
                db.execute(
                    "UPDATE scheduled_transfers SET next_execution = ?, last_executed_at = ? WHERE id = ?",
                    (next_day.isoformat(), stamp, item["id"]),
                )
            add_notification(
                user_id,
                "Przelew zaplanowany wykonany",
                f"Tytuł: {item['title']}. Przelew cykliczny został zaksięgowany.",
                "success",
                operation_type="scheduled_transfer_out",
                operation_reference=f"AUTO-{item['id']:06d}",
                amount_cents=item['amount_cents'],
                counterparty=item['recipient'],
                related_transaction_id=debit.lastrowid,
            )
            add_notification(
                recipient["id"],
                "Otrzymano przelew zaplanowany",
                f"Tytuł: {item['title']}. Środki są już dostępne na rachunku.",
                "success",
                operation_type="scheduled_transfer_in",
                operation_reference=f"AUTO-{item['id']:06d}",
                amount_cents=item['amount_cents'],
                counterparty=f"{sender['first_name']} {sender['last_name']}",
                related_transaction_id=credit.lastrowid,
            )
            warn_about_low_balance(user_id, sender["balance_cents"] - item["amount_cents"])
            db.commit()
        except (sqlite3.Error, ValueError):
            db.rollback()
            db.execute(
                "UPDATE scheduled_transfers SET status = 'paused' WHERE id = ?",
                (item["id"],),
            )
            add_notification(
                user_id,
                "Przelew zaplanowany wstrzymany",
                f"Nie udało się wykonać przelewu „{item['title']}”.",
                "warning",
            )
            db.commit()


def next_monthly_day(payment_day: int, *, after: date | None = None) -> date:
    reference = after or date.today()
    candidate = reference.replace(day=min(payment_day, 28))
    if candidate < reference:
        candidate = next_month(candidate).replace(day=min(payment_day, 28))
    return candidate






def process_due_loan_installments(user_id: int) -> None:
    """Automatycznie pobiera wymagalne raty przy aktywności klienta."""
    db = get_db()
    due_installments = db.execute(
        """SELECT i.*, l.id AS loan_number
        FROM loan_installments i
        JOIN loan_applications l ON l.id = i.loan_id
        WHERE l.user_id = ? AND l.status = 'approved'
          AND i.status = 'pending' AND i.due_date <= ?
        ORDER BY i.due_date, i.installment_number""",
        (user_id, date.today().isoformat()),
    ).fetchall()
    for installment in due_installments:
        user = db.execute('SELECT * FROM users WHERE id = ?', (user_id,)).fetchone()
        reference = f"RATA-{installment['id']:08d}"
        if user['balance_cents'] < installment['amount_cents']:
            exists = db.execute(
                """SELECT 1 FROM notifications
                WHERE user_id = ? AND operation_reference = ?""",
                (user_id, reference),
            ).fetchone()
            if not exists:
                add_notification(
                    user_id, 'Nie udało się pobrać raty kredytu',
                    f"Rata nr {installment['installment_number']} kredytu "
                    f"KR-{installment['loan_number']:06d} wymaga "
                    f"{money(installment['amount_cents'])}. Uzupełnij saldo i zapłać ją ręcznie.",
                    'warning', operation_type='loan_installment_failed',
                    operation_reference=reference,
                    amount_cents=installment['amount_cents'],
                    counterparty='NovaBank Kredyty',
                )
                db.commit()
            continue
        stamp = now_iso()
        try:
            db.execute('BEGIN IMMEDIATE')
            debited = db.execute(
                'UPDATE users SET balance_cents = balance_cents - ? WHERE id = ? AND balance_cents >= ?',
                (installment['amount_cents'], user_id, installment['amount_cents']),
            )
            paid = db.execute(
                """UPDATE loan_installments SET status = 'paid', paid_at = ?,
                paid_amount_cents = amount_cents, payment_method = 'regular'
                WHERE id = ? AND status = 'pending'""",
                (stamp, installment['id']),
            )
            if debited.rowcount != 1 or paid.rowcount != 1:
                raise ValueError('Rata została już rozliczona albo brakuje środków.')
            transaction = db.execute(
                """INSERT INTO transactions
                (user_id, kind, amount_cents, title, counterparty,
                 counterparty_account, created_at)
                VALUES (?, 'debit', ?, ?, 'NovaBank Kredyty', 'KREDYT-RATA', ?)""",
                (user_id, installment['amount_cents'],
                 f"Automatyczna rata {installment['installment_number']} "
                 f"kredytu KR-{installment['loan_number']:06d}", stamp),
            )
            add_notification(
                user_id, 'Rata kredytu pobrana automatycznie',
                f"Zapłacono ratę nr {installment['installment_number']} w wysokości "
                f"{money(installment['amount_cents'])}.",
                'success', operation_type='loan_installment_paid',
                operation_reference=reference,
                amount_cents=installment['amount_cents'],
                counterparty='NovaBank Kredyty',
                related_transaction_id=transaction.lastrowid,
            )
            remaining = db.execute(
                "SELECT COUNT(*) FROM loan_installments WHERE loan_id = ? AND status = 'pending'",
                (installment['loan_id'],),
            ).fetchone()[0]
            if remaining == 0:
                add_notification(
                    user_id, 'Kredyt spłacony',
                    f"Kredyt KR-{installment['loan_number']:06d} został całkowicie spłacony.",
                    'success',
                )
            warn_about_low_balance(user_id, user['balance_cents'] - installment['amount_cents'])
            db.commit()
        except (sqlite3.Error, ValueError):
            db.rollback()


@app.before_request
def execute_due_transfers_once_per_request():
    ensure_wallet_schema()
    user_id = session.get("user_id")
    if not user_id:
        return None
    signed_user = current_user()
    if signed_user is None or signed_user["account_type"] != "personal" or signed_user["activation_status"] != "active":
        clear_session_preserving_language()
        flash("To konto nie jest już obsługiwane lub jest nieaktywne. Skontaktuj się z bankiem.", "error")
        return redirect(url_for("login"))
    access = current_access()
    if access is None or access["locked"]:
        clear_session_preserving_language()
        flash("To konto jest zablokowane. Skontaktuj się z bankiem.", "error")
        return redirect(url_for("login"))
    admin_endpoints = {
        "admin_dashboard", "admin_customers", "admin_toggle_user",
        "admin_customer_details", "admin_top_up", "admin_transactions", "admin_loans",
        "admin_review_loan", "admin_tickets", "admin_audit_log_view",
        "ticket_details", "ticket_reply", "logout", "home", "static",
    }
    if access["role"] == "admin":
        if request.endpoint not in admin_endpoints:
            return redirect(url_for("admin_dashboard"))
        return None
    if not getattr(g, "scheduled_transfers_checked", False):
        g.scheduled_transfers_checked = True
        process_due_scheduled_transfers(user_id)
        process_due_loan_installments(user_id)
        process_due_vault_savings(user_id)
        process_exchange_alerts(user_id)
    return None


