            const max = Math.max(100, ...days.map(d => Math.max(d.income, d.expenses)));
            const x = i => 44 + i * 684 / Math.max(1, days.length - 1);
            const y = value => 195 - value * 155 / max;
            const element = (tag, attrs, parent) => { const el = document.createElementNS(NS, tag); for (const [key, value] of Object.entries(attrs)) el.setAttribute(key, value); parent.appendChild(el); return el; };
            for (let i = 0; i <= 3; i++) {
