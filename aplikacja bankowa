def calculate_monthly_payment(amount_cents: int, months: int, annual_rate: Decimal) -> int:
    principal = Decimal(amount_cents) / 100
    monthly_rate = annual_rate / Decimal("100") / Decimal("12")
    factor = (Decimal("1") + monthly_rate) ** months
    payment = principal * monthly_rate * factor / (factor - Decimal("1"))
    return int((payment.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)) * 100)


def loan_due_date(reference: date, month_offset: int, payment_day: int) -> date:
    """Zwraca wybrany dzień miesiąca albo jego ostatni dzień."""
    first_of_month = date(reference.year, reference.month, 1)
    target = add_months(first_of_month, month_offset)
    effective_day = min(payment_day, calendar.monthrange(target.year, target.month)[1])
    return target.replace(day=effective_day)


def calculate_first_loan_payment(
    amount_cents: int, months: int, annual_rate: Decimal, installment_type: str
) -> int:
    if installment_type == 'decreasing':
        monthly_rate = annual_rate / Decimal('100') / Decimal('12')
        principal = (amount_cents + months - 1) // months
        interest = int(
            (Decimal(amount_cents) * monthly_rate).quantize(
                Decimal('1'), rounding=ROUND_HALF_UP
            )
        )
        return principal + interest
    return calculate_monthly_payment(amount_cents, months, annual_rate)


def loan_schedule_rows(
    principal_cents: int,
    months: int,
    annual_rate: Decimal,
    installment_type: str,
    first_number: int,
    first_due: date,
    payment_day: int,
) -> list[tuple[int, str, int, int, int]]:
    """Buduje harmonogram: numer, termin, kapitał, odsetki i kwota raty."""
    monthly_rate = annual_rate / Decimal('100') / Decimal('12')
    balance = principal_cents
    equal_payment = (
        calculate_monthly_payment(principal_cents, months, annual_rate)
        if installment_type == 'equal' else None
    )
    decreasing_principal = principal_cents // months
    rows = []
    due = first_due
    for index in range(months):
        interest = int(
            (Decimal(balance) * monthly_rate).quantize(
                Decimal('1'), rounding=ROUND_HALF_UP
            )
        )
        if index == months - 1:
            principal = balance
        elif installment_type == 'decreasing':
            principal = min(balance, decreasing_principal)
        else:
            principal = min(balance, max(1, equal_payment - interest))
        amount = principal + interest
        rows.append((first_number + index, due.isoformat(), principal, interest, amount))
        balance -= principal
        due = loan_due_date(due, 1, payment_day)
    return rows


def insert_loan_schedule(
    loan_id: int,
    principal_cents: int,
    months: int,
    annual_rate: Decimal,
    installment_type: str,
    first_number: int,
    first_due: date,
    payment_day: int,
) -> list[tuple[int, str, int, int, int]]:
    rows = loan_schedule_rows(
        principal_cents, months, annual_rate, installment_type,
        first_number, first_due, payment_day,
    )
    get_db().executemany(
        """INSERT INTO loan_installments
        (loan_id, installment_number, due_date, principal_cents,
         interest_cents, amount_cents, status)
        VALUES (?, ?, ?, ?, ?, ?, 'pending')""",
        [(loan_id, number, due, principal, interest, amount)
         for number, due, principal, interest, amount in rows],
    )
    return rows


def ensure_loan_schedule(loan_id: int) -> None:
    """Tworzy harmonogram raz, także dla kredytów zaakceptowanych przed aktualizacją."""
    db = get_db()
    loan = db.execute(
        "SELECT * FROM loan_applications WHERE id = ?", (loan_id,)
    ).fetchone()
    if loan is None or loan["status"] != "approved":
        return
    if db.execute(
        "SELECT 1 FROM loan_installments WHERE loan_id = ?", (loan_id,)
    ).fetchone():
        return
    start = date.today()
    if loan["reviewed_at"]:
        start = datetime.fromisoformat(loan["reviewed_at"]).date()
    insert_loan_schedule(
        loan_id=loan_id,
        principal_cents=loan['amount_cents'],
        months=loan['months'],
        annual_rate=Decimal(loan['annual_rate']),
        installment_type=loan['installment_type'],
        first_number=1,
        first_due=loan_due_date(start, 1, loan['preferred_payment_day']),
        payment_day=loan['preferred_payment_day'],
    )


def csrf_token() -> str:
    if "csrf_token" not in session:
        session["csrf_token"] = secrets.token_urlsafe(32)
    return session["csrf_token"]


def valid_csrf() -> bool:
    sent = request.form.get("csrf_token", "")
    expected = session.get("csrf_token", "")
    return bool(sent and expected and secrets.compare_digest(sent, expected))


def parse_amount(value: str) -> int | None:
    try:
        amount = Decimal(value.replace(" ", "").replace(",", ".")).quantize(
            Decimal("0.01"), rounding=ROUND_HALF_UP
        )
    except (InvalidOperation, AttributeError):
        return None
    if not amount.is_finite() or amount <= 0 or amount > Decimal("1000000"):
        return None
    return int(amount * 100)


def parse_nonnegative_amount(value: str) -> int | None:
    try:
        amount = Decimal(value.replace(" ", "").replace(",", ".")).quantize(
            Decimal("0.01"), rounding=ROUND_HALF_UP
        )
    except (InvalidOperation, AttributeError):
        return None
    if not amount.is_finite() or amount < 0 or amount > Decimal("1000000"):
        return None
    return int(amount * 100)


def money(cents: int) -> str:
    value = Decimal(cents) / 100
    if get_language() == "en":
        return f"{value:,.2f} PLN"
    return f"{value:,.2f}".replace(",", " ").replace(".", ",") + " zł"


def format_date(value: str) -> str:
    try:
        parsed = datetime.fromisoformat(value).astimezone()
        if get_language() == "en":
            months = ("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
            return f"{months[parsed.month - 1]} {parsed.day}, {parsed.year}, {parsed:%H:%M}"
        return parsed.strftime("%d.%m.%Y, %H:%M")
    except ValueError:
        return value


