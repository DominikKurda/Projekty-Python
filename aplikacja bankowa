            error = 'Deklarowany miesięczny dochód musi wynosić co najmniej 2 000 zł.'
        elif costs is None or costs > income:
            error = 'Miesięczne koszty muszą wynosić od 0 zł do wysokości dochodu.'
        elif get_db().execute(
            "SELECT 1 FROM loan_applications WHERE user_id = ? AND status = 'pending'",
