                error = 'Nie możesz wysłać prośby o przelew do siebie.'
        if error:
            flash(error, 'error')
        else:
            stamp = now_iso()
            try:
                db.execute('BEGIN IMMEDIATE')
                created = db.execute(
                    """INSERT INTO payment_requests
                    (requester_id, payer_id, amount_cents, title, status, created_at)
