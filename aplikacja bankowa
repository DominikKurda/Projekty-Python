@app.post('/loans/<int:loan_id>/installments/<int:installment_id>/pay')
@login_required
def pay_loan_installment(loan_id, installment_id):
    if not valid_csrf():
        abort(400)
    db = get_db()
    loan = db.execute(
        "SELECT * FROM loan_applications WHERE id = ? AND user_id = ? AND status = 'approved'",
        (loan_id, session['user_id']),
    ).fetchone()
    if loan is None:
        abort(404)
    ensure_loan_schedule(loan_id)
    db.commit()
    installment = db.execute(
        "SELECT * FROM loan_installments WHERE id = ? AND loan_id = ? AND status = 'pending'",
        (installment_id, loan_id),
    ).fetchone()
    first_pending = db.execute(
        "SELECT * FROM loan_installments WHERE loan_id = ? AND status = 'pending' ORDER BY installment_number LIMIT 1",
        (loan_id,),
    ).fetchone()
    if installment is None:
        flash('Ta rata została już zapłacona lub nie istnieje.', 'error')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    if first_pending is None or first_pending['id'] != installment['id']:
        flash('Raty należy spłacać w kolejności.', 'error')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    user = current_user()
    if user['balance_cents'] < installment['amount_cents']:
        add_notification(user['id'], 'Brak środków na ratę', f"Do zapłaty raty kredytu KR-{loan_id:06d} potrzeba {money(installment['amount_cents'])}.", 'warning')
        db.commit()
        flash('Brak wystarczających środków na zapłacenie raty.', 'error')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    stamp = now_iso()
    try:
        db.execute('BEGIN IMMEDIATE')
        changed = db.execute(
            'UPDATE users SET balance_cents = balance_cents - ? WHERE id = ? AND balance_cents >= ?',
            (installment['amount_cents'], user['id'], installment['amount_cents']),
        )
        if changed.rowcount != 1:
            raise ValueError('Brak wystarczających środków.')
        changed = db.execute(
            """UPDATE loan_installments SET status = 'paid', paid_at = ?,
            paid_amount_cents = amount_cents, payment_method = 'regular'
            WHERE id = ? AND status = 'pending'""", (stamp, installment['id'])
        )
        if changed.rowcount != 1:
            raise ValueError('Rata została już zapłacona.')
        db.execute(
            """INSERT INTO transactions
            (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
            VALUES (?, 'debit', ?, ?, 'NovaBank Kredyty', 'KREDYT-RATA', ?)""",
            (user['id'], installment['amount_cents'], f"Rata {installment['installment_number']} kredytu KR-{loan_id:06d}", stamp),
        )
        remaining = db.execute(
            "SELECT COUNT(*) FROM loan_installments WHERE loan_id = ? AND status = 'pending'", (loan_id,)
        ).fetchone()[0]
        add_notification(user['id'], 'Rata kredytu zapłacona', f"Zapłacono ratę nr {installment['installment_number']} w wysokości {money(installment['amount_cents'])}.", 'success')
        if remaining == 0:
            add_notification(user['id'], 'Kredyt spłacony', f"Kredyt KR-{loan_id:06d} został całkowicie spłacony.", 'success')
        warn_about_low_balance(user['id'], user['balance_cents'] - installment['amount_cents'])
        db.commit()
    except (sqlite3.Error, ValueError) as exc:
        db.rollback()
        flash(str(exc), 'error')
    else:
        flash('Rata została zapłacona.', 'success')
    return redirect(url_for('loan_schedule', loan_id=loan_id))


@app.post('/loans/<int:loan_id>/change-payment-day')
@login_required
def change_loan_payment_day(loan_id):
    if not valid_csrf():
        abort(400)
    payment_day = request.form.get('payment_day', type=int)
    if payment_day is None or not 1 <= payment_day <= 31:
        flash('Wybierz dzień spłaty od 1. do 31.', 'error')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    db = get_db()
    loan = db.execute(
        "SELECT * FROM loan_applications WHERE id = ? AND user_id = ? AND status = 'approved'",
        (loan_id, session['user_id']),
    ).fetchone()
    if loan is None:
        abort(404)
    ensure_loan_schedule(loan_id)
    db.commit()
    pending = db.execute(
        """SELECT * FROM loan_installments
        WHERE loan_id = ? AND status = 'pending' ORDER BY installment_number""",
        (loan_id,),
    ).fetchall()
    if not pending:
        flash('Kredyt nie ma już rat oczekujących na spłatę.', 'info')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    if any(item['due_date'] < date.today().isoformat() for item in pending):
        flash('Najpierw spłać ratę po terminie. Dopiero potem można zmienić dzień spłaty.', 'error')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    current_due = date.fromisoformat(pending[0]['due_date'])
    month_reference = date(current_due.year, current_due.month, 1)
    first_due = loan_due_date(month_reference, 0, payment_day)
    if first_due <= date.today():
        first_due = loan_due_date(month_reference, 1, payment_day)
    stamp = now_iso()
    try:
        db.execute('BEGIN IMMEDIATE')
        due = first_due
        for item in pending:
            db.execute(
                'UPDATE loan_installments SET due_date = ? WHERE id = ?',
                (due.isoformat(), item['id']),
            )
            due = loan_due_date(due, 1, payment_day)
        db.execute(
            """UPDATE loan_applications SET payment_day = ?, preferred_payment_day = ?
            WHERE id = ?""",
            (min(payment_day, 28), payment_day, loan_id),
        )
        db.execute(
            """INSERT INTO loan_contract_changes
            (loan_id, user_id, change_type, old_value, new_value, details, created_at)
            VALUES (?, ?, 'payment_day', ?, ?, ?, ?)""",
            (loan_id, session['user_id'], str(loan['preferred_payment_day']),
             str(payment_day),
             f"Zmiana dnia spłaty z {loan['preferred_payment_day']} na {payment_day}", stamp),
        )
        add_notification(
            session['user_id'], 'Zmieniono dzień spłaty kredytu',
            f"Kredyt KR-{loan_id:06d}: przyszłe raty przypadają {payment_day}. dnia "
            'miesiąca lub w ostatnim dniu krótszego miesiąca.', 'success',
        )
        db.commit()
    except sqlite3.Error as exc:
        db.rollback()
        flash(f'Nie udało się zmienić dnia spłaty: {exc}', 'error')
    else:
        flash('Dzień spłaty został zmieniony, a harmonogram zaktualizowany.', 'success')
    return redirect(url_for('loan_schedule', loan_id=loan_id))


@app.post('/loans/<int:loan_id>/bulk-payment')
@login_required
def pay_multiple_loan_installments(loan_id):
    if not valid_csrf():
        abort(400)
    count = request.form.get('installment_count', type=int)
    db = get_db()
    loan = db.execute(
        "SELECT * FROM loan_applications WHERE id = ? AND user_id = ? AND status = 'approved'",
        (loan_id, session['user_id']),
    ).fetchone()
    if loan is None:
        abort(404)
    ensure_loan_schedule(loan_id)
    db.commit()
    pending = db.execute(
        """SELECT * FROM loan_installments
        WHERE loan_id = ? AND status = 'pending' ORDER BY installment_number""",
        (loan_id,),
    ).fetchall()
    if count is None or count < 2 or count > len(pending):
        flash('Wybierz od 2 do liczby wszystkich pozostałych rat.', 'error')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    selected = pending[:count]
    total = sum(item['amount_cents'] for item in selected)
    user = current_user()
    if user['balance_cents'] < total:
        add_notification(
            user['id'], 'Brak środków na spłatę kilku rat',
            f"Do spłaty {count} rat kredytu KR-{loan_id:06d} potrzeba {money(total)}.",
            'warning',
        )
        db.commit()
        flash(f'Brak środków. Spłata {count} rat wymaga {money(total)}.', 'error')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    stamp = now_iso()
    try:
        db.execute('BEGIN IMMEDIATE')
        debited = db.execute(
            'UPDATE users SET balance_cents = balance_cents - ? WHERE id = ? AND balance_cents >= ?',
            (total, user['id'], total),
        )
        if debited.rowcount != 1:
            raise ValueError('Brak wystarczających środków.')
        for item in selected:
            changed = db.execute(
                """UPDATE loan_installments SET status = 'paid', paid_at = ?,
                paid_amount_cents = amount_cents, payment_method = 'regular'
                WHERE id = ? AND status = 'pending'""",
                (stamp, item['id']),
            )
            if changed.rowcount != 1:
                raise ValueError('Jedna z wybranych rat została już rozliczona.')
        transaction = db.execute(
            """INSERT INTO transactions
            (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
            VALUES (?, 'debit', ?, ?, 'NovaBank Kredyty', 'KREDYT-WIELE-RAT', ?)""",
            (user['id'], total, f"Spłata {count} rat kredytu KR-{loan_id:06d}", stamp),
        )
        db.execute(
            """INSERT INTO loan_contract_changes
            (loan_id, user_id, change_type, old_value, new_value, details, created_at)
            VALUES (?, ?, 'bulk_payment', ?, ?, ?, ?)""",
            (loan_id, user['id'], str(len(pending)), str(len(pending) - count),
             f"Jednorazowo spłacono raty {selected[0]['installment_number']}–{selected[-1]['installment_number']} za {money(total)}",
             stamp),
        )
        add_notification(
            user['id'], 'Kilka rat kredytu spłaconych',
            f"Jednorazowo zapłacono {count} rat kredytu KR-{loan_id:06d} na kwotę {money(total)}.",
            'success', operation_type='loan_bulk_payment',
            operation_reference=f'KR-{loan_id:06d}-WIELE-{transaction.lastrowid}',
            amount_cents=total, counterparty='NovaBank Kredyty',
            related_transaction_id=transaction.lastrowid,
        )
        warn_about_low_balance(user['id'], user['balance_cents'] - total)
        db.commit()
    except (sqlite3.Error, ValueError) as exc:
        db.rollback()
        flash(str(exc), 'error')
    else:
        flash(f'Jednorazowo spłacono {count} rat na łączną kwotę {money(total)}.', 'success')
    return redirect(url_for('loan_schedule', loan_id=loan_id))


