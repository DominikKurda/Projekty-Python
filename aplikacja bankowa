def init_wallet_features():
    db = get_db()
    db.executescript('''
        CREATE TABLE IF NOT EXISTS wallet_operations (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL REFERENCES users(id),
            currency TEXT NOT NULL, kind TEXT NOT NULL,
            direction TEXT NOT NULL CHECK(direction IN ('credit','debit','none')),
            amount_cents INTEGER NOT NULL CHECK(amount_cents > 0),
            pln_cents INTEGER NOT NULL DEFAULT 0,
            title TEXT NOT NULL, counterparty TEXT NOT NULL,
            reference TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'approved',
            card_payment_id INTEGER REFERENCES card_payments(id),
            created_at TEXT NOT NULL
        );
        CREATE INDEX IF NOT EXISTS idx_wallet_history
        ON wallet_operations(user_id, currency, id DESC);
        CREATE TABLE IF NOT EXISTS wallet_goals (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL REFERENCES users(id),
            currency TEXT NOT NULL, name TEXT NOT NULL,
            target_cents INTEGER NOT NULL CHECK(target_cents > 0),
            saved_cents INTEGER NOT NULL DEFAULT 0 CHECK(saved_cents >= 0),
            deadline TEXT, status TEXT NOT NULL DEFAULT 'active'
                CHECK(status IN ('active','completed','closed')),
            created_at TEXT NOT NULL
        );
        CREATE INDEX IF NOT EXISTS idx_wallet_goals ON wallet_goals(user_id, currency, id DESC);
        CREATE TABLE IF NOT EXISTS wallet_requests (
            token TEXT PRIMARY KEY, user_id INTEGER NOT NULL REFERENCES users(id),
            kind TEXT NOT NULL, created_at TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS wallet_currency_limits (
            user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
            currency TEXT NOT NULL,
            card_daily_limit_cents INTEGER NOT NULL DEFAULT 100000000
                CHECK(card_daily_limit_cents BETWEEN 0 AND 100000000),
            transfer_daily_limit_cents INTEGER NOT NULL DEFAULT 100000000
                CHECK(transfer_daily_limit_cents BETWEEN 0 AND 100000000),
            updated_at TEXT NOT NULL,
            PRIMARY KEY(user_id, currency)
        );
    ''')
    # Uzupełnij wspólną historię o wymiany zapisane przed dodaniem dziennika
    # operacji portfela. Numer FX jest stabilnym kluczem zapobiegającym duplikatom.
    db.execute("""INSERT INTO wallet_operations
        (user_id,currency,kind,direction,amount_cents,pln_cents,title,counterparty,reference,status,created_at)
        SELECT e.user_id,e.currency,'exchange',
               CASE WHEN e.direction='buy' THEN 'credit' ELSE 'debit' END,
               e.amount_cents,e.pln_cents,
               CASE WHEN e.direction='buy' THEN 'Kupno ' ELSE 'Sprzedaż ' END || e.currency,
               'Kantor NovaBank','FX-' || e.id,'approved',e.created_at
        FROM currency_exchanges e
        WHERE NOT EXISTS (SELECT 1 FROM wallet_operations w
                          WHERE w.user_id=e.user_id AND w.reference='FX-' || e.id)""")
    columns = {row['name'] for row in db.execute('PRAGMA table_info(card_payments)')}
    if 'currency' not in columns:
        db.execute("ALTER TABLE card_payments ADD COLUMN currency TEXT NOT NULL DEFAULT 'PLN'")
    if 'pln_equivalent_cents' not in columns:
        db.execute('ALTER TABLE card_payments ADD COLUMN pln_equivalent_cents INTEGER')
    db.commit()


def ensure_wallet_schema():
    """Uzupełnia brakującą migrację przed obsługą żądania; zachowuje dane."""
    if getattr(g, 'wallet_schema_checked', False):
        return
    db = get_db()
    required_tables = {'wallet_operations', 'wallet_goals', 'wallet_requests', 'wallet_currency_limits'}
    existing_tables = {row['name'] for row in db.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name IN ('wallet_operations','wallet_goals','wallet_requests','wallet_currency_limits')"
    )}
    card_columns = {row['name'] for row in db.execute('PRAGMA table_info(card_payments)')}
    if required_tables != existing_tables or not {'currency', 'pln_equivalent_cents'} <= card_columns:
        init_wallet_features()
    g.wallet_schema_checked = True


def wallet_money(amount, currency='PLN'):
    amount = int(amount or 0)
    precision = 0 if currency == 'JPY' and amount % 100 == 0 else 2
    value = Decimal(amount) / 100
    if get_language() == "en":
        return f"{value:,.{precision}f} {currency}"
    return f"{value:,.{precision}f}".replace(',', ' ').replace('.', ',') + ' ' + currency


app.jinja_env.filters['wallet_money'] = wallet_money


def wallet_amount(value, currency):
    raw = (value or '').strip().replace(',', '.')
    if not re.fullmatch(r'\d{1,7}(?:\.\d{1,2})?', raw):
        raise ValueError('Podaj dodatnią kwotę, maksymalnie dwa miejsca po przecinku.')
    amount = parse_amount(raw)
    if amount is None:
        raise ValueError('Kwota musi być większa od zera i nie przekraczać 1 000 000.')
    if currency == 'JPY' and amount % 100:
        raise ValueError('Kwotę w jenach japońskich podaj w pełnych jenach.')
    return amount


def wallet_currency(code, *, card=False):
    code = str(code or '').upper()
    if code not in EXCHANGE_CURRENCIES or (card and code == 'XDR'):
        raise ValueError('Wybierz obsługiwaną walutę.' if not card else 'Wybierz walutę płatności. XDR nie służy do płatności kartą.')
    return code


def wallet_balance(user_id, currency):
    row = get_db().execute('SELECT balance_cents FROM currency_balances WHERE user_id=? AND currency=?',
                           (user_id, currency)).fetchone()
    return row['balance_cents'] if row else 0


def get_wallet_currency_limits(user_id):
    db = get_db()
    stamp = now_iso()
    db.executemany(
        """INSERT OR IGNORE INTO wallet_currency_limits
        (user_id, currency, card_daily_limit_cents, transfer_daily_limit_cents, updated_at)
        VALUES (?, ?, 100000000, 100000000, ?)""",
        [(user_id, code, stamp) for code in EXCHANGE_CURRENCIES],
    )
    db.commit()
    return {row['currency']: row for row in db.execute(
        'SELECT * FROM wallet_currency_limits WHERE user_id = ?', (user_id,)
    )}


def wallet_currency_usage(user_id, currency, kind):
    operation_kind = {'card': 'card', 'transfer': 'transfer'}.get(kind)
    if operation_kind is None:
        raise ValueError('Nieobsługiwany rodzaj limitu walutowego.')
    return get_db().execute(
        """SELECT COALESCE(SUM(amount_cents), 0) FROM wallet_operations
        WHERE user_id = ? AND currency = ? AND kind = ? AND direction = 'debit'
          AND status = 'approved' AND substr(created_at, 1, 10) = ?""",
        (user_id, currency, operation_kind, date.today().isoformat()),
    ).fetchone()[0]


def wallet_change(user_id, currency, delta):
    db = get_db()
    db.execute('INSERT OR IGNORE INTO currency_balances(user_id,currency) VALUES (?,?)', (user_id, currency))
    changed = db.execute('UPDATE currency_balances SET balance_cents=balance_cents+? WHERE user_id=? AND currency=? AND balance_cents+? >= 0',
                         (delta, user_id, currency, delta))
    if changed.rowcount != 1:
        raise ValueError('Brak wystarczających środków w portfelu ' + currency + '. Kup walutę w kantorze.')


def wallet_log(user_id, currency, kind, direction, amount, title, counterparty, reference,
               *, pln=0, status='approved', payment_id=None):
    return get_db().execute('''INSERT INTO wallet_operations
        (user_id,currency,kind,direction,amount_cents,pln_cents,title,counterparty,reference,status,card_payment_id,created_at)
        VALUES (?,?,?,?,?,?,?,?,?,?,?,?)''',
        (user_id,currency,kind,direction,amount,pln,title,counterparty,reference,status,payment_id,now_iso())).lastrowid


def wallet_serializer():
    return URLSafeTimedSerializer(app.secret_key, salt='wallet-operation-v1')


def wallet_token(kind, **values):
    return wallet_serializer().dumps(dict(user=session['user_id'], kind=kind,
                                         nonce=secrets.token_urlsafe(24), **values))


def wallet_decode(token, kind):
    try:
        data = wallet_serializer().loads(token, max_age=1800)
    except (BadSignature, SignatureExpired):
        raise ValueError('Potwierdzenie wygasło lub jest nieprawidłowe. Otwórz formularz ponownie.')
    if data.get('user') != session['user_id'] or data.get('kind') != kind:
        raise ValueError('Nieprawidłowe potwierdzenie operacji.')
    return data


def wallet_claim(token, kind):
    data = wallet_decode(token, kind)
    try:
        get_db().execute('INSERT INTO wallet_requests(token,user_id,kind,created_at) VALUES (?,?,?,?)',
                         (data['nonce'],session['user_id'],kind,now_iso()))
    except sqlite3.IntegrityError:
        raise ValueError('Ta operacja została już wykonana. Sprawdź historię — saldo nie zostało ponownie obciążone.')
    return data


def wallet_pln_equivalent(currency, amount):
    snapshot = nbp_snapshot(refresh=False)
    pair = snapshot['rates'].get(currency)
    if not pair or pair[0] <= 0 or pair[1] <= 0:
        raise ValueError('Brak zapisanego kursu NBP do sprawdzenia limitu w PLN. Otwórz kantor i odśwież kursy.')
    rate = (pair[0] + pair[1]) / 2
    return int((Decimal(amount) * rate).quantize(Decimal('1'), rounding=ROUND_HALF_UP))


