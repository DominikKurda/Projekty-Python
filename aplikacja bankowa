                const path = document.getElementById(id);
                path.setAttribute('d', d || '');
                path.style.setProperty('--path-length', Math.ceil(path.getTotalLength() + 1));
            }
            days.forEach((day, index) => {
                const group = element('g', {}, points);
                for (const [kind, color] of [['income','#2563eb'],['expenses','#ff9f43']])
                    element('circle', {cx:x(index),cy:y(day[kind]),r:day[kind] ? 3.7 : 2.2,fill:color}, group);
                const hit = element('rect', {x:x(index)-Math.min(12, 342/Math.max(1,days.length-1)),y:30,width:Math.min(24,684/Math.max(1,days.length-1)),height:175,fill:'transparent',class:'cashflow-hit',tabindex:0,role:'button','aria-label':`${day.day}. dzień: wpływy ${fmt(day.income)}, wydatki ${fmt(day.expenses)}; ${day.operations.length} operacji`}, group);
                const show = () => {
                    tooltip.replaceChildren();
                    const title = document.createElement('strong'); title.textContent = day.day + '. dzień miesiąca'; tooltip.appendChild(title);
                    const summary = document.createElement('div'); summary.textContent = `Wpływy: ${fmt(day.income)} · Wydatki: ${fmt(day.expenses)}`; tooltip.appendChild(summary);
                    const list = document.createElement('ul');
                    if (day.operations.length) for (const tx of day.operations) {
                        const item = document.createElement('li'); item.textContent = `${tx.kind === 'credit' ? '+' : '−'}${tx.amount} · ${tx.title} (${tx.counterparty})`; list.appendChild(item);
                    } else { const item = document.createElement('li'); item.textContent = 'Brak operacji'; list.appendChild(item); }
                    tooltip.appendChild(list); tooltip.hidden = false;
                    tooltip.style.left = Math.max(0, Math.min(75, (x(index) / 760) * 100 - 14)) + '%';
                    tooltip.style.top = '5px';
                };
                hit.addEventListener('pointerenter', show);
                hit.addEventListener('focus', show);
                hit.addEventListener('pointerleave', () => { tooltip.hidden = true; });
                hit.addEventListener('blur', () => { tooltip.hidden = true; });
            });
        })();
        </script>
