@app.route('/scheduled-transfers', methods=['GET', 'POST'])
@login_required
def scheduled_transfers():
    user = current_user()
    saved = get_db().execute(
        "SELECT * FROM beneficiaries WHERE user_id = ? ORDER BY name COLLATE NOCASE",
        (user['id'],),
    ).fetchall()
    values = {key: request.form.get(key, '').strip() for key in ('recipient', 'account', 'amount', 'title', 'execute_at', 'recurrence')}
    if not values['recurrence']:
        values['recurrence'] = 'once'
    if request.method == 'POST':
        account = normalize_account_number(values['account'])
        amount = parse_amount(values['amount'])
        error = None
        try:
            execution = date.fromisoformat(values['execute_at'])
        except ValueError:
            execution = None
        if not valid_csrf():
            error = 'Sesja formularza wygasła. Spróbuj ponownie.'
        elif not values['recipient'] or not values['title'] or len(values['recipient']) > 120 or len(values['title']) > 140:
            error = 'Uzupełnij odbiorcę i tytuł przelewu.'
        elif account_validation_error(account):
            error = account_validation_error(account)
        elif account == user['account_number']:
            error = 'Nie możesz zaplanować przelewu na własne konto.'
        elif not get_db().execute('SELECT 1 FROM users WHERE account_number = ?', (account,)).fetchone():
            error = 'W wersji demo odbiorca musi posiadać konto NovaBank.'
        elif amount is None:
            error = 'Podaj poprawną kwotę większą od 0 zł.'
        elif execution is None or execution <= date.today():
            error = 'Wybierz datę późniejszą niż dzisiaj.'
        elif values['recurrence'] not in ('once', 'weekly', 'monthly'):
            error = 'Wybierz poprawną częstotliwość.'
        if error:
            flash(error, 'error')
        else:
            get_db().execute(
                """INSERT INTO scheduled_transfers
                (user_id, recipient, account_number, amount_cents, title, recurrence,
                 next_execution, status, created_at)
                VALUES (?, ?, ?, ?, ?, ?, ?, 'active', ?)""",
                (user['id'], values['recipient'], account, amount, values['title'],
                 values['recurrence'], execution.isoformat(), now_iso()),
            )
            add_notification(
                user['id'], 'Przelew został zaplanowany',
                f"Najbliższe wykonanie: {execution.strftime('%d.%m.%Y')}, kwota {money(amount)}.", 'success')
            get_db().commit()
            flash('Przelew został zaplanowany.', 'success')
            return redirect(url_for('scheduled_transfers'))
    rows = get_db().execute(
        "SELECT * FROM scheduled_transfers WHERE user_id = ? ORDER BY next_execution, id DESC",
        (user['id'],),
    ).fetchall()
    return page('Przelewy zaplanowane', r"""
        <div class="topline"><div><div class="eyebrow">Automatyczne płatności</div><h2>Przelewy zaplanowane</h2></div></div>
        <section class="panel panel-pad"><h3>Nowy przelew</h3><form method="post" data-testid="scheduled-form">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        {% if saved %}<label for="scheduled-beneficiary">Zapisany odbiorca (opcjonalnie)</label><select id="scheduled-beneficiary" data-testid="scheduled-beneficiary"><option value="">Wpiszę dane ręcznie</option>{% for item in saved %}<option data-name="{{ item.name }}" data-account="{{ item.account_number }}">{{ item.name }}</option>{% endfor %}</select>{% endif %}
        <div class="form-row"><div><label for="recipient">Odbiorca</label><input id="recipient" name="recipient" value="{{ values.recipient }}" maxlength="120" required data-testid="scheduled-recipient"></div>
        <div><label for="account">Numer rachunku</label><input id="account" name="account" value="{{ values.account }}" maxlength="34" placeholder="PL00 0000 0000 0000 0000 0000 0000" required data-testid="scheduled-account"></div></div>
        <div class="form-row"><div><label for="amount">Kwota (PLN)</label><input id="amount" name="amount" value="{{ values.amount }}" inputmode="decimal" required data-testid="scheduled-amount"></div>
        <div><label for="title">Tytuł</label><input id="title" name="title" value="{{ values.title }}" maxlength="140" required data-testid="scheduled-title"></div></div>
        <div class="form-row"><div><label for="execute_at">Pierwsze wykonanie</label><input type="date" id="execute_at" name="execute_at" value="{{ values.execute_at }}" min="{{ min_date }}" required data-testid="scheduled-date"></div>
        <div><label for="recurrence">Częstotliwość</label><select id="recurrence" name="recurrence" data-testid="scheduled-recurrence"><option value="once">Jednorazowo</option><option value="weekly" {% if values.recurrence == 'weekly' %}selected{% endif %}>Co tydzień</option><option value="monthly" {% if values.recurrence == 'monthly' %}selected{% endif %}>Co miesiąc</option></select></div></div>
        <button class="btn" style="margin-top:18px" data-testid="scheduled-submit">Zaplanuj przelew</button></form></section>
        <section class="panel panel-pad" style="margin-top:22px"><h3>Lista przelewów</h3>
        {% if rows %}<div style="overflow-x:auto"><table data-testid="scheduled-table"><thead><tr><th>Odbiorca</th><th>Najbliższa data</th><th>Cykl</th><th>Kwota</th><th>Status</th><th></th></tr></thead><tbody>
        {% for item in rows %}<tr data-testid="scheduled-row-{{ item.id }}"><td><strong>{{ item.recipient }}</strong><br><span class="muted">{{ item.title }}</span></td><td>{{ item.next_execution }}</td><td>{{ {'once':'Jednorazowo','weekly':'Co tydzień','monthly':'Co miesiąc'}[item.recurrence] }}</td><td class="amount">{{ item.amount_cents|money }}</td><td>{{ {'active':'Oczekuje','paused':'Wstrzymany','cancelled':'Anulowany','completed':'Wykonany'}[item.status] }}</td><td>
        {% if item.status in ('active','paused') %}<form method="post" action="{{ url_for('cancel_scheduled_transfer', transfer_id=item.id) }}"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><button class="btn danger" data-testid="scheduled-cancel-{{ item.id }}">Anuluj</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table></div>
        {% else %}<div class="empty" data-testid="scheduled-empty">Nie masz zaplanowanych przelewów.</div>{% endif %}</section>
        {% if saved %}<script>document.getElementById('scheduled-beneficiary').addEventListener('change', function(){ const option=this.options[this.selectedIndex]; if(!this.value)return; document.getElementById('recipient').value=option.dataset.name; document.getElementById('account').value=option.dataset.account; });</script>{% endif %}
        """, rows=rows, saved=saved, values=values, min_date=(date.today() + timedelta(days=1)).isoformat())


