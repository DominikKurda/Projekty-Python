        <section class="cards"><div class="panel panel-pad"><h3>Ustaw limity</h3><form method="post" data-testid="transfer-limits-form"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><label for="single-limit">Limit pojedynczego przelewu</label><input id="single-limit" name="single_limit" value="{{ '%.2f'|format(limits.single_limit_cents / 100) }}" inputmode="decimal" required data-testid="single-transfer-limit"><label for="daily-limit">Dzienny limit przelewów</label><input id="daily-limit" name="daily_limit" value="{{ '%.2f'|format(limits.daily_limit_cents / 100) }}" inputmode="decimal" required data-testid="daily-transfer-limit"><button class="btn" style="margin-top:20px" data-testid="transfer-limits-save">Zapisz limity</button></form></div><div class="panel panel-pad"><h3>Wykorzystanie dzisiaj</h3><p class="balance" data-testid="daily-transfers-used">{{ used_today|money }}</p><p class="muted">Pozostało: <strong data-testid="daily-transfers-remaining">{{ [0, limits.daily_limit_cents - used_today]|max|money }}</strong></p><div class="progress"><span style="width:{{ [100, (used_today * 100 / limits.daily_limit_cents)|round]|min }}%"></span></div><p class="muted">Zmniejszenie limitu poniżej wykorzystanej kwoty zablokuje kolejne przelewy do następnego dnia.</p></div></section>
        <div class="actions"><a class="btn secondary" href="{{ url_for('profile') }}">← Wróć do profilu</a><a class="btn" href="{{ url_for('transfer') }}">Wykonaj przelew</a></div>
        """, limits=limits, used_today=used_today)


def recent_similar_transfer(user_id, account, amount_cents):
    cutoff = (datetime.now(timezone.utc) - timedelta(minutes=10)).isoformat(timespec='seconds')
    return get_db().execute("""SELECT * FROM transactions
        WHERE user_id=? AND kind='debit' AND counterparty_account=?
        AND amount_cents=? AND created_at>=? ORDER BY id DESC LIMIT 1""",
        (user_id, account, amount_cents, cutoff)).fetchone()


@app.route("/transfer", methods=["GET", "POST"])
@login_required
def transfer():
    user = financial_user()
    errors = {}
    serializer = URLSafeTimedSerializer(app.secret_key, salt='transfer-confirmation')
    draft_serializer = URLSafeTimedSerializer(app.secret_key, salt='transfer-draft')
    draft_token = request.form.get('draft_token', '') or draft_serializer.dumps(
        {'user': user['id'], 'nonce': secrets.token_urlsafe(32)})
    db = get_db()
    limits = get_transfer_limits(user['id'])
    daily_used = direct_transfers_today(user['id'])
    daily_remaining = max(0, limits['daily_limit_cents'] - daily_used)
    saved_beneficiaries = db.execute(
        "SELECT * FROM beneficiaries WHERE user_id = ? ORDER BY name COLLATE NOCASE",
        (user["id"],),
    ).fetchall()
    values = {key: request.form.get(key, "").strip() for key in ("recipient", "account", "amount", "title")}
    account_query = request.args.get("q", "").strip()[:80]
    account_pattern = f"%{account_query}%"
    normalized_pattern = f"%{normalize_account_number(account_query)}%"
    registered_accounts = db.execute(
        """SELECT u.id, u.first_name, u.last_name, u.account_number
        FROM users u JOIN user_access a ON a.user_id = u.id
        WHERE u.id != ? AND a.role = 'customer'
          AND (? = '' OR (u.first_name || ' ' || u.last_name) LIKE ? COLLATE NOCASE
                       OR u.account_number LIKE ?)
        ORDER BY u.first_name COLLATE NOCASE, u.last_name COLLATE NOCASE
        LIMIT 25""",
        (user["id"], account_query, account_pattern, normalized_pattern),
    ).fetchall()
    selected_beneficiary_id = None
    selected_registered_account_id = None
    if request.method == "GET":
        selected_beneficiary_id = request.args.get("beneficiary", type=int)
        if selected_beneficiary_id is not None:
            selected_beneficiary = db.execute(
                "SELECT * FROM beneficiaries WHERE id = ? AND user_id = ?",
                (selected_beneficiary_id, user["id"]),
            ).fetchone()
            if selected_beneficiary is None:
                flash("Nie znaleziono wybranego zapisanego odbiorcy.", "error")
                selected_beneficiary_id = None
            else:
                values["recipient"] = selected_beneficiary["name"]
                values["account"] = selected_beneficiary["account_number"]
        selected_registered_account_id = request.args.get("recipient_user", type=int)
        if selected_registered_account_id is not None:
            selected_account = db.execute(
                """SELECT u.id, u.first_name, u.last_name, u.account_number
                FROM users u JOIN user_access a ON a.user_id = u.id
                WHERE u.id = ? AND u.id != ? AND a.role = 'customer'""",
                (selected_registered_account_id, user["id"]),
            ).fetchone()
            if selected_account is None:
                flash("Nie znaleziono wybranego konta odbiorcy.", "error")
                selected_registered_account_id = None
            else:
                values["recipient"] = f"{selected_account['first_name']} {selected_account['last_name']}"
                values["account"] = selected_account["account_number"]
                suggested_amount = request.args.get('amount', '').strip()
                suggested_title = request.args.get('title', '').strip()
                if parse_amount(suggested_amount) is not None:
                    values['amount'] = suggested_amount
                if suggested_title and len(suggested_title) <= 140:
                    values['title'] = suggested_title

    if request.method == 'GET' and request.args.get('repeat', type=int) is not None:
        previous_transfer = db.execute("""SELECT * FROM transactions
            WHERE id=? AND user_id=? AND kind='debit' AND counterparty_account LIKE 'PL%'""",
            (request.args.get('repeat', type=int), user['id'])).fetchone()
        if previous_transfer is None:
            abort(404)
        values.update(recipient=previous_transfer['counterparty'],
                      account=previous_transfer['counterparty_account'],
                      amount=f"{previous_transfer['amount_cents'] / 100:.2f}",
                      title=previous_transfer['title'])

    if request.method == "POST" and request.form.get('step') == 'edit':
        if not valid_csrf():
            abort(400)
    elif request.method == "POST":
        amount_cents = parse_amount(values["amount"])
        clean_account = normalize_account_number(values["account"])
        error = None
        payload_values = dict(values, account=clean_account)
        signed = None
        if not valid_csrf():
            abort(400)
        if request.form.get('step') == 'confirm':
            try:
                signed = serializer.loads(request.form.get('confirmation', ''), max_age=1800)
                if signed.get('user') != user['id'] or signed.get('values') != payload_values or not signed.get('nonce'):
                    raise BadSignature('Zmienione dane')
            except (BadSignature, SignatureExpired):
                flash('Potwierdzenie wygasło lub zmieniono dane. Sprawdź przelew ponownie.', 'error')
                return redirect(url_for('transfer'))
            previous = db.execute('SELECT transaction_id FROM transfer_requests WHERE token=? AND user_id=?',
                                  (signed['nonce'], user['id'])).fetchone()
            if previous and previous['transaction_id']:
                return redirect(url_for('transfer_done', transaction_id=previous['transaction_id']), code=303)

        if not values['recipient']:
            errors['recipient'] = 'Wpisz nazwę odbiorcy.'
        elif len(values['recipient']) > 120:
            errors['recipient'] = 'Nazwa odbiorcy może mieć maksymalnie 120 znaków.'
        if not values['title']:
            errors['title'] = 'Wpisz tytuł przelewu.'
        elif len(values['title']) > 140:
            errors['title'] = 'Tytuł może mieć maksymalnie 140 znaków.'
        account_error = account_validation_error(clean_account)
        if account_error:
            errors['account'] = account_error
        elif clean_account == user['account_number']:
            errors['account'] = 'Nie możesz wykonać przelewu na własne konto.'
        if amount_cents is None:
            errors['amount'] = 'Podaj kwotę od 0,01 zł do 1 000 000 zł.'
        elif amount_cents > user['balance_cents']:
            errors['amount'] = f"Brak środków. Dostępne saldo: {money(user['balance_cents'])}."
        elif amount_cents > limits['single_limit_cents']:
            errors['amount'] = f"Limit pojedynczego przelewu: {money(limits['single_limit_cents'])}."
        elif amount_cents > daily_remaining:
            errors['amount'] = f"Pozostały dzienny limit: {money(daily_remaining)}."
        error = next(iter(errors.values()), None)

        recipient_user = None
        name_verified = True
        if not error:
            recipient_user = get_db().execute(
                "SELECT * FROM users WHERE account_number = ?", (clean_account,)
            ).fetchone()
            if not recipient_user:
                error = "W wersji demo przelew jest możliwy tylko na konto użytkownika NovaBank."
                errors['account'] = error
            else:
                name_verified = recipient_name_matches(values['recipient'], recipient_user)

        if (not error and request.form.get('step') == 'confirm' and not name_verified
                and request.form.get('confirm_name_mismatch') != '1'):
            flash('Potwierdź świadomie niezgodność nazwy odbiorcy z właścicielem rachunku.', 'error')
            return redirect(url_for('transfer'))

        if error:
            flash(error, "error")
        else:
            payload_values = dict(values, account=clean_account)
            token = request.form.get('confirmation', '')
            similar = recent_similar_transfer(user['id'], clean_account, amount_cents)
            if request.form.get('step') != 'confirm':
                try:
                    draft = draft_serializer.loads(draft_token, max_age=1800)
                    if draft.get('user') != user['id'] or not draft.get('nonce'):
                        raise BadSignature('Niepoprawny formularz')
                except (BadSignature, SignatureExpired):
                    flash('Formularz wygasł. Otwórz nowy przelew.', 'error')
                    return redirect(url_for('transfer'))
                token = serializer.dumps(dict(user=user['id'], values=payload_values, nonce=draft['nonce']))
            if request.form.get('step') != 'confirm' or (similar and request.form.get('confirm_similar') != '1'):
                return page('Podsumowanie przelewu', r"""
                <section class="auth panel panel-pad" data-testid="transfer-summary">
                <p class="muted">1. Dane → <strong aria-current="step">2. Podsumowanie</strong> → 3. Potwierdzenie</p>
                <h2>Sprawdź przelew</h2><p>Odbiorca: <strong>{{ values.recipient }}</strong></p>
                <p class="account">{{ values.account }}</p><p>Tytuł: {{ values.title }}</p>
                {% if name_verified %}<p><span class="status approved" data-testid="recipient-name-verified">✓ Nazwa jest zgodna z właścicielem rachunku</span></p>{% else %}<div class="flash warning" data-testid="recipient-name-warning"><strong>Uwaga: nazwa odbiorcy nie odpowiada właścicielowi rachunku.</strong><br>Właściciel rachunku w NovaBank: {{ registered_name }}. Sprawdź dane przed wysłaniem.</div>{% endif %}
                <p class="balance" data-testid="transfer-summary-amount">{{ amount|money }}</p>
                <p>Opłata: 0,00 zł · Przelew wewnętrzny</p><p>Saldo po przelewie: <strong data-testid="transfer-summary-balance">{{ (user.balance_cents - amount)|money }}</strong></p><p class="muted">Po operacji pozostanie {{ (daily_remaining - amount)|money }} dziennego limitu.</p>
                {% if similar %}<div class="flash warning" data-testid="similar-transfer-warning"><strong>Podobny przelew został już wykonany w ostatnich 10 minutach.</strong><br>{{ similar.amount_cents|money }} na ten sam rachunek · {{ similar.created_at|date_pl }} · {{ similar.title }}. Sprawdź, czy chcesz wysłać kolejny.</div>{% endif %}
                <form method="post" data-testid="transfer-confirm-form"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="confirmation" value="{{ token }}">
                <input type="hidden" name="draft_token" value="{{ draft_token }}">
                {% if similar %}<label style="display:block;margin:18px 0"><input type="checkbox" name="confirm_similar" value="1" required data-testid="confirm-similar-transfer"> Chcę świadomie wykonać kolejny podobny przelew.</label>{% endif %}
                {% for key, value in values.items() %}<input type="hidden" name="{{ key }}" value="{{ value }}">{% endfor %}
                {% if not name_verified %}<label class="feature" style="display:block;margin-top:18px"><input type="checkbox" name="confirm_name_mismatch" value="1" required data-testid="confirm-name-mismatch"> Rozumiem ostrzeżenie i potwierdzam przelew do wskazanego rachunku.</label>{% endif %}
                <div class="actions"><button class="btn" type="submit" name="step" value="confirm" data-testid="transfer-confirm">Potwierdź i wyślij</button>
