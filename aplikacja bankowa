def get_db() -> sqlite3.Connection:
    if "db" not in g:
        g.db = sqlite3.connect(DATABASE, timeout=10)
        g.db.row_factory = sqlite3.Row
        g.db.execute("PRAGMA foreign_keys = ON")
        # Starsza baza musi mieć migrację portfela także przy bezpośrednim
        # wywołaniu widoku lub pominięciu inicjalizacji podczas startu.
        core_tables = {row['name'] for row in g.db.execute(
            "SELECT name FROM sqlite_master WHERE type='table' AND name IN ('users','card_payments','currency_balances')"
        )}
        if core_tables == {'users', 'card_payments', 'currency_balances'}:
            ensure_wallet_schema()
    return g.db


