@app.post('/benefits/redeem/<reward_code>')
@login_required
def redeem_reward(reward_code):
    if not valid_csrf():
        abort(400)
    offer = REWARD_OFFERS.get(reward_code)
    if offer is None:
        abort(404)
    user_id = session['user_id']
    db = get_db()
    stamp = now_iso()
    try:
        db.execute('BEGIN IMMEDIATE')
        changed = db.execute(
            """UPDATE reward_accounts
            SET points = points - ?, cashback_cents = cashback_cents + ?
            WHERE user_id = ? AND points >= ?""",
            (offer['points'], offer['cashback_cents'], user_id, offer['points']),
        )
        if changed.rowcount != 1:
            raise ValueError('Nie masz wystarczającej liczby punktów na tę nagrodę.')
        db.execute(
            'UPDATE users SET balance_cents = balance_cents + ? WHERE id = ?',
            (offer['cashback_cents'], user_id),
        )
        transaction = db.execute(
            """INSERT INTO transactions
            (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
            VALUES (?, 'credit', ?, ?, 'NovaClub', 'BENEFIT', ?)""",
            (user_id, offer['cashback_cents'], f"Cashback NovaClub — {offer['name']}", stamp),
        )
        redemption = db.execute(
            """INSERT INTO reward_redemptions
            (user_id, reward_code, reward_name, points_spent, cashback_cents,
             transaction_id, created_at) VALUES (?, ?, ?, ?, ?, ?, ?)""",
            (user_id, reward_code, offer['name'], offer['points'],
             offer['cashback_cents'], transaction.lastrowid, stamp),
        )
        db.execute(
            """INSERT INTO reward_events
            (user_id, event_type, points_delta, description, redemption_id, created_at)
            VALUES (?, 'redeemed', ?, ?, ?, ?)""",
            (user_id, -offer['points'], offer['name'], redemption.lastrowid, stamp),
        )
        add_notification(
            user_id, 'Nagroda NovaClub odebrana',
            f"{offer['name']} został dopisany do salda rachunku.", 'success',
            operation_type='reward_cashback',
            operation_reference=f"NVC-{redemption.lastrowid:06d}",
            amount_cents=offer['cashback_cents'], counterparty='NovaClub',
            related_transaction_id=transaction.lastrowid,
        )
        db.commit()
    except (sqlite3.Error, ValueError) as exc:
        db.rollback()
        flash(str(exc), 'error')
    else:
        flash(f"Odebrano {offer['name']}. Cashback jest już na rachunku.", 'success')
    return redirect(url_for('benefits'))


