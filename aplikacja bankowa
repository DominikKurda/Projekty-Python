def migrate_currency_support(db):
    """Rebuild old currency CHECK constraints, preserving IDs, balances and references."""
    legacy = "'EUR','USD','GBP','CHF'"
    previous = "'EUR','USD','GBP','CHF','JPY','CZK','NOK','SEK','DKK','CAD','AUD','HUF','XDR'"
    expanded = previous + ",'UAH','CNY'"
    tables = []
    for name in ('currency_balances', 'currency_exchanges', 'exchange_alerts'):
        row = db.execute('SELECT sql FROM sqlite_master WHERE type=\'table\' AND name=?', (name,)).fetchone()
        if row and (f"IN ({legacy})" in row['sql'] or f"IN ({previous})" in row['sql']):
            tables.append((name, row['sql']))
    if not tables:
        return
    rebuilt_names = {name for name, _sql in tables}
    dependent_triggers = [
        (row['name'], row['sql'])
        for row in db.execute("SELECT name, sql FROM sqlite_master WHERE type='trigger' AND sql IS NOT NULL")
        if any(re.search(r'\b' + re.escape(table_name) + r'\b', row['sql'], re.I)
               for table_name in rebuilt_names)
    ]
    db.commit()
    db.execute('PRAGMA foreign_keys=OFF')
    try:
        db.execute('BEGIN IMMEDIATE')
        # SQLite validates triggers when a referenced table is renamed. Drop
        # dependent triggers during the short rebuild window, then restore the
        # exact saved definitions once all currency tables exist again.
        for trigger_name, _trigger_sql in dependent_triggers:
            escaped_trigger = trigger_name.replace('"', '""')
            db.execute(f'DROP TRIGGER "{escaped_trigger}"')
        for name, sql in tables:
            indexes = db.execute('SELECT sql FROM sqlite_master WHERE type=\'index\' AND tbl_name=? AND sql IS NOT NULL', (name,)).fetchall()
            columns = ','.join('"' + row['name'] + '"' for row in db.execute(f'PRAGMA table_info({name})'))
            sequence = db.execute('SELECT seq FROM sqlite_sequence WHERE name=?', (name,)).fetchone()
            temp = name + '_expanded'
            definition = re.sub(r'CREATE TABLE\s+"?' + name + r'"?', 'CREATE TABLE ' + temp, sql, count=1, flags=re.I)
            definition = definition.replace(f"IN ({legacy})", f"IN ({expanded})")
            definition = definition.replace(f"IN ({previous})", f"IN ({expanded})")
            db.execute(definition)
            db.execute(f'INSERT INTO {temp}({columns}) SELECT {columns} FROM {name}')
            db.execute(f'DROP TABLE {name}')
            db.execute(f'ALTER TABLE {temp} RENAME TO {name}')
            if sequence:
                db.execute('UPDATE sqlite_sequence SET seq=MAX(seq,?) WHERE name=?', (sequence['seq'], name))
            for index in indexes:
                db.execute(index['sql'])
        for _trigger_name, trigger_sql in dependent_triggers:
            db.execute(trigger_sql)
        if db.execute("SELECT 1 FROM sqlite_master WHERE name='nbp_cache_meta'").fetchone():
            db.execute('DELETE FROM nbp_cache_meta')
        if db.execute('PRAGMA foreign_key_check').fetchone():
            raise ValueError('Niezgodność powiązań po rozszerzeniu walut')
        db.commit()
    except Exception:
        db.rollback()
        raise
    finally:
        db.execute('PRAGMA foreign_keys=ON')


