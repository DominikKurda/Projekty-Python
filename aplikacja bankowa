CARD_OPERATION_LABELS = {
    'store': 'Płatność w sklepie',
    'online': 'Płatność internetowa',
    'atm': 'Wypłata z bankomatu',
}


@app.route('/card-payments', methods=['GET', 'POST'])
@login_required
def card_payments():
    if request.method == 'POST' and (
        request.form.get('currency', 'PLN') != 'PLN'
        or request.form.get('wallet_confirmation') == '1'
    ):
        return wallet_card_payment()
    user = current_user()
    db = get_db()
    db.execute('INSERT OR IGNORE INTO card_settings(user_id) VALUES (?)', (user['id'],))
    db.execute('INSERT OR IGNORE INTO card_appearances(user_id, theme) VALUES (?, ?)', (user['id'], 'blue'))
    db.commit()
    card = db.execute('SELECT * FROM card_settings WHERE user_id = ?', (user['id'],)).fetchone()
    card_theme = db.execute('SELECT theme FROM card_appearances WHERE user_id = ?', (user['id'],)).fetchone()['theme']
    card_last_four = visa_card_number(user['id'])[-4:]
    photo_row = db.execute('SELECT updated_at FROM card_backgrounds WHERE user_id = ?', (user['id'],)).fetchone()
    values = {
        'currency': request.values.get('currency', 'PLN') if request.values.get('currency', 'PLN') in ('PLN', *EXCHANGE_CURRENCIES) else 'PLN',
        'operation_type': request.form.get('operation_type', 'store').strip(),
        'merchant': request.form.get('merchant', '').strip(),
        'amount': request.form.get('amount', '').strip(),
    }
    if request.method == 'POST':
        amount = parse_amount(values['amount'])
        operation_type = values['operation_type']
        error = None
        rejection = None
        if not valid_csrf():
            error = 'Sesja formularza wygasła. Spróbuj ponownie.'
        elif operation_type not in CARD_OPERATION_LABELS:
            error = 'Wybierz poprawny rodzaj operacji.'
        elif not values['merchant'] or len(values['merchant']) > 120:
            error = 'Podaj nazwę sklepu lub lokalizację bankomatu.'
        elif amount is None:
            error = 'Podaj poprawną kwotę większą od 0 zł.'
        if error is None:
            limit_column = {'store': 'payment_limit', 'online': 'online_limit', 'atm': 'atm_limit'}[operation_type]
            daily_limit = card[limit_column]
            spent_today = db.execute(
                """SELECT COALESCE(SUM(COALESCE(pln_equivalent_cents,amount_cents)), 0) FROM card_payments
                WHERE user_id = ? AND operation_type = ? AND status = 'approved'
                AND substr(created_at, 1, 10) = ?""",
                (user['id'], operation_type, date.today().isoformat()),
            ).fetchone()[0]
            remaining_limit = max(0, daily_limit - spent_today)
            if card['locked']:
                rejection = 'Karta jest zablokowana.'
            elif operation_type == 'online' and not card['online_enabled']:
                rejection = 'Płatności internetowe są wyłączone w ustawieniach karty.'
            elif operation_type == 'atm' and not card['atm_enabled']:
                rejection = 'Wypłaty z bankomatu są wyłączone w ustawieniach karty.'
            elif operation_type == 'store' and not card['contactless_enabled']:
                rejection = 'Płatności zbliżeniowe w sklepach są wyłączone w ustawieniach karty.'
            elif amount > remaining_limit:
                rejection = f"Przekroczono dostępny limit dzienny. Pozostało: {money(remaining_limit)}."
            elif amount > user['balance_cents']:
                rejection = 'Brak wystarczających środków na rachunku.'

            stamp = now_iso()
            if rejection:
                rejected_payment = db.execute(
                    """INSERT INTO card_payments
                    (user_id, operation_type, merchant, amount_cents, status,
                     rejection_reason, created_at)
                    VALUES (?, ?, ?, ?, 'rejected', ?, ?)""",
                    (user['id'], operation_type, values['merchant'], amount, rejection, stamp),
                )
                add_notification(
                    user['id'], 'Odrzucona operacja kartą',
                    f"{CARD_OPERATION_LABELS[operation_type]} na {money(amount)} — {values['merchant']}. Powód: {rejection}",
                    'warning', operation_type='card_payment', amount_cents=amount,
                    operation_reference=f"KP-{rejected_payment.lastrowid:06d}",
                    counterparty=values['merchant'],
                )
                db.commit()
                return redirect(url_for('card_payments', payment=rejected_payment.lastrowid))
            try:
                db.execute('BEGIN IMMEDIATE')
                earned_points = amount // 100 if operation_type in ('store', 'online') else 0
                changed = db.execute(
                    'UPDATE users SET balance_cents = balance_cents - ? WHERE id = ? AND balance_cents >= ?',
                    (amount, user['id'], amount),
                )
                if changed.rowcount != 1:
                    raise ValueError('Brak wystarczających środków na rachunku.')
                payment = db.execute(
                    """INSERT INTO card_payments
                    (user_id, operation_type, merchant, amount_cents, status, reward_points, created_at)
                    VALUES (?, ?, ?, ?, 'approved', ?, ?)""",
                    (user['id'], operation_type, values['merchant'], amount, earned_points, stamp),
                )
                title = ('Wypłata z bankomatu' if operation_type == 'atm' else 'Płatność kartą') + f" – {values['merchant']}"
                transaction = db.execute(
                    """INSERT INTO transactions
                    (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
                    VALUES (?, 'debit', ?, ?, ?, 'CARD', ?)""",
                    (user['id'], amount, title, values['merchant'], stamp),
                )
                add_notification(
                    user['id'], 'Operacja kartą',
                    f"{CARD_OPERATION_LABELS[operation_type]} na {money(amount)} — {values['merchant']}."
                    + (f" Zdobyto {earned_points} pkt NovaClub." if earned_points else ""),
                    'success', operation_type='card_payment',
                    operation_reference=f"KP-{payment.lastrowid:06d}", amount_cents=amount,
                    counterparty=values['merchant'], related_transaction_id=transaction.lastrowid,
                )
                if earned_points:
                    db.execute(
                        """INSERT OR IGNORE INTO reward_accounts
                        (user_id, points, lifetime_points, cashback_cents) VALUES (?, 600, 600, 0)""",
                        (user['id'],),
                    )
                    db.execute(
                        """UPDATE reward_accounts
                        SET points = points + ?, lifetime_points = lifetime_points + ?
                        WHERE user_id = ?""",
                        (earned_points, earned_points, user['id']),
                    )
                    db.execute(
                        """INSERT INTO reward_events
                        (user_id, event_type, points_delta, description,
                         related_card_payment_id, created_at)
                        VALUES (?, 'earned', ?, ?, ?, ?)""",
                        (user['id'], earned_points,
                         f"Płatność kartą w {values['merchant']}", payment.lastrowid, stamp),
                    )
                if amount >= 200_000 or (operation_type == 'online' and amount >= 100_000):
                    add_notification(
                        user['id'], 'Alert bezpieczeństwa: płatność kartą',
                        f"Wykryto wysoką operację kartą na {money(amount)} w {values['merchant']}. Jeśli to nie Ty, zablokuj kartę.",
                        'security',
                    )
                warn_about_low_balance(user['id'], user['balance_cents'] - amount)
                db.commit()
            except (sqlite3.Error, ValueError) as exc:
                db.rollback()
                flash(str(exc), 'error')
            else:
                return redirect(url_for('card_payments', payment=payment.lastrowid))
        if error:
            flash(error, 'error')

    history = db.execute(
        'SELECT * FROM card_payments WHERE user_id = ? ORDER BY id DESC', (user['id'],)
    ).fetchall()
    result_id = request.args.get('payment', '')
    payment_result = (db.execute(
        'SELECT * FROM card_payments WHERE id = ? AND user_id = ?', (int(result_id), user['id'])
    ).fetchone() if result_id.isdecimal() and len(result_id) < 18 else None)
    today_usage = {}
    for operation_type, column in [('store', 'payment_limit'), ('online', 'online_limit'), ('atm', 'atm_limit')]:
        used = db.execute(
            """SELECT COALESCE(SUM(COALESCE(pln_equivalent_cents,amount_cents)), 0) FROM card_payments
            WHERE user_id = ? AND operation_type = ? AND status = 'approved'
            AND substr(created_at, 1, 10) = ?""",
            (user['id'], operation_type, date.today().isoformat()),
        ).fetchone()[0]
        today_usage[operation_type] = {'used': used, 'limit': card[column], 'remaining': max(0, card[column] - used)}
    return page('Płatności kartą', r"""
        <div class="topline"><div><div class="eyebrow">VISA Debit · demo</div><h2>Zapłać kartą VISA</h2><p class="muted">Symulacja płatności w NovaBanku. Saldo PLN: <strong data-testid="card-payment-balance">{{ user.balance_cents|money }}</strong></p><a href="{{ url_for('wallet_limits') }}" data-testid="card-wallet-limits-link">Ustaw limity dla poszczególnych walut →</a></div><span class="status {{ 'rejected' if card.locked else 'approved' }}" data-testid="payment-card-status">{{ 'Karta zablokowana' if card.locked else 'Karta aktywna' }}</span></div>
        {% if payment_result %}<section class="payment-result {{ payment_result.status }}" role="status" data-testid="card-payment-result"><div class="payment-result-icon" aria-hidden="true">{{ {'approved':'✓','rejected':'×','refunded':'↶'}[payment_result.status] }}</div><div><h3>{{ {'approved':'Płatność zaakceptowana','rejected':'Płatność odrzucona','refunded':'Płatność zwrócona'}[payment_result.status] }}</h3><p><strong>{{ payment_result.amount_cents|wallet_money(payment_result.currency) }}</strong> · {{ payment_result.merchant }} · KP-{{ '%06d'|format(payment_result.id) }}</p>{% if payment_result.rejection_reason %}<p>{{ payment_result.rejection_reason }}</p>{% endif %}</div></section>{% endif %}
        <section class="cards"><div class="panel panel-pad"><h3>Nowa operacja</h3><form method="post" data-testid="card-payment-form"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <label for="operation-type">Rodzaj operacji</label><select id="operation-type" name="operation_type" data-testid="card-operation-type">{% for value,label in labels.items() %}<option value="{{ value }}" {% if values.operation_type == value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select>
