@app.post('/wallet/goals/<int:goal_id>/operation')
@login_required
def wallet_goal_operation(goal_id):
    if not valid_csrf(): abort(400)
    db=get_db();uid=session['user_id'];currency='EUR'
    if db.execute('SELECT 1 FROM wallet_goals WHERE id=? AND user_id=?',(goal_id,uid)).fetchone() is None: abort(404)
    try:
        db.execute('BEGIN IMMEDIATE');data=wallet_claim(request.form.get('wallet_token',''),'goal-operation')
        if data.get('goal_id')!=goal_id: raise ValueError('Potwierdzenie dotyczy innego celu.')
        goal=db.execute('SELECT * FROM wallet_goals WHERE id=? AND user_id=?',(goal_id,uid)).fetchone()
        currency=goal['currency'];action=request.form.get('action')
        if goal['status']=='closed': raise ValueError('Cel został już zamknięty.')
        if action=='close':
            amount=goal['saved_cents']
            if amount:
                wallet_change(uid,currency,amount)
                wallet_log(uid,currency,'goal','credit',amount,'Zamknięcie celu',goal['name'],f'CEL-{goal_id}')
            db.execute("UPDATE wallet_goals SET saved_cents=0,status='closed' WHERE id=?",(goal_id,))
        elif action in ('deposit','withdraw'):
            amount=wallet_amount(request.form.get('amount'),currency)
            if action=='deposit':
                wallet_change(uid,currency,-amount);saved=goal['saved_cents']+amount
            else:
                if amount>goal['saved_cents']: raise ValueError('Kwota przekracza środki zgromadzone na celu.')
                wallet_change(uid,currency,amount);saved=goal['saved_cents']-amount
            db.execute('UPDATE wallet_goals SET saved_cents=?,status=? WHERE id=?',(saved,'completed' if saved>=goal['target_cents'] else 'active',goal_id))
            wallet_log(uid,currency,'goal','debit' if action=='deposit' else 'credit',amount,'Wpłata na cel' if action=='deposit' else 'Wypłata z celu',goal['name'],f'CEL-{goal_id}')
        else: raise ValueError('Wybierz poprawną operację.')
        db.commit();flash('Operacja na celu została wykonana.','success')
    except (ValueError,sqlite3.Error) as exc:
        db.rollback();flash(str(exc) if isinstance(exc,ValueError) else 'Nie udało się zmienić celu.','error')
    return redirect(url_for('wallet_goals',currency=currency))


