def exchange_alert_create():
    if not valid_csrf():
        abort(400)
    currency = request.form.get('currency', '')
    direction = request.form.get('direction', '')
    comparison = request.form.get('comparison', '')
    raw = request.form.get('target_rate', '').strip().replace(',', '.')
    if (currency not in EXCHANGE_CURRENCIES or direction not in ('buy', 'sell') or
            comparison not in ('below', 'above') or not re.fullmatch(r'\d{1,4}(?:\.\d{1,6})?', raw)):
        flash('Wybierz walutę, kierunek i poprawny kurs z maksymalnie sześcioma miejscami po przecinku.', 'error')
        return redirect(url_for('exchange') + '#exchange-alerts')
    target = Decimal(raw)
    if not Decimal('.000001') <= target <= Decimal('1000'):
        flash('Kurs docelowy musi wynosić od 0,000001 do 1000 PLN.', 'error')
        return redirect(url_for('exchange') + '#exchange-alerts')
    db = get_db()
    db.execute('INSERT INTO exchange_alerts(user_id,currency,direction,comparison,target_rate,created_at) VALUES (?,?,?,?,?,?)',
               (session['user_id'], currency, direction, comparison, str(target), now_iso()))
    db.commit()
    process_exchange_alerts(session['user_id'])
    flash('Alert kursowy został zapisany.', 'success')
    return redirect(url_for('exchange') + '#exchange-alerts')


