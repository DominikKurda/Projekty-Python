@app.route('/vault/pockets/<int:pocket_id>/photo', methods=['GET','POST'])
@login_required
def vault_pocket_photo(pocket_id):
    user=financial_user()
    db=get_db()
    if not db.execute('SELECT 1 FROM vault_pockets WHERE id=? AND user_id=?',(pocket_id,user['id'])).fetchone():
        abort(404)
    if request.method=='GET':
        photo=db.execute('SELECT image FROM vault_pocket_photos WHERE pocket_id=?',(pocket_id,)).fetchone()
        if photo is None:
            abort(404)
        return Response(photo['image'],content_type='image/jpeg',headers={'Cache-Control':'private, no-store'})
    if not valid_csrf():
        abort(400)
    if request.form.get('action')=='remove':
        db.execute('DELETE FROM vault_pocket_photos WHERE pocket_id=?',(pocket_id,));db.commit()
        flash('Zdjęcie celu zostało usunięte.','success')
        return redirect(url_for('vault',pocket_id=pocket_id))
    upload=request.files.get('photo')
    try:
        if not upload or not upload.filename:
            raise ValueError('Wybierz zdjęcie celu.')
        raw=upload.read(5*1024*1024+1)
        if len(raw)>5*1024*1024:
            raise ValueError('Zdjęcie może mieć maksymalnie 5 MB.')
        with warnings.catch_warnings():
            warnings.simplefilter('error',Image.DecompressionBombWarning)
            with Image.open(BytesIO(raw)) as source:
                if source.format not in ('JPEG','PNG','WEBP') or source.width*source.height>16_000_000:
                    raise ValueError('Wybierz JPG, PNG lub WebP do 16 milionów pikseli.')
                source.load()
                cropped=ImageOps.fit(ImageOps.exif_transpose(source).convert('RGB'),(900,600),method=Image.Resampling.LANCZOS)
                clean=Image.new('RGB',(900,600));clean.paste(cropped)
                buffer=BytesIO();clean.save(buffer,format='JPEG',quality=88,optimize=True)
        db.execute('''INSERT INTO vault_pocket_photos VALUES(?,?,?) ON CONFLICT(pocket_id)
            DO UPDATE SET image=excluded.image,updated_at=excluded.updated_at''',(pocket_id,buffer.getvalue(),now_iso()))
        db.commit();flash('Zdjęcie celu zostało zapisane.','success')
    except ValueError as exc:
        flash(str(exc),'error')
    except (UnidentifiedImageError,OSError,Image.DecompressionBombError,Image.DecompressionBombWarning):
