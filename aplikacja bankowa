                const label = element('text', {x:38,y:py+4,'text-anchor':'end',fill:'#52647c','font-size':12}, grid);
                label.textContent = fmt(Math.round(max * i / 3));
            }
            for (const index of [...new Set([0, Math.floor((days.length-1)/2), days.length-1])]) {
