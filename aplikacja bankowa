EN_TRANSLATION_PHRASES = tuple(sorted(EN_TRANSLATIONS.items(), key=lambda pair: len(pair[0]), reverse=True))


def get_language() -> str:
    if not has_request_context():
        return "pl"
    selected = session.get("language", "pl")
    return selected if selected in SUPPORTED_LANGUAGES else "pl"


def translate_text(value, language=None):
    if not isinstance(value, str) or (language or get_language()) != "en":
        return value
    direct = EN_TRANSLATIONS.get(value)
    if direct is not None:
        return direct
    stripped = value.strip()
    direct = EN_TRANSLATIONS.get(stripped)
    if direct is None:
        direct = EN_TRANSLATIONS.get(" ".join(stripped.split()))
    if direct is not None:
        start = len(value) - len(value.lstrip())
        end = len(value.rstrip())
        return value[:start] + direct + value[end:]
    # Translate static fragments around Jinja expressions before rendering.
    # Rendered names, transaction titles and other user-provided data stay intact.
    if "{{" not in value and "{%" not in value:
        return value
    result = value
    for polish, english in EN_TRANSLATION_PHRASES:
        result = result.replace(polish, english)
    return result


def translate_markup(markup: str, language: str) -> str:
    if language != "en":
        return markup
    markup = re.sub(r">([^<>]*)<", lambda match: ">" + translate_text(match.group(1), language) + "<", markup)
    attribute_pattern = r"""(placeholder|title|aria-label|alt|value)=(['"])(.*?)\2"""
    markup = re.sub(attribute_pattern, lambda match: f"{match.group(1)}={match.group(2)}{translate_text(match.group(3), language)}{match.group(2)}", markup)

    # Translate fixed user-facing strings in inline scripts (alerts, validation
    # hints, and dynamically inserted labels) without changing JavaScript code.
    script_pattern = r"(<script\b[^>]*>)(.*?)(</script\s*>)"
    def translate_script(match):
        script = re.sub(
            r"(['\"`])(.*?)\1",
            lambda quoted: quoted.group(1) + translate_rendered_text(quoted.group(2)) + quoted.group(1),
            match.group(2),
            flags=re.S,
        )
        return match.group(1) + script + match.group(3)
    markup = re.sub(script_pattern, translate_script, markup, flags=re.S | re.I)
    return markup


def translate_rendered_text(value: str) -> str:
    """Translate a rendered UI text node while leaving unmatched user data alone."""
    if not isinstance(value, str) or not value.strip():
        return value
    leading = value[:len(value) - len(value.lstrip())]
    trailing = value[len(value.rstrip()):]
    core = value.strip()
    direct = EN_TRANSLATIONS.get(core)
    if direct is None:
        direct = EN_TRANSLATIONS.get(" ".join(core.split()))
    if direct is not None:
        return leading + direct + trailing

    # Some UI nodes contain both a translated label and a rendered value, such
    # as a greeting followed by a customer's name. Replace known phrases only.
    result = core
    for polish, english in EN_TRANSLATION_PHRASES:
        if len(polish) < 7 or "{{" in polish or "{%" in polish:
            continue
        if polish in result:
            result = result.replace(polish, english)
    result = re.sub(
        r"\bPozostało\s+([\d\s.,]+)\s+z\s+([\d\s.,]+)",
        lambda match: f"Remaining {match.group(1).strip()} of {match.group(2).strip()}",
        result,
    )
    result = re.sub(r"\bProśby\s+(\d+)\b", r"Requests \1", result)
    return leading + result + trailing


class RenderedEnglishTranslator(HTMLParser):
    """Translate final HTML text and UI attributes, including dynamic labels."""

    VOID_TAGS = {"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "param", "source", "track", "wbr"}
    TRANSLATABLE_ATTRIBUTES = {"placeholder", "title", "aria-label", "alt"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.parts = []
        self.tags = []

    def handle_decl(self, decl):
        self.parts.append(f"<!{decl}>")

    def handle_comment(self, data):
        self.parts.append(f"<!--{data}-->")

    def handle_starttag(self, tag, attrs):
        changed = False
        rendered_attrs = []
        input_type = next((value for name, value in attrs if name == "type"), "").lower()
        for name, value in attrs:
            updated = value
            if value is not None and name in self.TRANSLATABLE_ATTRIBUTES:
                updated = translate_rendered_text(value)
            elif value is not None and name == "value" and input_type in {"button", "submit", "reset"}:
                updated = translate_rendered_text(value)
            if updated != value:
                changed = True
            rendered_attrs.append((name, updated))

        if not changed:
            self.parts.append(self.get_starttag_text())
        else:
            attrs_text = "".join(
                f' {name}="{html_escape(value, quote=True)}"' if value is not None else f" {name}"
                for name, value in rendered_attrs
            )
            self.parts.append(f"<{tag}{attrs_text}>")
        if tag not in self.VOID_TAGS:
            self.tags.append(tag)

    def handle_startendtag(self, tag, attrs):
        self.handle_starttag(tag, attrs)
        if tag not in self.VOID_TAGS and self.tags:
            self.tags.pop()
        if self.parts and self.parts[-1].endswith(">"):
            self.parts[-1] = self.parts[-1][:-1] + "/>"

    def handle_endtag(self, tag):
        self.parts.append(f"</{tag}>")
        if tag in self.tags:
            self.tags = self.tags[:len(self.tags) - 1 - self.tags[::-1].index(tag)]

    def handle_data(self, data):
        if any(tag in {"script", "style", "code", "pre"} for tag in self.tags):
            self.parts.append(data)
        else:
            self.parts.append(html_escape(translate_rendered_text(data), quote=False))

    def handle_entityref(self, name):
        self.parts.append(f"&{name};")

    def handle_charref(self, name):
        self.parts.append(f"&#{name};")

    def result(self, markup: str) -> str:
        self.feed(markup)
        self.close()
        return "".join(self.parts)


def translate_rendered_markup(markup: str, language: str) -> str:
    if language != "en":
        return markup
    return RenderedEnglishTranslator().result(markup)


app.jinja_env.filters["translate"] = translate_text


def clear_session_preserving_language():
    language = session.get("language", "pl")
    session.clear()
    if language in SUPPORTED_LANGUAGES:
        session["language"] = language


@app.route("/language", methods=["POST"])
def set_language():
    if not valid_csrf():
        abort(400)
    selected = request.form.get("language", "pl")
    if selected in SUPPORTED_LANGUAGES:
        session["language"] = selected
    return_to = request.form.get("next", "")
    if not return_to.startswith("/") or return_to.startswith("//"):
        return_to = url_for("home")
    return redirect(return_to)


