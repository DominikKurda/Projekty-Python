@app.route('/qa/log.csv')
@login_required
def qa_export_log():
    rows = get_db().execute(
        """SELECT id, created_at, scenario, result, http_status, details
        FROM qa_scenario_runs WHERE user_id = ? ORDER BY id DESC""",
        (session['user_id'],),
    ).fetchall()
    output = StringIO()
    output.write('\ufeff')
    writer = csv.writer(output, delimiter=';')
    writer.writerow(['ID', 'Data', 'Scenariusz', 'Wynik', 'HTTP', 'Szczegóły'])
    for row in rows:
        writer.writerow([f"QA-{row['id']:05d}", row['created_at'], row['scenario'],
                         row['result'], row['http_status'], row['details']])
    return Response(output.getvalue(), content_type='text/csv; charset=utf-8', headers={
        'Content-Disposition': 'attachment; filename="NovaBank-dziennik-QA.csv"'})


