                    'info', operation_type='payment_request',
                    operation_reference=f"PRO-{request_id:06d}",
                    amount_cents=amount,
                    counterparty=f"{user['first_name']} {user['last_name']}",
                )
                db.commit()
            except sqlite3.Error:
                db.rollback()
                app.logger.exception('Błąd tworzenia prośby o przelew')
                flash('Nie udało się wysłać prośby o przelew.', 'error')
            else:
                flash(f'Prośba PRO-{request_id:06d} została wysłana.', 'success')
                return redirect(url_for('payment_requests'))

    incoming = db.execute(
        """SELECT r.*, u.first_name, u.last_name, u.account_number
        FROM payment_requests r JOIN users u ON u.id = r.requester_id
