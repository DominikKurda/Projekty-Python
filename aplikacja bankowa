    <section class="grid">{% for goal in goals %}<article class="panel panel-pad" data-testid="wallet-goal-{{ goal.id }}"><div class="eyebrow">{{ goal.currency }}</div><h3>{{ goal.name }}</h3><p><strong>{{ goal.saved_cents|wallet_money(goal.currency) }}</strong> z {{ goal.target_cents|wallet_money(goal.currency) }}</p><div class="progress"><span style="width:{{ goal.progress }}%"></span></div><p class="muted">{{ 'Cel zamknięty' if goal.status=='closed' else ('Cel osiągnięty' if goal.status=='completed' else 'Oszczędzasz') }}{% if goal.deadline %} · Termin: {{ goal.deadline }}{% endif %}</p>{% if goal.status!='closed' %}<p>Dostępne w portfelu: {{ balances.get(goal.currency,0)|wallet_money(goal.currency) }}</p><form method="post" action="{{ url_for('wallet_goal_operation',goal_id=goal.id) }}"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="wallet_token" value="{{ goal.token }}"><label for="goal-amount-{{ goal.id }}">Kwota w {{ goal.currency }}</label><input id="goal-amount-{{ goal.id }}" name="amount" inputmode="decimal" required><div class="actions" style="margin-top:12px"><button class="btn" name="action" value="deposit">Wpłać na cel</button><button class="btn secondary" name="action" value="withdraw">Wypłać do portfela</button></div></form><form method="post" action="{{ url_for('wallet_goal_operation',goal_id=goal.id) }}" style="margin-top:12px"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="wallet_token" value="{{ goal.token }}"><button class="btn danger" name="action" value="close">Zamknij cel i zwróć środki</button></form>{% endif %}</article>{% else %}<div class="empty">Utwórz pierwszy cel, np. wyjazd do Japonii w JPY.</div>{% endfor %}</section>
