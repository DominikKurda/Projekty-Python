            if live_recipient is None: raise ValueError('Odbiorca nie jest już dostępny.')
            limits=db.execute('SELECT * FROM transfer_limits WHERE user_id=?',(uid,)).fetchone()
            live_currency_limit=db.execute('SELECT transfer_daily_limit_cents FROM wallet_currency_limits WHERE user_id=? AND currency=?',(uid,currency)).fetchone()[0]
            if wallet_currency_usage(uid,currency,'transfer')+amount>live_currency_limit:
                raise ValueError('Przekroczono aktualny limit przelewów w '+currency+'.')
            # direct_transfers_today uwzględnia już przelewy walutowe.
