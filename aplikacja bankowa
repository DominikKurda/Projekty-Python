DEPOSIT_OFFERS = {
    3: Decimal("3.25"),
    6: Decimal("3.75"),
    12: Decimal("4.25"),
    24: Decimal("4.75"),
}


@app.route('/deposits', methods=['GET', 'POST'])
@login_required
def deposits():
    user = current_user()
    db = get_db()
    values = {
        'amount': request.form.get('amount', '').strip(),
        'months': request.form.get('months', '12').strip(),
    }
    if request.method == 'POST':
        amount = parse_amount(values['amount'])
        try:
            months = int(values['months'])
        except ValueError:
            months = 0
        rate = DEPOSIT_OFFERS.get(months)
        error = None
        if not valid_csrf():
            error = 'Sesja formularza wygasła. Spróbuj ponownie.'
        elif amount is None or not 50_000 <= amount <= 50_000_000:
            error = 'Kwota lokaty musi wynosić od 500 zł do 500 000 zł.'
        elif rate is None:
            error = 'Wybierz dostępny okres lokaty.'
        elif amount > user['balance_cents']:
            error = 'Brak wystarczających środków na rachunku.'
        if error:
            flash(error, 'error')
        else:
            started = date.today()
            maturity = add_months(started, months)
            interest = calculate_deposit_interest(amount, months, rate)
            stamp = now_iso()
            try:
                db.execute('BEGIN IMMEDIATE')
                changed = db.execute(
                    'UPDATE users SET balance_cents = balance_cents - ? WHERE id = ? AND balance_cents >= ?',
                    (amount, user['id'], amount),
                )
                if changed.rowcount != 1:
                    raise ValueError('Brak wystarczających środków na rachunku.')
                deposit = db.execute(
                    """INSERT INTO term_deposits
                    (user_id, principal_cents, term_months, annual_rate,
                     expected_interest_cents, status, started_at, maturity_date)
                    VALUES (?, ?, ?, ?, ?, 'active', ?, ?)""",
                    (user['id'], amount, months, str(rate), interest, stamp, maturity.isoformat()),
                )
                db.execute(
                    """INSERT INTO transactions
                    (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
                    VALUES (?, 'debit', ?, ?, 'NovaBank Lokaty', 'LOKATA', ?)""",
                    (user['id'], amount, f"Założenie lokaty LK-{deposit.lastrowid:06d}", stamp),
                )
                add_notification(
                    user['id'], 'Lokata została założona',
                    f"Lokata LK-{deposit.lastrowid:06d} na {money(amount)} zakończy się {maturity.strftime('%d.%m.%Y')}.",
                    'success',
                )
                warn_about_low_balance(user['id'], user['balance_cents'] - amount)
                db.commit()
            except (sqlite3.Error, ValueError) as exc:
                db.rollback()
                flash(str(exc), 'error')
            else:
                flash('Lokata została założona.', 'success')
                return redirect(url_for('deposits'))

    rows = db.execute(
        'SELECT * FROM term_deposits WHERE user_id = ? ORDER BY id DESC',
        (user['id'],),
    ).fetchall()
    today = date.today()
    deposit_rows = []
    for row in rows:
        item = dict(row)
        maturity = date.fromisoformat(item['maturity_date'])
        item['days_left'] = max(0, (maturity - today).days)
        item['is_matured'] = item['status'] == 'active' and maturity <= today
        item['projected_payout'] = item['principal_cents'] + item['expected_interest_cents']
        deposit_rows.append(item)
    active_total = sum(item['principal_cents'] for item in deposit_rows if item['status'] == 'active')
    expected_total = sum(item['expected_interest_cents'] for item in deposit_rows if item['status'] == 'active')
    return page('Lokaty', r"""
        <div class="topline"><div><div class="eyebrow">Oszczędności terminowe</div><h2>Lokaty</h2><p class="muted">Wybierz okres, sprawdź odsetki i załóż demonstracyjną lokatę.</p></div></div>
        <section class="grid"><div class="feature"><h3>Środki na lokatach</h3><div class="balance" style="font-size:30px" data-testid="deposits-total">{{ active_total|money }}</div></div><div class="feature"><h3>Planowane odsetki</h3><div class="balance" style="font-size:30px" data-testid="deposits-interest-total">{{ expected_total|money }}</div></div><div class="feature"><h3>Saldo rachunku</h3><div class="balance" style="font-size:30px">{{ user.balance_cents|money }}</div></div></section>
        <section class="cards" style="margin-top:22px"><div class="panel panel-pad"><h3>Załóż lokatę</h3><form method="post" data-testid="deposit-form"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <label for="deposit-amount">Kwota lokaty</label><input id="deposit-amount" name="amount" value="{{ values.amount }}" inputmode="decimal" placeholder="np. 10 000" required data-testid="deposit-amount">
        <label for="deposit-months">Okres i oprocentowanie</label><select id="deposit-months" name="months" data-testid="deposit-months">{% for months,rate in offers.items() %}<option value="{{ months }}" data-rate="{{ rate }}" {% if values.months == months|string %}selected{% endif %}>{{ months }} mies. — {{ rate }}% w skali roku</option>{% endfor %}</select>
        <div class="demo-box" role="status" data-testid="deposit-preview">Wpisz kwotę, aby zobaczyć symulację.</div><button class="btn" style="margin-top:18px" data-testid="deposit-submit">Załóż lokatę</button></form></div>
        <div class="panel panel-pad"><h3>Ważne informacje</h3><p class="muted">Odsetki są wyliczane dla całego wybranego okresu. Po terminie otrzymasz kapitał i pełne odsetki.</p><div class="flash info"><strong>Wcześniejsze zerwanie</strong><br>Kapitał wróci na rachunek, ale naliczone odsetki wyniosą 0 zł.</div></div></section>
        <section class="panel panel-pad" style="margin-top:22px"><h3>Twoje lokaty</h3>{% if deposits %}<div style="overflow-x:auto"><table data-testid="deposits-table"><thead><tr><th>Numer</th><th>Kapitał</th><th>Okres</th><th>Oprocentowanie</th><th>Zakończenie</th><th>Odsetki</th><th>Status</th><th>Operacja</th></tr></thead><tbody>{% for item in deposits %}<tr id="deposit-{{ item.id }}" data-testid="deposit-row-{{ item.id }}"><td>LK-{{ '%06d'|format(item.id) }}</td><td><strong>{{ item.principal_cents|money }}</strong></td><td>{{ item.term_months }} mies.</td><td>{{ item.annual_rate }}%</td><td>{{ item.maturity_date }}{% if item.status == 'active' %}<br><span class="muted" data-testid="deposit-days-{{ item.id }}">{{ 'Gotowa do wypłaty' if item.is_matured else item.days_left|string + ' dni' }}</span>{% endif %}</td><td>{{ (item.paid_interest_cents if item.paid_interest_cents is not none else item.expected_interest_cents)|money }}</td><td><span class="status {{ 'approved' if item.status == 'completed' else ('rejected' if item.status == 'broken' else 'pending') }}">{{ {'active':'Aktywna','completed':'Zakończona','broken':'Zerwana'}[item.status] }}</span></td><td>{% if item.status == 'active' %}<form method="post" action="{{ url_for('close_deposit', deposit_id=item.id) }}" onsubmit="return confirm('{{ 'Odebrać lokatę wraz z odsetkami?' if item.is_matured else 'Zerwać lokatę przed terminem? Odsetki zostaną utracone.' }}')"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><button class="btn {{ '' if item.is_matured else 'danger' }}" data-testid="deposit-close-{{ item.id }}">{{ 'Odbierz środki' if item.is_matured else 'Zerwij lokatę' }}</button></form>{% else %}<span class="muted">Wypłacono {{ item.payout_cents|money }}</span>{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty" data-testid="deposits-empty">Nie masz jeszcze żadnych lokat.</div>{% endif %}</section>
        <script>(()=>{const amount=document.getElementById('deposit-amount'),term=document.getElementById('deposit-months'),preview=document.querySelector('[data-testid="deposit-preview"]');const locale={{ ('en-US' if language == 'en' else 'pl-PL')|tojson }},unit={{ (' PLN' if language == 'en' else ' zł')|tojson }};function update(){const principal=Number(amount.value.replace(/\s/g,'').replace(',','.')),months=Number(term.value),rate=Number(term.options[term.selectedIndex].dataset.rate);if(!Number.isFinite(principal)||principal<500||principal>500000){preview.textContent='Kwota lokaty: 500–500 000 zł.';return;}const interest=principal*(rate/100)*(months/12);const payout=principal+interest;preview.textContent='Odsetki: '+interest.toLocaleString(locale,{minimumFractionDigits:2,maximumFractionDigits:2})+unit+' · Payout: '+payout.toLocaleString(locale,{minimumFractionDigits:2,maximumFractionDigits:2})+unit;}[amount,term].forEach(el=>el.addEventListener('input',update));if(amount.value)update();})();</script>
        """, user=user, values=values, deposits=deposit_rows, offers=DEPOSIT_OFFERS,
        active_total=active_total, expected_total=expected_total)


@app.post('/deposits/<int:deposit_id>/close')
@login_required
def close_deposit(deposit_id):
    if not valid_csrf():
        abort(400)
    db = get_db()
    deposit = db.execute(
        "SELECT * FROM term_deposits WHERE id = ? AND user_id = ? AND status = 'active'",
        (deposit_id, session['user_id']),
    ).fetchone()
    if deposit is None:
        abort(404)
    matured = date.today() >= date.fromisoformat(deposit['maturity_date'])
    interest = deposit['expected_interest_cents'] if matured else 0
    payout = deposit['principal_cents'] + interest
    status = 'completed' if matured else 'broken'
    stamp = now_iso()
    try:
        db.execute('BEGIN IMMEDIATE')
        changed = db.execute(
            """UPDATE term_deposits SET status = ?, closed_at = ?,
            paid_interest_cents = ?, payout_cents = ?
            WHERE id = ? AND user_id = ? AND status = 'active'""",
            (status, stamp, interest, payout, deposit_id, session['user_id']),
        )
        if changed.rowcount != 1:
            raise ValueError('Lokata została już zakończona.')
        db.execute('UPDATE users SET balance_cents = balance_cents + ? WHERE id = ?', (payout, session['user_id']))
        db.execute(
            """INSERT INTO transactions
            (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
            VALUES (?, 'credit', ?, ?, 'NovaBank Lokaty', 'LOKATA', ?)""",
            (session['user_id'], payout, f"Wypłata lokaty LK-{deposit_id:06d}", stamp),
        )
        if matured:
            add_notification(session['user_id'], 'Lokata zakończona', f"Wypłacono {money(payout)}, w tym {money(interest)} odsetek.", 'success')
        else:
            add_notification(session['user_id'], 'Lokata zerwana przed terminem', f"Na rachunek wrócił kapitał {money(payout)}. Odsetki nie zostały naliczone.", 'warning')
        db.commit()
    except (sqlite3.Error, ValueError) as exc:
        db.rollback()
        flash(str(exc), 'error')
    else:
        flash('Lokata została zakończona.' if matured else 'Lokata została zerwana, a kapitał wrócił na rachunek.', 'success')
    return redirect(url_for('deposits'))


