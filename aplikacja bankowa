    return redirect(url_for('vault',pocket_id=pocket_id))


def vault_savings_chart(pocket, month):
    today=datetime.now(ZoneInfo('Europe/Warsaw')).date()
    try:
        start=date.fromisoformat(month+'-01')
        if start.year<1900 or start>today.replace(day=1):
            raise ValueError
    except (ValueError,TypeError):
        start=today.replace(day=1)
    last=today.day if start==today.replace(day=1) else calendar.monthrange(start.year,start.month)[1]
    operations=get_db().execute('SELECT * FROM vault_operations WHERE pocket_id=? AND user_id=? ORDER BY created_at,id',(pocket['id'],pocket['user_id'])).fetchall()
    balance=pocket['balance_cents']-sum(o['amount_cents']*(1 if o['kind']=='deposit' else -1) for o in operations)
    days={i:{'day':i,'date':start.replace(day=i).isoformat(),'deposit':0,'withdraw':0} for i in range(1,last+1)}
    for op in operations:
        stamp=datetime.fromisoformat(op['created_at'])
        if stamp.tzinfo is None:
            stamp=stamp.replace(tzinfo=timezone.utc)
        day=stamp.astimezone(ZoneInfo('Europe/Warsaw')).date()
        if day<start:
            balance+=op['amount_cents']*(1 if op['kind']=='deposit' else -1)
        elif day.year==start.year and day.month==start.month and day.day<=last:
            days[day.day][op['kind']]+=op['amount_cents']
    rows=[{'day':0,'date':start.isoformat(),'deposit':0,'withdraw':0,'balance':balance}]
    for row in days.values():
        balance+=row['deposit']-row['withdraw'];rows.append({**row,'balance':balance})
    low=min(0,min(r['balance'] for r in rows)); high=max(100,max(r['balance'] for r in rows))
    for i,row in enumerate(rows):
        row['x']=round(30+700*i/(len(rows)-1),2)
        row['y']=round(190-(row['balance']-low)*155/max(1,high-low),2)
    return {'rows':rows,'points':' '.join(f"{r['x']},{r['y']}" for r in rows),
            'month':start.strftime('%Y-%m'),'max_month':today.strftime('%Y-%m'),
            'income':sum(r['deposit'] for r in rows),'outgo':sum(r['withdraw'] for r in rows),
            'opening':rows[0]['balance'],'closing':rows[-1]['balance'],'high':high,'low':low}


def vault_next_due(day, frequency):
    return day + timedelta(days=1 if frequency == 'daily' else 7) if frequency in ('daily', 'weekly') else next_month(day)


def vault_transfer(db, user_id, pocket_id, kind, amount, nonce):
    pocket = db.execute('SELECT * FROM vault_pockets WHERE id=? AND user_id=?', (pocket_id,user_id)).fetchone()
    if pocket is None:
        raise ValueError('Przegródka nie jest dostępna.')
    if kind == 'deposit':
        changed=db.execute('UPDATE users SET balance_cents=balance_cents-? WHERE id=? AND balance_cents>=?',(amount,user_id,amount))
        if changed.rowcount != 1:
            raise ValueError('Brak wystarczających środków na rachunku.')
        db.execute('UPDATE vault_pockets SET balance_cents=balance_cents+? WHERE id=?',(amount,pocket_id))
        db.execute('UPDATE vault_accounts SET balance_cents=balance_cents+? WHERE user_id=?',(amount,user_id))
    else:
        changed=db.execute('UPDATE vault_pockets SET balance_cents=balance_cents-? WHERE id=? AND balance_cents>=?',(amount,pocket_id,amount))
        if changed.rowcount != 1:
            raise ValueError('Brak wystarczających środków w tej przegródce.')
        db.execute('UPDATE vault_accounts SET balance_cents=balance_cents-? WHERE user_id=?',(amount,user_id))
        db.execute('UPDATE users SET balance_cents=balance_cents+? WHERE id=?',(amount,user_id))
    balance=pocket['balance_cents'] + (amount if kind=='deposit' else -amount)
    stamp=now_iso()
    op=db.execute('''INSERT INTO vault_operations(user_id,pocket_id,kind,amount_cents,balance_after,request_token,created_at)
        VALUES(?,?,?,?,?,?,?)''',(user_id,pocket_id,kind,amount,balance,nonce,stamp))
    db.execute('''INSERT INTO transactions(user_id,kind,amount_cents,title,counterparty,counterparty_account,created_at)
        VALUES(?,?,?,?, 'Skarbiec NovaBank','SKARBIEC',?)''',
        (user_id,'debit' if kind=='deposit' else 'credit',amount,
         ('Wpłata do skarbca: ' if kind=='deposit' else 'Wypłata ze skarbca: ')+pocket['name'],stamp))
    return op.lastrowid


def process_due_vault_savings(user_id):
    db=get_db()
    today=datetime.now(ZoneInfo('Europe/Warsaw')).date()
    pockets=db.execute('SELECT id FROM vault_pockets WHERE user_id=? AND auto_active=1 AND next_due<=?',(user_id,today.isoformat())).fetchall()
    for item in pockets:
        for _ in range(60):
            try:
                db.execute('BEGIN IMMEDIATE')
                p=db.execute('SELECT * FROM vault_pockets WHERE id=? AND user_id=?',(item['id'],user_id)).fetchone()
                if not p or not p['auto_active'] or not p['next_due'] or p['next_due']>today.isoformat():
                    db.rollback(); break
                due=date.fromisoformat(p['next_due'])
                exists=db.execute('SELECT 1 FROM vault_auto_runs WHERE pocket_id=? AND due_date=?',(p['id'],p['next_due'])).fetchone()
                status='completed'
                if not exists:
                    try:
                        vault_transfer(db,user_id,p['id'],'deposit',p['auto_amount'],f"vault-auto-{p['id']}-{p['next_due']}")
                    except ValueError:
                        status='skipped'
                        add_notification(user_id,'Wpłata do skarbca pominięta',f"Brak środków na {money(p['auto_amount'])} do przegródki {p['name']}.",'warning')
                    db.execute('INSERT INTO vault_auto_runs VALUES(?,?,?,?)',(p['id'],p['next_due'],status,p['auto_amount']))
                db.execute('UPDATE vault_pockets SET next_due=? WHERE id=?',(vault_next_due(due,p['frequency']).isoformat(),p['id']))
                db.commit()
            except sqlite3.Error:
                db.rollback(); app.logger.exception('Automatyczna wpłata do skarbca'); break


