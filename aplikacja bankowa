        <div class="panel panel-pad"><div class="card-flip payment-visa-preview {{ 'is-locked' if card.locked }}" data-theme="{{ card_theme }}" data-testid="payment-visa-preview"><div class="real-card visa-front {{ 'has-photo' if photo_row }}">{% if photo_row %}<img class="card-photo-layer" src="{{ url_for('card_background', v=photo_row.updated_at) }}" alt="" aria-hidden="true"><span class="card-photo-shade" aria-hidden="true"></span>{% endif %}<div class="card-topline"><div><div class="card-bank-name">NovaBank</div><span class="card-demo-label">DEMO</span></div><div class="visa-wordmark">VISA</div></div><div class="chip-row"><span class="real-chip" aria-label="Chip karty"></span><span class="contactless" aria-hidden="true">)))</span></div><div class="real-card-number">•••• •••• •••• {{ card_last_four }}</div><div class="card-data"><div><small>POSIADACZ KARTY</small><strong>{{ user.first_name }} {{ user.last_name }}</strong></div><div><small>TYP</small><strong>DEBIT</strong></div></div>{% if card.locked %}<div class="card-lock-label"><span class="lock-icon" aria-hidden="true">🔒</span>ZABLOKOWANA</div>{% endif %}</div></div><h3>Dzisiejsze limity</h3>{% for value,label in labels.items() %}<div class="feature" style="margin-bottom:12px" data-testid="card-limit-{{ value }}"><strong>{{ label }}</strong><br>Wykorzystano: {{ usage[value].used|money }}<br><span class="muted">Pozostało {{ usage[value].remaining|money }} z {{ usage[value].limit|money }}</span></div>{% endfor %}<a class="btn secondary" href="{{ url_for('cards') }}">Moja karta i limity</a></div></section>
