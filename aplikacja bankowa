def wallet_card_payment():
    if not valid_csrf(): abort(400)
    db=get_db();uid=session['user_id'];currency=request.form.get('currency','')
    try:
        token=request.form.get('wallet_token','')
        payload=wallet_decode(token,'card')
        confirmed=request.form.get('wallet_confirmation')=='1'
        if confirmed:
            currency=wallet_currency(payload.get('currency'),card=True)
            amount=int(payload['amount']);kind=payload['operation_type'];merchant=payload['merchant']
            equivalent=int(payload['pln_equivalent']);rate=Decimal(payload['rate']);rate_date=payload['rate_date']
            rate_checked_at=payload.get('rate_checked_at','');rate_offline=bool(payload.get('rate_offline'))
            if (amount<=0 or kind not in CARD_OPERATION_LABELS or not merchant or
                    not rate.is_finite() or rate<=0 or equivalent<=0):
                raise ValueError('Podsumowanie płatności jest nieprawidłowe. Rozpocznij ponownie.')
        else:
            currency=wallet_currency(currency,card=True);amount=wallet_amount(request.form.get('amount'),currency)
            kind=request.form.get('operation_type');merchant=request.form.get('merchant','').strip()
            if kind not in CARD_OPERATION_LABELS: raise ValueError('Wybierz poprawny rodzaj operacji.')
            if not merchant or len(merchant)>120: raise ValueError('Podaj sklep lub lokalizację bankomatu (maks. 120 znaków).')
            snapshot=nbp_snapshot(refresh=False)
            pair=snapshot['rates'].get(currency)
            if not pair or not snapshot['available']:
                raise ValueError('Brak zapisanego kursu NBP do podglądu płatności. Otwórz kantor i odśwież kursy.')
            rate=(pair[0]+pair[1])/2
            equivalent=int((Decimal(amount)*rate).quantize(Decimal('1'),rounding=ROUND_HALF_UP))
            rate_date=snapshot['date']
            rate_checked_at=snapshot['checked_at'] or ''
            rate_offline=snapshot['offline']
        currency_limits=get_wallet_currency_limits(uid)
        db.execute('INSERT OR IGNORE INTO card_settings(user_id) VALUES (?)',(uid,))
        card=db.execute('SELECT * FROM card_settings WHERE user_id=?',(uid,)).fetchone()
        column={'store':'payment_limit','online':'online_limit','atm':'atm_limit'}[kind]
        used=db.execute("""SELECT COALESCE(SUM(COALESCE(pln_equivalent_cents,amount_cents)),0) FROM card_payments
            WHERE user_id=? AND operation_type=? AND status='approved' AND substr(created_at,1,10)=?""",(uid,kind,date.today().isoformat())).fetchone()[0]
        rejection=None
        if card['locked']: rejection='Karta jest zablokowana.'
        elif kind=='online' and not card['online_enabled']: rejection='Płatności internetowe są wyłączone w ustawieniach karty.'
        elif kind=='atm' and not card['atm_enabled']: rejection='Wypłaty z bankomatu są wyłączone w ustawieniach karty.'
        elif kind=='store' and not card['contactless_enabled']: rejection='Płatności zbliżeniowe w sklepach są wyłączone w ustawieniach karty.'
        elif used+equivalent>card[column]: rejection='Przekroczono dzienny limit karty w przeliczeniu na PLN.'
        elif wallet_currency_usage(uid,currency,'card')+amount>currency_limits[currency]['card_daily_limit_cents']: rejection='Przekroczono dzienny limit płatności w '+currency+'.'
        elif wallet_balance(uid,currency)<amount: rejection='Brak środków w portfelu '+currency+'.'

        if not confirmed and not rejection:
            signed_confirmation=wallet_token('card',currency=currency,amount=amount,
                operation_type=kind,merchant=merchant,pln_equivalent=equivalent,
                rate=str(rate),rate_date=rate_date,rate_checked_at=rate_checked_at,rate_offline=rate_offline)
            balance_before=wallet_balance(uid,currency)
            currency_limit=currency_limits[currency]['card_daily_limit_cents']
            currency_used=wallet_currency_usage(uid,currency,'card')
            fx_label=CARD_OPERATION_LABELS[kind]
            return page('Potwierdź płatność kartą',r'''<section class="auth panel panel-pad" data-testid="wallet-card-confirmation"><div class="eyebrow">Podsumowanie operacji</div><h2>Potwierdź {{ operation_label|lower }}</h2><p>Sklep / miejsce: <strong>{{ merchant }}</strong></p><p>Kwota pobierana z portfela: <strong data-testid="card-confirm-amount">{{ amount|wallet_money(currency) }}</strong></p><p>Opłata: <strong>0,00 {{ currency }}</strong></p><p>Kurs orientacyjny NBP (średni): <strong>{{ rate }} PLN</strong> za 1 {{ currency }} · tabela z {{ rate_date }} · sprawdzono {{ rate_checked_at|date_pl if rate_checked_at else 'brak czasu sprawdzenia' }}.</p>{% if rate_offline %}<div class="flash warning">NBP jest chwilowo niedostępne; pokazany kurs pochodzi z ostatniej zapisanej tabeli.</div>{% endif %}<p class="muted">Kurs służy tylko do przeliczenia limitu karty. Sama płatność nie przewalutowuje środków.</p><p>Równowartość do limitu karty: {{ equivalent|money }}</p><p class="muted">Kwota rozliczana w PLN jest zaokrąglana do grosza metodą połówki w górę; płatność pobiera dokładnie kwotę pokazaną powyżej w {{ currency }}.</p><div class="demo-box" data-testid="card-currency-balance-preview">Saldo {{ currency }} przed: {{ balance_before|wallet_money(currency) }} · po operacji: <strong>{{ (balance_before-amount)|wallet_money(currency) }}</strong><br>Pozostały dzienny limit {{ currency }}: {{ (currency_limit-currency_used-amount)|wallet_money(currency) }}</div><p class="muted">Podsumowanie ważne 30 minut. Saldo i limity zostaną sprawdzone ponownie przed płatnością.</p><form method="post" data-testid="wallet-card-confirm-form"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="wallet_confirmation" value="1"><input type="hidden" name="currency" value="{{ currency }}"><input type="hidden" name="wallet_token" value="{{ confirmation }}"><button class="btn" data-testid="confirm-wallet-card-payment">Potwierdzam i płacę</button></form><a class="btn secondary" href="{{ url_for('card_payments',currency=currency) }}">Anuluj</a></section>''',operation_label=fx_label,merchant=merchant,amount=amount,currency=currency,rate=rate,rate_date=rate_date,rate_checked_at=rate_checked_at,rate_offline=rate_offline,equivalent=equivalent,balance_before=balance_before,currency_limit=currency_limit,currency_used=currency_used,confirmation=signed_confirmation)

        db.execute('BEGIN IMMEDIATE');wallet_claim(token,'card')
        # Ponownie odczytaj saldo i bieżące zużycie limitów po rozpoczęciu transakcji.
        card=db.execute('SELECT * FROM card_settings WHERE user_id=?',(uid,)).fetchone()
        used=db.execute("""SELECT COALESCE(SUM(COALESCE(pln_equivalent_cents,amount_cents)),0) FROM card_payments
            WHERE user_id=? AND operation_type=? AND status='approved' AND substr(created_at,1,10)=?""",(uid,kind,date.today().isoformat())).fetchone()[0]
        live_currency_used=wallet_currency_usage(uid,currency,'card')
        live_currency_limit=db.execute('SELECT card_daily_limit_cents FROM wallet_currency_limits WHERE user_id=? AND currency=?',(uid,currency)).fetchone()[0]
        if not rejection and used+equivalent>card[column]: rejection='Przekroczono aktualny limit karty w przeliczeniu na PLN.'
        if not rejection and live_currency_used+amount>live_currency_limit: rejection='Przekroczono aktualny dzienny limit płatności w '+currency+'.'
        if not rejection and wallet_balance(uid,currency)<amount: rejection='Brak wystarczających środków w portfelu '+currency+'.'
        if not rejection: wallet_change(uid,currency,-amount)
        payment=db.execute('''INSERT INTO card_payments(user_id,operation_type,merchant,amount_cents,status,rejection_reason,currency,pln_equivalent_cents,created_at)
            VALUES (?,?,?,?,?,?,?,?,?)''',(uid,kind,merchant,amount,'rejected' if rejection else 'approved',rejection,currency,equivalent,now_iso()))
        reference=f'KP-{payment.lastrowid:06d}'
        wallet_log(uid,currency,'card','none' if rejection else 'debit',amount,
            CARD_OPERATION_LABELS[kind]+(' — '+rejection if rejection else ''),merchant,reference,
            status='rejected' if rejection else 'approved',payment_id=payment.lastrowid,pln=equivalent)
        add_notification(
            uid,
            'Odrzucona płatność kartą' if rejection else 'Płatność kartą zaakceptowana',
            f"{CARD_OPERATION_LABELS[kind]} na {wallet_money(amount, currency)} — {merchant}. "
            + (f"Powód: {rejection}" if rejection else "Płatność została rozliczona z portfela walutowego."),
            'warning' if rejection else 'success',
            operation_type='card_payment', operation_reference=reference,
            counterparty=merchant,
        )
        db.commit()
        flash(rejection or 'Z portfela pobrano '+wallet_money(amount,currency)+'.','error' if rejection else 'success')
        return redirect(url_for('card_payments',payment=payment.lastrowid,currency=currency))
    except (ValueError,sqlite3.Error) as exc:
        db.rollback();flash(str(exc) if isinstance(exc,ValueError) else 'Operacja nie powiodła się. Saldo nie zostało zmienione.','error')
        return redirect(url_for('card_payments',currency=currency if currency in EXCHANGE_CURRENCIES else 'EUR'))


def wallet_card_refund(payment):
    db=get_db();uid=session['user_id'];currency=payment['currency'];amount=payment['amount_cents']
    try:
        db.execute('BEGIN IMMEDIATE')
        changed=db.execute("UPDATE card_payments SET status='refunded',refunded_at=? WHERE id=? AND user_id=? AND status='approved'",(now_iso(),payment['id'],uid))
        if changed.rowcount!=1: raise ValueError('Ta płatność została już zwrócona albo była odrzucona.')
        wallet_change(uid,currency,amount)
        wallet_log(uid,currency,'refund','credit',amount,'Zwrot płatności kartą',payment['merchant'],f"ZW-KP-{payment['id']:06d}",payment_id=payment['id'])
        add_notification(
            uid, 'Zwrot płatności kartą',
            f"Na portfel {currency} wróciło {wallet_money(amount, currency)} ze sklepu {payment['merchant']}.",
            'success', operation_type='card_refund',
            operation_reference=f"ZW-KP-{payment['id']:06d}", counterparty=payment['merchant'],
        )
        db.commit();flash('Do portfela wróciło '+wallet_money(amount,currency)+'.','success')
    except (ValueError,sqlite3.Error) as exc:
        db.rollback();flash(str(exc) if isinstance(exc,ValueError) else 'Nie udało się wykonać zwrotu.','error')
    return redirect(url_for('card_payments',currency=currency,payment=payment['id']))


