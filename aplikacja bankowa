            currency=wallet_currency(request.form.get('currency'))
            name=request.form.get('name','').strip();target=wallet_amount(request.form.get('target'),currency)
            deadline=request.form.get('deadline','').strip()
            if not name or len(name)>100: raise ValueError('Podaj nazwę celu (maksymalnie 100 znaków).')
            if deadline and date.fromisoformat(deadline)<date.today(): raise ValueError('Termin celu nie może być w przeszłości.')
            db.execute('BEGIN IMMEDIATE');wallet_claim(request.form.get('wallet_token',''),'goal-create')
            db.execute('INSERT INTO wallet_goals(user_id,currency,name,target_cents,deadline,created_at) VALUES (?,?,?,?,?,?)',(uid,currency,name,target,deadline or None,now_iso()))
            db.commit();flash('Cel walutowy został utworzony.','success')
            return redirect(url_for('wallet_goals',currency=currency))
