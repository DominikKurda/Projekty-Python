@app.post('/qa/generate-data')
@login_required
def qa_generate_data():
    if not valid_csrf():
        abort(400)
    db = get_db()
    user_id = session['user_id']
    existing = db.execute(
        "SELECT 1 FROM qa_generated_records WHERE user_id = ? LIMIT 1", (user_id,)
    ).fetchone()
    if existing:
        flash('Dane QA już istnieją. Najpierw użyj „Przywróć dane QA”.', 'info')
        return redirect(url_for('qa_mode'))
    # Suma wpływów i wydatków jest identyczna, więc saldo końcowe pozostaje bez zmian.
    samples = [
        (12, 'credit', 500000, 'Wynagrodzenie QA', 'Nova Software'),
        (10, 'debit', 12500, 'Zakupy spożywcze QA', 'Nova Market'),
        (8, 'debit', 28000, 'Paliwo QA', 'Stacja Testowa'),
        (6, 'credit', 4500, 'Zwrot za zakupy QA', 'Sklep Internetowy'),
        (5, 'debit', 4999, 'Subskrypcja QA', 'StreamTest'),
        (3, 'credit', 15500, 'Przelew przychodzący QA', 'Klient Testowy'),
        (2, 'debit', 8501, 'Restauracja QA', 'Bistro Automat'),
        (1, 'debit', 466000, 'Sprzęt komputerowy QA', 'Tech Demo'),
    ]
    try:
        db.execute('BEGIN IMMEDIATE')
        for days, kind, amount, title, counterparty in samples:
            stamp = (datetime.now(timezone.utc) - timedelta(days=days)).isoformat(timespec='seconds')
            cursor = db.execute(
                """INSERT INTO transactions
                (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
                VALUES (?, ?, ?, ?, ?, 'QA-DEMO', ?)""",
                (user_id, kind, amount, title, counterparty, stamp),
            )
            qa_track('transaction', cursor.lastrowid)
        for operation_type, merchant, amount, status, reason in [
            ('store', 'Sklep QA', 12999, 'approved', None),
            ('online', 'Demo E-commerce', 24900, 'rejected', 'Przekroczony limit internetowy'),
            ('atm', 'Bankomat QA', 10000, 'refunded', None),
        ]:
            cursor = db.execute(
                """INSERT INTO card_payments
                (user_id, operation_type, merchant, amount_cents, status,
                 rejection_reason, created_at, refunded_at)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
                (user_id, operation_type, merchant, amount, status, reason,
                 now_iso(), now_iso() if status == 'refunded' else None),
            )
            qa_track('card_payment', cursor.lastrowid)
        for title, message, kind in [
            ('Dane testowe gotowe', 'Generator utworzył przykładową historię operacji.', 'success'),
            ('Test limitu karty', 'Przykładowa płatność została odrzucona.', 'warning'),
            ('Raport QA', 'Możesz teraz uruchomić scenariusze testowe.', 'info'),
        ]:
            notification_id = add_notification(user_id, title, message, kind)
            qa_track('notification', notification_id)
        qa_log('Generator danych', 'passed', 201, 'Utworzono 8 transakcji, 3 płatności kartą i 3 powiadomienia.')
        db.commit()
    except sqlite3.Error:
        db.rollback()
        app.logger.exception('Nie udało się wygenerować danych QA')
        flash('Nie udało się wygenerować danych QA.', 'error')
    else:
        flash('Zestaw danych QA został wygenerowany. Saldo końcowe nie uległo zmianie.', 'success')
    return redirect(url_for('qa_mode'))


@app.post('/qa/run')
@login_required
def qa_run_scenario():
    if not valid_csrf():
        abort(400)
    code = request.form.get('scenario', '')
    scenario = QA_SCENARIOS.get(code)
    if scenario is None:
        abort(400)
    label, result, http_status, details = scenario
    db = get_db()
    try:
        db.execute('BEGIN IMMEDIATE')
        if code in ('card_approved', 'card_rejected'):
            approved = code == 'card_approved'
            cursor = db.execute(
                """INSERT INTO card_payments
                (user_id, operation_type, merchant, amount_cents, status,
                 rejection_reason, created_at)
                VALUES (?, 'online', 'Scenariusz QA', 19900, ?, ?, ?)""",
                (session['user_id'], 'approved' if approved else 'rejected',
                 None if approved else 'Symulacja przekroczenia limitu', now_iso()),
            )
            qa_track('card_payment', cursor.lastrowid)
        if code == 'suspicious_operation':
            notification_id = add_notification(
                session['user_id'], 'Podejrzana operacja wykryta',
                'Tryb QA oznaczył nietypową płatność 9 999,00 zł. Sprawdź szczegóły operacji.',
                'warning',
            )
            qa_track('notification', notification_id)
        run_id = qa_log(label, result, http_status, details)
        db.commit()
    except sqlite3.Error:
        db.rollback()
        flash('Nie udało się uruchomić scenariusza.', 'error')
    else:
        flash(f'Scenariusz QA-{run_id:05d} został zapisany w dzienniku.', 'success')
    return redirect(url_for('qa_mode'))


@app.post('/qa/reset-data')
@login_required
def qa_reset_data():
    if not valid_csrf():
        abort(400)
    db = get_db()
    user_id = session['user_id']
    records = db.execute(
        "SELECT entity_type, entity_id FROM qa_generated_records WHERE user_id = ?",
        (user_id,),
    ).fetchall()
    tables = {'transaction': 'transactions', 'notification': 'notifications',
              'card_payment': 'card_payments'}
    try:
        db.execute('BEGIN IMMEDIATE')
        for item in records:
            db.execute(
                f"DELETE FROM {tables[item['entity_type']]} WHERE id = ? AND user_id = ?",
                (item['entity_id'], user_id),
            )
        db.execute('DELETE FROM qa_generated_records WHERE user_id = ?', (user_id,))
        qa_log('Przywrócenie danych QA', 'passed', 200,
               f'Usunięto {len(records)} rekordów wygenerowanych przez moduł QA.')
        db.commit()
    except sqlite3.Error:
        db.rollback()
        flash('Nie udało się przywrócić danych QA.', 'error')
    else:
        flash(f'Usunięto {len(records)} rekordów QA. Pozostałe dane konta są bez zmian.', 'success')
    return redirect(url_for('qa_mode'))


