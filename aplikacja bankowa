def nbp_json(path):
    # Only a fixed official HTTPS host is used; no account data is sent.
    req = Request('https://api.nbp.pl/api/exchangerates/' + path + '?format=json',
                  headers={'Accept': 'application/json', 'User-Agent': 'NovaBank/1.0'})
    with urlopen(req, timeout=8) as response:
        raw = response.read(2_000_001)
    if len(raw) > 2_000_000:
        raise ValueError('Zbyt duża odpowiedź NBP')
    return json.loads(raw, parse_float=Decimal)


def nbp_meta(key):
    row = get_db().execute('SELECT * FROM nbp_cache_meta WHERE cache_key=?', (key,)).fetchone()
    return dict(row) if row else None


def nbp_refresh_due(key, seconds):
    meta = nbp_meta(key)
    return not meta or (datetime.now(timezone.utc) - datetime.fromisoformat(meta['attempted_at'])).total_seconds() >= seconds


def nbp_set_meta(key, state):
    get_db().execute('INSERT INTO nbp_cache_meta(cache_key,attempted_at,state) VALUES (?,?,?) ON CONFLICT(cache_key) DO UPDATE SET attempted_at=excluded.attempted_at,state=excluded.state',
                     (key, now_iso(), state))
    get_db().commit()


def nbp_parse_tables(payload, require_complete=False, table_type='C', currencies=None):
    if not isinstance(payload, list) or not payload:
        raise ValueError('Brak tabel NBP')
    allowed = set(currencies or (NBP_TABLE_C_CURRENCIES if table_type == 'C' else NBP_TABLE_A_CURRENCIES))
    points = []
    for table in payload:
        if not isinstance(table, dict) or table.get('table') != table_type:
            raise ValueError('Niepoprawna tabela NBP')
        effective = date.fromisoformat(table['effectiveDate']).isoformat()
        trading = date.fromisoformat(table.get('tradingDate', table['effectiveDate'])).isoformat()
        number = str(table['no'])[:80]
        codes = set()
        for item in table['rates']:
            if not isinstance(item, dict):
                raise ValueError('Niepoprawna odpowiedź NBP')
            code = item['code']
            if code not in allowed:
                continue
            if table_type == 'C':
                bid, ask = Decimal(str(item['bid'])), Decimal(str(item['ask']))
            else:
                mid = Decimal(str(item['mid']))
                if not mid.is_finite() or not Decimal('0') < mid <= Decimal('1000'):
                    raise ValueError('Niepoprawny kurs średni NBP')
                # Tabela A nie zawiera kursów kupna i sprzedaży. Dla walut
                # UAH/CNY pokazujemy więc jawnie kurs demonstracyjny ±1%.
                bid = (mid * (Decimal('1') - NBP_A_DEMO_SPREAD)).quantize(Decimal('.000001'), rounding=ROUND_HALF_UP)
                ask = (mid * (Decimal('1') + NBP_A_DEMO_SPREAD)).quantize(Decimal('.000001'), rounding=ROUND_HALF_UP)
            if not bid.is_finite() or not ask.is_finite() or not Decimal('0') < bid <= ask <= Decimal('1000'):
                raise ValueError('Niepoprawny kurs NBP')
            if bid != bid.quantize(Decimal('.000001')) or ask != ask.quantize(Decimal('.000001')):
                raise ValueError('Niepoprawna precyzja kursu NBP')
            points.append((code, effective, trading, number, str(bid), str(ask)))
            codes.add(code)
        if require_complete and codes != allowed:
            raise ValueError('Niepełna tabela NBP')
    return points


def nbp_store_points(points):
    get_db().executemany('INSERT INTO nbp_rate_points(currency,effective_date,trading_date,table_no,bid,ask) VALUES (?,?,?,?,?,?) ON CONFLICT(currency,effective_date) DO UPDATE SET trading_date=excluded.trading_date,table_no=excluded.table_no,bid=excluded.bid,ask=excluded.ask', points)
    get_db().commit()


def nbp_snapshot(refresh=True):
    if hasattr(g, 'nbp_snapshot'):
        return g.nbp_snapshot
    if refresh and nbp_refresh_due('latest', 900):
        # Record the attempt before I/O, so an outage does not block every page.
        nbp_set_meta('latest', 'checking')
        try:
            for table_type, currencies in (('C', NBP_TABLE_C_CURRENCIES), ('A', NBP_TABLE_A_CURRENCIES)):
                points = nbp_parse_tables(nbp_json(f'tables/{table_type.lower()}/'), require_complete=True,
                                          table_type=table_type, currencies=currencies)
                nbp_store_points(points)
                latest_date = max(point[1] for point in points)
                current_points = [point for point in points if point[1] == latest_date]
                get_db().executemany('INSERT INTO nbp_current_rates(currency,effective_date,trading_date,table_no,bid,ask) VALUES (?,?,?,?,?,?) ON CONFLICT(currency) DO UPDATE SET effective_date=excluded.effective_date,trading_date=excluded.trading_date,table_no=excluded.table_no,bid=excluded.bid,ask=excluded.ask',
                                     current_points)
                get_db().commit()
        except (OSError, ValueError, KeyError, TypeError, InvalidOperation):
            nbp_set_meta('latest', 'error')
            app.logger.warning('Nie udało się odświeżyć kursów NBP; użycie zapisanych danych, jeśli dostępne.')
        else:
            nbp_set_meta('latest', 'ok')
    rows = get_db().execute('SELECT * FROM nbp_current_rates').fetchall()
    rates = {r['currency']: (Decimal(r['bid']), Decimal(r['ask'])) for r in rows}
    currency_meta = {r['currency']: {'date': r['effective_date'], 'trading_date': r['trading_date'],
                                     'table_no': r['table_no']} for r in rows}
    meta = nbp_meta('latest')
    g.nbp_snapshot = {'rates': rates, 'available': bool(rates),
                      'date': max((r['effective_date'] for r in rows), default=None),
                      'table_no': next((r['table_no'] for r in rows if r['currency'] == 'EUR'), None),
                      'currency_meta': currency_meta,
                      'checked_at': meta['attempted_at'] if meta else None,
                      'offline': not meta or meta['state'] != 'ok'}
    return g.nbp_snapshot


def nbp_exchange_history():
    today = datetime.now(ZoneInfo('Europe/Warsaw')).date()
    start = today - timedelta(days=364)
    history_meta = nbp_meta('history')
    if nbp_refresh_due('history', 86400 if history_meta and history_meta['state'] == 'ok' else 900):
        nbp_set_meta('history', 'checking')
        try:
            current = start
            while current <= today:
                end = min(today, current + timedelta(days=92))
                for table_type, currencies in (('C', NBP_TABLE_C_CURRENCIES), ('A', NBP_TABLE_A_CURRENCIES)):
                    path = f'tables/{table_type.lower()}/{current.isoformat()}/{end.isoformat()}/'
                    nbp_store_points(nbp_parse_tables(nbp_json(path), table_type=table_type, currencies=currencies))
                current = end + timedelta(days=1)
        except (OSError, ValueError, KeyError, TypeError, InvalidOperation):
            nbp_set_meta('history', 'error')
            app.logger.warning('Nie udało się pobrać pełnej historii NBP; wykres pokazuje dostępne zapisane notowania.')
        else:
            nbp_set_meta('history', 'ok')
    history = {code: [] for code in EXCHANGE_CURRENCIES}
    for row in get_db().execute('SELECT * FROM nbp_rate_points WHERE effective_date>=? AND effective_date<=? ORDER BY effective_date', (start.isoformat(), today.isoformat())):
        history[row['currency']].append({'date': row['effective_date'], 'buy': float(row['ask']), 'sell': float(row['bid'])})
    return history


def process_exchange_alerts(user_id):
    db = get_db()
    pending = db.execute("SELECT * FROM exchange_alerts WHERE user_id=? AND status='active'", (user_id,)).fetchall()
    if not pending:
        return
    snapshot = nbp_snapshot()
    # Do not fire a new alert from a cache whose current validity could not be checked.
    if not snapshot['available'] or snapshot['offline']:
        return
    for alert in pending:
        if alert['currency'] not in snapshot['rates']:
            continue
        rate = snapshot['rates'][alert['currency']][1 if alert['direction'] == 'buy' else 0]
        target = Decimal(alert['target_rate'])
        reached = rate <= target if alert['comparison'] == 'below' else rate >= target
        if not reached:
            continue
        try:
            db.execute('BEGIN IMMEDIATE')
            alert_date = snapshot.get('currency_meta', {}).get(alert['currency'], {}).get('date', snapshot['date'])
            changed = db.execute("UPDATE exchange_alerts SET status='triggered',triggered_at=?,triggered_rate=?,triggered_rate_date=? WHERE id=? AND user_id=? AND status='active'",
                                 (now_iso(), str(rate), alert_date, alert['id'], user_id))
            if changed.rowcount == 1:
                source_note = ('kurs demonstracyjny oparty na średnim NBP, marża ±1%' if alert['currency'] in NBP_TABLE_A_CURRENCIES
                               else 'kurs kupna/sprzedaży z tabeli C NBP')
                message = f"{alert['currency']}/PLN: {source_note} {rate} (tabela z {alert_date}) osiągnął ustawiony poziom {target}."
                add_notification(user_id, 'Alert kursowy: cel osiągnięty', message, 'success')
            db.commit()
        except sqlite3.Error:
            db.rollback()
            app.logger.exception('Błąd sprawdzania alertu kursowego')
        else:
            if changed.rowcount == 1:
                flash(message + ' Szczegóły znajdziesz w kantorze.', 'success')


@app.post('/exchange/alerts')
