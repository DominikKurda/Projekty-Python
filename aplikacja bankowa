    for tx in month_rows:
        try:
            stamp = datetime.fromisoformat(tx['created_at'])
            if stamp.tzinfo is None:
                stamp = stamp.replace(tzinfo=timezone.utc)
            local_day = stamp.astimezone(ZoneInfo('Europe/Warsaw')).date()
        except (ValueError, TypeError):
            continue
        if local_day.year != month_start.year or local_day.month != month_start.month or local_day.day > last_day:
