def change_loan_payment_day(loan_id):
    if not valid_csrf():
        abort(400)
    payment_day = request.form.get('payment_day', type=int)
    if payment_day is None or not 1 <= payment_day <= 31:
        flash('Wybierz dzień spłaty od 1. do 31.', 'error')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    db = get_db()
    loan = db.execute(
        "SELECT * FROM loan_applications WHERE id = ? AND user_id = ? AND status = 'approved'",
        (loan_id, session['user_id']),
    ).fetchone()
    if loan is None:
        abort(404)
    ensure_loan_schedule(loan_id)
    db.commit()
    pending = db.execute(
        """SELECT * FROM loan_installments
        WHERE loan_id = ? AND status = 'pending' ORDER BY installment_number""",
        (loan_id,),
    ).fetchall()
    if not pending:
        flash('Kredyt nie ma już rat oczekujących na spłatę.', 'info')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    if any(item['due_date'] < date.today().isoformat() for item in pending):
        flash('Najpierw spłać ratę po terminie. Dopiero potem można zmienić dzień spłaty.', 'error')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    current_due = date.fromisoformat(pending[0]['due_date'])
    month_reference = date(current_due.year, current_due.month, 1)
    first_due = loan_due_date(month_reference, 0, payment_day)
    if first_due <= date.today():
        first_due = loan_due_date(month_reference, 1, payment_day)
    stamp = now_iso()
    try:
        db.execute('BEGIN IMMEDIATE')
        due = first_due
        for item in pending:
            db.execute(
                'UPDATE loan_installments SET due_date = ? WHERE id = ?',
                (due.isoformat(), item['id']),
            )
            due = loan_due_date(due, 1, payment_day)
        db.execute(
            """UPDATE loan_applications SET payment_day = ?, preferred_payment_day = ?
            WHERE id = ?""",
            (min(payment_day, 28), payment_day, loan_id),
        )
        db.execute(
            """INSERT INTO loan_contract_changes
            (loan_id, user_id, change_type, old_value, new_value, details, created_at)
            VALUES (?, ?, 'payment_day', ?, ?, ?, ?)""",
            (loan_id, session['user_id'], str(loan['preferred_payment_day']),
             str(payment_day),
             f"Zmiana dnia spłaty z {loan['preferred_payment_day']} na {payment_day}", stamp),
        )
        add_notification(
            session['user_id'], 'Zmieniono dzień spłaty kredytu',
            f"Kredyt KR-{loan_id:06d}: przyszłe raty przypadają {payment_day}. dnia "
            'miesiąca lub w ostatnim dniu krótszego miesiąca.', 'success',
        )
        db.commit()
    except sqlite3.Error as exc:
        db.rollback()
        flash(f'Nie udało się zmienić dnia spłaty: {exc}', 'error')
    else:
        flash('Dzień spłaty został zmieniony, a harmonogram zaktualizowany.', 'success')
    return redirect(url_for('loan_schedule', loan_id=loan_id))


