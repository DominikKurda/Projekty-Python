                    return redirect(url_for('dashboard'))
                except sqlite3.Error:
                    db.rollback()
                    app.logger.exception('Błąd tworzenia zgody na przelew Junior')
                    flash('Nie udało się przekazać przelewu do akceptacji.', 'error')
                    return redirect(url_for('transfer'))
            try:
                db.execute("BEGIN IMMEDIATE")
                live_limits = db.execute(
                    'SELECT * FROM transfer_limits WHERE user_id = ?', (user['id'],)
                ).fetchone()
                live_daily_used = db.execute(
                    """SELECT COALESCE(SUM(amount_cents), 0) FROM transactions
                    WHERE user_id = ? AND kind = 'debit' AND counterparty_account LIKE 'PL%'
                    AND substr(created_at, 1, 10) = ?""",
                    (user['id'], date.today().isoformat()),
                ).fetchone()[0]
