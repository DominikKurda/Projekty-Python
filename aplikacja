@app.post('/messages/<int:ticket_id>/reply')
@login_required
def ticket_reply(ticket_id):
    if not valid_csrf():
        abort(400)
    db = get_db()
    ticket = db.execute('SELECT * FROM support_tickets WHERE id = ?', (ticket_id,)).fetchone()
    admin = is_admin()
    if ticket is None or (not admin and ticket['user_id'] != session['user_id']):
        abort(404)
    message = request.form.get('message', '').strip()
    if not message or len(message) > 2000:
        flash('Wiadomość musi mieć od 1 do 2000 znaków.', 'error')
        return redirect(url_for('ticket_details', ticket_id=ticket_id))
    if ticket['status'] == 'closed' and not admin:
        flash('To zgłoszenie jest już zamknięte.', 'error')
        return redirect(url_for('ticket_details', ticket_id=ticket_id))
    status = request.form.get('status', ticket['status']) if admin else 'open'
    if status not in TICKET_STATUSES:
        abort(400)
    stamp = now_iso()
    db.execute(
        """INSERT INTO support_messages
        (ticket_id, sender_user_id, sender_role, message, is_read, created_at)
        VALUES (?, ?, ?, ?, 0, ?)""",
        (ticket_id, session['user_id'], 'admin' if admin else 'customer', message, stamp),
    )
    db.execute('UPDATE support_tickets SET status = ?, updated_at = ? WHERE id = ?', (status, stamp, ticket_id))
    if admin:
        add_notification(ticket['user_id'], 'Nowa odpowiedź z banku', f"Odpowiedź w zgłoszeniu #{ticket_id}.", 'info')
        log_admin_action('Odpowiedź na zgłoszenie', 'ticket', ticket_id, f"Status: {status}")
    db.commit()
    flash('Odpowiedź została wysłana.', 'success')
    return redirect(url_for('ticket_details', ticket_id=ticket_id))


