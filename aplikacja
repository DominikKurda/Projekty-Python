FINANCIAL_EVENT_CATEGORIES = {
    'bill': ('Rachunek', '🧾'),
    'income': ('Wpływ', '💰'),
    'reminder': ('Przypomnienie', '🔔'),
    'other': ('Inne', '📌'),
}


def calendar_month(value: str) -> date:
    try:
        selected = datetime.strptime(value, '%Y-%m').date().replace(day=1)
    except (TypeError, ValueError):
        selected = date.today().replace(day=1)
    if not date(2020, 1, 1) <= selected <= date(2100, 12, 1):
        selected = date.today().replace(day=1)
    return selected


def previous_month(value: date) -> date:
    return date(value.year - (1 if value.month == 1 else 0), 12 if value.month == 1 else value.month - 1, 1)


@app.route('/financial-calendar', methods=['GET', 'POST'])
@login_required
def financial_calendar():
    db = get_db()
    user_id = session['user_id']
    selected_month = calendar_month(request.args.get('month', ''))
    if request.method == 'POST':
        values = {key: request.form.get(key, '').strip() for key in ('title', 'event_date', 'amount', 'category')}
        error = None
        try:
            event_date = datetime.strptime(values['event_date'], '%Y-%m-%d').date()
        except ValueError:
            event_date = None
        amount = parse_amount(values['amount']) if values['amount'] else None
        if not valid_csrf():
            error = 'Sesja formularza wygasła. Spróbuj ponownie.'
        elif not values['title'] or len(values['title']) > 120:
            error = 'Podaj nazwę wydarzenia (maksymalnie 120 znaków).'
        elif event_date is None or not date(2020, 1, 1) <= event_date <= date(2100, 12, 31):
            error = 'Podaj poprawną datę wydarzenia.'
        elif values['amount'] and amount is None:
            error = 'Kwota musi być większa od 0 zł albo pozostać pusta.'
        elif values['category'] not in FINANCIAL_EVENT_CATEGORIES:
            error = 'Wybierz poprawny rodzaj wydarzenia.'
        if error:
            flash(error, 'error')
        else:
            db.execute(
                """INSERT INTO financial_events
                (user_id, title, event_date, amount_cents, category, status, created_at)
                VALUES (?, ?, ?, ?, ?, 'planned', ?)""",
                (user_id, values['title'], event_date.isoformat(), amount, values['category'], now_iso()),
            )
            db.commit()
            flash('Wydarzenie zostało dodane do kalendarza.', 'success')
            return redirect(url_for('financial_calendar', month=event_date.strftime('%Y-%m')))

    month_end = next_month(selected_month)
    start_text, end_text = selected_month.isoformat(), month_end.isoformat()
    events: list[dict] = []

    custom_rows = db.execute(
        """SELECT * FROM financial_events WHERE user_id = ?
        AND event_date >= ? AND event_date < ? ORDER BY event_date, id""",
        (user_id, start_text, end_text),
    ).fetchall()
    for row in custom_rows:
        label, icon = FINANCIAL_EVENT_CATEGORIES[row['category']]
        events.append(dict(id=row['id'], date=row['event_date'], title=row['title'],
                           amount=row['amount_cents'], type=row['category'], icon=icon,
                           source=label, custom=True, status=row['status']))

    for row in db.execute(
        """SELECT * FROM scheduled_transfers WHERE user_id = ? AND status IN ('active','paused')
        AND next_execution >= ? AND next_execution < ?""",
        (user_id, start_text, end_text),
    ).fetchall():
        events.append(dict(id=None, date=row['next_execution'], title=row['title'],
