@app.post('/blik/operations/<int:operation_id>/decision')
@login_required
def decide_blik_operation(operation_id):
    if not valid_csrf():
        abort(400)
    decision = request.form.get('decision')
    if decision not in ('approve', 'reject'):
        abort(400)
    db = get_db()
    user = current_user()
    operation = db.execute(
        """SELECT o.*, c.expires_at FROM blik_operations o
        JOIN blik_codes c ON c.id = o.code_id
        WHERE o.id = ? AND o.user_id = ?""",
        (operation_id, user['id']),
    ).fetchone()
    if operation is None:
        abort(404)
    if operation['status'] != 'pending':
        flash('Ta operacja BLIK została już rozpatrzona.', 'error')
        return redirect(url_for('blik'))
    if decision == 'reject':
        db.execute(
            """UPDATE blik_operations SET status = 'rejected',
            rejection_reason = 'Operacja odrzucona przez użytkownika.', confirmed_at = ?
            WHERE id = ? AND status = 'pending'""",
            (now_iso(), operation_id),
        )
        add_notification(
            user['id'], 'Odrzucona operacja BLIK',
            f"Odrzucono {money(operation['amount_cents'])} — {operation['counterparty']}.",
            'security', operation_type='blik_operation',
            operation_reference=f'BLIK-{operation_id:06d}',
            amount_cents=operation['amount_cents'], counterparty=operation['counterparty'],
        )
        notify_junior_guardian(
            user['id'], 'Odrzucona operacja BLIK dziecka',
            f"Odrzucono {money(operation['amount_cents'])} — {operation['counterparty']}.",
            'security', operation_type='blik_operation', amount_cents=operation['amount_cents'],
            counterparty=operation['counterparty'],
        )
        db.commit()
        flash('Operacja BLIK została odrzucona.', 'success')
        return redirect(url_for('blik'))

    stamp = now_iso()
    if operation['expires_at'] <= stamp:
        db.execute(
            "UPDATE blik_operations SET status = 'expired', rejection_reason = 'Kod BLIK wygasł.' WHERE id = ?",
            (operation_id,),
        )
        db.commit()
        flash('Nie można zatwierdzić operacji — kod BLIK wygasł.', 'error')
        return redirect(url_for('blik'))

    settings = ensure_blik_settings(user['id'])
    limit_column = {'payment': 'payment_limit', 'atm': 'atm_limit', 'phone': 'phone_limit'}[operation['operation_type']]
    used_today = db.execute(
        """SELECT COALESCE(SUM(amount_cents), 0) FROM blik_operations
        WHERE user_id = ? AND operation_type = ? AND status = 'approved'
        AND substr(confirmed_at, 1, 10) = ?""",
        (user['id'], operation['operation_type'], date.today().isoformat()),
    ).fetchone()[0]
    remaining = max(0, settings[limit_column] - used_today)
    rejection = None
    recipient = None
    if operation['amount_cents'] > remaining:
        rejection = f"Przekroczono dzienny limit BLIK. Pozostało: {money(remaining)}."
    elif operation['amount_cents'] > user['balance_cents']:
        rejection = 'Brak wystarczających środków na rachunku.'
    elif operation['operation_type'] == 'phone':
        recipient = db.execute('SELECT * FROM users WHERE id = ?', (operation['recipient_user_id'],)).fetchone()
        if recipient is None or recipient['id'] == user['id']:
            rejection = 'Odbiorca przelewu na telefon jest niedostępny.'

    if rejection:
        db.execute(
            """UPDATE blik_operations SET status = 'rejected', rejection_reason = ?, confirmed_at = ?
            WHERE id = ? AND status = 'pending'""",
            (rejection, stamp, operation_id),
        )
        add_notification(
            user['id'], 'Odrzucona operacja BLIK',
            f"{BLIK_OPERATION_LABELS[operation['operation_type']]} na {money(operation['amount_cents'])}. Powód: {rejection}",
            'warning', operation_type='blik_operation',
            operation_reference=f'BLIK-{operation_id:06d}',
            amount_cents=operation['amount_cents'], counterparty=operation['counterparty'],
        )
        notify_junior_guardian(
            user['id'], 'Odrzucona operacja BLIK dziecka',
            f"{money(operation['amount_cents'])} — {operation['counterparty']}. Powód: {rejection}",
            'warning', operation_type='blik_operation', amount_cents=operation['amount_cents'],
            counterparty=operation['counterparty'],
        )
        db.commit()
        flash('Operacja BLIK została odrzucona: ' + rejection, 'error')
        return redirect(url_for('blik'))

    try:
        db.execute('BEGIN IMMEDIATE')
        changed = db.execute(
            'UPDATE users SET balance_cents = balance_cents - ? WHERE id = ? AND balance_cents >= ?',
            (operation['amount_cents'], user['id'], operation['amount_cents']),
        )
        if changed.rowcount != 1:
            raise ValueError('Brak wystarczających środków na rachunku.')
        changed = db.execute(
            """UPDATE blik_operations SET status = 'approved', confirmed_at = ?
            WHERE id = ? AND user_id = ? AND status = 'pending'""",
            (stamp, operation_id, user['id']),
        )
        if changed.rowcount != 1:
            raise ValueError('Operacja została już rozpatrzona.')
        title = BLIK_OPERATION_LABELS[operation['operation_type']]
        debit_tx = db.execute(
            """INSERT INTO transactions
            (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
            VALUES (?, 'debit', ?, ?, ?, 'BLIK', ?)""",
            (user['id'], operation['amount_cents'], title, operation['counterparty'], stamp),
        )
        if recipient:
            db.execute(
                'UPDATE users SET balance_cents = balance_cents + ? WHERE id = ?',
                (operation['amount_cents'], recipient['id']),
            )
            sender_name = f"{user['first_name']} {user['last_name']}"
            db.execute(
                """INSERT INTO transactions
                (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
                VALUES (?, 'credit', ?, 'Przelew na telefon BLIK', ?, 'BLIK', ?)""",
                (recipient['id'], operation['amount_cents'], sender_name, stamp),
            )
            add_notification(
                recipient['id'], 'Przelew na telefon BLIK',
                f"Otrzymujesz {money(operation['amount_cents'])} od {sender_name}.", 'success',
                operation_type='blik_transfer_in', operation_reference=f'BLIK-{operation_id:06d}',
                amount_cents=operation['amount_cents'], counterparty=sender_name,
            )
        add_notification(
            user['id'], 'Operacja BLIK zatwierdzona',
            f"{title}: {money(operation['amount_cents'])} — {operation['counterparty']}.", 'success',
            operation_type='blik_operation', operation_reference=f'BLIK-{operation_id:06d}',
            amount_cents=operation['amount_cents'], counterparty=operation['counterparty'],
            related_transaction_id=debit_tx.lastrowid,
        )
        if operation['amount_cents'] >= 200_000:
            add_notification(
                user['id'], 'Alert bezpieczeństwa: wysoka operacja BLIK',
                f"Zatwierdzono operację BLIK na {money(operation['amount_cents'])}. Jeśli to nie Ty, skontaktuj się z bankiem.",
                'security',
            )
        warn_about_low_balance(user['id'], user['balance_cents'] - operation['amount_cents'])
        db.commit()
    except (sqlite3.Error, ValueError) as exc:
        db.rollback()
        flash(str(exc), 'error')
    else:
        flash(f"Operacja BLIK-{operation_id:06d} została zatwierdzona.", 'success')
    return redirect(url_for('blik'))


