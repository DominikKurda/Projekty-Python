                            user['id'], code_row['id'], operation_type, counterparty,
                            values['phone_number'] if operation_type == 'phone' else None,
                            recipient['id'] if recipient else None, amount, stamp,
                        ),
                    )
                    db.commit()
                except (sqlite3.Error, ValueError) as exc:
                    db.rollback()
                    flash(str(exc), 'error')
                else:
                    flash(f"Operacja BLIK-{operation.lastrowid:06d} oczekuje na Twoją decyzję.", 'info')
                return redirect(url_for('blik'))

        if action not in ('generate', 'limits', 'create-operation'):
            flash('Nieprawidłowa operacja.', 'error')

    stamp = now_iso()
    active_code_row = db.execute(
        """SELECT * FROM blik_codes
        WHERE user_id = ? AND used_at IS NULL AND expires_at > ?
        ORDER BY id DESC LIMIT 1""",
        (user['id'], stamp),
    ).fetchone()
    active_code = None
    expires_ms = 0
    if active_code_row:
        try:
            code_value = str(active_code_row['code']).strip()
            expires_at = datetime.fromisoformat(str(active_code_row['expires_at']))
            if expires_at.tzinfo is None:
                expires_at = expires_at.replace(tzinfo=timezone.utc)
            if not re.fullmatch(r'\d{6}', code_value) or expires_at <= datetime.now(timezone.utc):
                raise ValueError('Nieprawidłowy starszy kod BLIK.')
            active_code = dict(active_code_row)
            active_code['code'] = code_value
            expires_ms = int(expires_at.timestamp() * 1000)
        except (TypeError, ValueError, OverflowError):
            db.execute(
                'UPDATE blik_codes SET used_at = ? WHERE id = ?',
                (stamp, active_code_row['id']),
            )
            db.commit()
    pending_rows = db.execute(
        "SELECT * FROM blik_operations WHERE user_id = ? AND status = 'pending' ORDER BY id DESC",
        (user['id'],),
    ).fetchall()
    history_rows = db.execute(
        'SELECT * FROM blik_operations WHERE user_id = ? ORDER BY id DESC',
        (user['id'],),
    ).fetchall()
    pending = [safe_blik_operation(row) for row in pending_rows]
    history = [safe_blik_operation(row) for row in history_rows]
    settings = ensure_blik_settings(user['id'])
    usage = blik_usage(user['id'], settings)
    anna_phone_row = db.execute(
