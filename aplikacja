def validate_beneficiary(user, name: str, account: str, beneficiary_id: int | None = None) -> str | None:
    if not name or len(name) > 120:
        return "Podaj nazwę odbiorcy (maksymalnie 120 znaków)."
    if account_validation_error(account):
        return account_validation_error(account)
    if account == user["account_number"]:
        return "Nie możesz dodać własnego rachunku jako odbiorcy."
    if not get_db().execute("SELECT 1 FROM users WHERE account_number = ?", (account,)).fetchone():
        return "W wersji demo możesz zapisać tylko odbiorcę posiadającego konto NovaBank."
    duplicate = get_db().execute(
        """SELECT 1 FROM beneficiaries
        WHERE user_id = ? AND account_number = ? AND (? IS NULL OR id != ?)""",
        (user["id"], account, beneficiary_id, beneficiary_id),
    ).fetchone()
    if duplicate:
        return "Ten numer rachunku jest już zapisany."
    return None


