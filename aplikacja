@login_required
def loan_schedule(loan_id):
    db = get_db()
    loan = db.execute(
        "SELECT * FROM loan_applications WHERE id = ? AND user_id = ?",
        (loan_id, session['user_id']),
    ).fetchone()
    if loan is None or loan['status'] != 'approved':
        abort(404)
    ensure_loan_schedule(loan_id)
    db.commit()
    installments = db.execute(
        'SELECT * FROM loan_installments WHERE loan_id = ? ORDER BY installment_number',
        (loan_id,),
    ).fetchall()
    next_installment = next((item for item in installments if item['status'] == 'pending'), None)
    remaining_principal = sum(item['principal_cents'] for item in installments if item['status'] == 'pending')
    remaining_total = sum(item['amount_cents'] for item in installments if item['status'] == 'pending')
    paid_count = sum(1 for item in installments if item['status'] == 'paid')
    overpayments = db.execute(
        """SELECT * FROM loan_overpayments
        WHERE loan_id = ? AND user_id = ? ORDER BY id DESC""",
        (loan_id, session['user_id']),
    ).fetchall()
    contract_changes = db.execute(
        """SELECT * FROM loan_contract_changes
        WHERE loan_id = ? AND user_id = ? ORDER BY id DESC""",
        (loan_id, session['user_id']),
    ).fetchall()
    maximum_remaining_months = 120 - paid_count
    default_month = (
        next_installment['due_date'][:7]
        if next_installment else installments[-1]['due_date'][:7]
    )
    selected_month = calendar_month(request.args.get('month', default_month))
