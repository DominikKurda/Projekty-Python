@app.post('/joint-account/contributions/<int:contribution_id>/toggle')
@login_required
def joint_contribution_toggle(contribution_id):
    if not valid_csrf():
        abort(400)
    new_status = {'pause': 'paused', 'resume': 'active', 'cancel': 'cancelled'}.get(
        request.form.get('action')
    )
    if new_status is None:
        abort(400)
    db = get_db()
    row = db.execute(
        """SELECT c.* FROM joint_recurring_contributions c
        JOIN joint_account_members m ON m.account_id = c.account_id
        WHERE c.id = ? AND c.user_id = ? AND m.user_id = ?""",
        (contribution_id, session['user_id'], session['user_id']),
    ).fetchone()
    if row is None:
        abort(404)
    db.execute('UPDATE joint_recurring_contributions SET status = ? WHERE id = ?',
               (new_status, contribution_id))
    db.commit()
    flash('Status cyklicznej wpłaty został zmieniony.', 'success')
    return redirect(url_for('joint_account', account_id=row['account_id']))


@app.post('/joint-account/invitations/<int:invitation_id>/decision')
@login_required
def joint_invitation_decision(invitation_id):
    if not valid_csrf():
        abort(400)
    signed_user = current_user()
    if signed_user['account_type'] == 'junior' or signed_user['age'] < 18:
        flash('Konto Junior nie może zostać współwłaścicielem konta wspólnego.', 'error')
        return redirect(url_for('dashboard'))
    decision = request.form.get('decision')
    if decision not in ('accept', 'reject'):
        abort(400)
    db = get_db()
    invitation = db.execute(
        """SELECT i.*, a.name AS account_name FROM joint_account_invitations i
        JOIN joint_accounts a ON a.id = i.account_id
        WHERE i.id = ? AND i.invitee_id = ? AND i.status = 'pending'""",
        (invitation_id, session['user_id']),
    ).fetchone()
    if invitation is None:
        abort(404)
    try:
        db.execute('BEGIN IMMEDIATE')
        if decision == 'accept':
            count = db.execute(
                'SELECT COUNT(*) FROM joint_account_members WHERE account_id = ?',
                (invitation['account_id'],),
            ).fetchone()[0]
            if count >= 2:
                raise ValueError('To konto ma już dwóch współwłaścicieli.')
            db.execute(
                'INSERT INTO joint_account_members(account_id, user_id, joined_at) VALUES (?, ?, ?)',
                (invitation['account_id'], session['user_id'], now_iso()),
            )
            db.execute(
                "UPDATE joint_accounts SET activation_status = 'active' WHERE id = ?",
                (invitation['account_id'],),
            )
        changed = db.execute(
            """UPDATE joint_account_invitations SET status = ?, responded_at = ?
            WHERE id = ? AND invitee_id = ? AND status = 'pending'""",
            ('accepted' if decision == 'accept' else 'rejected', now_iso(),
             invitation_id, session['user_id']),
        )
        if changed.rowcount != 1:
            raise ValueError('Zaproszenie zostało już rozpatrzone.')
        user = current_user()
        add_notification(
            invitation['inviter_id'],
            'Zaproszenie do konta wspólnego przyjęte' if decision == 'accept' else 'Zaproszenie odrzucone',
            f"{user['first_name']} {user['last_name']} " +
            ('dołączył(a)' if decision == 'accept' else 'nie dołączył(a)') +
            f" do konta „{invitation['account_name']}”.",
            'success' if decision == 'accept' else 'warning',
        )
        db.commit()
        flash('Dołączyłeś do konta wspólnego.' if decision == 'accept' else 'Zaproszenie zostało odrzucone.', 'success')
    except (sqlite3.Error, ValueError) as exc:
        db.rollback()
        flash(str(exc), 'error')
    return redirect(url_for('joint_account', account_id=invitation['account_id']))


@app.post('/joint-account/transfers/<int:order_id>/decision')
@login_required
def joint_transfer_decision(order_id):
    if not valid_csrf():
        abort(400)
    decision = request.form.get('decision')
    if decision not in ('approve', 'reject'):
        abort(400)
    db = get_db()
    order = db.execute(
        """SELECT o.* FROM joint_transfer_orders o
        JOIN joint_account_members m ON m.account_id = o.account_id
        WHERE o.id = ? AND m.user_id = ? AND o.status = 'pending'""",
        (order_id, session['user_id']),
    ).fetchone()
    if order is None:
        abort(404)
    if order['created_by'] == session['user_id']:
        flash('Przelew musi zatwierdzić drugi właściciel konta.', 'error')
        return redirect(url_for('joint_account', account_id=order['account_id']))
    try:
        db.execute('BEGIN IMMEDIATE')
        if decision == 'approve':
            complete_joint_transfer(order_id, session['user_id'])
            message = 'Przelew został zatwierdzony i wykonany.'
        else:
            changed = db.execute(
                """UPDATE joint_transfer_orders SET status = 'rejected', decided_at = ?, decided_by = ?
                WHERE id = ? AND status = 'pending'""",
                (now_iso(), session['user_id'], order_id),
            )
            if changed.rowcount != 1:
                raise ValueError('Ten przelew został już rozpatrzony.')
            notify_joint_members(
                order['account_id'], 'Przelew z konta wspólnego odrzucony',
                f"Zlecenie WSP-{order_id:06d} zostało odrzucone.", 'warning',
                operation_reference=f'WSP-{order_id:06d}', amount_cents=order['amount_cents'],
                counterparty=order['recipient_name'],
            )
            message = 'Przelew został odrzucony.'
        db.commit()
        flash(message, 'success')
    except (sqlite3.Error, ValueError) as exc:
        db.rollback()
        flash(str(exc), 'error')
    return redirect(url_for('joint_account', account_id=order['account_id']))


