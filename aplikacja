def page(title: str, content: str, **context):
    body = render_template_string(content, **context)
    user = current_user()
    unread_support = 0
    pending_payment_requests = 0
    pending_account_consents = 0
    admin_user = False
    account_contexts = []
    selected_account_context = None
    if user:
        admin_user = is_admin()
        if not admin_user:
            account_contexts = available_account_contexts(user['id'])
            selected_account_context = active_account_context()
        if admin_user:
            unread_support = get_db().execute(
                "SELECT COUNT(*) FROM support_messages WHERE sender_role = 'customer' AND is_read = 0"
            ).fetchone()[0]
        else:
            pending_payment_requests = get_db().execute(
                "SELECT COUNT(*) FROM payment_requests WHERE payer_id = ? AND status = 'pending'",
                (user["id"],),
            ).fetchone()[0]
            pending_account_consents = get_db().execute(
                """SELECT
                (SELECT COUNT(*) FROM joint_account_invitations
                 WHERE invitee_id = ? AND status = 'pending') +
                (SELECT COUNT(*) FROM joint_transfer_orders o
                 JOIN joint_account_members m ON m.account_id = o.account_id
                 WHERE m.user_id = ? AND o.created_by != ? AND o.status = 'pending') +
                (SELECT COUNT(*) FROM junior_guardian_requests
                 WHERE guardian_user_id = ? AND status = 'pending')""",
                (user['id'], user['id'], user['id'], user['id']),
            ).fetchone()[0]
            unread_support = get_db().execute(
                """SELECT COUNT(*) FROM support_messages m
                JOIN support_tickets t ON t.id = m.ticket_id
                WHERE t.user_id = ? AND m.sender_role = 'admin' AND m.is_read = 0""",
                (user["id"],),
            ).fetchone()[0]
    return render_template_string(
        BASE_TEMPLATE,
        title=title,
        content=body,
        user=user,
        unread_support=unread_support,
        pending_payment_requests=pending_payment_requests,
        pending_account_consents=pending_account_consents,
        is_admin_user=admin_user,
        account_contexts=account_contexts,
        active_account_context=selected_account_context,
    )


