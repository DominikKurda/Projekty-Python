@app.route('/profile/photo', methods=['POST'])
@login_required
def update_profile_photo():
    if not valid_csrf():
        flash('Sesja formularza wygasła. Odśwież stronę i spróbuj ponownie.', 'error')
        return redirect(url_for('dashboard'))
    db = get_db()
    user_id = session['user_id']
    action = request.form.get('action')
    if action == 'remove':
        db.execute('DELETE FROM profile_photos WHERE user_id = ?', (user_id,))
        db.commit()
        flash('Zdjęcie profilowe zostało usunięte.', 'success')
        return redirect(url_for('dashboard'))
    if action != 'upload':
        abort(400)
    upload = request.files.get('photo')
    try:
        if upload is None or not upload.filename:
            raise ValueError('Wybierz zdjęcie do przesłania.')
        raw = upload.read(5 * 1024 * 1024 + 1)
        if len(raw) > 5 * 1024 * 1024:
            raise ValueError('Zdjęcie może mieć maksymalnie 5 MB.')
        with warnings.catch_warnings():
            warnings.simplefilter('error', Image.DecompressionBombWarning)
            with Image.open(BytesIO(raw)) as source:
                if source.format not in ('JPEG', 'PNG', 'WEBP'):
                    raise ValueError('Obsługiwane formaty to JPG, PNG i WebP.')
                if source.width * source.height > 16_000_000:
                    raise ValueError('Zdjęcie może mieć maksymalnie 16 milionów pikseli.')
                source.load()
                normalized = ImageOps.fit(ImageOps.exif_transpose(source).convert('RGB'), (256, 256), method=Image.Resampling.LANCZOS)
                # Nowy obraz usuwa metadane źródła, w tym dane EXIF i lokalizację.
                clean = Image.new('RGB', (256, 256))
                clean.paste(normalized)
                buffer = BytesIO()
                clean.save(buffer, format='PNG')
        db.execute('INSERT INTO profile_photos(user_id, image, updated_at) VALUES (?, ?, ?) ON CONFLICT(user_id) DO UPDATE SET image = excluded.image, updated_at = excluded.updated_at',
                   (user_id, buffer.getvalue(), now_iso()))
        db.commit()
    except ValueError as exc:
        flash(str(exc), 'error')
    except (UnidentifiedImageError, OSError, Image.DecompressionBombError, Image.DecompressionBombWarning):
        flash('Nie można odczytać zdjęcia. Wybierz poprawny plik JPG, PNG lub WebP.', 'error')
    else:
        flash('Zdjęcie profilowe zostało zapisane.', 'success')
    return redirect(url_for('dashboard'))


