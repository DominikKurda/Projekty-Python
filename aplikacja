def get_transfer_limits(user_id: int):
    db = get_db()
    db.execute(
        """INSERT OR IGNORE INTO transfer_limits
        (user_id, single_limit_cents, daily_limit_cents, updated_at)
        VALUES (?, 500000, 1000000, ?)""",
        (user_id, now_iso()),
    )
    db.commit()
    return db.execute('SELECT * FROM transfer_limits WHERE user_id = ?', (user_id,)).fetchone()


def direct_transfers_today(user_id: int) -> int:
    return get_db().execute(
        """SELECT COALESCE(SUM(amount_cents), 0) FROM transactions
        WHERE user_id = ? AND kind = 'debit' AND counterparty_account LIKE 'PL%'
        AND substr(created_at, 1, 10) = ?""",
        (user_id, date.today().isoformat()),
    ).fetchone()[0]


def recipient_name_matches(value: str, recipient) -> bool:
    supplied = normalize_assistant_text(re.sub(r'[^A-Za-zĄĆĘŁŃÓŚŹŻąćęłńóśźż -]', '', value))
    expected = normalize_assistant_text(f"{recipient['first_name']} {recipient['last_name']}")
    reverse = normalize_assistant_text(f"{recipient['last_name']} {recipient['first_name']}")
    return supplied in {expected, reverse}


