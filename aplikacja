@login_required
def consolidate_loans():
    if not valid_csrf():
        abort(400)
    try:
        loan_ids = sorted({int(value) for value in request.form.getlist('loan_ids')})
    except ValueError:
        loan_ids = []
    months = request.form.get('months', type=int)
    payment_day = request.form.get('payment_day', type=int)
    installment_type = request.form.get('installment_type', '')
    if len(loan_ids) < 2:
        flash('Wybierz co najmniej dwa aktywne kredyty.', 'error')
        return redirect(url_for('loans'))
    if months is None or not 6 <= months <= 120:
        flash('Nowy okres konsolidacji musi wynosić od 6 do 120 miesięcy.', 'error')
        return redirect(url_for('loans'))
    if payment_day is None or not 1 <= payment_day <= 31:
        flash('Wybierz dzień spłaty od 1. do 31.', 'error')
        return redirect(url_for('loans'))
    if installment_type not in ('equal', 'decreasing'):
        flash('Wybierz raty równe albo malejące.', 'error')
        return redirect(url_for('loans'))
    db = get_db()
    placeholders = ','.join('?' for _ in loan_ids)
    selected_loans = db.execute(
        f"""SELECT * FROM loan_applications
        WHERE id IN ({placeholders}) AND user_id = ? AND status = 'approved'
          AND consolidated_into_id IS NULL""",
        (*loan_ids, session['user_id']),
    ).fetchall()
    if len(selected_loans) != len(loan_ids):
        flash('Co najmniej jeden wybrany kredyt nie jest dostępny do konsolidacji.', 'error')
        return redirect(url_for('loans'))
    for loan_id in loan_ids:
        ensure_loan_schedule(loan_id)
    db.commit()
    pending_by_loan = {}
    for loan_id in loan_ids:
        rows = db.execute(
            """SELECT * FROM loan_installments
            WHERE loan_id = ? AND status = 'pending' ORDER BY installment_number""",
            (loan_id,),
        ).fetchall()
        if not rows:
            flash('Każdy konsolidowany kredyt musi mieć niespłacony kapitał.', 'error')
            return redirect(url_for('loans'))
        pending_by_loan[loan_id] = rows
    total_principal = sum(
        item['principal_cents']
        for rows in pending_by_loan.values() for item in rows
    )
    previous_combined_payment = sum(rows[0]['amount_cents'] for rows in pending_by_loan.values())
    new_payment = calculate_first_loan_payment(
        total_principal, months, CONSOLIDATION_ANNUAL_RATE, installment_type
    )
    if new_payment >= previous_combined_payment:
        flash(
            f'Nowa rata {money(new_payment)} nie jest niższa od obecnej sumy rat '
            f'{money(previous_combined_payment)}. Wybierz dłuższy okres.',
            'error',
        )
        return redirect(url_for('loans'))
    stamp = now_iso()
    try:
        db.execute('BEGIN IMMEDIATE')
        created = db.execute(
            """INSERT INTO loan_applications
            (user_id, amount_cents, months, annual_rate, monthly_payment_cents,
             installment_type, payment_day, preferred_payment_day, loan_kind,
             monthly_income_cents, monthly_costs_cents, decision_reason,
             status, created_at, reviewed_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'consolidation', NULL, NULL, ?,
                    'approved', ?, ?)""",
            (session['user_id'], total_principal, months,
             str(CONSOLIDATION_ANNUAL_RATE), new_payment, installment_type,
             min(payment_day, 28), payment_day,
             f"Konsolidacja kredytów: {', '.join(f'KR-{item:06d}' for item in loan_ids)}",
             stamp, stamp),
        )
        new_loan_id = created.lastrowid
        insert_loan_schedule(
            loan_id=new_loan_id,
            principal_cents=total_principal,
            months=months,
            annual_rate=CONSOLIDATION_ANNUAL_RATE,
            installment_type=installment_type,
            first_number=1,
            first_due=loan_due_date(date.today(), 1, payment_day),
            payment_day=payment_day,
        )
        for old_loan_id in loan_ids:
            db.execute(
                """UPDATE loan_installments SET status = 'paid', paid_at = ?,
                paid_amount_cents = principal_cents, payment_method = 'early'
                WHERE loan_id = ? AND status = 'pending'""",
                (stamp, old_loan_id),
            )
            db.execute(
                'UPDATE loan_applications SET consolidated_into_id = ? WHERE id = ?',
                (new_loan_id, old_loan_id),
            )
            db.execute(
                """INSERT INTO loan_contract_changes
                (loan_id, user_id, change_type, old_value, new_value, details, created_at)
                VALUES (?, ?, 'consolidation', ?, ?, ?, ?)""",
                (old_loan_id, session['user_id'], f'KR-{old_loan_id:06d}',
                 f'KR-{new_loan_id:06d}',
                 f"Kredyt połączono z nowym kredytem konsolidacyjnym KR-{new_loan_id:06d}",
                 stamp),
            )
        db.execute(
            """INSERT INTO loan_contract_changes
            (loan_id, user_id, change_type, old_value, new_value, details, created_at)
            VALUES (?, ?, 'consolidation', ?, ?, ?, ?)""",
            (new_loan_id, session['user_id'],
             ', '.join(f'KR-{item:06d}' for item in loan_ids),
             f'KR-{new_loan_id:06d}',
             f"Utworzono jedną ratę {money(new_payment)} zamiast łącznej kwoty {money(previous_combined_payment)}",
             stamp),
        )
        add_notification(
            session['user_id'], 'Kredyt konsolidacyjny uruchomiony',
            f"Połączono {len(loan_ids)} kredyty w KR-{new_loan_id:06d}. "
            f"Nowa pierwsza rata wynosi {money(new_payment)}.", 'success',
        )
        db.commit()
    except sqlite3.Error as exc:
        db.rollback()
        flash(f'Nie udało się przeprowadzić konsolidacji: {exc}', 'error')
    else:
        flash(
            f'Kredyty zostały połączone. Nowy kredyt to KR-{new_loan_id:06d}.',
            'success',
        )
        return redirect(url_for('loan_schedule', loan_id=new_loan_id))
    return redirect(url_for('loans'))


