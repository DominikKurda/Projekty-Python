    # Niektóre najstarsze bazy miały kolumnę id dodaną zwykłym ALTER TABLE,
    # więc nie była ona prawdziwym kluczem głównym. Taka tabela wyglądała
    # poprawnie, ale INSERT kodu BLIK mógł kończyć się błędem 500 lub
    # "foreign key mismatch". Przebudowujemy tylko wadliwy schemat, zachowując
    # możliwe do odzyskania kody i operacje użytkowników.
    def rebuild_legacy_blik_schema() -> None:
        code_info = {row["name"]: row for row in db.execute("PRAGMA table_info(blik_codes)")}
        operation_info = {
            row["name"]: row for row in db.execute("PRAGMA table_info(blik_operations)")
        }
        codes_ok = "id" in code_info and code_info["id"]["pk"] == 1
        operations_ok = "id" in operation_info and operation_info["id"]["pk"] == 1
        if codes_ok and operations_ok:
            return

        old_codes = [dict(row) for row in db.execute("SELECT * FROM blik_codes")]
        old_operations = [dict(row) for row in db.execute("SELECT * FROM blik_operations")]
        valid_users = {row[0] for row in db.execute("SELECT id FROM users")}
        fallback_stamp = now_iso()

        db.executescript(
            """
            DROP TABLE IF EXISTS blik_operations_repaired;
            DROP TABLE IF EXISTS blik_codes_repaired;
            CREATE TABLE blik_codes_repaired (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
                code TEXT NOT NULL,
                created_at TEXT NOT NULL,
                expires_at TEXT NOT NULL,
                used_at TEXT
            );
            CREATE TABLE blik_operations_repaired (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
                code_id INTEGER NOT NULL REFERENCES blik_codes_repaired(id),
                operation_type TEXT NOT NULL CHECK(operation_type IN ('payment','atm','phone')),
                counterparty TEXT NOT NULL,
                phone_number TEXT,
                recipient_user_id INTEGER REFERENCES users(id),
                amount_cents INTEGER NOT NULL CHECK(amount_cents > 0),
                status TEXT NOT NULL DEFAULT 'pending'
                    CHECK(status IN ('pending','approved','rejected','expired')),
                rejection_reason TEXT,
                created_at TEXT NOT NULL,
                confirmed_at TEXT
            );
            """
        )

        restored_code_ids: set[int] = set()
        for item in old_codes:
            try:
                code_id = int(item.get("id"))
                user_id = int(item.get("user_id"))
            except (TypeError, ValueError):
                continue
            if user_id not in valid_users or code_id <= 0:
                continue
            code_value = str(item.get("code") or "").strip()
            if not re.fullmatch(r"\d{6}", code_value):
                code_value = f"{abs(code_id) % 1_000_000:06d}"
            created_at = str(item.get("created_at") or fallback_stamp)
            expires_at = str(item.get("expires_at") or fallback_stamp)
            db.execute(
                """INSERT OR IGNORE INTO blik_codes_repaired
                (id, user_id, code, created_at, expires_at, used_at)
                VALUES (?, ?, ?, ?, ?, ?)""",
                (code_id, user_id, code_value, created_at, expires_at, item.get("used_at")),
            )
            restored_code_ids.add(code_id)

        for item in old_operations:
            try:
                operation_id = int(item.get("id"))
                user_id = int(item.get("user_id"))
                code_id = int(item.get("code_id"))
                amount = int(item.get("amount_cents"))
            except (TypeError, ValueError):
                continue
            if (
                operation_id <= 0 or user_id not in valid_users
                or code_id not in restored_code_ids or amount <= 0
            ):
                continue
            operation_type = item.get("operation_type")
            if operation_type not in ("payment", "atm", "phone"):
                operation_type = "payment"
            status = item.get("status")
            if status not in ("pending", "approved", "rejected", "expired"):
                status = "rejected"
            recipient_id = item.get("recipient_user_id")
            if recipient_id not in valid_users:
                recipient_id = None
            db.execute(
                """INSERT OR IGNORE INTO blik_operations_repaired
                (id, user_id, code_id, operation_type, counterparty, phone_number,
                 recipient_user_id, amount_cents, status, rejection_reason,
                 created_at, confirmed_at)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
                (
                    operation_id, user_id, code_id, operation_type,
                    str(item.get("counterparty") or "Starsza operacja BLIK"),
                    item.get("phone_number"), recipient_id, amount, status,
                    item.get("rejection_reason"),
                    str(item.get("created_at") or fallback_stamp),
                    item.get("confirmed_at"),
                ),
            )

        db.executescript(
            """
            DROP TABLE blik_operations;
            DROP TABLE blik_codes;
            ALTER TABLE blik_codes_repaired RENAME TO blik_codes;
            ALTER TABLE blik_operations_repaired RENAME TO blik_operations;
            """
        )

    rebuild_legacy_blik_schema()

