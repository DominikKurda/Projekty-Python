def complete_junior_transfer(order_id: int, guardian_user_id: int) -> int:
    db = get_db()
    order = db.execute(
        """SELECT o.*, j.first_name AS junior_first, j.last_name AS junior_last,
        j.account_number AS junior_account, j.balance_cents
        FROM junior_transfer_orders o JOIN users j ON j.id = o.junior_user_id
        WHERE o.id = ? AND o.guardian_user_id = ? AND o.status = 'pending'""",
        (order_id, guardian_user_id),
    ).fetchone()
    if order is None:
        raise ValueError('Ten przelew nie oczekuje już na decyzję.')
    changed = db.execute(
        'UPDATE users SET balance_cents = balance_cents - ? WHERE id = ? AND balance_cents >= ?',
        (order['amount_cents'], order['junior_user_id'], order['amount_cents']),
    )
    if changed.rowcount != 1:
        raise ValueError('Na Koncie Junior nie ma wystarczających środków.')
    db.execute('UPDATE users SET balance_cents = balance_cents + ? WHERE id = ?',
               (order['amount_cents'], order['recipient_user_id']))
    stamp = now_iso()
    debit = db.execute(
        """INSERT INTO transactions
        (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
        VALUES (?, 'debit', ?, ?, ?, ?, ?)""",
        (order['junior_user_id'], order['amount_cents'], order['title'],
         order['recipient_name'], order['recipient_account'], stamp),
    )
    db.execute(
        """INSERT INTO transactions
        (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
        VALUES (?, 'credit', ?, ?, ?, ?, ?)""",
        (order['recipient_user_id'], order['amount_cents'], order['title'],
         f"{order['junior_first']} {order['junior_last']}", order['junior_account'], stamp),
    )
    db.execute(
        """UPDATE junior_transfer_orders SET status = 'approved', decided_at = ?,
        decided_by = ?, transaction_id = ? WHERE id = ? AND status = 'pending'""",
        (stamp, guardian_user_id, debit.lastrowid, order_id),
