        return redirect(url_for('loan_schedule', loan_id=loan_id))
    stamp = now_iso()
    try:
        db.execute('BEGIN IMMEDIATE')
        debited = db.execute(
            'UPDATE users SET balance_cents = balance_cents - ? WHERE id = ? AND balance_cents >= ?',
            (total, user['id'], total),
        )
        if debited.rowcount != 1:
            raise ValueError('Brak wystarczających środków.')
        for item in selected:
            changed = db.execute(
                """UPDATE loan_installments SET status = 'paid', paid_at = ?,
                paid_amount_cents = amount_cents, payment_method = 'regular'
                WHERE id = ? AND status = 'pending'""",
                (stamp, item['id']),
            )
            if changed.rowcount != 1:
                raise ValueError('Jedna z wybranych rat została już rozliczona.')
        transaction = db.execute(
            """INSERT INTO transactions
            (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
            VALUES (?, 'debit', ?, ?, 'NovaBank Kredyty', 'KREDYT-WIELE-RAT', ?)""",
            (user['id'], total, f"Spłata {count} rat kredytu KR-{loan_id:06d}", stamp),
        )
        db.execute(
            """INSERT INTO loan_contract_changes
            (loan_id, user_id, change_type, old_value, new_value, details, created_at)
            VALUES (?, ?, 'bulk_payment', ?, ?, ?, ?)""",
            (loan_id, user['id'], str(len(pending)), str(len(pending) - count),
             f"Jednorazowo spłacono raty {selected[0]['installment_number']}–{selected[-1]['installment_number']} za {money(total)}",
             stamp),
        )
        add_notification(
            user['id'], 'Kilka rat kredytu spłaconych',
            f"Jednorazowo zapłacono {count} rat kredytu KR-{loan_id:06d} na kwotę {money(total)}.",
            'success', operation_type='loan_bulk_payment',
            operation_reference=f'KR-{loan_id:06d}-WIELE-{transaction.lastrowid}',
            amount_cents=total, counterparty='NovaBank Kredyty',
            related_transaction_id=transaction.lastrowid,
        )
        warn_about_low_balance(user['id'], user['balance_cents'] - total)
        db.commit()
    except (sqlite3.Error, ValueError) as exc:
        db.rollback()
        flash(str(exc), 'error')
    else:
        flash(f'Jednorazowo spłacono {count} rat na łączną kwotę {money(total)}.', 'success')
    return redirect(url_for('loan_schedule', loan_id=loan_id))


@app.post('/loans/<int:loan_id>/overpayment')
@login_required
def overpay_loan(loan_id):
    if not valid_csrf():
        abort(400)
    amount = parse_amount(request.form.get('amount', ''))
    strategy = request.form.get('strategy', '')
    if amount is None:
        flash('Wpisz poprawną kwotę nadpłaty.', 'error')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    if strategy not in ('reduce_payment', 'shorten_term'):
        flash('Wybierz zmniejszenie rat albo skrócenie okresu.', 'error')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    db = get_db()
    loan = db.execute(
        "SELECT * FROM loan_applications WHERE id = ? AND user_id = ? AND status = 'approved'",
        (loan_id, session['user_id']),
    ).fetchone()
    if loan is None:
        abort(404)
    ensure_loan_schedule(loan_id)
    db.commit()
    pending = db.execute(
        """SELECT * FROM loan_installments
        WHERE loan_id = ? AND status = 'pending' ORDER BY installment_number""",
        (loan_id,),
    ).fetchall()
    if not pending:
        flash('Ten kredyt jest już spłacony.', 'info')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    remaining_principal = sum(item['principal_cents'] for item in pending)
    if amount >= remaining_principal:
        flash('Częściowa nadpłata musi być niższa od pozostałego kapitału. Użyj przycisku „Spłać cały kredyt”.', 'error')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    user = current_user()
    if user['balance_cents'] < amount:
        add_notification(user['id'], 'Brak środków na nadpłatę',
                         f"Wymagana kwota: {money(amount)}.", 'warning')
        db.commit()
        flash('Brak wystarczających środków na nadpłatę.', 'error')
        return redirect(url_for('loan_schedule', loan_id=loan_id))

    previous_months = len(pending)
    new_principal = remaining_principal - amount
    annual_rate = Decimal(loan['annual_rate'])
    installment_type = loan['installment_type']
    new_months = previous_months
    if strategy == 'shorten_term':
        current_payment = pending[0]['amount_cents']
        for candidate in range(1, previous_months + 1):
            if calculate_first_loan_payment(
                new_principal, candidate, annual_rate, installment_type
            ) <= current_payment:
                new_months = candidate
                break
    first_number = pending[0]['installment_number']
    first_due = date.fromisoformat(pending[0]['due_date'])
    preview_rows = loan_schedule_rows(
        new_principal, new_months, annual_rate, installment_type,
        first_number, first_due, loan['preferred_payment_day'],
    )
    old_interest = sum(item['interest_cents'] for item in pending)
    new_interest = sum(item[3] for item in preview_rows)
    interest_saved = max(0, old_interest - new_interest)
    stamp = now_iso()
    try:
        db.execute('BEGIN IMMEDIATE')
        debited = db.execute(
            'UPDATE users SET balance_cents = balance_cents - ? WHERE id = ? AND balance_cents >= ?',
            (amount, user['id'], amount),
        )
        if debited.rowcount != 1:
            raise ValueError('Brak wystarczających środków.')
        db.execute(
            "DELETE FROM loan_installments WHERE loan_id = ? AND status = 'pending'",
            (loan_id,),
        )
        db.executemany(
            """INSERT INTO loan_installments
            (loan_id, installment_number, due_date, principal_cents,
             interest_cents, amount_cents, status)
            VALUES (?, ?, ?, ?, ?, ?, 'pending')""",
            [(loan_id, number, due, principal, interest, installment_amount)
             for number, due, principal, interest, installment_amount in preview_rows],
        )
        total_months = first_number - 1 + new_months
        db.execute(
            """UPDATE loan_applications SET months = ?, monthly_payment_cents = ?
            WHERE id = ?""",
            (total_months, preview_rows[0][4], loan_id),
        )
        db.execute(
            """INSERT INTO loan_overpayments
            (loan_id, user_id, amount_cents, strategy, previous_remaining_months,
             new_remaining_months, interest_saved_cents, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
            (loan_id, user['id'], amount, strategy, previous_months,
             new_months, interest_saved, stamp),
        )
        db.execute(
            """INSERT INTO transactions
            (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
            VALUES (?, 'debit', ?, ?, 'NovaBank Kredyty', 'KREDYT-NADPLATA', ?)""",
            (user['id'], amount, f"Nadpłata kredytu KR-{loan_id:06d}", stamp),
        )
        action_label = 'obniżono kolejne raty' if strategy == 'reduce_payment' else f'skrócono okres do {new_months} rat'
        add_notification(
            user['id'], 'Nadpłata kredytu wykonana',
            f"Nadpłacono {money(amount)} — {action_label}. Oszczędność na odsetkach: {money(interest_saved)}.",
            'success',
        )
        warn_about_low_balance(user['id'], user['balance_cents'] - amount)
        db.commit()
    except (sqlite3.Error, ValueError) as exc:
        db.rollback()
        flash(str(exc), 'error')
    else:
        flash(
            f"Nadpłata została wykonana. Nowy harmonogram ma {new_months} rat, "
            f"a oszczędność na odsetkach wynosi {money(interest_saved)}.",
            'success',
        )
    return redirect(url_for('loan_schedule', loan_id=loan_id))


@app.post('/loans/<int:loan_id>/restructure')
@login_required
def restructure_loan(loan_id):
    if not valid_csrf():
        abort(400)
    new_remaining_months = request.form.get('new_remaining_months', type=int)
    reason = request.form.get('reason', '').strip()
    db = get_db()
    loan = db.execute(
        "SELECT * FROM loan_applications WHERE id = ? AND user_id = ? AND status = 'approved'",
        (loan_id, session['user_id']),
    ).fetchone()
    if loan is None:
        abort(404)
    ensure_loan_schedule(loan_id)
    db.commit()
    pending = db.execute(
        """SELECT * FROM loan_installments
        WHERE loan_id = ? AND status = 'pending' ORDER BY installment_number""",
        (loan_id,),
    ).fetchall()
    if not pending:
        flash('Spłacony kredyt nie wymaga restrukturyzacji.', 'info')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    paid_count = db.execute(
        "SELECT COUNT(*) FROM loan_installments WHERE loan_id = ? AND status = 'paid'",
        (loan_id,),
    ).fetchone()[0]
    current_remaining = len(pending)
    maximum_remaining = 120 - paid_count
    if new_remaining_months is None or not current_remaining < new_remaining_months <= maximum_remaining:
        flash(
            f'Nowy okres musi wynosić od {current_remaining + 1} do {maximum_remaining} pozostałych rat.',
            'error',
        )
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    if len(reason) < 5:
        flash('Podaj krótki powód restrukturyzacji.', 'error')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    principal = sum(item['principal_cents'] for item in pending)
    first_number = pending[0]['installment_number']
    first_due = date.fromisoformat(pending[0]['due_date'])
    if first_due <= date.today():
        first_due = loan_due_date(date.today(), 1, loan['preferred_payment_day'])
    rows = loan_schedule_rows(
        principal, new_remaining_months, Decimal(loan['annual_rate']),
        loan['installment_type'], first_number, first_due,
        loan['preferred_payment_day'],
    )
    old_payment = pending[0]['amount_cents']
    new_payment = rows[0][4]
    stamp = now_iso()
    try:
        db.execute('BEGIN IMMEDIATE')
        db.execute(
            "DELETE FROM loan_installments WHERE loan_id = ? AND status = 'pending'",
            (loan_id,),
        )
        db.executemany(
            """INSERT INTO loan_installments
            (loan_id, installment_number, due_date, principal_cents,
             interest_cents, amount_cents, status)
            VALUES (?, ?, ?, ?, ?, ?, 'pending')""",
            [(loan_id, number, due, capital, interest, amount)
             for number, due, capital, interest, amount in rows],
        )
        db.execute(
            """UPDATE loan_applications SET months = ?, monthly_payment_cents = ?,
            decision_reason = ? WHERE id = ?""",
            (paid_count + new_remaining_months, new_payment,
             f"Restrukturyzacja zaakceptowana: {reason}", loan_id),
        )
        db.execute(
            """INSERT INTO loan_contract_changes
            (loan_id, user_id, change_type, old_value, new_value, details, created_at)
            VALUES (?, ?, 'restructuring', ?, ?, ?, ?)""",
            (loan_id, session['user_id'], str(current_remaining),
             str(new_remaining_months),
             f"Powód: {reason}. Rata {money(old_payment)} → {money(new_payment)}", stamp),
        )
        add_notification(
            session['user_id'], 'Restrukturyzacja kredytu zaakceptowana',
            f"Kredyt KR-{loan_id:06d}: liczba pozostałych rat wzrosła z "
            f"{current_remaining} do {new_remaining_months}, a pierwsza nowa rata wynosi {money(new_payment)}.",
            'success',
        )
        db.commit()
    except sqlite3.Error as exc:
        db.rollback()
        flash(f'Nie udało się zapisać restrukturyzacji: {exc}', 'error')
    else:
        flash(
            f'Restrukturyzacja została zaakceptowana. Nowa rata wynosi {money(new_payment)}.',
            'success',
        )
    return redirect(url_for('loan_schedule', loan_id=loan_id))


