@app.post('/deposits/<int:deposit_id>/close')
@login_required
def close_deposit(deposit_id):
    if not valid_csrf():
        abort(400)
    db = get_db()
    deposit = db.execute(
        "SELECT * FROM term_deposits WHERE id = ? AND user_id = ? AND status = 'active'",
        (deposit_id, session['user_id']),
    ).fetchone()
    if deposit is None:
        abort(404)
    matured = date.today() >= date.fromisoformat(deposit['maturity_date'])
    interest = deposit['expected_interest_cents'] if matured else 0
    payout = deposit['principal_cents'] + interest
    status = 'completed' if matured else 'broken'
    stamp = now_iso()
    try:
        db.execute('BEGIN IMMEDIATE')
        changed = db.execute(
            """UPDATE term_deposits SET status = ?, closed_at = ?,
            paid_interest_cents = ?, payout_cents = ?
            WHERE id = ? AND user_id = ? AND status = 'active'""",
            (status, stamp, interest, payout, deposit_id, session['user_id']),
        )
        if changed.rowcount != 1:
            raise ValueError('Lokata została już zakończona.')
        db.execute('UPDATE users SET balance_cents = balance_cents + ? WHERE id = ?', (payout, session['user_id']))
        db.execute(
            """INSERT INTO transactions
            (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
            VALUES (?, 'credit', ?, ?, 'NovaBank Lokaty', 'LOKATA', ?)""",
            (session['user_id'], payout, f"Wypłata lokaty LK-{deposit_id:06d}", stamp),
        )
        if matured:
            add_notification(session['user_id'], 'Lokata zakończona', f"Wypłacono {money(payout)}, w tym {money(interest)} odsetek.", 'success')
        else:
            add_notification(session['user_id'], 'Lokata zerwana przed terminem', f"Na rachunek wrócił kapitał {money(payout)}. Odsetki nie zostały naliczone.", 'warning')
        db.commit()
    except (sqlite3.Error, ValueError) as exc:
        db.rollback()
        flash(str(exc), 'error')
    else:
        flash('Lokata została zakończona.' if matured else 'Lokata została zerwana, a kapitał wrócił na rachunek.', 'success')
    return redirect(url_for('deposits'))


