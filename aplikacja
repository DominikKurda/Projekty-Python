def next_monthly_day(payment_day: int, *, after: date | None = None) -> date:
    reference = after or date.today()
    candidate = reference.replace(day=min(payment_day, 28))
    if candidate < reference:
        candidate = next_month(candidate).replace(day=min(payment_day, 28))
    return candidate


def process_due_junior_allowances(user_id: int) -> None:
    """Realizuje kieszonkowe, gdy zaloguje się opiekun albo dziecko."""
    db = get_db()
    today = date.today()
    rows = db.execute(
        """SELECT a.*, j.first_name AS junior_first, j.last_name AS junior_last,
        g.first_name AS guardian_first, g.last_name AS guardian_last
        FROM junior_allowances a
        JOIN users j ON j.id = a.junior_user_id
        JOIN users g ON g.id = a.guardian_user_id
        WHERE a.status = 'active' AND a.next_execution <= ?
          AND (a.guardian_user_id = ? OR a.junior_user_id = ?)
        ORDER BY a.next_execution, a.id""",
        (today.isoformat(), user_id, user_id),
    ).fetchall()
    for item in rows:
        stamp = now_iso()
        try:
            db.execute('BEGIN IMMEDIATE')
            changed = db.execute(
                """UPDATE users SET balance_cents = balance_cents - ?
                WHERE id = ? AND balance_cents >= ?""",
                (item['amount_cents'], item['guardian_user_id'], item['amount_cents']),
            )
            if changed.rowcount != 1:
                db.execute("UPDATE junior_allowances SET status = 'paused' WHERE id = ?", (item['id'],))
                add_notification(
                    item['guardian_user_id'], 'Kieszonkowe zostało wstrzymane',
                    f"Brak środków na kieszonkowe dla {item['junior_first']}: {money(item['amount_cents'])}.",
                    'warning', operation_type='junior_allowance',
                    operation_reference=f"KIESZ-{item['id']:06d}",
                )
                db.commit()
                continue
            db.execute(
                'UPDATE users SET balance_cents = balance_cents + ? WHERE id = ?',
                (item['amount_cents'], item['junior_user_id']),
            )
            guardian = f"{item['guardian_first']} {item['guardian_last']}"
            junior = f"{item['junior_first']} {item['junior_last']}"
            db.execute(
                """INSERT INTO transactions
                (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
                VALUES (?, 'debit', ?, 'Regularne kieszonkowe', ?, 'JUNIOR', ?)""",
                (item['guardian_user_id'], item['amount_cents'], junior, stamp),
            )
            junior_tx = db.execute(
                """INSERT INTO transactions
                (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
                VALUES (?, 'credit', ?, 'Regularne kieszonkowe', ?, 'GUARDIAN', ?)""",
                (item['junior_user_id'], item['amount_cents'], guardian, stamp),
            )
            scheduled = date.fromisoformat(item['next_execution'])
            future = next_month(scheduled).replace(day=item['payment_day'])
            while future <= today:
                future = next_month(future).replace(day=item['payment_day'])
            db.execute(
                """UPDATE junior_allowances SET next_execution = ?, last_executed_at = ?
                WHERE id = ?""",
                (future.isoformat(), stamp, item['id']),
            )
            add_notification(
                item['junior_user_id'], 'Otrzymano kieszonkowe',
                f"Opiekun przekazał Ci {money(item['amount_cents'])}.", 'success',
                operation_type='junior_allowance', operation_reference=f"KIESZ-{item['id']:06d}",
                amount_cents=item['amount_cents'], counterparty=guardian,
                related_transaction_id=junior_tx.lastrowid,
            )
            db.commit()
        except (sqlite3.Error, ValueError):
            db.rollback()


def process_due_joint_contributions(user_id: int) -> None:
    """Automatyczne miesięczne wpłaty właściciela na aktywne konto wspólne."""
    db = get_db()
    today = date.today()
    rows = db.execute(
        """SELECT c.*, a.name AS account_name, a.account_number,
        u.first_name, u.last_name, u.account_number AS user_account
        FROM joint_recurring_contributions c
        JOIN joint_accounts a ON a.id = c.account_id
        JOIN users u ON u.id = c.user_id
        WHERE c.user_id = ? AND c.status = 'active' AND c.next_execution <= ?
          AND a.status = 'active' AND a.activation_status = 'active'
        ORDER BY c.next_execution, c.id""",
        (user_id, today.isoformat()),
    ).fetchall()
    for item in rows:
        stamp = now_iso()
        try:
            db.execute('BEGIN IMMEDIATE')
            changed = db.execute(
                'UPDATE users SET balance_cents = balance_cents - ? WHERE id = ? AND balance_cents >= ?',
                (item['amount_cents'], user_id, item['amount_cents']),
            )
            if changed.rowcount != 1:
                db.execute("UPDATE joint_recurring_contributions SET status = 'paused' WHERE id = ?", (item['id'],))
                add_notification(
                    user_id, 'Cykliczna wpłata wstrzymana',
                    f"Brak środków na wpłatę {money(item['amount_cents'])} do „{item['account_name']}”.",
                    'warning', operation_type='joint_contribution',
                    operation_reference=f"WSP-CYK-{item['id']:06d}",
                )
                db.commit()
                continue
            db.execute('UPDATE joint_accounts SET balance_cents = balance_cents + ? WHERE id = ?',
                       (item['amount_cents'], item['account_id']))
            db.execute(
                """INSERT INTO transactions
                (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
                VALUES (?, 'debit', ?, ?, ?, ?, ?)""",
                (user_id, item['amount_cents'], 'Cykliczna wpłata na konto wspólne',
                 item['account_name'], item['account_number'], stamp),
            )
            db.execute(
                """INSERT INTO joint_transactions
                (account_id, kind, amount_cents, title, counterparty,
                 counterparty_account, performed_by, created_at)
                VALUES (?, 'credit', ?, 'Cykliczna wpłata właściciela', ?, ?, ?, ?)""",
                (item['account_id'], item['amount_cents'],
                 f"{item['first_name']} {item['last_name']}", item['user_account'], user_id, stamp),
            )
            scheduled = date.fromisoformat(item['next_execution'])
            future = next_month(scheduled).replace(day=item['payment_day'])
            while future <= today:
                future = next_month(future).replace(day=item['payment_day'])
            db.execute(
                """UPDATE joint_recurring_contributions
                SET next_execution = ?, last_executed_at = ? WHERE id = ?""",
                (future.isoformat(), stamp, item['id']),
            )
            notify_joint_members(
                item['account_id'], 'Cykliczna wpłata na konto wspólne',
                f"{item['first_name']} wpłacił(a) {money(item['amount_cents'])}.",
                'success', operation_reference=f"WSP-CYK-{item['id']:06d}",
                amount_cents=item['amount_cents'],
                counterparty=f"{item['first_name']} {item['last_name']}",
            )
            db.commit()
        except (sqlite3.Error, ValueError):
            db.rollback()


def process_due_loan_installments(user_id: int) -> None:
    """Automatycznie pobiera wymagalne raty przy aktywności klienta."""
    db = get_db()
    due_installments = db.execute(
        """SELECT i.*, l.id AS loan_number
        FROM loan_installments i
        JOIN loan_applications l ON l.id = i.loan_id
        WHERE l.user_id = ? AND l.status = 'approved'
          AND i.status = 'pending' AND i.due_date <= ?
        ORDER BY i.due_date, i.installment_number""",
        (user_id, date.today().isoformat()),
    ).fetchall()
    for installment in due_installments:
        user = db.execute('SELECT * FROM users WHERE id = ?', (user_id,)).fetchone()
        reference = f"RATA-{installment['id']:08d}"
        if user['balance_cents'] < installment['amount_cents']:
            exists = db.execute(
                """SELECT 1 FROM notifications
                WHERE user_id = ? AND operation_reference = ?""",
                (user_id, reference),
            ).fetchone()
            if not exists:
                add_notification(
                    user_id, 'Nie udało się pobrać raty kredytu',
                    f"Rata nr {installment['installment_number']} kredytu "
                    f"KR-{installment['loan_number']:06d} wymaga "
                    f"{money(installment['amount_cents'])}. Uzupełnij saldo i zapłać ją ręcznie.",
                    'warning', operation_type='loan_installment_failed',
                    operation_reference=reference,
                    amount_cents=installment['amount_cents'],
                    counterparty='NovaBank Kredyty',
                )
                db.commit()
            continue
        stamp = now_iso()
        try:
            db.execute('BEGIN IMMEDIATE')
            debited = db.execute(
                'UPDATE users SET balance_cents = balance_cents - ? WHERE id = ? AND balance_cents >= ?',
                (installment['amount_cents'], user_id, installment['amount_cents']),
            )
            paid = db.execute(
                """UPDATE loan_installments SET status = 'paid', paid_at = ?,
                paid_amount_cents = amount_cents, payment_method = 'regular'
                WHERE id = ? AND status = 'pending'""",
                (stamp, installment['id']),
            )
            if debited.rowcount != 1 or paid.rowcount != 1:
                raise ValueError('Rata została już rozliczona albo brakuje środków.')
            transaction = db.execute(
                """INSERT INTO transactions
                (user_id, kind, amount_cents, title, counterparty,
                 counterparty_account, created_at)
                VALUES (?, 'debit', ?, ?, 'NovaBank Kredyty', 'KREDYT-RATA', ?)""",
                (user_id, installment['amount_cents'],
                 f"Automatyczna rata {installment['installment_number']} "
                 f"kredytu KR-{installment['loan_number']:06d}", stamp),
            )
            add_notification(
                user_id, 'Rata kredytu pobrana automatycznie',
                f"Zapłacono ratę nr {installment['installment_number']} w wysokości "
                f"{money(installment['amount_cents'])}.",
                'success', operation_type='loan_installment_paid',
                operation_reference=reference,
                amount_cents=installment['amount_cents'],
                counterparty='NovaBank Kredyty',
                related_transaction_id=transaction.lastrowid,
            )
            remaining = db.execute(
                "SELECT COUNT(*) FROM loan_installments WHERE loan_id = ? AND status = 'pending'",
                (installment['loan_id'],),
            ).fetchone()[0]
            if remaining == 0:
                add_notification(
                    user_id, 'Kredyt spłacony',
                    f"Kredyt KR-{installment['loan_number']:06d} został całkowicie spłacony.",
                    'success',
                )
            warn_about_low_balance(user_id, user['balance_cents'] - installment['amount_cents'])
            db.commit()
        except (sqlite3.Error, ValueError):
            db.rollback()


@app.before_request
def execute_due_transfers_once_per_request():
    user_id = session.get("user_id")
    if not user_id:
        return None
    access = current_access()
    if access is None or access["locked"]:
        session.clear()
        flash("To konto jest zablokowane. Skontaktuj się z bankiem.", "error")
        return redirect(url_for("login"))
    admin_endpoints = {
        "admin_dashboard", "admin_customers", "admin_toggle_user",
        "admin_customer_details", "admin_top_up", "admin_transactions", "admin_loans",
        "admin_review_loan", "admin_tickets", "admin_audit_log_view",
        "ticket_details", "ticket_reply", "logout", "home", "static",
    }
    if access["role"] == "admin":
        if request.endpoint not in admin_endpoints:
            return redirect(url_for("admin_dashboard"))
        return None
    if not getattr(g, "scheduled_transfers_checked", False):
        g.scheduled_transfers_checked = True
        process_due_scheduled_transfers(user_id)
        process_due_junior_allowances(user_id)
        process_due_joint_contributions(user_id)
        process_due_loan_installments(user_id)
    context = active_account_context()
    if context and context['type'] == 'junior':
        junior_allowed = {
            'dashboard', 'transactions', 'transfer', 'transfer_done',
            'transfer_limits', 'cards', 'switch_account_context',
            'junior_control', 'junior_transfer_decision', 'junior_allowance_toggle',
            'account_consents', 'logout', 'home', 'static',
        }
        if request.endpoint not in junior_allowed:
            flash('W trybie opiekuna ta funkcja nie jest dostępna. Wróć do swojego konta, aby z niej skorzystać.', 'info')
            return redirect(url_for('dashboard'))
    if context and context['type'] == 'joint':
        joint_allowed = {
            'joint_account', 'joint_invitation_decision', 'joint_transfer_decision',
            'cancel_joint_transfer', 'joint_contribution_toggle', 'transactions', 'switch_account_context',
            'account_consents', 'logout', 'home', 'static',
        }
        if request.endpoint == 'dashboard':
            return redirect(url_for('joint_account', account_id=context['id']))
        if request.endpoint not in joint_allowed:
            flash('Ta funkcja dotyczy konta osobistego. Najpierw przełącz rachunek.', 'info')
            return redirect(url_for('joint_account', account_id=context['id']))
    return None


