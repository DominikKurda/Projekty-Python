        else:
            result.update(intent='recipient_history', answer='Nie znalazłem wskazanego odbiorcy. Podaj jego imię.')
        return result

    transactions = db.execute(
        """SELECT * FROM transactions
        WHERE user_id = ? AND created_at >= ? AND created_at < ? ORDER BY id DESC""",
        (user['id'], month_start, next_month_start),
    ).fetchall()
    expenses = sum(item['amount_cents'] for item in transactions if item['kind'] == 'debit')
    income = sum(item['amount_cents'] for item in transactions if item['kind'] == 'credit')

    if any(phrase in normalized for phrase in ('najwiecej', 'kategoria', 'na co wyd')):
        categories = {}
        for item in transactions:
            if item['kind'] == 'debit':
                category = operation_category(item)
                categories[category] = categories.get(category, 0) + item['amount_cents']
        if categories:
            name, amount = max(categories.items(), key=lambda pair: pair[1])
            answer = f"W tym miesiącu najwięcej wydałeś w kategorii „{name}”: {money(amount)}."
        else:
            answer = 'W tym miesiącu nie masz jeszcze wydatków do przeanalizowania.'
        result.update(intent='top_category', answer=answer,
                      action_url=url_for('transactions', kind='debit'), action_label='Pokaż wydatki')
