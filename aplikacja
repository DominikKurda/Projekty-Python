def get_db() -> sqlite3.Connection:
    if "db" not in g:
        g.db = sqlite3.connect(DATABASE, timeout=10)
        g.db.row_factory = sqlite3.Row
        g.db.execute("PRAGMA foreign_keys = ON")
    return g.db


@app.teardown_appcontext
def close_db(_error=None) -> None:
    db = g.pop("db", None)
    if db is not None:
        db.close()


def normalize_account_number(value: str) -> str:
    """Usuwa odstępy z numeru rachunku i ujednolica kod kraju."""
    return re.sub(r"\s+", "", value or "").upper()


def valid_polish_iban(value: str) -> bool:
    """Sprawdza format i sumę kontrolną polskiego numeru IBAN."""
    iban = normalize_account_number(value)
    if not re.fullmatch(r"PL\d{26}", iban):
        return False
    rearranged = iban[4:] + "2521" + iban[2:4]  # P=25, L=21
    remainder = 0
    for digit in rearranged:
        remainder = (remainder * 10 + int(digit)) % 97
    return remainder == 1


def account_validation_error(value: str) -> str | None:
    iban = normalize_account_number(value)
    if not re.fullmatch(r"PL\d{26}", iban):
        return "Numer rachunku musi zaczynać się od PL i zawierać dokładnie 26 cyfr."
    if not valid_polish_iban(iban):
        return "Numer rachunku ma nieprawidłową sumę kontrolną IBAN."
    return None


def account_number() -> str:
    """Generuje polski IBAN: dwie cyfry kontrolne i 24-cyfrowy BBAN."""
    bban = "".join(str(secrets.randbelow(10)) for _ in range(24))
    check_digits = 98 - (int(bban + "252100") % 97)
    return f"PL{check_digits:02d}{bban}"


def visa_card_number(user_id: int) -> str:
    """Tworzy stabilny demonstracyjny numer VISA z prawidłową cyfrą Luhna."""
    body = "4" + f"{(user_id * 79190000000001 + 48210000000000) % 10**14:014d}"
    total = 0
    for index, digit in enumerate(body):
        value = int(digit) * (2 if index % 2 == 0 else 1)
        total += value - 9 if value > 9 else value
    return body + str((10 - total % 10) % 10)


def visa_cvv(user_id: int) -> str:
    """Stabilny, wyłącznie demonstracyjny kod CVV."""
    return f"{(user_id * 137 + 421) % 1000:03d}"


