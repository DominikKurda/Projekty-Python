                    raise ValueError('Kwota przekracza aktualny limit pojedynczego przelewu.')
                if live_daily_used + amount_cents > live_limits['daily_limit_cents']:
                    raise ValueError('Kwota przekracza aktualny dzienny limit przelewów.')
                previous = db.execute('SELECT transaction_id FROM transfer_requests WHERE token = ? AND user_id = ?', (signed['nonce'], user['id'])).fetchone()
                if previous:
                    db.rollback()
                    return redirect(url_for('transfer_done', transaction_id=previous['transaction_id']))
                db.execute('INSERT INTO transfer_requests(token, user_id) VALUES (?, ?)', (signed['nonce'], user['id']))
                updated = db.execute(
                    """
                    UPDATE users SET balance_cents = balance_cents - ?
                    WHERE id = ? AND balance_cents >= ?
                    """,
                    (amount_cents, user["id"], amount_cents),
                )
                if updated.rowcount != 1:
                    raise ValueError("Brak wystarczających środków.")
                db.execute(
                    "UPDATE users SET balance_cents = balance_cents + ? WHERE id = ?",
                    (amount_cents, recipient_user["id"]),
                )
                debit = db.execute(
                    """INSERT INTO transactions
                    (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
                    VALUES (?, 'debit', ?, ?, ?, ?, ?)""",
                    (user["id"], amount_cents, values["title"], values["recipient"], clean_account, stamp),
                )
                credit = db.execute(
                    """INSERT INTO transactions
                    (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
                    VALUES (?, 'credit', ?, ?, ?, ?, ?)""",
