            action_url=url_for('transactions', kind='debit'), action_label='Pokaż wydatki',
        )
        return result

    if any(word in normalized for word in ('odlozyc', 'oszczedz', 'zostanie do konca')):
        surplus = max(0, income - expenses)
        suggestion = round(surplus * 20 / 100)
        result.update(
            intent='savings',
            answer=(f"W tym miesiącu wpływy wynoszą {money(income)}, a wydatki {money(expenses)}. "
                    f"Ostrożna propozycja oszczędności to 20% nadwyżki, czyli {money(suggestion)}."),
            action_url=url_for('goals'), action_label='Otwórz cele oszczędnościowe',
        )
        return result

    result['answer'] = ('Mogę sprawdzić saldo, miesięczne wydatki, największą kategorię, raty kredytu, '
                        'kalendarz, punkty NovaClub i bezpieczeństwo. Mogę też przygotować szkic przelewu, '
                        'np. „Przygotuj przelew 100 zł do Anny”.')
    return result


