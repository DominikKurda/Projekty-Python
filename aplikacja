    pending = db.execute(
        """SELECT * FROM loan_installments
        WHERE loan_id = ? AND status = 'pending' ORDER BY installment_number""",
        (loan_id,),
    ).fetchall()
    if count is None or count < 2 or count > len(pending):
        flash('Wybierz od 2 do liczby wszystkich pozostałych rat.', 'error')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    selected = pending[:count]
    total = sum(item['amount_cents'] for item in selected)
    user = current_user()
    if user['balance_cents'] < total:
        add_notification(
            user['id'], 'Brak środków na spłatę kilku rat',
