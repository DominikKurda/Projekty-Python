@app.post('/payment-requests/<int:request_id>/decision')
@login_required
def decide_payment_request(request_id):
    if not valid_csrf():
        abort(400)
    decision = request.form.get('decision')
    if decision not in ('accept', 'reject'):
        abort(400)
    return_url = url_for('transfer') if request.form.get('return_to') == 'transfer' else url_for('payment_requests')
    db = get_db()
    payment_request = db.execute(
        """SELECT r.*, requester.first_name AS requester_first,
        requester.last_name AS requester_last, requester.account_number AS requester_account,
        payer.first_name AS payer_first, payer.last_name AS payer_last,
        payer.account_number AS payer_account, payer.balance_cents AS payer_balance
        FROM payment_requests r
        JOIN users requester ON requester.id = r.requester_id
        JOIN users payer ON payer.id = r.payer_id
        WHERE r.id = ? AND r.payer_id = ?""",
        (request_id, session['user_id']),
    ).fetchone()
    if payment_request is None:
        abort(404)
    if payment_request['status'] != 'pending':
        flash('Ta prośba została już rozpatrzona.', 'info')
        return redirect(return_url)
    stamp = now_iso()
    requester_name = f"{payment_request['requester_first']} {payment_request['requester_last']}"
    payer_name = f"{payment_request['payer_first']} {payment_request['payer_last']}"
    if decision == 'reject':
        changed = db.execute(
            """UPDATE payment_requests SET status = 'rejected', responded_at = ?
            WHERE id = ? AND payer_id = ? AND status = 'pending'""",
            (stamp, request_id, session['user_id']),
        )
        if changed.rowcount != 1:
            flash('Ta prośba została już rozpatrzona.', 'info')
        else:
            db.execute(
                """UPDATE notifications SET is_read = 1
                WHERE user_id = ? AND operation_type = 'payment_request'
                AND operation_reference = ?""",
                (session['user_id'], f"PRO-{request_id:06d}"),
            )
            add_notification(
                payment_request['requester_id'], 'Prośba o przelew odrzucona',
                f"{payer_name} odrzucił prośbę „{payment_request['title']}” na {money(payment_request['amount_cents'])}.",
                'warning',
            )
            db.commit()
            flash('Prośba została odrzucona.', 'success')
        return redirect(return_url)

    limits = get_transfer_limits(session['user_id'])
    used_today = direct_transfers_today(session['user_id'])
    if payment_request['amount_cents'] > limits['single_limit_cents']:
        flash('Kwota prośby przekracza limit pojedynczego przelewu.', 'error')
        return redirect(return_url)
    if used_today + payment_request['amount_cents'] > limits['daily_limit_cents']:
        flash('Opłacenie prośby przekroczyłoby dzienny limit przelewów.', 'error')
        return redirect(return_url)

    try:
        db.execute('BEGIN IMMEDIATE')
        live_limits = db.execute(
            'SELECT * FROM transfer_limits WHERE user_id = ?', (session['user_id'],)
        ).fetchone()
        live_used = db.execute(
            """SELECT COALESCE(SUM(amount_cents), 0) FROM transactions
            WHERE user_id = ? AND kind = 'debit' AND counterparty_account LIKE 'PL%'
            AND substr(created_at, 1, 10) = ?""",
            (session['user_id'], date.today().isoformat()),
        ).fetchone()[0]
        if payment_request['amount_cents'] > live_limits['single_limit_cents']:
            raise ValueError('Kwota prośby przekracza aktualny limit pojedynczego przelewu.')
        if live_used + payment_request['amount_cents'] > live_limits['daily_limit_cents']:
            raise ValueError('Opłacenie prośby przekroczyłoby aktualny dzienny limit przelewów.')
        reserved = db.execute(
            """UPDATE payment_requests SET status = 'accepted', responded_at = ?
            WHERE id = ? AND payer_id = ? AND status = 'pending'""",
            (stamp, request_id, session['user_id']),
        )
        if reserved.rowcount != 1:
            raise ValueError('Ta prośba została już rozpatrzona.')
        debited = db.execute(
            'UPDATE users SET balance_cents = balance_cents - ? WHERE id = ? AND balance_cents >= ?',
            (payment_request['amount_cents'], session['user_id'], payment_request['amount_cents']),
        )
        if debited.rowcount != 1:
            raise ValueError('Brak wystarczających środków do opłacenia prośby.')
        db.execute(
            'UPDATE users SET balance_cents = balance_cents + ? WHERE id = ?',
            (payment_request['amount_cents'], payment_request['requester_id']),
        )
        transaction_title = f"Prośba PRO-{request_id:06d}: {payment_request['title']}"
        debit = db.execute(
            """INSERT INTO transactions
            (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
            VALUES (?, 'debit', ?, ?, ?, ?, ?)""",
            (session['user_id'], payment_request['amount_cents'], transaction_title,
             requester_name, payment_request['requester_account'], stamp),
        )
        credit = db.execute(
            """INSERT INTO transactions
            (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
            VALUES (?, 'credit', ?, ?, ?, ?, ?)""",
            (payment_request['requester_id'], payment_request['amount_cents'], transaction_title,
             payer_name, payment_request['payer_account'], stamp),
        )
        db.execute(
            'UPDATE payment_requests SET transaction_id = ? WHERE id = ?',
            (debit.lastrowid, request_id),
        )
        reference = f"PRO-{request_id:06d}"
        db.execute(
            """UPDATE notifications SET is_read = 1
            WHERE user_id = ? AND operation_type = 'payment_request'
            AND operation_reference = ?""",
            (session['user_id'], reference),
        )
        add_notification(
            session['user_id'], 'Prośba została opłacona',
            f"Tytuł: {payment_request['title']}. Operacja została zaksięgowana.",
            'success', operation_type='request_payment_out',
            operation_reference=reference, amount_cents=payment_request['amount_cents'],
            counterparty=requester_name, related_transaction_id=debit.lastrowid,
        )
        add_notification(
            payment_request['requester_id'], 'Otrzymano pieniądze z prośby',
            f"Tytuł: {payment_request['title']}. Środki są dostępne na rachunku.",
            'success', operation_type='request_payment_in',
            operation_reference=reference, amount_cents=payment_request['amount_cents'],
            counterparty=payer_name, related_transaction_id=credit.lastrowid,
        )
        warn_about_low_balance(
            session['user_id'], payment_request['payer_balance'] - payment_request['amount_cents']
        )
        db.commit()
    except (sqlite3.Error, ValueError) as exc:
        db.rollback()
        flash(str(exc), 'error')
    else:
        flash(f'Prośba {reference} została opłacona.', 'success')
    return redirect(return_url)


