}


@app.route('/deposits', methods=['GET', 'POST'])
@login_required
def deposits():
    user = current_user()
    db = get_db()
    values = {
        'amount': request.form.get('amount', '').strip(),
        'months': request.form.get('months', '12').strip(),
    }
    if request.method == 'POST':
        amount = parse_amount(values['amount'])
        try:
            months = int(values['months'])
        except ValueError:
            months = 0
        rate = DEPOSIT_OFFERS.get(months)
        error = None
        if not valid_csrf():
            error = 'Sesja formularza wygasła. Spróbuj ponownie.'
        elif amount is None or not 50_000 <= amount <= 50_000_000:
            error = 'Kwota lokaty musi wynosić od 500 zł do 500 000 zł.'
        elif rate is None:
            error = 'Wybierz dostępny okres lokaty.'
        elif amount > user['balance_cents']:
            error = 'Brak wystarczających środków na rachunku.'
        if error:
            flash(error, 'error')
        else:
            started = date.today()
            maturity = add_months(started, months)
            interest = calculate_deposit_interest(amount, months, rate)
            stamp = now_iso()
            try:
                db.execute('BEGIN IMMEDIATE')
                changed = db.execute(
                    'UPDATE users SET balance_cents = balance_cents - ? WHERE id = ? AND balance_cents >= ?',
                    (amount, user['id'], amount),
                )
                if changed.rowcount != 1:
                    raise ValueError('Brak wystarczających środków na rachunku.')
                deposit = db.execute(
                    """INSERT INTO term_deposits
                    (user_id, principal_cents, term_months, annual_rate,
                     expected_interest_cents, status, started_at, maturity_date)
                    VALUES (?, ?, ?, ?, ?, 'active', ?, ?)""",
                    (user['id'], amount, months, str(rate), interest, stamp, maturity.isoformat()),
                )
                db.execute(
                    """INSERT INTO transactions
                    (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
                    VALUES (?, 'debit', ?, ?, 'NovaBank Lokaty', 'LOKATA', ?)""",
                    (user['id'], amount, f"Założenie lokaty LK-{deposit.lastrowid:06d}", stamp),
                )
                add_notification(
                    user['id'], 'Lokata została założona',
                    f"Lokata LK-{deposit.lastrowid:06d} na {money(amount)} zakończy się {maturity.strftime('%d.%m.%Y')}.",
                    'success',
                )
                warn_about_low_balance(user['id'], user['balance_cents'] - amount)
                db.commit()
            except (sqlite3.Error, ValueError) as exc:
                db.rollback()
                flash(str(exc), 'error')
            else:
                flash('Lokata została założona.', 'success')
                return redirect(url_for('deposits'))

    rows = db.execute(
        'SELECT * FROM term_deposits WHERE user_id = ? ORDER BY id DESC',
        (user['id'],),
    ).fetchall()
    today = date.today()
    deposit_rows = []
    for row in rows:
        item = dict(row)
        maturity = date.fromisoformat(item['maturity_date'])
        item['days_left'] = max(0, (maturity - today).days)
        item['is_matured'] = item['status'] == 'active' and maturity <= today
        item['projected_payout'] = item['principal_cents'] + item['expected_interest_cents']
        deposit_rows.append(item)
    active_total = sum(item['principal_cents'] for item in deposit_rows if item['status'] == 'active')
    expected_total = sum(item['expected_interest_cents'] for item in deposit_rows if item['status'] == 'active')
    return page('Lokaty', r"""
        <div class="topline"><div><div class="eyebrow">Oszczędności terminowe</div><h2>Lokaty</h2><p class="muted">Wybierz okres, sprawdź odsetki i załóż demonstracyjną lokatę.</p></div></div>
        <section class="grid"><div class="feature"><h3>Środki na lokatach</h3><div class="balance" style="font-size:30px" data-testid="deposits-total">{{ active_total|money }}</div></div><div class="feature"><h3>Planowane odsetki</h3><div class="balance" style="font-size:30px" data-testid="deposits-interest-total">{{ expected_total|money }}</div></div><div class="feature"><h3>Saldo rachunku</h3><div class="balance" style="font-size:30px">{{ user.balance_cents|money }}</div></div></section>
