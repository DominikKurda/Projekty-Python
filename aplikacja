@app.route("/login", methods=["GET", "POST"])
def login():
    if current_user():
        return redirect(url_for("admin_dashboard" if is_admin() else "dashboard"))

    email = request.form.get("email", "").strip()
    if request.method == "POST":
        user = get_db().execute("SELECT * FROM users WHERE email = ?", (email,)).fetchone()
        if not valid_csrf():
            flash("Sesja formularza wygasła. Spróbuj ponownie.", "error")
        elif not user or not check_password_hash(user["password_hash"], request.form.get("password", "")):
            if user:
                record_login_event(user["id"], "failed")
            flash("Nieprawidłowy e-mail lub hasło.", "error")
        else:
            access = get_db().execute(
                "SELECT * FROM user_access WHERE user_id = ?", (user["id"],)
            ).fetchone()
            if access and access["locked"]:
                record_login_event(user["id"], "blocked")
                flash("To konto jest zablokowane. Skontaktuj się z bankiem.", "error")
            elif user['activation_status'] == 'pending_guardian':
                flash(
                    'Konto Junior oczekuje na zgodę opiekuna. Poproś opiekuna '
                    'o zalogowanie się i otwarcie sekcji Zgody.', 'info'
                )
            elif user['activation_status'] == 'rejected':
                flash(
                    'Opiekun nie wyraził zgody na aktywację Konta Junior. '
                    'Skontaktuj się z bankiem.', 'error'
                )
            else:
                new_device = record_login_event(user["id"], "success")
                session.clear()
                session["user_id"] = user["id"]
                session["csrf_token"] = secrets.token_urlsafe(32)
                flash(f"Witaj ponownie, {user['first_name']}!", "success")
                if new_device:
                    flash("Wykryto logowanie z nowego urządzenia. Sprawdź historię logowań.", "warning")
                return redirect(url_for("admin_dashboard" if access and access["role"] == "admin" else "dashboard"))

