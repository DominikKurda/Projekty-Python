        if recipient:
            rows = db.execute(
                """SELECT * FROM transactions
                WHERE user_id = ? AND counterparty_account = ? ORDER BY id DESC LIMIT 5""",
                (user['id'], recipient['account_number']),
            ).fetchall()
            if rows:
                lines = [f"• {item['created_at'][:10]}: {money(item['amount_cents'])} — {item['title']}" for item in rows]
                answer = f"Ostatnie operacje z {recipient['first_name']} {recipient['last_name']}:\n" + '\n'.join(lines)
