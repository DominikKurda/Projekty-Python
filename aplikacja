@app.post('/loans/<int:loan_id>/installments/<int:installment_id>/pay')
@login_required
def pay_loan_installment(loan_id, installment_id):
    if not valid_csrf():
        abort(400)
    db = get_db()
    loan = db.execute(
        "SELECT * FROM loan_applications WHERE id = ? AND user_id = ? AND status = 'approved'",
        (loan_id, session['user_id']),
    ).fetchone()
    if loan is None:
        abort(404)
    ensure_loan_schedule(loan_id)
    db.commit()
    installment = db.execute(
        "SELECT * FROM loan_installments WHERE id = ? AND loan_id = ? AND status = 'pending'",
        (installment_id, loan_id),
    ).fetchone()
    first_pending = db.execute(
        "SELECT * FROM loan_installments WHERE loan_id = ? AND status = 'pending' ORDER BY installment_number LIMIT 1",
        (loan_id,),
    ).fetchone()
    if installment is None:
        flash('Ta rata została już zapłacona lub nie istnieje.', 'error')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    if first_pending is None or first_pending['id'] != installment['id']:
        flash('Raty należy spłacać w kolejności.', 'error')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    user = current_user()
    if user['balance_cents'] < installment['amount_cents']:
        add_notification(user['id'], 'Brak środków na ratę', f"Do zapłaty raty kredytu KR-{loan_id:06d} potrzeba {money(installment['amount_cents'])}.", 'warning')
        db.commit()
        flash('Brak wystarczających środków na zapłacenie raty.', 'error')
        return redirect(url_for('loan_schedule', loan_id=loan_id))
    stamp = now_iso()
    try:
        db.execute('BEGIN IMMEDIATE')
        changed = db.execute(
            'UPDATE users SET balance_cents = balance_cents - ? WHERE id = ? AND balance_cents >= ?',
            (installment['amount_cents'], user['id'], installment['amount_cents']),
        )
        if changed.rowcount != 1:
            raise ValueError('Brak wystarczających środków.')
        changed = db.execute(
            """UPDATE loan_installments SET status = 'paid', paid_at = ?,
            paid_amount_cents = amount_cents, payment_method = 'regular'
            WHERE id = ? AND status = 'pending'""", (stamp, installment['id'])
        )
        if changed.rowcount != 1:
            raise ValueError('Rata została już zapłacona.')
        db.execute(
            """INSERT INTO transactions
            (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
            VALUES (?, 'debit', ?, ?, 'NovaBank Kredyty', 'KREDYT-RATA', ?)""",
            (user['id'], installment['amount_cents'], f"Rata {installment['installment_number']} kredytu KR-{loan_id:06d}", stamp),
        )
        remaining = db.execute(
            "SELECT COUNT(*) FROM loan_installments WHERE loan_id = ? AND status = 'pending'", (loan_id,)
        ).fetchone()[0]
        add_notification(user['id'], 'Rata kredytu zapłacona', f"Zapłacono ratę nr {installment['installment_number']} w wysokości {money(installment['amount_cents'])}.", 'success')
        if remaining == 0:
            add_notification(user['id'], 'Kredyt spłacony', f"Kredyt KR-{loan_id:06d} został całkowicie spłacony.", 'success')
        warn_about_low_balance(user['id'], user['balance_cents'] - installment['amount_cents'])
        db.commit()
    except (sqlite3.Error, ValueError) as exc:
        db.rollback()
        flash(str(exc), 'error')
    else:
        flash('Rata została zapłacona.', 'success')
    return redirect(url_for('loan_schedule', loan_id=loan_id))


