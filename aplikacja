@app.route("/transfer", methods=["GET", "POST"])
@login_required
def transfer():
    user = financial_user()
    db = get_db()
    limits = get_transfer_limits(user['id'])
    daily_used = direct_transfers_today(user['id'])
    daily_remaining = max(0, limits['daily_limit_cents'] - daily_used)
    saved_beneficiaries = db.execute(
        "SELECT * FROM beneficiaries WHERE user_id = ? ORDER BY name COLLATE NOCASE",
        (user["id"],),
    ).fetchall()
    values = {key: request.form.get(key, "").strip() for key in ("recipient", "account", "amount", "title")}
    account_query = request.args.get("q", "").strip()[:80]
    account_pattern = f"%{account_query}%"
    normalized_pattern = f"%{normalize_account_number(account_query)}%"
    registered_accounts = db.execute(
        """SELECT u.id, u.first_name, u.last_name, u.account_number
        FROM users u JOIN user_access a ON a.user_id = u.id
        WHERE u.id != ? AND a.role = 'customer'
          AND (? = '' OR (u.first_name || ' ' || u.last_name) LIKE ? COLLATE NOCASE
                       OR u.account_number LIKE ?)
        ORDER BY u.first_name COLLATE NOCASE, u.last_name COLLATE NOCASE
        LIMIT 25""",
        (user["id"], account_query, account_pattern, normalized_pattern),
    ).fetchall()
    selected_beneficiary_id = None
    selected_registered_account_id = None
    if request.method == "GET":
        selected_beneficiary_id = request.args.get("beneficiary", type=int)
        if selected_beneficiary_id is not None:
            selected_beneficiary = db.execute(
                "SELECT * FROM beneficiaries WHERE id = ? AND user_id = ?",
                (selected_beneficiary_id, user["id"]),
            ).fetchone()
            if selected_beneficiary is None:
                flash("Nie znaleziono wybranego zapisanego odbiorcy.", "error")
                selected_beneficiary_id = None
            else:
                values["recipient"] = selected_beneficiary["name"]
                values["account"] = selected_beneficiary["account_number"]
        selected_registered_account_id = request.args.get("recipient_user", type=int)
        if selected_registered_account_id is not None:
            selected_account = db.execute(
                """SELECT u.id, u.first_name, u.last_name, u.account_number
                FROM users u JOIN user_access a ON a.user_id = u.id
                WHERE u.id = ? AND u.id != ? AND a.role = 'customer'""",
                (selected_registered_account_id, user["id"]),
            ).fetchone()
            if selected_account is None:
                flash("Nie znaleziono wybranego konta odbiorcy.", "error")
                selected_registered_account_id = None
            else:
                values["recipient"] = f"{selected_account['first_name']} {selected_account['last_name']}"
                values["account"] = selected_account["account_number"]
                suggested_amount = request.args.get('amount', '').strip()
                suggested_title = request.args.get('title', '').strip()
                if parse_amount(suggested_amount) is not None:
                    values['amount'] = suggested_amount
                if suggested_title and len(suggested_title) <= 140:
                    values['title'] = suggested_title

    if request.method == "POST" and request.form.get('step') == 'edit':
        if not valid_csrf():
            abort(400)
    elif request.method == "POST":
        amount_cents = parse_amount(values["amount"])
        clean_account = normalize_account_number(values["account"])
        error = None

        if not valid_csrf():
            error = "Sesja formularza wygasła. Spróbuj ponownie."
        elif not values["recipient"] or not values["title"] or len(values["recipient"]) > 120 or len(values["title"]) > 140:
            error = "Uzupełnij odbiorcę i tytuł przelewu."
        elif account_validation_error(clean_account):
            error = account_validation_error(clean_account)
        elif amount_cents is None:
            error = "Podaj poprawną kwotę większą od 0 zł."
        elif clean_account == user["account_number"]:
            error = "Nie możesz wykonać przelewu na własne konto."
        elif amount_cents > user["balance_cents"]:
            error = "Brak wystarczających środków na koncie."
        elif amount_cents > limits['single_limit_cents']:
            error = f"Kwota przekracza limit pojedynczego przelewu: {money(limits['single_limit_cents'])}."
        elif amount_cents > daily_remaining:
            error = f"Kwota przekracza pozostały dzienny limit: {money(daily_remaining)}."

        recipient_user = None
        name_verified = True
        if not error:
            recipient_user = get_db().execute(
                "SELECT * FROM users WHERE account_number = ?", (clean_account,)
            ).fetchone()
            if not recipient_user:
                error = "W wersji demo przelew jest możliwy tylko na konto użytkownika NovaBank."
            else:
                name_verified = recipient_name_matches(values['recipient'], recipient_user)

        if (not error and request.form.get('step') == 'confirm' and not name_verified
                and request.form.get('confirm_name_mismatch') != '1'):
            flash('Potwierdź świadomie niezgodność nazwy odbiorcy z właścicielem rachunku.', 'error')
            return redirect(url_for('transfer'))

        if error:
            flash(error, "error")
        else:
            serializer = URLSafeTimedSerializer(app.secret_key, salt='transfer-confirmation')
            payload_values = dict(values, account=clean_account)
            token = request.form.get('confirmation', '')
            if request.form.get('step') != 'confirm':
                token = serializer.dumps(dict(user=user['id'], values=payload_values, nonce=secrets.token_urlsafe(32)))
                return page('Podsumowanie przelewu', r"""
                <section class="auth panel panel-pad" data-testid="transfer-summary">
                <p class="muted">1. Dane → <strong aria-current="step">2. Podsumowanie</strong> → 3. Potwierdzenie</p>
