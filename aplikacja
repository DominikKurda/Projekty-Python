def login_device_label(user_agent: str) -> str:
    """Tworzy krótki opis urządzenia na podstawie nagłówka przeglądarki."""
    agent = (user_agent or '').lower()
    if 'edg/' in agent:
        browser = 'Microsoft Edge'
    elif 'firefox/' in agent:
        browser = 'Firefox'
    elif 'chrome/' in agent or 'crios/' in agent:
        browser = 'Google Chrome'
    elif 'safari/' in agent:
        browser = 'Safari'
    else:
        browser = 'Inna przeglądarka'

    if 'windows' in agent:
        system = 'Windows'
    elif 'android' in agent:
        system = 'Android'
    elif 'iphone' in agent or 'ipad' in agent:
        system = 'iOS'
    elif 'mac os' in agent or 'macintosh' in agent:
        system = 'macOS'
    elif 'linux' in agent:
        system = 'Linux'
    else:
        system = 'Nieznany system'
    return f'{browser} · {system}'


