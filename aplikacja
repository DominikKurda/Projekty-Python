                const cents = Number(parts[0]) * 100 + Number((parts[1] || '').padEnd(2, '0'));
                if (cents < 1 || cents > 100000000) { preview.textContent = 'Kwota musi wynosić od 0,01 do 1 000 000.'; return; }
                const code = currency.value, buy = direction.value === 'buy';
                const rate = rates[code][buy ? 1 : 0];
                // Obliczenia całkowitoliczbowe: takie samo zaokrąglenie jak po stronie serwera.
                const pln = Math.floor((cents * rate + 5000) / 10000);
                const afterPLN = plnBalance + (buy ? -pln : pln);
                const afterFX = (balances[code] || 0) + (buy ? cents : -cents);
                preview.textContent = (buy ? 'Zapłacisz ' : 'Otrzymasz ') + fmt(pln, 'PLN') +
                    ' · Kurs: ' + (rate/10000).toFixed(4) + ' PLN. Saldo po wymianie: ' + fmt(afterPLN, 'PLN') + ' i ' + fmt(afterFX, code) +
                    ((afterPLN < 0 || afterFX < 0) ? '. Brak wystarczających środków.' : '. Bez dodatkowej prowizji.');
            }
            [currency, direction, amount].forEach(el => el.addEventListener('input', update));
            if (amount.value) update();
        })();
        </script>
