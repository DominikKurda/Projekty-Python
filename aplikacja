            const fmt = (cents, code) => (cents / 100).toLocaleString('pl-PL', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' ' + code;
            function update() {
                const raw = amount.value.trim().replace(',', '.');
                if (!/^[0-9]{1,7}(?:\.[0-9]{1,2})?$/.test(raw)) { preview.textContent = 'Podaj poprawną kwotę z maksymalnie dwoma miejscami po przecinku.'; return; }
