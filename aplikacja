@login_required
def refund_card_payment(payment_id):
    if not valid_csrf():
        abort(400)
    db = get_db()
    payment = db.execute(
        'SELECT * FROM card_payments WHERE id = ? AND user_id = ?',
        (payment_id, session['user_id']),
    ).fetchone()
    if payment is None:
        abort(404)
    if db.execute(
        """SELECT 1 FROM qa_generated_records
        WHERE user_id = ? AND entity_type = 'card_payment' AND entity_id = ?""",
        (session['user_id'], payment_id),
    ).fetchone():
        flash('To jest izolowana płatność testowa. Zarządzaj nią w Trybie QA.', 'info')
        return redirect(url_for('card_payments'))
    if payment['status'] != 'approved':
        flash('Ta operacja została już zwrócona albo była odrzucona.', 'error')
        return redirect(url_for('card_payments'))
    stamp = now_iso()
    try:
        db.execute('BEGIN IMMEDIATE')
        changed = db.execute(
            "UPDATE card_payments SET status = 'refunded', refunded_at = ? WHERE id = ? AND user_id = ? AND status = 'approved'",
            (stamp, payment_id, session['user_id']),
        )
        if changed.rowcount != 1:
            raise ValueError('Zwrot został już wykonany.')
        db.execute('UPDATE users SET balance_cents = balance_cents + ? WHERE id = ?', (payment['amount_cents'], session['user_id']))
        db.execute(
            """INSERT INTO transactions
            (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
            VALUES (?, 'credit', ?, ?, ?, 'CARD', ?)""",
            (session['user_id'], payment['amount_cents'], f"Zwrot płatności KP-{payment_id:06d}", payment['merchant'], stamp),
        )
        reward_points = int(payment['reward_points'] or 0)
        if reward_points:
            reward_account = db.execute(
                'SELECT points FROM reward_accounts WHERE user_id = ?',
                (session['user_id'],),
            ).fetchone()
            reversed_points = min(reward_points, reward_account['points'] if reward_account else 0)
            if reversed_points:
                db.execute(
                    'UPDATE reward_accounts SET points = points - ? WHERE user_id = ?',
                    (reversed_points, session['user_id']),
                )
                db.execute(
                    """INSERT INTO reward_events
                    (user_id, event_type, points_delta, description,
                     related_card_payment_id, created_at)
                    VALUES (?, 'reversed', ?, ?, ?, ?)""",
                    (session['user_id'], -reversed_points,
                     f"Zwrot płatności w {payment['merchant']}", payment_id, stamp),
                )
        add_notification(session['user_id'], 'Zwrot płatności kartą', f"Na rachunek wróciło {money(payment['amount_cents'])}.", 'success')
        db.commit()
    except (sqlite3.Error, ValueError) as exc:
        db.rollback()
        flash(str(exc), 'error')
    else:
        flash('Zwrot został wykonany.', 'success')
    return redirect(url_for('card_payments'))


