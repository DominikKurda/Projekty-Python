@app.post('/goals/<int:goal_id>/operation')
@login_required
def goal_operation(goal_id):
    if not valid_csrf():
        abort(400)
    db = get_db()
    goal = db.execute(
        "SELECT * FROM savings_goals WHERE id = ? AND user_id = ?",
        (goal_id, session['user_id']),
    ).fetchone()
    if goal is None:
        abort(404)
    kind = request.form.get('kind')
    amount = parse_amount(request.form.get('amount', ''))
    user = current_user()
    if kind not in ('deposit', 'withdraw') or amount is None:
        flash('Podaj poprawną kwotę operacji.', 'error')
    elif kind == 'deposit' and amount > user['balance_cents']:
        flash('Brak wystarczających środków na rachunku.', 'error')
    elif kind == 'withdraw' and amount > goal['balance_cents']:
        flash('Na celu nie ma wystarczających środków.', 'error')
    else:
        stamp = now_iso()
        try:
            db.execute('BEGIN IMMEDIATE')
            if kind == 'deposit':
                changed = db.execute(
                    'UPDATE users SET balance_cents = balance_cents - ? WHERE id = ? AND balance_cents >= ?',
                    (amount, user['id'], amount),
                )
                if changed.rowcount != 1:
                    raise ValueError('Brak wystarczających środków na rachunku.')
                db.execute('UPDATE savings_goals SET balance_cents = balance_cents + ? WHERE id = ?', (amount, goal_id))
                tx_kind, tx_title = 'debit', f"Wpłata na cel: {goal['name']}"
            else:
                changed = db.execute(
                    'UPDATE savings_goals SET balance_cents = balance_cents - ? WHERE id = ? AND balance_cents >= ?',
                    (amount, goal_id, amount),
                )
                if changed.rowcount != 1:
                    raise ValueError('Na celu nie ma wystarczających środków.')
                db.execute('UPDATE users SET balance_cents = balance_cents + ? WHERE id = ?', (amount, user['id']))
                tx_kind, tx_title = 'credit', f"Wypłata z celu: {goal['name']}"
            db.execute(
                "INSERT INTO savings_goal_operations(goal_id, user_id, kind, amount_cents, created_at) VALUES (?, ?, ?, ?, ?)",
                (goal_id, user['id'], kind, amount, stamp),
            )
            db.execute(
                """INSERT INTO transactions
                (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
                VALUES (?, ?, ?, ?, 'Cele NovaBank', 'CEL', ?)""",
                (user['id'], tx_kind, amount, tx_title, stamp),
            )
            new_goal_balance = goal['balance_cents'] + amount if kind == 'deposit' else goal['balance_cents'] - amount
            if kind == 'deposit' and goal['balance_cents'] < goal['target_cents'] <= new_goal_balance:
                add_notification(user['id'], 'Cel osiągnięty!', f"Udało Ci się zebrać środki na cel „{goal['name']}”.", 'success')
            if kind == 'deposit':
                warn_about_low_balance(user['id'], user['balance_cents'] - amount)
            db.commit()
        except (sqlite3.Error, ValueError) as exc:
            db.rollback()
            flash(str(exc), 'error')
        else:
            flash('Wpłata została wykonana.' if kind == 'deposit' else 'Środki wróciły na rachunek.', 'success')
            return redirect(url_for('goal_details', goal_id=goal_id))
    return redirect(url_for('goal_details', goal_id=goal_id))


