@app.post('/junior-consents/<int:request_id>/decision')
@login_required
def junior_consent_decision(request_id):
    if not valid_csrf():
        abort(400)
    decision = request.form.get('decision')
    if decision not in ('accept', 'reject'):
        abort(400)
    db = get_db()
    consent = db.execute(
        """SELECT r.*, u.first_name, u.last_name FROM junior_guardian_requests r
        JOIN users u ON u.id = r.junior_user_id
        WHERE r.id = ? AND r.guardian_user_id = ? AND r.status = 'pending'""",
        (request_id, session['user_id']),
    ).fetchone()
    if consent is None:
        abort(404)
    stamp = now_iso()
    try:
        db.execute('BEGIN IMMEDIATE')
        changed = db.execute(
            """UPDATE junior_guardian_requests SET status = ?, responded_at = ?
            WHERE id = ? AND guardian_user_id = ? AND status = 'pending'""",
            ('accepted' if decision == 'accept' else 'rejected', stamp,
             request_id, session['user_id']),
        )
        if changed.rowcount != 1:
            raise ValueError('Ta zgoda została już rozpatrzona.')
        db.execute(
            'UPDATE users SET activation_status = ? WHERE id = ?',
            ('active' if decision == 'accept' else 'rejected', consent['junior_user_id']),
        )
        if decision == 'accept':
            db.execute(
                """INSERT OR REPLACE INTO junior_settings
                (junior_user_id, guardian_user_id, transfer_approval_threshold_cents,
                 online_payments_blocked_until, updated_at)
                VALUES (?, ?, COALESCE((SELECT transfer_approval_threshold_cents
                FROM junior_settings WHERE junior_user_id = ?), 20000),
                (SELECT online_payments_blocked_until FROM junior_settings
                 WHERE junior_user_id = ?), ?)""",
                (consent['junior_user_id'], session['user_id'], consent['junior_user_id'],
                 consent['junior_user_id'], stamp),
            )
        guardian = current_user()
        add_notification(
            consent['junior_user_id'],
            'Konto Junior zostało aktywowane' if decision == 'accept' else 'Opiekun odrzucił zgodę',
            f"{guardian['first_name']} {guardian['last_name']} " +
            ('wyraził(a) zgodę. Możesz się już zalogować.' if decision == 'accept'
             else 'nie wyraził(a) zgody na aktywację konta.'),
            'success' if decision == 'accept' else 'warning',
        )
        db.commit()
        flash(
            f"Konto Junior użytkownika {consent['first_name']} {consent['last_name']} " +
            ('zostało aktywowane.' if decision == 'accept' else 'nie zostało aktywowane.'),
            'success' if decision == 'accept' else 'info',
        )
    except (sqlite3.Error, ValueError) as exc:
        db.rollback()
        flash(str(exc), 'error')
    return redirect(url_for('account_consents'))


def junior_for_guardian(junior_user_id: int, guardian_user_id: int):
    return get_db().execute(
        """SELECT u.*, r.id AS guardian_request_id
        FROM junior_guardian_requests r JOIN users u ON u.id = r.junior_user_id
        WHERE r.junior_user_id = ? AND r.guardian_user_id = ?
          AND r.status = 'accepted' AND u.activation_status = 'active'""",
        (junior_user_id, guardian_user_id),
    ).fetchone()


def ensure_junior_controls(junior_user_id: int, guardian_user_id: int) -> None:
    db = get_db()
    stamp = now_iso()
    db.execute(
        """INSERT OR IGNORE INTO junior_settings
        (junior_user_id, guardian_user_id, transfer_approval_threshold_cents, updated_at)
        VALUES (?, ?, 20000, ?)""",
        (junior_user_id, guardian_user_id, stamp),
    )
    db.execute('INSERT OR IGNORE INTO card_settings(user_id) VALUES (?)', (junior_user_id,))
    db.execute(
        """INSERT OR IGNORE INTO transfer_limits
        (user_id, single_limit_cents, daily_limit_cents, updated_at)
        VALUES (?, 50000, 100000, ?)""",
        (junior_user_id, stamp),
    )
    phone = db.execute('SELECT phone_number FROM users WHERE id = ?', (junior_user_id,)).fetchone()['phone_number']
    if phone:
        db.execute(
            """INSERT OR IGNORE INTO blik_settings
            (user_id, phone_number, payment_limit, atm_limit, phone_limit)
            VALUES (?, ?, 50000, 50000, 50000)""",
            (junior_user_id, phone),
        )


@app.route('/junior-control', methods=['GET', 'POST'])
@login_required
def junior_control():
    context = active_account_context()
    if not context or context['type'] != 'junior':
        flash('Najpierw wybierz Konto Junior w przełączniku rachunków.', 'info')
        return redirect(url_for('dashboard'))
    db = get_db()
    junior = junior_for_guardian(context['id'], session['user_id'])
    if junior is None:
        abort(403)
    ensure_junior_controls(junior['id'], session['user_id'])
    db.commit()
    if request.method == 'POST':
        if not valid_csrf():
            abort(400)
        action = request.form.get('action', '')
        try:
            if action == 'limits':
                threshold = parse_amount(request.form.get('approval_threshold', ''))
                single = parse_amount(request.form.get('transfer_single', ''))
                daily = parse_amount(request.form.get('transfer_daily', ''))
                card_store = parse_nonnegative_amount(request.form.get('card_store', ''))
                card_atm = parse_nonnegative_amount(request.form.get('card_atm', ''))
                card_online = parse_nonnegative_amount(request.form.get('card_online', ''))
                blik_payment = parse_nonnegative_amount(request.form.get('blik_payment', ''))
                blik_atm = parse_nonnegative_amount(request.form.get('blik_atm', ''))
                blik_phone = parse_nonnegative_amount(request.form.get('blik_phone', ''))
                values = (threshold, single, daily, card_store, card_atm, card_online,
                          blik_payment, blik_atm, blik_phone)
                if any(value is None for value in values):
                    raise ValueError('Wpisz poprawne kwoty limitów.')
                if threshold > 50_000 or single > 50_000 or daily > 100_000 or single > daily:
                    raise ValueError('Próg i limit pojedynczy mogą wynosić maksymalnie 500 zł, a dzienny 1 000 zł.')
                if any(value > 50_000 for value in values[3:]):
                    raise ValueError('Każdy limit karty i BLIK-a może wynosić maksymalnie 500 zł.')
                db.execute('BEGIN IMMEDIATE')
                db.execute(
                    """UPDATE junior_settings SET transfer_approval_threshold_cents = ?,
                    updated_at = ? WHERE junior_user_id = ? AND guardian_user_id = ?""",
                    (threshold, now_iso(), junior['id'], session['user_id']),
                )
                db.execute(
                    """UPDATE transfer_limits SET single_limit_cents = ?, daily_limit_cents = ?,
                    updated_at = ? WHERE user_id = ?""",
                    (single, daily, now_iso(), junior['id']),
                )
                db.execute(
                    """UPDATE card_settings SET payment_limit = ?, atm_limit = ?, online_limit = ?
                    WHERE user_id = ?""", (card_store, card_atm, card_online, junior['id']))
                if db.execute('SELECT 1 FROM blik_settings WHERE user_id = ?', (junior['id'],)).fetchone():
                    db.execute(
                        """UPDATE blik_settings SET payment_limit = ?, atm_limit = ?, phone_limit = ?
                        WHERE user_id = ?""", (blik_payment, blik_atm, blik_phone, junior['id']))
                log_context_action('junior_all_limits', 'Zmieniono limity i próg akceptacji')
                add_notification(junior['id'], 'Opiekun zmienił limity',
                                 'Nowe limity karty, BLIK-a i przelewów są już aktywne.', 'security')
                db.commit()
                flash('Limity Konta Junior zostały zapisane.', 'success')
            elif action == 'online_block':
                days = request.form.get('days', type=int)
                if days not in (1, 7, 30):
                    raise ValueError('Wybierz blokadę na 1, 7 albo 30 dni.')
                blocked_until = (date.today() + timedelta(days=days)).isoformat()
                db.execute(
                    """UPDATE junior_settings SET online_payments_blocked_until = ?, updated_at = ?
                    WHERE junior_user_id = ? AND guardian_user_id = ?""",
                    (blocked_until, now_iso(), junior['id'], session['user_id']),
                )
