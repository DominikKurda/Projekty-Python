CARD_OPERATION_LABELS = {
    'store': 'Płatność w sklepie',
    'online': 'Płatność internetowa',
    'atm': 'Wypłata z bankomatu',
}


@app.route('/card-payments', methods=['GET', 'POST'])
@login_required
def card_payments():
    user = current_user()
    db = get_db()
    db.execute('INSERT OR IGNORE INTO card_settings(user_id) VALUES (?)', (user['id'],))
    db.commit()
    card = db.execute('SELECT * FROM card_settings WHERE user_id = ?', (user['id'],)).fetchone()
    junior_controls = db.execute(
        'SELECT * FROM junior_settings WHERE junior_user_id = ?', (user['id'],)
    ).fetchone()
    values = {
        'operation_type': request.form.get('operation_type', 'store').strip(),
        'merchant': request.form.get('merchant', '').strip(),
        'amount': request.form.get('amount', '').strip(),
    }
    if request.method == 'POST':
        amount = parse_amount(values['amount'])
        operation_type = values['operation_type']
        error = None
        rejection = None
        if not valid_csrf():
            error = 'Sesja formularza wygasła. Spróbuj ponownie.'
        elif operation_type not in CARD_OPERATION_LABELS:
            error = 'Wybierz poprawny rodzaj operacji.'
        elif not values['merchant'] or len(values['merchant']) > 120:
            error = 'Podaj nazwę sklepu lub lokalizację bankomatu.'
        elif amount is None:
            error = 'Podaj poprawną kwotę większą od 0 zł.'
        if error is None:
            limit_column = {'store': 'payment_limit', 'online': 'online_limit', 'atm': 'atm_limit'}[operation_type]
            daily_limit = card[limit_column]
            spent_today = db.execute(
                """SELECT COALESCE(SUM(amount_cents), 0) FROM card_payments
                WHERE user_id = ? AND operation_type = ? AND status = 'approved'
                AND substr(created_at, 1, 10) = ?""",
                (user['id'], operation_type, date.today().isoformat()),
            ).fetchone()[0]
            remaining_limit = max(0, daily_limit - spent_today)
            if (operation_type == 'online' and junior_controls
                    and junior_controls['online_payments_blocked_until']
                    and junior_controls['online_payments_blocked_until'] >= date.today().isoformat()):
                rejection = f"Płatności internetowe zablokowane przez opiekuna do {junior_controls['online_payments_blocked_until']}."
            elif card['locked']:
                rejection = 'Karta jest zablokowana.'
            elif amount > remaining_limit:
                rejection = f"Przekroczono dostępny limit dzienny. Pozostało: {money(remaining_limit)}."
            elif amount > user['balance_cents']:
                rejection = 'Brak wystarczających środków na rachunku.'

            stamp = now_iso()
            if rejection:
                db.execute(
                    """INSERT INTO card_payments
                    (user_id, operation_type, merchant, amount_cents, status,
                     rejection_reason, created_at)
                    VALUES (?, ?, ?, ?, 'rejected', ?, ?)""",
                    (user['id'], operation_type, values['merchant'], amount, rejection, stamp),
                )
                add_notification(
                    user['id'], 'Odrzucona operacja kartą',
                    f"{CARD_OPERATION_LABELS[operation_type]} na {money(amount)} — {values['merchant']}. Powód: {rejection}",
                    'warning', operation_type='card_payment', amount_cents=amount,
                    counterparty=values['merchant'],
                )
                notify_junior_guardian(
                    user['id'], 'Odrzucona operacja kartą dziecka',
                    f"{CARD_OPERATION_LABELS[operation_type]} na {money(amount)} — {values['merchant']}. Powód: {rejection}",
                    'warning', operation_type='card_payment', amount_cents=amount,
                    counterparty=values['merchant'],
                )
                db.commit()
                flash('Operacja została odrzucona: ' + rejection, 'error')
                return redirect(url_for('card_payments'))
            try:
                db.execute('BEGIN IMMEDIATE')
                earned_points = amount // 100 if operation_type in ('store', 'online') else 0
                changed = db.execute(
                    'UPDATE users SET balance_cents = balance_cents - ? WHERE id = ? AND balance_cents >= ?',
                    (amount, user['id'], amount),
                )
                if changed.rowcount != 1:
                    raise ValueError('Brak wystarczających środków na rachunku.')
                payment = db.execute(
                    """INSERT INTO card_payments
                    (user_id, operation_type, merchant, amount_cents, status, reward_points, created_at)
                    VALUES (?, ?, ?, ?, 'approved', ?, ?)""",
                    (user['id'], operation_type, values['merchant'], amount, earned_points, stamp),
                )
                title = ('Wypłata z bankomatu' if operation_type == 'atm' else 'Płatność kartą') + f" – {values['merchant']}"
                transaction = db.execute(
                    """INSERT INTO transactions
                    (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
                    VALUES (?, 'debit', ?, ?, ?, 'CARD', ?)""",
                    (user['id'], amount, title, values['merchant'], stamp),
                )
                add_notification(
                    user['id'], 'Operacja kartą',
                    f"{CARD_OPERATION_LABELS[operation_type]} na {money(amount)} — {values['merchant']}."
                    + (f" Zdobyto {earned_points} pkt NovaClub." if earned_points else ""),
                    'success', operation_type='card_payment',
                    operation_reference=f"KP-{payment.lastrowid:06d}", amount_cents=amount,
                    counterparty=values['merchant'], related_transaction_id=transaction.lastrowid,
                )
                if earned_points:
                    db.execute(
                        """INSERT OR IGNORE INTO reward_accounts
                        (user_id, points, lifetime_points, cashback_cents) VALUES (?, 600, 600, 0)""",
                        (user['id'],),
                    )
                    db.execute(
                        """UPDATE reward_accounts
                        SET points = points + ?, lifetime_points = lifetime_points + ?
