                <p class="account">{{ values.account }}</p><p>Tytuł: {{ values.title }}</p>
                {% if name_verified %}<p><span class="status approved" data-testid="recipient-name-verified">✓ Nazwa jest zgodna z właścicielem rachunku</span></p>{% else %}<div class="flash warning" data-testid="recipient-name-warning"><strong>Uwaga: nazwa odbiorcy nie odpowiada właścicielowi rachunku.</strong><br>Właściciel rachunku w NovaBank: {{ registered_name }}. Sprawdź dane przed wysłaniem.</div>{% endif %}
                <p class="balance" data-testid="transfer-summary-amount">{{ amount|money }}</p>
                <p>Opłata: 0,00 zł · Przelew wewnętrzny</p><p>Saldo po przelewie: {{ (user.balance_cents - amount)|money }}</p><p class="muted">Po operacji pozostanie {{ (daily_remaining - amount)|money }} dziennego limitu.</p>
                <form method="post" data-testid="transfer-confirm-form"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="confirmation" value="{{ token }}">
                {% for key, value in values.items() %}<input type="hidden" name="{{ key }}" value="{{ value }}">{% endfor %}
                {% if not name_verified %}<label class="feature" style="display:block;margin-top:18px"><input type="checkbox" name="confirm_name_mismatch" value="1" required data-testid="confirm-name-mismatch"> Rozumiem ostrzeżenie i potwierdzam przelew do wskazanego rachunku.</label>{% endif %}
                <div class="actions"><button class="btn" type="submit" name="step" value="confirm" data-testid="transfer-confirm">Potwierdź i wyślij</button>
                <button class="btn secondary" type="submit" name="step" value="edit" data-testid="transfer-edit">Popraw dane</button></div></form>
                <p class="muted">Podsumowanie ważne 30 minut. Dostępne środki sprawdzimy ponownie przy wysyłaniu.</p>
                </section>""", user=user, values=payload_values, amount=amount_cents, token=token,
                name_verified=name_verified,
                registered_name=f"{recipient_user['first_name']} {recipient_user['last_name']}",
                daily_remaining=daily_remaining)
            try:
                signed = serializer.loads(token, max_age=1800)
                if signed.get('user') != user['id'] or signed.get('values') != payload_values:
                    raise BadSignature('Zmienione dane')
            except (BadSignature, SignatureExpired):
                flash('Potwierdzenie wygasło lub zmieniono dane. Sprawdź przelew ponownie.', 'error')
                return redirect(url_for('transfer'))
            db = get_db()
            stamp = now_iso()
            junior_settings = None
            if user['id'] == session['user_id'] and user['account_type'] == 'junior':
                junior_settings = db.execute(
                    """SELECT s.* FROM junior_settings s
                    JOIN junior_guardian_requests r ON r.junior_user_id = s.junior_user_id
                    WHERE s.junior_user_id = ? AND r.status = 'accepted'""",
                    (user['id'],),
                ).fetchone()
            if (junior_settings and
                    amount_cents > junior_settings['transfer_approval_threshold_cents']):
                try:
                    db.execute('BEGIN IMMEDIATE')
                    existing = db.execute(
                        'SELECT id FROM junior_transfer_orders WHERE request_token = ?',
                        (signed['nonce'],),
                    ).fetchone()
                    if existing:
                        db.rollback()
                        flash('Ten przelew już czeka na decyzję opiekuna.', 'info')
                        return redirect(url_for('dashboard'))
                    order = db.execute(
                        """INSERT INTO junior_transfer_orders
                        (junior_user_id, guardian_user_id, recipient_user_id,
                         recipient_name, recipient_account, amount_cents, title,
                         request_token, status, created_at)
                        VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'pending', ?)""",
                        (user['id'], junior_settings['guardian_user_id'], recipient_user['id'],
                         values['recipient'], clean_account, amount_cents, values['title'],
                         signed['nonce'], stamp),
                    )
                    add_notification(
                        junior_settings['guardian_user_id'], 'Przelew dziecka wymaga zgody',
                        f"{user['first_name']} chce wysłać {money(amount_cents)} do {values['recipient']}.",
