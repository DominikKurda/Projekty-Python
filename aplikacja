                warn_about_low_balance(user["id"], user["balance_cents"] - amount_cents)
                if user['id'] != session['user_id']:
                    log_context_action(
                        'junior_transfer',
                        f"{money(amount_cents)} dla {values['recipient']} ({transfer_reference})",
                    )
                db.commit()
            except (sqlite3.Error, ValueError) as exc:
                db.rollback()
                flash(str(exc), "error")
            else:
                flash(f"Przelew na kwotę {money(amount_cents)} został wykonany.", "success")
                return redirect(url_for("transfer_done", transaction_id=debit.lastrowid))

    pending_requests = db.execute(
        """SELECT r.*, u.first_name, u.last_name, u.account_number
        FROM payment_requests r JOIN users u ON u.id = r.requester_id
        WHERE r.payer_id = ? AND r.status = 'pending' ORDER BY r.id DESC""",
        (user['id'],),
    ).fetchall()
    request_activity = db.execute(
        """SELECT r.*,
        CASE WHEN r.requester_id = ? THEN 'outgoing' ELSE 'incoming' END AS direction,
        CASE WHEN r.requester_id = ?
             THEN payer.first_name || ' ' || payer.last_name
             ELSE requester.first_name || ' ' || requester.last_name END AS other_party
        FROM payment_requests r
        JOIN users requester ON requester.id = r.requester_id
        JOIN users payer ON payer.id = r.payer_id
        WHERE r.requester_id = ? OR r.payer_id = ?
        ORDER BY r.id DESC LIMIT 8""",
        (user['id'], user['id'], user['id'], user['id']),
    ).fetchall()
    return page(
        "Nowy przelew",
        """
        <div class="topline"><div><div class="eyebrow">Przelewy i rozliczenia</div><h2>Centrum przelewów</h2><p class="muted">Wykonuj przelewy i odpowiadaj na otrzymane prośby o pieniądze.</p></div><a class="btn secondary" href="{{ url_for('payment_requests') }}" data-testid="open-payment-requests">Wszystkie prośby</a></div>
