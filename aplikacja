@login_required
def cancel_joint_transfer(order_id):
    if not valid_csrf():
        abort(400)
    db = get_db()
    order = db.execute(
        """SELECT o.* FROM joint_transfer_orders o
        JOIN joint_account_members m ON m.account_id = o.account_id
        WHERE o.id = ? AND o.created_by = ? AND m.user_id = ?""",
        (order_id, session['user_id'], session['user_id']),
    ).fetchone()
    if order is None:
