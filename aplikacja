@app.post('/junior-control/transfers/<int:order_id>/decision')
@login_required
def junior_transfer_decision(order_id):
    if not valid_csrf():
        abort(400)
    decision = request.form.get('decision')
    if decision not in ('approve', 'reject'):
        abort(400)
    context = active_account_context()
    if not context or context['type'] != 'junior':
        abort(403)
    db = get_db()
    order = db.execute(
        """SELECT * FROM junior_transfer_orders
        WHERE id = ? AND junior_user_id = ? AND guardian_user_id = ? AND status = 'pending'""",
        (order_id, context['id'], session['user_id']),
    ).fetchone()
    if order is None:
        abort(404)
    try:
        db.execute('BEGIN IMMEDIATE')
        if decision == 'approve':
            complete_junior_transfer(order_id, session['user_id'])
            message = 'Przelew został zatwierdzony i wykonany.'
        else:
            db.execute(
                """UPDATE junior_transfer_orders SET status = 'rejected', decided_at = ?, decided_by = ?
                WHERE id = ? AND status = 'pending'""", (now_iso(), session['user_id'], order_id))
            add_notification(order['junior_user_id'], 'Opiekun odrzucił przelew',
                             f"Przelew {money(order['amount_cents'])} nie został wykonany.", 'warning',
                             operation_type='junior_transfer', operation_reference=f'JPR-{order_id:06d}')
            message = 'Przelew został odrzucony.'
        log_context_action('junior_transfer_decision', f'JPR-{order_id:06d}: {decision}')
        db.commit()
        flash(message, 'success')
    except (sqlite3.Error, ValueError) as exc:
        db.rollback()
        flash(str(exc), 'error')
    return redirect(url_for('junior_control'))


def joint_account_for_member(account_id: int, user_id: int):
    return get_db().execute(
        """SELECT a.*, (SELECT COUNT(*) FROM joint_account_members m2
        WHERE m2.account_id = a.id) AS member_count
        FROM joint_accounts a
        JOIN joint_account_members m ON m.account_id = a.id
        WHERE a.id = ? AND m.user_id = ? AND a.status = 'active'""",
        (account_id, user_id),
    ).fetchone()


def notify_joint_members(account_id: int, title: str, message: str, kind: str = 'info',
                         *, skip_user_id: int | None = None,
                         operation_reference: str | None = None,
                         amount_cents: int | None = None,
                         counterparty: str | None = None) -> None:
    members = get_db().execute(
        'SELECT user_id FROM joint_account_members WHERE account_id = ?',
        (account_id,),
    ).fetchall()
    for member in members:
        if member['user_id'] != skip_user_id:
            add_notification(
                member['user_id'], title, message, kind,
                operation_type='joint_account',
                operation_reference=operation_reference,
                amount_cents=amount_cents,
                counterparty=counterparty,
            )


def complete_joint_transfer(order_id: int, decided_by: int) -> int:
    """Księguje oczekujący przelew. Wywołujący zarządza transakcją i commit/rollback."""
    db = get_db()
    order = db.execute(
        """SELECT o.*, a.name AS joint_name, a.balance_cents,
        u.first_name AS creator_first, u.last_name AS creator_last
        FROM joint_transfer_orders o
        JOIN joint_accounts a ON a.id = o.account_id
        JOIN users u ON u.id = o.created_by
        WHERE o.id = ? AND o.status = 'pending' AND a.status = 'active'
        AND a.activation_status = 'active'""",
        (order_id,),
    ).fetchone()
    if order is None:
        raise ValueError('Ten przelew nie oczekuje już na zatwierdzenie.')
    updated = db.execute(
        """UPDATE joint_accounts SET balance_cents = balance_cents - ?
        WHERE id = ? AND status = 'active' AND activation_status = 'active'
        AND balance_cents >= ?""",
        (order['amount_cents'], order['account_id'], order['amount_cents']),
    )
    if updated.rowcount != 1:
        raise ValueError('Na koncie wspólnym nie ma wystarczających środków.')
    db.execute(
        'UPDATE users SET balance_cents = balance_cents + ? WHERE id = ?',
        (order['amount_cents'], order['recipient_user_id']),
    )
    stamp = now_iso()
    joint_tx = db.execute(
        """INSERT INTO joint_transactions
        (account_id, kind, amount_cents, title, counterparty,
         counterparty_account, performed_by, created_at)
        VALUES (?, 'debit', ?, ?, ?, ?, ?, ?)""",
        (order['account_id'], order['amount_cents'], order['title'],
         order['recipient_name'], order['recipient_account'], order['created_by'], stamp),
    )
    recipient_tx = db.execute(
        """INSERT INTO transactions
        (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
        VALUES (?, 'credit', ?, ?, ?, ?, ?)""",
        (order['recipient_user_id'], order['amount_cents'], order['title'],
         f"Konto wspólne: {order['joint_name']}",
         db.execute('SELECT account_number FROM joint_accounts WHERE id = ?',
                    (order['account_id'],)).fetchone()['account_number'], stamp),
    )
    changed = db.execute(
        """UPDATE joint_transfer_orders
        SET status = 'completed', decided_at = ?, decided_by = ?, joint_transaction_id = ?
        WHERE id = ? AND status = 'pending'""",
        (stamp, decided_by, joint_tx.lastrowid, order_id),
    )
    if changed.rowcount != 1:
        raise ValueError('Nie udało się zatwierdzić przelewu.')
    reference = f'WSP-{order_id:06d}'
    notify_joint_members(
        order['account_id'], 'Przelew z konta wspólnego wykonany',
        f"{money(order['amount_cents'])} dla {order['recipient_name']}. Tytuł: {order['title']}.",
        'success', operation_reference=reference,
        amount_cents=order['amount_cents'], counterparty=order['recipient_name'],
    )
    add_notification(
        order['recipient_user_id'], 'Otrzymano przelew z konta wspólnego',
        f"Tytuł: {order['title']}. Środki są dostępne na rachunku.",
        'success', operation_type='joint_transfer_in', operation_reference=reference,
        amount_cents=order['amount_cents'], counterparty=order['joint_name'],
        related_transaction_id=recipient_tx.lastrowid,
    )
    return joint_tx.lastrowid


@app.route('/joint-account', methods=['GET', 'POST'])
@login_required
def joint_account():
    db = get_db()
    user_id = session['user_id']
    signed_user = current_user()
    if signed_user['account_type'] == 'junior' or signed_user['age'] < 18:
        return page('Konto wspólne', r"""
        <section class="auth panel panel-pad" data-testid="joint-unavailable-junior">
        <div class="eyebrow">Konto Junior</div><h2>Konto wspólne jest dostępne od 18 lat</h2>
        <p>Po osiągnięciu pełnoletności będzie można utworzyć konto wspólne i zaprosić drugiego właściciela.</p>
        <a class="btn secondary" href="{{ url_for('dashboard') }}">Wróć na pulpit</a></section>""")
    if request.method == 'POST':
        if not valid_csrf():
            abort(400)
        action = request.form.get('action', '')
        try:
            if action == 'create':
                name = request.form.get('name', '').strip()
                threshold = parse_amount(request.form.get('threshold', ''))
                if not 3 <= len(name) <= 60:
                    raise ValueError('Nazwa konta musi mieć od 3 do 60 znaków.')
                if threshold is None:
                    raise ValueError('Podaj poprawny próg podwójnej akceptacji.')
                db.execute('BEGIN IMMEDIATE')
                created = db.execute(
                    """INSERT INTO joint_accounts
                    (name, account_number, approval_threshold_cents, created_by, created_at)
                    VALUES (?, ?, ?, ?, ?)""",
                    (name, account_number(), threshold, user_id, now_iso()),
                )
                db.execute(
                    'INSERT INTO joint_account_members(account_id, user_id, joined_at) VALUES (?, ?, ?)',
                    (created.lastrowid, user_id, now_iso()),
                )
                db.commit()
                flash('Konto wspólne zostało utworzone. Teraz zaproś współwłaściciela.', 'success')
                return redirect(url_for('joint_account', account_id=created.lastrowid))

            account_id = request.form.get('account_id', type=int)
            account = joint_account_for_member(account_id or 0, user_id)
            if account is None:
                abort(404)

            if action == 'goal_create':
                name = request.form.get('name', '').strip()
                target = parse_amount(request.form.get('target', ''))
                deadline_raw = request.form.get('deadline', '').strip()
                try:
                    deadline = date.fromisoformat(deadline_raw)
                except ValueError:
                    deadline = None
                if not 2 <= len(name) <= 100:
                    raise ValueError('Nazwa celu musi mieć od 2 do 100 znaków.')
                if target is None:
                    raise ValueError('Podaj poprawną kwotę celu.')
                if deadline is None or deadline <= date.today():
                    raise ValueError('Termin celu musi przypadać po dzisiejszym dniu.')
                db.execute(
                    """INSERT INTO joint_goals
                    (account_id, name, target_cents, deadline, created_by, created_at)
                    VALUES (?, ?, ?, ?, ?, ?)""",
                    (account_id, name, target, deadline.isoformat(), user_id, now_iso()),
                )
                db.commit()
                flash('Wspólny cel oszczędnościowy został utworzony.', 'success')

            elif action == 'goal_fund':
                goal_id = request.form.get('goal_id', type=int)
                amount = parse_amount(request.form.get('amount', ''))
                goal = db.execute(
                    """SELECT * FROM joint_goals
                    WHERE id = ? AND account_id = ? AND status = 'active'""",
                    (goal_id or 0, account_id),
                ).fetchone()
                if goal is None:
                    raise ValueError('Nie znaleziono aktywnego celu.')
                if amount is None:
                    raise ValueError('Podaj poprawną kwotę wpłaty na cel.')
                remaining = goal['target_cents'] - goal['saved_cents']
                amount = min(amount, remaining)
                db.execute('BEGIN IMMEDIATE')
                changed = db.execute(
                    'UPDATE joint_accounts SET balance_cents = balance_cents - ? WHERE id = ? AND balance_cents >= ?',
                    (amount, account_id, amount),
                )
                if changed.rowcount != 1:
                    raise ValueError('Brak wystarczających środków na koncie wspólnym.')
                new_saved = goal['saved_cents'] + amount
                db.execute(
                    """UPDATE joint_goals SET saved_cents = ?, status = ? WHERE id = ?""",
                    (new_saved, 'completed' if new_saved >= goal['target_cents'] else 'active', goal['id']),
                )
                member = current_user()
                db.execute(
                    """INSERT INTO joint_transactions
                    (account_id, kind, amount_cents, title, counterparty,
                     counterparty_account, performed_by, created_at)
                    VALUES (?, 'debit', ?, ?, 'Wspólny cel', 'JOINT-GOAL', ?, ?)""",
                    (account_id, amount, f"Wpłata na cel: {goal['name']}", user_id, now_iso()),
                )
                notify_joint_members(
                    account_id, 'Wpłata na wspólny cel',
                    f"{member['first_name']} wpłacił(a) {money(amount)} na cel „{goal['name']}” .",
                    'success', operation_reference=f"WSP-CEL-{goal['id']:06d}",
                    amount_cents=amount, counterparty=goal['name'],
                )
                db.commit()
                flash('Środki zostały odłożone na wspólny cel.', 'success')

            elif action == 'recurring_contribution':
                amount = parse_amount(request.form.get('amount', ''))
                payment_day = request.form.get('payment_day', type=int)
                if amount is None:
                    raise ValueError('Podaj poprawną kwotę cyklicznej wpłaty.')
                if payment_day is None or not 1 <= payment_day <= 28:
                    raise ValueError('Wybierz dzień miesiąca od 1 do 28.')
                first_date = next_monthly_day(payment_day)
                db.execute(
                    """INSERT INTO joint_recurring_contributions
