def normalize_assistant_text(value: str) -> str:
    translation = str.maketrans('ąćęłńóśźż', 'acelnoszz')
    return re.sub(r'\s+', ' ', (value or '').lower().translate(translation)).strip()


def assistant_month_bounds() -> tuple[str, str]:
    first = date.today().replace(day=1)
    following = next_month(first)
    return first.isoformat(), following.isoformat()


def assistant_recipient(user_id: int, normalized_question: str):
    rows = get_db().execute(
        """SELECT u.id, u.first_name, u.last_name, u.account_number
        FROM users u JOIN user_access a ON a.user_id = u.id
        WHERE u.id != ? AND a.role = 'customer' AND a.locked = 0
        ORDER BY u.id""",
        (user_id,),
    ).fetchall()
    for row in rows:
        first = normalize_assistant_text(row['first_name'])
        last = normalize_assistant_text(row['last_name'])
        full = f'{first} {last}'
        if full in normalized_question or first in normalized_question or last in normalized_question:
            return row
        if len(first) >= 3 and first[:3] in normalized_question:
            return row
    return None


def nova_assistant_answer(user, question: str) -> dict:
    db = get_db()
    normalized = normalize_assistant_text(question)
    result = {'intent': 'help', 'answer': '', 'action_url': None, 'action_label': None}
    month_start, next_month_start = assistant_month_bounds()

    if any(phrase in normalized for phrase in ('przygotuj przelew', 'zrob przelew', 'wykonaj przelew')):
        result['intent'] = 'transfer_draft'
        recipient = assistant_recipient(user['id'], normalized)
        amount_match = re.search(r'(\d+(?:[,.]\d{1,2})?)\s*(?:zl|zlot)', normalized)
        amount = parse_amount(amount_match.group(1)) if amount_match else None
        if recipient is None:
            result['answer'] = 'Nie znalazłem odbiorcy wśród aktywnych kont NovaBank. Podaj jego imię, np. „Przygotuj przelew 100 zł do Anny”.'
            result['action_url'] = url_for('transfer')
            result['action_label'] = 'Wybierz odbiorcę ręcznie'
        elif amount is None:
            result['answer'] = f"Znalazłem odbiorcę {recipient['first_name']} {recipient['last_name']}, ale potrzebuję poprawnej kwoty przelewu."
            result['action_url'] = url_for('transfer', recipient_user=recipient['id'])
            result['action_label'] = 'Uzupełnij przelew'
        elif amount > user['balance_cents']:
            result['answer'] = f"Nie mogę przygotować przelewu na {money(amount)}, ponieważ dostępne saldo wynosi {money(user['balance_cents'])}."
        else:
            amount_value = f'{amount / 100:.2f}'.replace('.', ',')
            result['answer'] = (f"Przygotowałem szkic przelewu na {money(amount)} do "
                                f"{recipient['first_name']} {recipient['last_name']}. "
                                'Sprawdź dane w formularzu — pieniądze nie zostały jeszcze wysłane.')
            result['action_url'] = url_for(
                'transfer', recipient_user=recipient['id'], amount=amount_value,
                title='Przelew przygotowany przez Nova Assistant',
            )
            result['action_label'] = 'Sprawdź szkic przelewu'
        return result

    if ('saldo' in normalized or 'stan konta' in normalized
            or 'ile mam na koncie' in normalized or 'ile mam pieniedzy' in normalized):
        result.update(intent='balance', answer=f"Twoje dostępne saldo wynosi {money(user['balance_cents'])}.")
        return result

    if any(word in normalized for word in ('punkt', 'novaclub', 'cashback')):
        rewards = db.execute(
            'SELECT * FROM reward_accounts WHERE user_id = ?', (user['id'],)
        ).fetchone()
        if rewards:
            result.update(
                intent='rewards',
                answer=(f"Masz {rewards['points']} pkt NovaClub. Łącznie zdobyłeś "
                        f"{rewards['lifetime_points']} pkt, a otrzymany cashback wynosi "
                        f"{money(rewards['cashback_cents'])}."),
                action_url=url_for('benefits'), action_label='Otwórz NovaClub',
            )
        else:
            result.update(intent='rewards', answer='Twoje konto NovaClub nie zostało jeszcze aktywowane.')
        return result

    if any(word in normalized for word in ('rat', 'kredyt')):
        installment = db.execute(
            """SELECT i.*, l.id AS loan_number FROM loan_installments i
            JOIN loan_applications l ON l.id = i.loan_id
            WHERE l.user_id = ? AND l.status = 'approved' AND i.status = 'pending'
            ORDER BY i.due_date, i.installment_number LIMIT 1""",
            (user['id'],),
        ).fetchone()
        if installment:
            result.update(
                intent='loan',
                answer=(f"Najbliższa rata kredytu KR-{installment['loan_number']:06d} wynosi "
                        f"{money(installment['amount_cents'])} i ma termin {installment['due_date']}."),
                action_url=url_for('loan_schedule', loan_id=installment['loan_id']),
                action_label='Pokaż kalendarz rat',
            )
        else:
            result.update(intent='loan', answer='Nie masz obecnie żadnej oczekującej raty kredytu.')
        return result

    if any(word in normalized for word in ('kalendarz', 'rachunk', 'termin', 'nadchodz')):
        events = db.execute(
            """SELECT * FROM financial_events
            WHERE user_id = ? AND status = 'planned' AND event_date >= ?
            ORDER BY event_date, id LIMIT 5""",
            (user['id'], date.today().isoformat()),
        ).fetchall()
        if events:
            lines = [f"• {item['event_date']}: {item['title']}" +
                     (f" — {money(item['amount_cents'])}" if item['amount_cents'] is not None else '')
                     for item in events]
            answer = 'Najbliższe wydarzenia finansowe:\n' + '\n'.join(lines)
        else:
            answer = 'Nie masz nadchodzących wydarzeń w kalendarzu finansowym.'
        result.update(intent='calendar', answer=answer,
                      action_url=url_for('financial_calendar'), action_label='Otwórz kalendarz')
        return result

    if any(word in normalized for word in ('podejrz', 'bezpiecz', 'nieudane logowanie', 'ryzyk')):
        threshold = (datetime.now(timezone.utc) - timedelta(days=30)).isoformat(timespec='seconds')
        failed = db.execute(
            """SELECT COUNT(*) FROM login_history
            WHERE user_id = ? AND event_type IN ('failed','blocked') AND created_at >= ?""",
            (user['id'], threshold),
        ).fetchone()[0]
        rejected_cards = db.execute(
            """SELECT COUNT(*) FROM card_payments
            WHERE user_id = ? AND status = 'rejected' AND created_at >= ?""",
            (user['id'], threshold),
        ).fetchone()[0]
        high_transfers = db.execute(
            """SELECT COUNT(*) FROM transactions
            WHERE user_id = ? AND kind = 'debit' AND amount_cents >= 500000 AND created_at >= ?""",
            (user['id'], threshold),
        ).fetchone()[0]
        risk = min(100, failed * 15 + rejected_cards * 10 + high_transfers * 25)
        level = 'niskie' if risk < 30 else ('średnie' if risk < 70 else 'wysokie')
        result.update(
            intent='security',
            answer=(f"Ocena ryzyka z ostatnich 30 dni: {risk}/100 ({level}). "
                    f"Nieudane logowania: {failed}, odrzucone operacje kartą: {rejected_cards}, "
                    f"wysokie obciążenia: {high_transfers}."),
