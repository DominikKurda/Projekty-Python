    user = current_user()
    values = {key: request.form.get(key, '').strip() for key in ('name', 'target', 'deadline')}
    if request.method == 'POST':
        target = parse_amount(values['target'])
        try:
            deadline = date.fromisoformat(values['deadline'])
        except ValueError:
            deadline = None
        error = None
        if not valid_csrf():
            error = 'Sesja formularza wygasła. Spróbuj ponownie.'
        elif not values['name'] or len(values['name']) > 100:
            error = 'Podaj nazwę celu (maksymalnie 100 znaków).'
        elif target is None:
            error = 'Podaj poprawną kwotę docelową.'
        elif deadline is None or deadline <= date.today():
            error = 'Termin celu musi przypadać po dzisiejszym dniu.'
        if error:
            flash(error, 'error')
