BLIK_OPERATION_LABELS = {
    'payment': 'Płatność w sklepie',
    'atm': 'Wypłata z bankomatu',
    'phone': 'Przelew na telefon',
}
BLIK_STATUS_LABELS = {
    'pending': 'Oczekuje na decyzję',
    'approved': 'Zatwierdzona',
    'rejected': 'Odrzucona',
    'expired': 'Wygasła',
}


def safe_blik_operation(row) -> dict:
    """Przygotowuje także rekordy pochodzące ze starszych wersji bazy."""
    item = dict(row)
    if item.get('operation_type') not in BLIK_OPERATION_LABELS:
        item['operation_type'] = 'payment'
    if item.get('status') not in BLIK_STATUS_LABELS:
        item['status'] = 'rejected'
    item['counterparty'] = str(item.get('counterparty') or 'Starsza operacja BLIK')
    try:
        item['amount_cents'] = max(0, int(item.get('amount_cents') or 0))
    except (TypeError, ValueError):
        item['amount_cents'] = 0
    item['created_at'] = str(item.get('created_at') or 'Brak daty')
    item['phone_number'] = item.get('phone_number') or None
    return item


def ensure_blik_settings(user_id: int):
    db = get_db()
    row = db.execute('SELECT * FROM blik_settings WHERE user_id = ?', (user_id,)).fetchone()
    if row is None:
        phone = str(500_000_000 + user_id)
        db.execute(
            'INSERT INTO blik_settings(user_id, phone_number) VALUES (?, ?)',
            (user_id, phone),
        )
        db.commit()
        row = db.execute('SELECT * FROM blik_settings WHERE user_id = ?', (user_id,)).fetchone()
    return row


def expire_blik_operations(user_id: int) -> None:
    stamp = now_iso()
    get_db().execute(
        """UPDATE blik_operations
        SET status = 'expired', rejection_reason = 'Kod BLIK wygasł.'
        WHERE user_id = ? AND status = 'pending' AND code_id IN (
            SELECT id FROM blik_codes WHERE expires_at <= ?
        )""",
        (user_id, stamp),
    )
    get_db().commit()


def blik_usage(user_id: int, settings) -> dict:
    db = get_db()
    usage = {}
    columns = {'payment': 'payment_limit', 'atm': 'atm_limit', 'phone': 'phone_limit'}
    for operation_type, column in columns.items():
        used = db.execute(
            """SELECT COALESCE(SUM(amount_cents), 0) FROM blik_operations
            WHERE user_id = ? AND operation_type = ? AND status = 'approved'
            AND substr(confirmed_at, 1, 10) = ?""",
            (user_id, operation_type, date.today().isoformat()),
        ).fetchone()[0]
        limit = settings[column]
        usage[operation_type] = {'used': used, 'limit': limit, 'remaining': max(0, limit - used)}
    return usage


@app.route('/blik', methods=['GET', 'POST'])
@login_required
def blik():
    user = current_user()
    db = get_db()
    settings = ensure_blik_settings(user['id'])
    expire_blik_operations(user['id'])
    values = {
        'code': request.form.get('code', '').strip(),
        'operation_type': request.form.get('operation_type', 'payment').strip(),
        'counterparty': request.form.get('counterparty', '').strip(),
        'phone_number': re.sub(r'\D', '', request.form.get('phone_number', '')),
        'amount': request.form.get('amount', '').strip(),
    }

    if request.method == 'POST':
        if not valid_csrf():
            flash('Sesja formularza wygasła. Spróbuj ponownie.', 'error')
            return redirect(url_for('blik'))
        action = request.form.get('action')

        if action == 'generate':
            stamp = datetime.now(timezone.utc)
            stamp_text = stamp.isoformat(timespec='seconds')
            try:
                db.execute('BEGIN IMMEDIATE')
                db.execute(
                    'UPDATE blik_codes SET used_at = ? WHERE user_id = ? AND used_at IS NULL',
                    (stamp_text, user['id']),
                )
                code = None
                for _ in range(30):
                    candidate = f"{secrets.randbelow(1_000_000):06d}"
                    exists = db.execute(
                        'SELECT 1 FROM blik_codes WHERE code = ? AND used_at IS NULL AND expires_at > ?',
                        (candidate, stamp_text),
                    ).fetchone()
                    if not exists:
                        code = candidate
                        break
                if code is None:
                    raise ValueError('Nie udało się znaleźć wolnego kodu BLIK.')
                db.execute(
                    """INSERT INTO blik_codes
                    (user_id, code, created_at, expires_at) VALUES (?, ?, ?, ?)""",
                    (user['id'], code, stamp_text,
                     (stamp + timedelta(minutes=2)).isoformat(timespec='seconds')),
                )
                db.commit()
            except (sqlite3.Error, ValueError):
                db.rollback()
                app.logger.exception('Błąd generowania kodu BLIK')
                flash('Nie udało się wygenerować kodu BLIK. Uruchom aplikację ponownie, aby dokończyć naprawę bazy.', 'error')
            else:
                flash('Wygenerowano nowy kod BLIK ważny przez 2 minuty.', 'success')
            return redirect(url_for('blik'))

        if action == 'limits':
            limits = []
            for key in ('payment_limit', 'atm_limit', 'phone_limit'):
                raw = request.form.get(key, '').strip().replace(',', '.')
                if not re.fullmatch(r'[0-9]{1,6}(?:\.[0-9]{1,2})?', raw):
                    break
                amount = int(Decimal(raw) * 100)
                if amount > 10_000_000:
                    break
                limits.append(amount)
            if len(limits) != 3:
                flash('Każdy limit musi wynosić od 0 do 100 000 zł.', 'error')
            else:
                db.execute(
                    """UPDATE blik_settings SET payment_limit = ?, atm_limit = ?, phone_limit = ?
                    WHERE user_id = ?""",
                    (*limits, user['id']),
                )
                db.commit()
                flash('Dzienne limity BLIK zostały zapisane.', 'success')
            return redirect(url_for('blik'))

        if action == 'create-operation':
            amount = parse_amount(values['amount'])
            operation_type = values['operation_type']
            error = None
            recipient = None
            if not re.fullmatch(r'\d{6}', values['code']):
                error = 'Kod BLIK musi składać się dokładnie z 6 cyfr.'
            elif operation_type not in BLIK_OPERATION_LABELS:
                error = 'Wybierz poprawny rodzaj operacji BLIK.'
            elif amount is None:
                error = 'Podaj poprawną kwotę większą od 0 zł.'
            elif operation_type in ('payment', 'atm') and (
                not values['counterparty'] or len(values['counterparty']) > 120
            ):
                error = 'Podaj nazwę sklepu albo lokalizację bankomatu.'
            elif operation_type == 'phone' and not re.fullmatch(r'\d{9}', values['phone_number']):
                error = 'Numer telefonu musi składać się dokładnie z 9 cyfr.'

            code_row = None
            if error is None:
                code_row = db.execute(
                    """SELECT * FROM blik_codes
                    WHERE user_id = ? AND code = ? AND used_at IS NULL AND expires_at > ?
                    ORDER BY id DESC LIMIT 1""",
                    (user['id'], values['code'], now_iso()),
                ).fetchone()
                if code_row is None:
                    error = 'Kod BLIK jest nieprawidłowy, wykorzystany albo wygasł.'
            if error is None and operation_type == 'phone':
                recipient = db.execute(
                    """SELECT u.* FROM users u JOIN blik_settings b ON b.user_id = u.id
                    WHERE b.phone_number = ?""",
                    (values['phone_number'],),
                ).fetchone()
                if recipient is None:
                    error = 'Nie znaleziono użytkownika NovaBank z takim numerem telefonu.'
                elif recipient['id'] == user['id']:
                    error = 'Nie możesz wykonać przelewu BLIK na własny numer telefonu.'

            if error:
                flash(error, 'error')
            else:
                stamp = now_iso()
                counterparty = (
                    f"{recipient['first_name']} {recipient['last_name']}"
                    if operation_type == 'phone' else values['counterparty']
                )
                try:
                    db.execute('BEGIN IMMEDIATE')
                    used = db.execute(
                        'UPDATE blik_codes SET used_at = ? WHERE id = ? AND used_at IS NULL AND expires_at > ?',
                        (stamp, code_row['id'], stamp),
                    )
                    if used.rowcount != 1:
                        raise ValueError('Kod BLIK wygasł albo został już wykorzystany.')
                    operation = db.execute(
                        """INSERT INTO blik_operations
                        (user_id, code_id, operation_type, counterparty, phone_number,
                         recipient_user_id, amount_cents, status, created_at)
                        VALUES (?, ?, ?, ?, ?, ?, ?, 'pending', ?)""",
