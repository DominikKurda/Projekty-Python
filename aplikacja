@app.route("/register", methods=["GET", "POST"])
def register():
    # Formularz rejestracji ma być dostępny także wtedy, gdy w przeglądarce
    # pozostała sesja innego konta. Sesję zmieniamy dopiero po poprawnym
    # utworzeniu nowego użytkownika.
    active_user = current_user()

    values = {
        key: request.form.get(key, default).strip()
        for key, default in (
            ("first_name", ""), ("last_name", ""), ("email", ""),
            ("age", ""), ("account_type", "personal"),
            ("co_owner_email", ""), ("guardian_email", ""),
        )
    }
    if request.method == "POST":
        password = request.form.get("password", "")
        password_repeat = request.form.get("password_repeat", "")
        try:
            age = int(values['age'])
        except (TypeError, ValueError):
            age = 0
        account_type = values['account_type']
        accepted_terms = request.form.get('accept_terms') == '1'
        confirmed_data = request.form.get('confirm_data') == '1'
        approval_user = None
        error = None

        if not valid_csrf():
            error = "Sesja formularza wygasła. Spróbuj ponownie."
        elif not all(values[key] for key in ('first_name', 'last_name', 'email', 'age')):
            error = "Uzupełnij wszystkie pola."
        elif not 1 <= age <= 120:
            error = "Podaj poprawny wiek od 1 do 120 lat."
        elif account_type not in ('personal', 'joint', 'junior'):
            error = "Wybierz poprawny rodzaj konta."
        elif age < 18 and account_type != 'junior':
            error = "Osoba poniżej 18 lat może założyć wyłącznie Konto Junior."
        elif age >= 18 and account_type == 'junior':
            error = "Konto Junior jest przeznaczone dla osób poniżej 18 lat."
        elif not re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", values["email"]):
            error = "Podaj poprawny adres e-mail."
        elif len(password) < 8 or not re.search(r"[A-Z]", password) or not re.search(r"\d", password):
            error = "Hasło musi mieć minimum 8 znaków, wielką literę i cyfrę."
        elif password != password_repeat:
            error = "Podane hasła nie są takie same."
        elif not accepted_terms:
            error = "Zaakceptuj regulamin i zasady korzystania z NovaBanku."
        elif not confirmed_data:
            error = "Potwierdź, że podane dane są prawidłowe."

        if not error and account_type in ('joint', 'junior'):
            approval_email = (
                values['co_owner_email'] if account_type == 'joint'
                else values['guardian_email']
            ).lower()
            role_name = 'drugiego właściciela' if account_type == 'joint' else 'opiekuna'
            if not re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", approval_email):
                error = f"Podaj poprawny adres e-mail {role_name}."
            else:
                approval_user = get_db().execute(
                    """SELECT u.* FROM users u JOIN user_access a ON a.user_id = u.id
                    WHERE u.email = ? AND u.age >= 18 AND u.account_type != 'junior'
                    AND u.activation_status = 'active'
                    AND a.role = 'customer' AND a.locked = 0""",
                    (approval_email,),
                ).fetchone()
                if approval_user is None:
                    error = (
                        f"{role_name.capitalize()} musi mieć aktywne, pełnoletnie "
                        "konto użytkownika w NovaBanku."
                    )

        if error:
            flash(error, "error")
        else:
            db = get_db()
            try:
                db.execute('BEGIN IMMEDIATE')
                stamp = now_iso()
                activation_status = 'pending_guardian' if account_type == 'junior' else 'active'
                cursor = db.execute(
                    """
                    INSERT INTO users
                        (first_name, last_name, email, age, account_type,
                         activation_status, registration_consent_at, password_hash,
                         account_number, balance_cents, created_at)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 1000000, ?)
                    """,
                    (
                        values["first_name"], values["last_name"],
                        values["email"].lower(), age, account_type, activation_status,
                        stamp, generate_password_hash(password), account_number(), stamp,
                    ),
                )
                db.execute(
                    """
                    INSERT INTO transactions
                        (user_id, kind, amount_cents, title, counterparty,
                         counterparty_account, created_at)
                    VALUES (?, 'credit', 1000000, 'Bonus powitalny',
                            'NovaBank Demo', 'PL00000000000000000000000000', ?)
                    """,
                    (cursor.lastrowid, stamp),
                )
                db.execute(
                    "INSERT INTO user_access(user_id, role, locked) VALUES (?, 'customer', 0)",
                    (cursor.lastrowid,),
                )
                db.execute(
                    """INSERT INTO transfer_limits
                    (user_id, single_limit_cents, daily_limit_cents, updated_at)
                    VALUES (?, ?, ?, ?)""",
                    (
                        cursor.lastrowid,
                        50_000 if account_type == 'junior' else 500_000,
                        100_000 if account_type == 'junior' else 1_000_000,
                        stamp,
                    ),
                )
                db.execute(
                    """INSERT INTO reward_accounts(user_id, points, lifetime_points, cashback_cents)
                    VALUES (?, 600, 600, 0)""",
                    (cursor.lastrowid,),
                )
                db.execute(
                    """INSERT INTO reward_events
                    (user_id, event_type, points_delta, description, created_at)
                    VALUES (?, 'welcome', 600, 'Punkty powitalne NovaClub', ?)""",
                    (cursor.lastrowid, stamp),
                )
                joint_account_id = None
                if account_type == 'joint':
                    joint = db.execute(
                        """INSERT INTO joint_accounts
                        (name, account_number, approval_threshold_cents,
                         created_by, activation_status, created_at)
                        VALUES (?, ?, 100000, ?, 'pending', ?)""",
                        (f"Konto wspólne – {values['first_name']}", account_number(),
                         cursor.lastrowid, stamp),
                    )
                    joint_account_id = joint.lastrowid
                    db.execute(
                        """INSERT INTO joint_account_members
                        (account_id, user_id, joined_at) VALUES (?, ?, ?)""",
                        (joint_account_id, cursor.lastrowid, stamp),
                    )
                    db.execute(
                        """INSERT INTO joint_account_invitations
