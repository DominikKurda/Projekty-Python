def calculate_monthly_payment(amount_cents: int, months: int, annual_rate: Decimal) -> int:
    principal = Decimal(amount_cents) / 100
    monthly_rate = annual_rate / Decimal("100") / Decimal("12")
    factor = (Decimal("1") + monthly_rate) ** months
    payment = principal * monthly_rate * factor / (factor - Decimal("1"))
    return int((payment.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)) * 100)


def loan_due_date(reference: date, month_offset: int, payment_day: int) -> date:
    """Zwraca wybrany dzień miesiąca albo jego ostatni dzień."""
    first_of_month = date(reference.year, reference.month, 1)
    target = add_months(first_of_month, month_offset)
    effective_day = min(payment_day, calendar.monthrange(target.year, target.month)[1])
    return target.replace(day=effective_day)


def calculate_first_loan_payment(
    amount_cents: int, months: int, annual_rate: Decimal, installment_type: str
) -> int:
    if installment_type == 'decreasing':
        monthly_rate = annual_rate / Decimal('100') / Decimal('12')
        principal = (amount_cents + months - 1) // months
        interest = int(
            (Decimal(amount_cents) * monthly_rate).quantize(
                Decimal('1'), rounding=ROUND_HALF_UP
            )
        )
        return principal + interest
    return calculate_monthly_payment(amount_cents, months, annual_rate)


def loan_schedule_rows(
    principal_cents: int,
    months: int,
    annual_rate: Decimal,
    installment_type: str,
    first_number: int,
    first_due: date,
    payment_day: int,
) -> list[tuple[int, str, int, int, int]]:
    """Buduje harmonogram: numer, termin, kapitał, odsetki i kwota raty."""
    monthly_rate = annual_rate / Decimal('100') / Decimal('12')
    balance = principal_cents
    equal_payment = (
        calculate_monthly_payment(principal_cents, months, annual_rate)
        if installment_type == 'equal' else None
    )
    decreasing_principal = principal_cents // months
    rows = []
    due = first_due
    for index in range(months):
        interest = int(
            (Decimal(balance) * monthly_rate).quantize(
                Decimal('1'), rounding=ROUND_HALF_UP
            )
        )
        if index == months - 1:
            principal = balance
        elif installment_type == 'decreasing':
            principal = min(balance, decreasing_principal)
        else:
            principal = min(balance, max(1, equal_payment - interest))
        amount = principal + interest
        rows.append((first_number + index, due.isoformat(), principal, interest, amount))
        balance -= principal
        due = loan_due_date(due, 1, payment_day)
    return rows


def insert_loan_schedule(
    loan_id: int,
    principal_cents: int,
    months: int,
    annual_rate: Decimal,
    installment_type: str,
    first_number: int,
    first_due: date,
    payment_day: int,
) -> list[tuple[int, str, int, int, int]]:
    rows = loan_schedule_rows(
        principal_cents, months, annual_rate, installment_type,
        first_number, first_due, payment_day,
    )
    get_db().executemany(
        """INSERT INTO loan_installments
        (loan_id, installment_number, due_date, principal_cents,
         interest_cents, amount_cents, status)
        VALUES (?, ?, ?, ?, ?, ?, 'pending')""",
        [(loan_id, number, due, principal, interest, amount)
         for number, due, principal, interest, amount in rows],
    )
    return rows


