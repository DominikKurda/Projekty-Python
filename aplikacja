                add_notification(junior['id'], 'Płatności internetowe czasowo zablokowane',
                                 f'Blokada ustawiona przez opiekuna obowiązuje do {blocked_until}.', 'security')
                db.commit()
                flash('Płatności internetowe zostały czasowo zablokowane.', 'success')
            elif action == 'online_unblock':
