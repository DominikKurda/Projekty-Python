@app.post('/admin/loans/<int:loan_id>/review')
@admin_required
def admin_review_loan(loan_id):
    if not valid_csrf():
        abort(400)
    decision = request.form.get('decision')
    if decision not in ('approve', 'reject'):
        abort(400)
    db = get_db()
    loan = db.execute('SELECT * FROM loan_applications WHERE id = ?', (loan_id,)).fetchone()
    if loan is None:
        abort(404)
    if loan['status'] != 'pending':
        flash('Ten wniosek ma już wydaną decyzję.', 'info')
        return redirect(url_for('admin_loans'))
    stamp = now_iso()
    try:
        db.execute('BEGIN IMMEDIATE')
        new_status = 'approved' if decision == 'approve' else 'rejected'
        changed = db.execute(
            """UPDATE loan_applications SET status = ?, reviewed_at = ?, reviewed_by = ?
            WHERE id = ? AND status = 'pending'""", (new_status, stamp, session['user_id'], loan_id)
        )
        if changed.rowcount != 1:
            raise ValueError('Wniosek został już rozpatrzony.')
        if decision == 'approve':
            db.execute('UPDATE users SET balance_cents = balance_cents + ? WHERE id = ?', (loan['amount_cents'], loan['user_id']))
            db.execute(
                """INSERT INTO transactions
                (user_id, kind, amount_cents, title, counterparty, counterparty_account, created_at)
                VALUES (?, 'credit', ?, ?, 'NovaBank Kredyty', 'KREDYT', ?)""",
                (loan['user_id'], loan['amount_cents'], f"Uruchomienie kredytu KR-{loan_id:06d}", stamp),
            )
            ensure_loan_schedule(loan_id)
            add_notification(loan['user_id'], 'Kredyt zaakceptowany', f"Kwota {money(loan['amount_cents'])} została przekazana na rachunek.", 'success')
        else:
            add_notification(loan['user_id'], 'Wniosek kredytowy odrzucony', f"Wniosek KR-{loan_id:06d} został odrzucony.", 'warning')
        log_admin_action('Akceptacja kredytu' if decision == 'approve' else 'Odrzucenie kredytu', 'loan', loan_id, f"Kwota: {money(loan['amount_cents'])}")
        db.commit()
    except (sqlite3.Error, ValueError) as exc:
        db.rollback()
        flash(str(exc), 'error')
    else:
        flash('Kredyt został zaakceptowany.' if decision == 'approve' else 'Wniosek został odrzucony.', 'success')
    return redirect(url_for('admin_loans'))


