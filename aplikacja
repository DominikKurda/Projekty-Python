                    (now_iso(), junior['id'], session['user_id']),
                )
                log_context_action('junior_online_unblock', 'Zdjęto blokadę płatności internetowych')
                add_notification(junior['id'], 'Płatności internetowe odblokowane',
                                 'Opiekun ponownie zezwolił na płatności internetowe.', 'success')
                db.commit()
                flash('Płatności internetowe zostały odblokowane.', 'success')
