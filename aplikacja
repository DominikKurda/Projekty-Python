    # Starsze wydania aplikacji mogły utworzyć niepełne tabele BLIK, w których
    # klucz obcy wskazywał na nieistniejącą jeszcze kolumnę blik_codes.id.
    # Na czas naprawy schematu wyłączamy kontrolę FK. PRAGMA zadziała tylko poza
    # transakcją, dlatego najpierw jawnie kończymy executescript().
    db.commit()
    db.execute("PRAGMA foreign_keys = OFF")

    # Migracja modułu BLIK dla baz utworzonych przez starsze wersje aplikacji.
    # Indeksy powstają dopiero po dodaniu brakujących kolumn, dzięki czemu
    # aktualizacja nie wymaga kasowania pliku novabank.db.
    def ensure_column(table: str, column: str, definition: str) -> None:
        columns = {row["name"] for row in db.execute(f"PRAGMA table_info({table})")}
        if column not in columns:
            db.execute(f"ALTER TABLE {table} ADD COLUMN {column} {definition}")

    def ensure_legacy_row_id(table: str) -> None:
        """Dodaje stabilne ID do tabel BLIK utworzonych przez starszą wersję."""
        columns = {row["name"] for row in db.execute(f"PRAGMA table_info({table})")}
        if "id" not in columns:
            db.execute(f"ALTER TABLE {table} ADD COLUMN id INTEGER")

        # Indeks UNIQUE musi powstać przed UPDATE. W starej bazie tabela
        # blik_operations odwołuje się już do blik_codes(id), więc bez tego
        # SQLite zgłasza "foreign key mismatch" przy pierwszej zmianie danych.
        db.execute(
            f"CREATE UNIQUE INDEX IF NOT EXISTS idx_{table}_legacy_id ON {table}(id)"
        )
        # W SQLite rowid istnieje także w starych tabelach bez jawnej kolumny id.
        # Uzupełniamy nim stare rekordy, aby relacja code_id działała.
        db.execute(f"UPDATE {table} SET id = rowid WHERE id IS NULL")
        db.execute(
            f"""CREATE TRIGGER IF NOT EXISTS trg_{table}_legacy_id
            AFTER INSERT ON {table}
            WHEN NEW.id IS NULL
            BEGIN
                UPDATE {table} SET id = NEW.rowid WHERE rowid = NEW.rowid;
            END"""
        )

    ensure_legacy_row_id("blik_codes")
