                                   f'{money(amount)}, dzień {payment_day}, KIESZ-{created.lastrowid:06d}')
                db.commit()
                flash('Regularne kieszonkowe zostało ustawione.', 'success')
            else:
                abort(400)
        except (sqlite3.Error, ValueError) as exc:
            db.rollback()
            flash(str(exc), 'error')
        return redirect(url_for('junior_control'))

    settings = db.execute('SELECT * FROM junior_settings WHERE junior_user_id = ?', (junior['id'],)).fetchone()
