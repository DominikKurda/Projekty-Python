def balance_chart(user_id):
    db = get_db()
    user = db.execute('SELECT * FROM users WHERE id = ?', (user_id,)).fetchone()
    transactions = db.execute('SELECT * FROM transactions WHERE user_id = ? ORDER BY created_at, id', (user_id,)).fetchall()
    balance = user['balance_cents'] - sum(row['amount_cents'] * (1 if row['kind'] == 'credit' else -1) for row in transactions)
    rows = [{'date': format_date(user['created_at']), 'title': 'Saldo początkowe (odtworzone)', 'balance': balance}]
    for row in transactions:
        balance += row['amount_cents'] * (1 if row['kind'] == 'credit' else -1)
        rows.append({'date': format_date(row['created_at']), 'title': row['title'], 'balance': balance})
    low, high = min(r['balance'] for r in rows), max(r['balance'] for r in rows)
    points = ' '.join(f"{20 + i * 720 / max(1, len(rows)-1):.2f},{170 - (row['balance']-low)*130 / max(1, high-low):.2f}" for i, row in enumerate(rows))
    if len(rows) == 1:
        points += ' 740,170'
    return dict(points=points, low=low, high=high, rows=rows, start=rows[0]['date'], end=rows[-1]['date'])


