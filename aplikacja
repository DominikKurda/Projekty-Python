def reward_level(lifetime_points: int) -> dict:
    if lifetime_points >= 2500:
        return {'name': 'Gold', 'next_name': None, 'remaining': 0, 'progress': 100}
    if lifetime_points >= 1000:
        return {
            'name': 'Silver', 'next_name': 'Gold',
            'remaining': 2500 - lifetime_points,
            'progress': round((lifetime_points - 1000) * 100 / 1500),
        }
    return {
        'name': 'Bronze', 'next_name': 'Silver',
        'remaining': 1000 - lifetime_points,
        'progress': round(lifetime_points * 100 / 1000),
    }


