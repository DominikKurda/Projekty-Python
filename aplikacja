@app.route('/exchange', methods=['GET', 'POST'])
@login_required
def exchange():
    user = current_user()
    if user is None:
        session.clear()
        return redirect(url_for('login'))
    db = get_db()
    values = {'currency': 'EUR', 'direction': 'buy', 'amount': ''}
    status = 200
    if request.method == 'POST':
        values = {key: request.form.get(key, '') for key in values}
        error = None
        amount = None
        if not valid_csrf():
            error = 'Nieprawidłowy token CSRF. Odśwież stronę i spróbuj ponownie.'
            status = 400
        elif values['currency'] not in EXCHANGE_RATES or values['direction'] not in ('buy', 'sell'):
            error = 'Wybierz poprawną walutę i rodzaj wymiany.'
        else:
            raw = values['amount'].strip().replace(',', '.')
            if not re.fullmatch(r'[0-9]{1,7}(?:\.[0-9]{1,2})?', raw):
                error = 'Podaj kwotę waluty z maksymalnie dwoma miejscami po przecinku.'
            else:
                amount = int(Decimal(raw) * 100)
                if not 1 <= amount <= 100_000_000:
                    error = 'Kwota waluty musi wynosić od 0,01 do 1 000 000.'
        if error is None:
            currency, direction = values['currency'], values['direction']
            rate = EXCHANGE_RATES[currency][1 if direction == 'buy' else 0]
            pln = int((Decimal(amount) * rate).quantize(Decimal('1'), rounding=ROUND_HALF_UP))
            serializer = URLSafeTimedSerializer(app.secret_key, salt='exchange-confirmation')
            confirmation = request.form.get('confirmation', '')
            if not confirmation:
                confirmation = serializer.dumps({'user': user['id'], 'currency': currency,
                    'direction': direction, 'amount': amount, 'rate': str(rate),
