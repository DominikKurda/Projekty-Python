SOURCE = "https://istqb.org/wp-content/uploads/2024/11/ISTQB_CTFL_Syllabus_v4.0.1.pdf"
TOPICS = [{'id': 1, 'number': '01', 'title': 'Co to jest testowanie?', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>Testowanie oprogramowania</strong> to zbiór czynności, których celem jest wykrywanie defektów i ocena jakości produktów pracy związanych z oprogramowaniem.</p>\n<div class="definitioncopy"><p>Przedmiotem testów może być aplikacja, jej część, kod albo dokumentacja, np. wymagania. Testowanie pomaga ustalić, czy rozwiązanie spełnia <strong>określone wymagania</strong> (weryfikacja) oraz <strong>potrzeby użytkowników w rzeczywistym środowisku</strong> (walidacja).</p>\n<p>Obejmuje planowanie, monitorowanie i nadzór, analizę i projektowanie testów, ich implementację i wykonanie oraz zakończenie testów. Czynności te dobiera się do kontekstu projektu i mogą się one przenikać. Wyniki dostarczają informacji o jakości i ryzyku, wspierając decyzje, np. o wydaniu aplikacji.</p></div>\n<h3 style="margin-top:24px">Dwa sposoby testowania — ten sam przelew</h3>\n<p>Na koncie jest <strong>500 zł</strong>, przelew wynosi <strong>100 zł</strong>, bez prowizji i innych operacji. Zobacz, jak tester może sprawdzić tę funkcję na dwa sposoby.</p>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="intro-static-title"><div class="definition-label">OCENIASZ MATERIAŁ BEZ JEGO WYKONYWANIA</div><h3 id="intro-static-title">Testowanie statyczne</h3><p class="definition-text">Sprawdzasz produkt pracy, np. wymagania lub kod, bez uruchamiania ocenianego programu. Możesz bezpośrednio znaleźć defekt w tym materiale.</p><div class="definition-question"><strong>Co robi tester?</strong><p>Czyta wymagania dotyczące przelewu i porównuje zapisane reguły oraz przykłady.</p></div><div class="definition-mini"><strong>Przykład: sprzeczność w wymaganiach</strong><p>Reguła mówi: „odejmij kwotę przelewu tylko raz”, ale przykład podaje: 500 zł − 100 zł = 300 zł. Tester zgłasza sprzeczność. Po wyjaśnieniu przykład zostaje poprawiony na <strong>400 zł</strong>.</p><p><strong>Co wykrył?</strong> Defekt dokumentacji. Nie wykonywał przelewu w aplikacji.</p></div></section>\n<section class="definition-card validation" aria-labelledby="intro-dynamic-title"><div class="definition-label">URUCHAMIASZ PROGRAM I OBSERWUJESZ WYNIK</div><h3 id="intro-dynamic-title">Testowanie dynamiczne</h3><p class="definition-text">Sprawdzasz zachowanie uruchomionego oprogramowania. Wykonujesz test i porównujesz rzeczywisty wynik z oczekiwanym.</p><div class="definition-question"><strong>Co robi tester?</strong><p>W środowisku testowym wykonuje przelew i sprawdza saldo według uzgodnionych wymagań.</p></div><div class="definition-mini"><strong>Przykład: nieprawidłowe saldo w aplikacji</strong><p>Przed przelewem jest 500 zł. Tester wysyła 100 zł i oczekuje <strong>400 zł</strong>, ale aplikacja pokazuje <strong>300 zł</strong>. Zapisuje kroki oraz wyniki i zgłasza problem.</p><p><strong>Co ujawnił?</strong> Awarię, czyli nieprawidłowe działanie. Przyczynę i związany z nią defekt trzeba ustalić w dalszej analizie.</p></div></section>\n</div>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Najważniejsze różnice w tym przykładzie</caption><thead><tr><th scope="col">Co porównujemy?</th><th scope="col">Statyczne</th><th scope="col">Dynamiczne</th></tr></thead><tbody><tr><th scope="row">Przedmiot sprawdzenia</th><td>Dokument wymagań.</td><td>Działająca funkcja przelewu.</td></tr><tr><th scope="row">Sposób pracy</th><td>Przeczytanie i ocena zapisów bez wykonywania przelewu.</td><td>Wykonanie przelewu i porównanie salda z oczekiwaniem.</td></tr><tr><th scope="row">Wykryty problem</th><td>Sprzeczny przykład w dokumentacji — defekt.</td><td>Nieprawidłowe saldo podczas działania — awaria.</td></tr></tbody></table></div>\n<p class="note">To porównanie sposobów pracy, a nie sztywnych etapów projektu. Testowanie statyczne może dotyczyć również gotowego kodu. Uruchomienie narzędzia do analizy statycznej nie oznacza uruchomienia analizowanego programu. Oba podejścia się uzupełniają; szersze omówienie znajdziesz w temacie 9.</p>\n<div class="simple"><strong>Prostymi słowami</strong>Sprawdzamy, czy rozwiązanie działa zgodnie z oczekiwaniami i jest przydatne użytkownikowi. Szukamy problemów i zbieramy informacje potrzebne do oceny jakości.</div>\n</section>\n<div class="lower">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid"><div class="memory"><h3>Testowanie obejmuje wiele czynności</h3><p>Analizujesz wymagania, przygotowujesz i wykonujesz testy, a następnie oceniasz oraz przekazujesz wyniki.</p></div><div class="memory"><h3>Możesz zacząć przed powstaniem kodu</h3><p>Przegląd wymagań jest testowaniem statycznym. Uruchomienie aplikacji i sprawdzenie jej działania to testowanie dynamiczne.</p></div><div class="memory"><h3>Testowanie i debugowanie mają różne zadania</h3><p>Testowanie ujawnia problemy i dostarcza informacji o jakości. Diagnozowanie przyczyn oraz naprawa defektów to debugowanie.</p></div><div class="memory"><h3>Poprawny wynik ma określony zakres</h3><p>Zaliczone testy potwierdzają wyniki sprawdzonych przypadków. Nie dowodzą, że produkt jest wolny od wszystkich defektów.</p></div></div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia</h2></div>\n<div class="example"><h3>Przelew w banku</h3><p>Po wyjaśnieniu wymagań sprawdzasz działającą aplikację w środowisku testowym, na fikcyjnych kontach. Masz 500 zł i wysyłasz znajomemu 100 zł. Nie ma prowizji ani innych operacji.</p>\n<div class="balance" aria-label="500 zł minus przelew 100 zł daje 400 zł"><div><small>PRZED</small><b>500 zł</b></div><span class="arrow" aria-hidden="true">→</span><div><small>PRZELEW</small><b>100 zł</b></div><span class="arrow" aria-hidden="true">→</span><div><small>PO</small><b>400 zł</b></div></div>\n<h3>Co sprawdzasz?</h3><ul class="list"><li>Saldo po przelewie wynosi 400 zł.</li><li>Znajomy otrzymał dokładnie 100 zł.</li><li>Historia zawiera jeden przelew z poprawnymi danymi.</li><li>Ponowne kliknięcie w trakcie wysyłania nie zleca go drugi raz.</li></ul>\n<div class="failure"><p><b>Przykładowy problem:</b> znajomy dostał 100 zł, ale Twoje saldo wynosi 300 zł. Zaobserwowałeś awarię. Możliwy defekt to podwójne odjęcie kwoty — przyczynę trzeba sprawdzić.</p></div>\n<p class="report"><strong>Zgłoszenie testera:</strong> kroki odtworzenia, oczekiwane 400 zł, rzeczywiste 300 zł i dowody. Znalezienie przyczyny oraz poprawienie kodu to debugowanie.</p></div>\n</section>\n</div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Testowanie pomaga ocenić jakość i wykryć problemy. Nie daje gwarancji, że wszystkie defekty zostały znalezione.</p></div>\n</div>', 'sections': 'sekcje 1.1–1.4'}, {'id': 2, 'number': '02', 'title': 'Typowe cele testów — po co testujemy?', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>Cele testowania</strong> określają, co chcemy osiągnąć poprzez czynności testowe. Pomagają ustalić, po co testujemy i jakich informacji potrzebuje zespół.</p>\n<div class="definitioncopy"><p>Testowanie służy wykrywaniu problemów, ocenie jakości i wspieraniu decyzji. Cele dobiera się do kontekstu: produktu, poziomu testów, ryzyka, sposobu wytwarzania oprogramowania i sytuacji biznesowej.</p><p>Sylabus ISTQB CTFL 4.0 wymienia dziewięć typowych celów testów:</p></div>\n<ul class="objectives"><li>dokonywanie oceny produktów pracy, takich jak wymagania, historyjki użytkownika, projekty, kod;</li><li>powodowanie awarii i znajdowanie defektów;</li><li>zapewnienie wymaganego pokrycia przedmiotu testów;</li><li>obniżanie poziomu ryzyka związanego z niedostateczną jakością oprogramowania;</li><li>sprawdzanie, czy zostały spełnione wyspecyfikowane wymagania;</li><li>sprawdzanie, czy przedmiot testów spełnia wymagania umowne, prawne i regulacyjne;</li><li>dostarczanie interesariuszom informacji niezbędnych do podejmowania świadomych decyzji;</li><li>budowanie zaufania do jakości przedmiotu testów;</li><li>walidacja, czy przedmiot testów stanowi kompletne rozwiązanie i działa zgodnie z oczekiwaniami interesariuszy.</li></ul><p class="scope-note">Cele mogą się łączyć: jeden test może wspierać kilka z nich. Ich znaczenie i sposób realizacji zależą od kontekstu projektu. Budowanie zaufania opiera się na dowodach i nie oznacza gwarancji braku defektów.</p>\n<div class="simple"><strong>Prostymi słowami</strong>Chcemy wiedzieć, co działa, gdzie występują problemy i jakie ryzyko pozostaje przed udostępnieniem produktu użytkownikom.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid"><div class="memory"><h3>Cel wyjaśnia, po co wykonujesz test</h3><p>Zanim zaczniesz, ustal, co chcesz ocenić i jakie informacje są potrzebne zespołowi.</p></div><div class="memory"><h3>Cele zależą od kontekstu i ryzyka</h3><p>Dobierasz je do produktu, potrzeb użytkowników i możliwych skutków problemów.</p></div><div class="memory"><h3>Pokrycie musi mieć określony zakres</h3><p>Sprawdzenie wszystkich zaplanowanych wymagań nie oznacza sprawdzenia każdej możliwej sytuacji.</p></div><div class="memory"><h3>Wyniki wspierają świadomą decyzję</h3><p>Przekaż, co sprawdzono, co nie działa i jakie ryzyko pozostało. Sama liczba zaliczonych testów nie wystarcza.</p></div></div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — po co testujemy sklep?</h2></div>\n<div class="example"><h3>Chcesz kupić buty i zapłacić właściwą kwotę</h3><p>Sklep przygotowuje nową promocję. Buty kosztują <strong>200 zł</strong>, kod daje <strong>10% rabatu na produkt</strong>, a dostawa kosztuje <strong>15 zł</strong>. Zgodnie z wymaganiami klient powinien zapłacić <strong>195 zł</strong> i otrzymać jedno zamówienie we właściwym rozmiarze.</p><p>Jako tester sprawdzasz zakup przed uruchomieniem promocji. Każdy cel odpowiada na inne pytanie:</p>\n<ol class="goal-examples">\n<li><h3>Ocena produktów pracy</h3><p>Czytasz wymagania promocji. Zauważasz, że nie podano, czy rabat obejmuje dostawę. Wyjaśniasz to z zespołem, zanim zaczniecie sprawdzać wyliczenia.</p></li>\n<li><h3>Powodowanie awarii i znajdowanie defektów</h3><p>Uruchamiasz zakup z kodem. Sklep pokazuje 195 zł, ale w testowej płatności nalicza 215 zł. Ujawniasz awarię i zgłaszasz problem do zbadania.</p></li>\n<li><h3>Zapewnienie wymaganego pokrycia</h3><p>Ustalasz pięć scenariuszy: zakup bez kodu, z poprawnym kodem, z kodem wygasłym, odrzuconą płatność i podwójne kliknięcie przycisku zakupu. Wykonanie wszystkich daje pokrycie 5 z 5 zaplanowanych scenariuszy, a nie wszystkich możliwych sytuacji.</p></li>\n<li><h3>Obniżanie ryzyka niedostatecznej jakości</h3><p>Szczególnie dokładnie sprawdzasz pobraną kwotę i podwójne kliknięcie. Chcesz ograniczyć ryzyko, że klient zapłaci za dużo albo zostanie obciążony dwa razy.</p></li>\n<li><h3>Sprawdzanie wyspecyfikowanych wymagań</h3><p>Porównujesz wynik z uzgodnionym wymaganiem: 200 zł − 20 zł + 15 zł = 195 zł. Sprawdzasz też, czy zamówienie zawiera wybrany rozmiar i adres.</p></li>\n<li><h3>Sprawdzanie wymagań umownych, prawnych i regulacyjnych</h3><p>Korzystasz z przygotowanej dla sklepu listy obowiązujących wymagań. Sprawdzasz wskazane na niej elementy procesu zakupu, np. prezentację kosztów i treść potwierdzenia, oraz zgodność promocji z jej regulaminem.</p></li>\n<li><h3>Dostarczanie informacji do podjęcia decyzji</h3><p>Przekazujesz zespołowi raport: które scenariusze sprawdzono, jakie są wyniki i że płatność pobiera o 20 zł za dużo. Na tej podstawie zespół może wstrzymać promocję do czasu poprawki.</p></li>\n<li><h3>Budowanie zaufania do jakości</h3><p>Po poprawce płatności ponownie sprawdzasz naliczenie 195 zł oraz odpowiednią regresję. Przedstawiasz dowody: wyniki sprawdzonych scenariuszy, zakres pokrycia i otwarte problemy. Zespół zyskuje uzasadnione zaufanie do jakości w sprawdzonym zakresie, a nie pewność, że żaden defekt nie pozostał.</p></li>\n<li><h3>Walidacja kompletności i zgodności z oczekiwaniami</h3><p>Z udziałem przedstawicieli klientów przeprowadzasz realistyczny zakup butów: wybór właściwego rozmiaru, użycie promocji, dostawa, płatność i potwierdzenie. Obserwujesz, czy mogą zrealizować cały cel zakupu i czy otrzymują potrzebne informacje. Sprawdzasz, czy rozwiązanie jest dla nich kompletne i działa zgodnie z oczekiwaniami — także wtedy, gdy poszczególne funkcje spełniają zapisane wymagania.</p></li>\n</ol><div class="failure"><p><b>Efekt dla kupującego:</b> testy pomagają wykryć problemy, zanim prawdziwy klient zapłaci niewłaściwą kwotę. Zespół otrzymuje konkretne informacje potrzebne do decyzji o uruchomieniu promocji.</p></div></div>\n</section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Testujemy, aby wykrywać problemy, oceniać jakość i wspierać świadome decyzje.</p></div>\n</div>', 'sections': 'sekcja 1.1.1'}, {'id': 3, 'number': '03', 'title': 'Testowanie a debugowanie', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>Testowanie i debugowanie to odrębne czynności.</strong> Testowanie pomaga wykrywać defekty i oceniać jakość. Debugowanie służy ustaleniu przyczyn problemów i ich usunięciu.</p>\n<div class="definitioncopy"><p>Podczas <strong>testowania dynamicznego</strong> uruchamiamy program i możemy ujawnić awarię, czyli nieprawidłowe działanie. Podczas <strong>testowania statycznego</strong>, np. przeglądu wymagań lub kodu, możemy znaleźć defekt bez uruchamiania programu.</p><p>Po ujawnieniu awarii debugowanie zazwyczaj obejmuje jej <strong>odtworzenie</strong>, <strong>diagnozę</strong> — znalezienie defektu — oraz <strong>poprawienie defektu</strong>. Gdy przegląd bezpośrednio wskazał defekt, nie trzeba odtwarzać awarii, aby go usunąć.</p></div>\n<div class="twotypes"><div class="type"><h3>Testowanie potwierdzające</h3><p>Po poprawce sprawdzamy, czy usunięto problem, który ujawnił wcześniejszy test.</p></div><div class="type"><h3>Testowanie regresji</h3><p>Sprawdzamy, czy zmiana nie spowodowała niepożądanych skutków w zmienionym komponencie, innych komponentach lub systemach połączonych, a także w środowisku.</p></div></div>\n<div class="simple"><strong>Prostymi słowami</strong>Testowanie pomaga ujawnić problemy i ocenić jakość. Debugowanie ustala przyczynę problemu i usuwa defekt. Kolejne testy sprawdzają poprawkę oraz skutki zmiany.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Zaobserwowany problem to jeszcze nie diagnoza</h3><p>To, że aplikacja działa nieprawidłowo, nie wskazuje automatycznie, który fragment kodu lub inny czynnik jest przyczyną.</p></div>\n<div class="memory"><h3>Liczy się czynność, a nie stanowisko</h3><p>Ta sama osoba może testować i debugować. Zmiana wykonawcy nie decyduje o różnicy między tymi działaniami.</p></div>\n<div class="memory"><h3>Poprawka wymaga sprawdzenia</h3><p>Po zmianie wykonaj testowanie potwierdzające. Samo zmodyfikowanie kodu nie dowodzi, że problem rozwiązano.</p></div>\n<div class="memory"><h3>Sprawdź też wpływ na inne funkcje</h3><p>Poprawka jednego problemu może wpłynąć na inne zachowania. Dlatego dobierz odpowiednie testy regresji.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — rezerwacja biletu lotniczego</h2></div>\n<div class="example"><h3>Dwie osoby kupują ostatnie miejsce w samolocie</h3><p>Na lot <strong>Warszawa–Londyn</strong> zostało <strong>jedno dostępne miejsce</strong>. Dwie osoby próbują kupić bilet w tym samym momencie. W tym przykładzie wymaganie mówi, że system powinien potwierdzić zakup tylko jednej osobie — nie dopuszcza sprzedaży ponad liczbę dostępnych miejsc.</p><p>Tester sprawdza ten scenariusz <strong>w środowisku testowym, na fikcyjnych rezerwacjach i płatnościach</strong>.</p>\n<ol class="goal-examples">\n<li><h3>Testowanie — tester wykrywa i zgłasza problem</h3><p>Tester przygotowuje lot z jednym wolnym miejscem. W dwóch oddzielnych sesjach przeglądarki uruchamia równoczesne próby zakupu. Obie osoby otrzymują potwierdzenie, mimo że było tylko jedno miejsce. Tester zapisuje kroki, identyfikatory testowych rezerwacji oraz oczekiwany i rzeczywisty wynik. To zaobserwowana awaria.</p></li>\n<li><h3>Debugowanie — programista znajduje przyczynę i poprawia kod</h3><p>Programista odtwarza zgłoszony problem i analizuje zapis rezerwacji. W tym przykładzie obie próby zakupu sprawdzają dostępność, zanim którakolwiek zajmie ostatnie miejsce. Programista poprawia zabezpieczenie przed równoczesną sprzedażą, tak aby system mógł potwierdzić tylko jeden zakup.</p></li>\n<li><h3>Testowanie potwierdzające — tester sprawdza poprawkę</h3><p>Tester ponownie przygotowuje jedno wolne miejsce i powtarza ten sam scenariusz. Sprawdza, czy zakup zostaje potwierdzony tylko jednej osobie, druga otrzymuje informację o braku miejsca, a system nie tworzy dla niej potwierdzonego biletu. Sprawdza też rozliczenie testowych płatności zgodnie z wymaganiami.</p></li>\n<li><h3>Testowanie regresji — tester sprawdza inne funkcje</h3><p>Tester sprawdza również zwykły zakup przy większej liczbie wolnych miejsc, rezerwację na inny lot oraz anulowanie i ponowną sprzedaż zwolnionego miejsca, jeśli przewidują to wymagania. Ocenia, czy poprawka nie spowodowała problemów w tych obszarach.</p></li>\n</ol>\n<div class="failure"><p><b>Efekt dla pasażera:</b> w tym scenariuszu system nie potwierdza dwóch zakupów jednego dostępnego miejsca. Tester dostarcza zespołowi dowodów, że sprawdzona poprawka działa, oraz informacji o wynikach regresji.</p></div></div>\n</section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Wykrycie problemu, znalezienie i usunięcie jego przyczyny oraz sprawdzenie poprawki to odrębne czynności.</p></div>\n</div>\n', 'sections': 'sekcja 1.1.2'}, {'id': 4, 'number': '04', 'title': 'Dlaczego testowanie jest niezbędne?', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>Testowanie jest niezbędne, ponieważ pomaga wykrywać defekty, oceniać jakość i ograniczać ryzyko problemów podczas korzystania z oprogramowania.</strong> Dostarcza informacji potrzebnych do decyzji o udostępnieniu produktu.</p>\n<div class="definitioncopy"><p>Nieprawidłowe działanie systemu może oznaczać straty pieniędzy, czasu i zaufania, a w niektórych zastosowaniach zagrożenie dla zdrowia lub życia. Testowanie pomaga ujawnić problemy, zanim wystąpią u użytkowników.</p><p>Ocena wymagań, kodu i działającego systemu wspiera jakość na różnych etapach wytwarzania. Znalezione defekty można usunąć poprzez debugowanie. Ich wczesne wykrycie może ograniczyć koszty późniejszych poprawek i skutków awarii.</p><p>Wyniki testów pomagają ocenić gotowość produktu i pozostałe ryzyko. Testowanie uwzględnia też perspektywę użytkowników. Może być wymagane ze względu na umowy, przepisy lub regulacje.</p></div>\n<div class="simple"><strong>Prostymi słowami</strong>Lepiej wykryć, że system nie zapisuje opłaconej usługi podczas testów, niż dowiedzieć się o tym od klienta stojącego przy odprawie na lotnisku.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Problemy mają realne konsekwencje</h3><p>Użytkownik może stracić pieniądze, czas i zaufanie do usługi. Ważne są skutki awarii, a nie tylko jej techniczny opis.</p></div>\n<div class="memory"><h3>Zacznij od wymagań</h3><p>Niejasność można zauważyć przed napisaniem kodu. Wcześniejsze wyjaśnienie ogranicza ryzyko zbudowania niewłaściwego rozwiązania.</p></div>\n<div class="memory"><h3>Wyniki pomagają podjąć decyzję</h3><p>Przekaż zespołowi, co sprawdzono, co nie działa i jakie ryzyko pozostało. Testy nie gwarantują braku wszystkich defektów.</p></div>\n<div class="memory"><h3>Jakość jest wspólną odpowiedzialnością</h3><p>Tester dostarcza informacji o produkcie, ale także inni członkowie zespołu przyczyniają się do jakości i powodzenia projektu.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — opłacony bagaż znika z rezerwacji</h2></div>\n<div class="example"><h3>Płacisz 150 zł, lecz system nie zapisuje usługi</h3><p>Kupujesz bilet lotniczy i dodajesz <strong>bagaż rejestrowany za 150 zł</strong>. Płatność zostaje przyjęta, ale w rezerwacji i potwierdzeniu nie ma bagażu. Na lotnisku musisz wyjaśniać sprawę i możesz zostać poproszony o ponowną opłatę.</p><p>To przykładowy scenariusz do nauki, a nie opis konkretnej linii lotniczej.</p>\n<ol class="goal-examples">\n<li><h3>Co tester przygotowuje?</h3><p>W środowisku testowym sprawdza wymaganie: po przyjęciu płatności za bagaż usługa ma być przypisana do właściwego pasażera i lotu oraz widoczna w rezerwacji i potwierdzeniu. Korzysta z fikcyjnych danych i testowej płatności.</p></li>\n<li><h3>Co tester sprawdza?</h3><p>Kupuje testowy bilet, dodaje bagaż i opłaca zamówienie. Porównuje rozliczenie płatności, dane rezerwacji i potwierdzenie. Sprawdza cały przebieg zakupu, a nie tylko komunikat „Płatność zakończona”.</p></li>\n<li><h3>Jaki problem wykrywa i zgłasza?</h3><p>Opłata 150 zł została przyjęta, ale usługi nie zapisano. Tester zgłasza kroki odtworzenia, numer testowej rezerwacji, dane testowej transakcji oraz różnicę między oczekiwanym a rzeczywistym wynikiem. Wyjaśnia ryzyko dla pasażera: spór o opłatę, opóźnienie obsługi i stres.</p></li>\n<li><h3>Dlaczego testowanie było potrzebne?</h3><p>Zespół dowiaduje się o problemie przed udostępnieniem funkcji. Może poprawić zapis usługi i sprawdzić rozwiązanie, zamiast dopiero reagować na reklamacje prawdziwych pasażerów. Wynik testu wspiera decyzję o gotowości produktu.</p></li>\n</ol>\n<div class="failure"><p><b>Efekt dla pasażera:</b> po usunięciu problemu i sprawdzeniu poprawki opłacony bagaż jest widoczny w rezerwacji. Testowanie pomogło uniknąć sytuacji, w której klient płaci za usługę, której system nie potrafi potwierdzić.</p></div></div>\n</section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Testowanie pomaga wykryć problemy, zanim odczuje je użytkownik.</p></div>\n</div>\n', 'sections': 'sekcje 1.2 i 1.2.1'}, {'id': 5, 'number': '05', 'title': 'Testowanie a zapewnienie jakości (QA)', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>Testowanie i zapewnienie jakości (QA) są powiązane, ale oznaczają różne działania.</strong> Testowanie koncentruje się na produkcie, a QA na procesach jego tworzenia i testowania.</p>\n<div class="definitioncopy"><p><strong>Testowanie</strong> jest formą kontroli jakości (QC). Pomaga wykrywać defekty i oceniać jakość produktów pracy, np. wymagań, kodu i aplikacji. Dostarcza informacji o tym, czy produkt osiąga oczekiwany poziom jakości.</p><p><strong>Zapewnienie jakości (Quality Assurance, QA)</strong> ma charakter zapobiegawczy. Obejmuje wdrażanie i doskonalenie procesów, aby zwiększać szansę powstawania produktów o odpowiedniej jakości. Dotyczy zarówno wytwarzania, jak i testowania oprogramowania.</p><p>Wyniki testów mogą wspierać oba obszary: wskazują problemy w produkcie i dostarczają informacji o skuteczności sposobu pracy. Za zapewnienie jakości odpowiada cały zespół.</p></div>\n<div class="twotypes"><div class="type"><h3>Testowanie → produkt</h3><p>Sprawdzamy, czy aplikacja prawidłowo przekazuje wybrane składniki zamówienia.</p></div><div class="type"><h3>QA → proces</h3><p>Usprawniamy sposób uzgadniania i przeglądania wymagań dotyczących zamówień.</p></div></div>\n<div class="qa-detail">\n<h3>Na czym polega zapewnienie jakości w praktyce?</h3>\n<p>QA opiera się na założeniu, że odpowiednio zaprojektowane i stosowane procesy sprzyjają powstawaniu dobrego produktu. Zespół ustala sposób pracy, stosuje go, ocenia skuteczność i wprowadza usprawnienia. Samo posiadanie procedury nie daje gwarancji jakości.</p>\n<p><strong>Poniższe działania to przykłady zastosowania tego podejścia</strong> — ich zakres dobiera się do projektu, a nie traktuje jako obowiązkową listę dla każdego zespołu.</p>\n<div class="twotypes">\n<div class="type"><h3>Jasne zasady pracy z wymaganiami</h3><p>Zespół ustala, jak zapisywać oczekiwane zachowanie i kto wyjaśnia niejasności. Przykład: każda modyfikacja zamówienia ma określać, co zobaczy klient i restauracja.</p></div>\n<div class="type"><h3>Uzgodniony sposób przeglądu zmian</h3><p>Zespół określa, kiedy i przez kogo wymagania oraz zmiany kodu będą przeglądane. Wykonanie konkretnego przeglądu kodu w celu wykrycia defektów jest testowaniem statycznym; ustanowienie i doskonalenie tego procesu wspiera QA.</p></div>\n<div class="type"><h3>Doskonalenie procesu testowania</h3><p>Zespół określa sposób przygotowania danych, zgłaszania defektów i sprawdzania poprawek. Gdy zgłoszenia często nie pozwalają odtworzyć problemu, usprawnia ich szablon i uczy się go stosować.</p></div>\n<div class="type"><h3>Sprawdzanie skuteczności usprawnień</h3><p>Po zmianie sposobu pracy zespół wraca do wyników i opinii. Sprawdza, czy zgłoszenia są odtwarzalne i czy podobne niejasności pojawiają się rzadziej. W razie potrzeby ponownie zmienia proces.</p></div>\n</div>\n<h3>QA, QC i testowanie — jak je odróżnić?</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Porównanie na przykładzie aplikacji do zamawiania jedzenia</caption><thead><tr><th scope="col">Pojęcie</th><th scope="col">Na czym się koncentruje?</th><th scope="col">Przykład</th></tr></thead><tbody>\n<tr><th scope="row">QA — zapewnienie jakości</th><td>Wdrażanie i doskonalenie procesów; podejście zapobiegawcze.</td><td>Ustalenie i ulepszanie sposobu uzgadniania modyfikacji zamówień z restauracją.</td></tr>\n<tr><th scope="row">QC — kontrola jakości</th><td>Produkt i działania wspierające osiągnięcie odpowiedniego poziomu jego jakości.</td><td>Ocena, czy przekazywane zamówienia odpowiadają uzgodnionym wymaganiom.</td></tr>\n<tr><th scope="row">Testowanie</th><td>Forma QC: wykrywanie defektów oraz ocena jakości produktów pracy.</td><td>Porównanie opcji „bez sera” w koszyku z zamówieniem w panelu restauracji.</td></tr>\n</tbody></table></div>\n<h3>Kto odpowiada za zapewnienie jakości?</h3>\n<p><strong>Za zapewnienie jakości odpowiada cały zespół projektowy.</strong> Każdy uczestniczy w tworzeniu i doskonaleniu sposobu pracy, zgodnie ze swoją rolą:</p>\n<ul class="list"><li><strong>Analityk</strong> — pomaga ustalać jednoznaczne wymagania i kryteria akceptacji.</li><li><strong>Programista</strong> — uczestniczy w ustalaniu i doskonaleniu zasad tworzenia oraz przeglądania kodu.</li><li><strong>Tester</strong> — wykorzystuje wyniki testów do wskazywania słabości procesu i proponowania usprawnień.</li><li><strong>Osoba zarządzająca projektem lub zespołem</strong> — pomaga organizować pracę i wdrażać uzgodnione zmiany.</li></ul>\n<p>Podział zadań zależy od organizacji. <strong>Zapewnienie jakości nie jest wyłącznym obowiązkiem testera ani osoby ze stanowiskiem „QA Engineer”.</strong></p>\n<p><strong>Zapamiętaj:</strong> zapewnienie jakości dotyczy sposobu pracy całego zespołu, a testowanie dostarcza informacji o jakości produktu.</p>\n</div>\n<div class="simple"><strong>Prostymi słowami</strong>Testowanie pomaga zauważyć problem w rozwiązaniu. QA pomaga poprawić sposób pracy, aby ograniczyć powstawanie podobnych problemów.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Testowanie i QA nie są synonimami</h3><p>Testowanie to forma kontroli jakości produktu. QA koncentruje się na wdrażaniu i doskonaleniu procesów.</p></div>\n<div class="memory"><h3>QA obejmuje też proces testowania</h3><p>Można usprawniać nie tylko programowanie, lecz także sposób planowania testów, zgłaszania problemów i przekazywania wyników.</p></div>\n<div class="memory"><h3>Stanowisko nie określa rodzaju czynności</h3><p>Osoba z nazwą stanowiska „QA” może wykonywać testy. O tym, czy działanie jest testowaniem czy QA, decyduje jego przedmiot i cel.</p></div>\n<div class="memory"><h3>Jakość to wspólna odpowiedzialność</h3><p>Tester, programista, analityk i pozostałe osoby w zespole mogą uczestniczyć w ulepszaniu procesów. QA nie jest wyłącznym zadaniem testera.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — zamówienie pizzy przez aplikację</h2></div>\n<div class="example"><h3>Wybierasz „bez sera”, lecz restauracja dostaje inną informację</h3><p>Zamawiasz pizzę i zaznaczasz <strong>„bez sera”</strong>. Koszyk pokazuje prawidłową modyfikację, ale na zamówieniu przekazanym restauracji znajduje się standardowa pizza z serem. Wymaganie mówi, że wybrane modyfikacje muszą być zachowane w całym procesie zamówienia.</p>\n<ol class="goal-examples">\n<li><h3>Testowanie — sprawdzenie konkretnego zamówienia</h3><p>Tester w środowisku testowym wybiera pizzę, zaznacza „bez sera” i składa fikcyjne zamówienie. Porównuje dane w koszyku, potwierdzeniu dla klienta i panelu restauracji. Wykrywa, że w panelu brakuje modyfikacji. Zgłasza defekt, opisując kroki oraz oczekiwany i rzeczywisty wynik.</p></li>\n<li><h3>QA — usprawnienie sposobu pracy zespołu</h3><p>Zespół analizuje, dlaczego podobne niezgodności powracają. W tym przykładzie różne osoby inaczej rozumieją zapis modyfikacji. Zespół wprowadza wspólny sposób ich opisywania oraz przegląd wymagań z przedstawicielem restauracji przed rozpoczęciem programowania. Uzgadnia też, kto zatwierdza znaczenie modyfikacji i w jakich miejscach zamówienia ma ona być widoczna. To zmiana procesu, a nie tylko poprawienie pojedynczego zamówienia.</p></li>\n<li><h3>Jak wyniki testów pomagają QA?</h3><p>Zgłoszenie pokazuje, gdzie uzgodnienia były niewystarczające. Po wprowadzeniu nowego procesu zespół obserwuje, czy wymagania są bardziej jednoznaczne i czy podobne problemy występują rzadziej. To informacja zwrotna o skuteczności usprawnienia. Zespół porównuje podobne zmiany i uwzględnia ich liczbę oraz złożoność — sam spadek liczby zgłoszeń nie jest dowodem, że proces stał się skuteczny.</p></li>\n</ol>\n<div class="failure"><p><b>Efekt dla klienta:</b> testowanie ujawnia, że aplikacja przekazuje inne zamówienie niż wybrane. QA usprawnia proces uzgadniania wymagań, aby ograniczać powstawanie podobnych niezgodności w kolejnych zmianach.</p></div></div>\n</section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Testowanie pomaga wykrywać problemy w produkcie. QA pomaga ulepszać procesy, aby ograniczać ich powstawanie.</p></div>\n</div>\n', 'sections': 'sekcja 1.2.2'}, {'id': 6, 'number': '06', 'title': 'Błąd, defekt, awaria i przyczyna podstawowa', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicje i znaczenie</h2></div>\n<p class="lead"><strong>Błąd, defekt i awaria nie oznaczają tego samego.</strong> Opisują odpowiednio działanie człowieka, nieprawidłowość w produkcie pracy oraz nieprawidłowe działanie systemu. Przyczyna podstawowa wyjaśnia, dlaczego problem powstał.</p>\n<div class="twotypes">\n<div class="type"><h3>Błąd — działanie człowieka</h3><p>Działanie prowadzące do nieprawidłowego rezultatu, np. błędne zrozumienie wymagania lub wpisanie niewłaściwej wartości do kodu.</p></div>\n<div class="type"><h3>Defekt — nieprawidłowość w produkcie</h3><p>Wada produktu pracy, np. wymagania, kodu lub skryptu testowego. Może zostać wprowadzona wskutek błędu człowieka.</p></div>\n<div class="type"><h3>Awaria — nieprawidłowe działanie</h3><p>Podczas działania system nie wykonuje tego, co powinien, albo robi coś, czego robić nie powinien. Wykonanie kodu zawierającego defekt może ujawnić awarię.</p></div>\n<div class="type"><h3>Przyczyna podstawowa — źródło problemu</h3><p>Fundamentalna przyczyna wystąpienia problemu, np. brak procesu przekazywania zmian, który sprzyja korzystaniu z nieaktualnych wymagań.</p></div>\n</div>\n<div class="definitioncopy"><p>Niektóre defekty ujawniają awarię tylko w określonych warunkach, a inne mogą nigdy jej nie spowodować. Awaria może mieć również przyczyny środowiskowe. Analiza przyczyny podstawowej pomaga ograniczać występowanie podobnych problemów.</p></div>\n<div class="simple"><strong>Prostymi słowami</strong>Człowiek może pomylić się przy tworzeniu rozwiązania. W produkcie pozostaje defekt, który w określonej sytuacji ujawnia się jako nieprawidłowe działanie. Ustalenie źródła problemu wymaga analizy.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Rozróżniaj działanie, wadę i skutek</h3><p>Błąd popełnia człowiek, defekt znajduje się w produkcie pracy, a awarię obserwujemy podczas działania systemu.</p></div>\n<div class="memory"><h3>Defekt nie musi ujawnić się od razu</h3><p>Może być potrzebna konkretna wartość, kolejność działań albo warunki środowiskowe.</p></div>\n<div class="memory"><h3>Awaria nie wskazuje automatycznie przyczyny</h3><p>Nieprawidłowa opłata jest obserwacją. To, dlaczego została naliczona, trzeba ustalić na podstawie dowodów.</p></div>\n<div class="memory"><h3>Poprawienie kodu i zapobieganie nawrotom to różne działania</h3><p>Usunięcie defektu rozwiązuje konkretny problem. Zajęcie się jego przyczyną podstawową może zapobiec podobnym problemom w przyszłości.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — opłata za parking</h2></div>\n<div class="example"><h3>Bezpłatne 15 minut, ale aplikacja pobiera opłatę po 10 minutach</h3><p>Aktualny cennik przewiduje, że postój trwający <strong>do 15 minut włącznie jest bezpłatny</strong>. Parkujesz przez <strong>10 minut</strong>, a aplikacja nalicza opłatę. Poniżej przedstawiono przykładowe ustalenia z analizy tego problemu.</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Jedna sytuacja — cztery różne pojęcia</caption><thead><tr><th scope="col">Pojęcie</th><th scope="col">Co oznacza w tym przykładzie?</th></tr></thead><tbody>\n<tr><th scope="row">Przyczyna podstawowa</th><td>Nie ustalono sposobu przekazywania zmian cennika. Zespół korzystał z nieaktualnej wersji dokumentu.</td></tr>\n<tr><th scope="row">Błąd</th><td>Programista przyjął na podstawie starego cennika, że bezpłatne jest tylko pierwsze 5 minut.</td></tr>\n<tr><th scope="row">Defekt</th><td>W kodzie pozostał próg 5 minut zamiast wymaganych 15 minut.</td></tr>\n<tr><th scope="row">Awaria</th><td>Podczas 10-minutowego postoju aplikacja naliczyła opłatę, mimo że zgodnie z aktualnym cennikiem postój powinien być bezpłatny.</td></tr>\n</tbody></table></div>\n<h3>Co robi tester?</h3><ol class="goal-examples">\n<li><h3>Sprawdza aktualne wymaganie</h3><p>Potwierdza, że bezpłatny postój obejmuje 15 minut włącznie. Ustala też dokładność pomiaru czasu i zasady naliczania opłat po przekroczeniu limitu.</p></li>\n<li><h3>Ujawnia i zgłasza niezgodność</h3><p>W środowisku testowym sprawdza m.in. postój 10-, 14-, 15- i 16-minutowy. Dla 10 minut oczekuje 0 zł, lecz otrzymuje opłatę. Zapisuje dane testu, wynik oczekiwany i rzeczywisty oraz dowody.</p></li>\n<li><h3>Oddziela obserwację od diagnozy</h3><p>Nie wpisuje jako pewnika, że przyczyną jest zły próg w kodzie. To ustalenie wymaga analizy. Dopiero zbadanie kodu, dokumentów i sposobu przekazania zmian pozwala wyjaśnić defekt oraz jego przyczynę podstawową.</p></li>\n<li><h3>Sprawdza poprawkę i wspiera usprawnienie</h3><p>Po zmianie progu tester ponawia odpowiednie testy. Zespół dodatkowo ustala, kto aktualizuje cennik i jak informuje o zmianie. Poprawka kodu usuwa defekt, a usprawnienie procesu ogranicza ryzyko jego powtórzenia.</p></li>\n</ol>\n<div class="failure"><p><b>Efekt dla kierowcy:</b> za postój mieszczący się w bezpłatnym limicie aplikacja nie nalicza opłaty. Zespół rozumie również, dlaczego wcześniej zastosowano niewłaściwy cennik.</p></div></div>\n</section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Błąd popełnia człowiek, defekt znajduje się w produkcie, a awarię obserwujemy podczas działania systemu.</p></div>\n</div>\n', 'sections': 'sekcja 1.2.3'}, {'id': 7, 'number': '07', 'title': 'Zarządzanie defektami — zgłoszenie, ważność i priorytet', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>Zarządzanie defektami</strong> to proces rejestrowania, analizowania, klasyfikowania i śledzenia zgłoszonych problemów od wykrycia do zamknięcia. Obejmuje decyzję o sposobie ich obsługi, np. poprawieniu lub pozostawieniu bez zmian.</p>\n<div class="definitioncopy"><p>Analiza może wykazać, że zgłoszona anomalia nie jest defektem, lecz np. prośbą o zmianę.</p></div>\n<div class="simple"><strong>Prostymi słowami</strong>Opisujemy problem tak, aby zespół mógł go zrozumieć, ustalić dalsze działanie i śledzić rezultat.</div>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="severity-title"><div class="definition-label">WPŁYW PROBLEMU</div><h3 id="severity-title">Ważność defektu</h3><p class="definition-text">Stopień wpływu defektu na wymagania lub interesy interesariuszy.</p><div class="definition-mini"><strong>W naszym przykładzie</strong><p>Naliczanie pieniędzy po zwrocie roweru ma duży wpływ na użytkownika.</p></div></section>\n<section class="definition-card validation" aria-labelledby="priority-title"><div class="definition-label">PILNOŚĆ OBSŁUGI</div><h3 id="priority-title">Priorytet naprawy</h3><p class="definition-text">Określa, jak pilnie należy zająć się naprawą defektu względem innych zadań.</p><div class="definition-mini"><strong>W naszym przykładzie</strong><p>Zespół może nadać pilny priorytet problemowi, który powoduje niesłuszne opłaty.</p></div></section>\n</div>\n<h3 style="margin-top:24px">Co zawiera zgłoszenie defektu?</h3>\n<p>Identyfikator i tytuł, datę i autora, wersję produktu i środowisko, kontekst i dane testowe, kroki odtworzenia, wynik oczekiwany i rzeczywisty, dowody, ważność, priorytet, status oraz powiązania z testami.</p>\n<h3>Jak przebiega obsługa?</h3><p>Rejestracja → analiza i klasyfikacja → decyzja → realizacja uzgodnionego działania → zamknięcie. Przy poprawce potrzebne jest jej sprawdzenie. Nazwy statusów zależą od organizacji.</p>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Ważność a priorytet</h3><p>Wpływ problemu i pilność naprawy to różne informacje.</p></div>\n<div class="memory"><h3>Fakty pomagają</h3><p>Opisuj obserwacje. Przyczyna wymaga analizy.</p></div>\n<div class="memory"><h3>Poprawka wymaga sprawdzenia</h3><p>Sam status „naprawiony” nie potwierdza skuteczności poprawki.</p></div>\n<div class="memory"><h3>Decyzja jest wspólna</h3><p>Podział odpowiedzialności ustala organizacja.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — wypożyczanie roweru miejskiego</h2></div>\n<div class="example"><h3>Rower zwrócony, opłata nadal rośnie</h3><p>Tester na środowisku testowym kończy przejazd i wpina rower do stacji. Stacja potwierdza zwrot, a aplikacja pokazuje „Przejazd zakończony”. Mimo tego po odświeżeniu szczegółów naliczona opłata jest wyższa.</p><p>W tym przykładzie ustalona reguła mówi, że po potwierdzonym zwrocie opłata za czas przejazdu przestaje rosnąć.</p>\n<h3>Jak wygląda konkretne zgłoszenie?</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Przykładowy raport z testu</caption><thead><tr><th scope="col">Pole</th><th scope="col">Treść</th></tr></thead><tbody>\n<tr><th scope="row">Identyfikator i tytuł</th><td>ROW-127 — opłata rośnie po potwierdzonym zwrocie roweru.</td></tr>\n<tr><th scope="row">Środowisko i dane</th><td>Środowisko testowe, aplikacja 2.8.0 na Androidzie 15, konto TEST-24, rower R-018, stacja S-03, przejazd P-1042.</td></tr>\n<tr><th scope="row">Warunki początkowe</th><td>Trwa przejazd. Rower można zwrócić do stacji S-03.</td></tr>\n<tr><th scope="row">Kroki odtworzenia</th><td>1. Zwróć rower o 14:20. 2. Poczekaj na potwierdzenie stacji i komunikat „Przejazd zakończony”. 3. Zapisz kwotę 6 zł. 4. O 14:25 odśwież szczegóły tego samego przejazdu.</td></tr>\n<tr><th scope="row">Wynik oczekiwany</th><td>Opłata pozostaje równa 6 zł — naliczanie za czas zakończyło się o 14:20.</td></tr>\n<tr><th scope="row">Wynik rzeczywisty</th><td>Opłata wzrosła do 8 zł, mimo potwierdzonego zwrotu o 14:20.</td></tr>\n<tr><th scope="row">Dowody i powiązania</th><td>Zrzuty szczegółów o 14:20 i 14:25, zapis potwierdzenia zwrotu, identyfikator przejazdu P-1042, przypadek testowy TC-RETURN-04.</td></tr>\n<tr><th scope="row">Ważność i priorytet</th><td>Proponowana ważność: wysoka — ryzyko niesłusznych opłat. Zespół ustala pilny priorytet po analizie zakresu problemu.</td></tr>\n<tr><th scope="row">Autor, data i status</th><td>Tester zespołu mobilnego; data i godzina wykonania testu zapisane w zgłoszeniu; początkowo „Nowy”.</td></tr>\n</tbody></table></div>\n<h3>Co robi tester?</h3><ol class="goal-examples">\n<li><h3>Dokumentuje obserwacje</h3><p>Zapisuje potwierdzenie zwrotu i zmianę opłaty. Nie zakłada jeszcze, który element systemu spowodował problem.</p></li>\n<li><h3>Pomaga w analizie</h3><p>Przekazuje dane przejazdu i sprawdza, czy sytuacja powtarza się dla innych testowych rowerów i stacji. Ułatwia to ocenę wpływu problemu.</p></li>\n<li><h3>Sprawdza poprawkę</h3><p>Po otrzymaniu poprawionej wersji odtwarza scenariusz: po potwierdzonym zwrocie kwota nie powinna już rosnąć. Jeśli nadal rośnie, przekazuje dowody i ponownie otwiera zgłoszenie zgodnie z procesem zespołu.</p></li>\n<li><h3>Sprawdza powiązane działanie</h3><p>W ramach regresji sprawdza naliczanie podczas aktywnego przejazdu i poprawne rozliczenie kolejnego wypożyczenia. Wyniki zapisuje w powiązanych testach.</p></li>\n</ol><div class="failure"><p><b>Przykładowe zakończenie obsługi:</b> po poprawce kwota pozostaje równa 6 zł, a powiązane testy przechodzą. Tester zapisuje wersję i wyniki; zgłoszenie zostaje zamknięte zgodnie z zasadami zespołu.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Dobre zgłoszenie pozwala zrozumieć problem, odtworzyć go i podjąć decyzję o dalszym działaniu.</p></div>\n</div>\n', 'sections': 'sekcja 5.5'}, {'id': 8, 'number': '08', 'title': 'Weryfikacja a walidacja', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Dwie osobne definicje</h2></div>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="verification-title"><div class="definition-label">ZGODNOŚĆ Z WYMAGANIAMI</div><h3 id="verification-title">Weryfikacja</h3><p class="definition-text">Sprawdzanie, czy produkt pracy spełnia określone wymagania. Produktem może być np. dokumentacja, kod lub działająca aplikacja.</p><div class="definition-question"><strong>Pytanie pomocnicze</strong><p>„Czy zbudowaliśmy produkt zgodnie z wymaganiami?”</p></div><div class="definition-mini"><strong>Przykład — zamówienie pizzy</strong><p>Wymagania mówią, że klient może wybrać pizzę, podać adres i zapłacić. Tester sprawdza, czy te funkcje działają poprawnie.</p></div></section>\n<section class="definition-card validation" aria-labelledby="validation-title"><div class="definition-label">ZGODNOŚĆ Z POTRZEBAMI</div><h3 id="validation-title">Walidacja</h3><p class="definition-text">Sprawdzanie, czy rozwiązanie odpowiada potrzebom użytkowników i innych interesariuszy w środowisku, w którym będzie używane.</p><div class="definition-question"><strong>Pytanie pomocnicze</strong><p>„Czy zbudowaliśmy produkt, którego użytkownicy potrzebują?”</p></div><div class="definition-mini"><strong>Przykład — zamówienie pizzy</strong><p>Firma chce jednym zamówieniem kupić pizze dla pracowników pod różnymi adresami. Podczas próby okazuje się, że aplikacja tego nie umożliwia — mimo spełnienia zapisanych wymagań.</p></div></section>\n</div>\n<div class="simple"><strong>Prostymi słowami</strong>Weryfikacja → wymagania. Walidacja → rzeczywiste potrzeby użytkowników.</div>\n<p class="note" style="margin-top:16px">To rozróżnienie celów sprawdzania, a nie podział na pracę z dokumentacją i uruchamianie programu. Oba spojrzenia są potrzebne.</p>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Zgodność z wymaganiami nie wystarcza</h3><p>Wymagania mogą pomijać ważną potrzebę. Poprawnie wykonana specyfikacja nie gwarantuje użytecznego rozwiązania.</p></div>\n<div class="memory"><h3>Walidacja wymaga właściwego kontekstu</h3><p>Ustal, kto będzie korzystał z produktu, w jakim celu i w jakich warunkach. Potrzeby klienta indywidualnego mogą różnić się od potrzeb firmy.</p></div>\n<div class="memory"><h3>Zaangażuj docelowych użytkowników</h3><p>Obserwuj wykonywanie rzeczywistych zadań i zbieraj informacje zwrotne. Ocena zespołu może nie ujawnić wszystkich trudności użytkowników.</p></div>\n<div class="memory"><h3>Defekt może występować także w wymaganiach</h3><p>Pominięcie istotnej potrzeby może być defektem specyfikacji wymagań. Kod może przy tym poprawnie realizować istniejące zapisy. Ustal, czy problem dotyczy wymagań, implementacji, czy obu tych produktów pracy.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — pizza dla pracowników zdalnych</h2></div>\n<div class="example"><h3>Aplikacja działa zgodnie ze specyfikacją, lecz nie spełnia ważnej potrzeby</h3><p>Restauracja zamówiła aplikację przeznaczoną dla firm organizujących wspólne posiłki pracowników zdalnych. W specyfikacji zapisano, że klient może wybrać pizzę, podać adres, zapłacić i otrzymać potwierdzenie. Nie opisano jednego zamówienia z dostawą pod wiele adresów.</p>\n<ol class="goal-examples">\n<li><h3>Weryfikacja — tester porównuje działanie z wymaganiami</h3><p>Tester sprawdza wybór pizzy i rozmiaru, obliczanie ceny, zapis adresu, płatność oraz potwierdzenie. Wszystkie te funkcje działają zgodnie ze specyfikacją. W zakresie wykonanych sprawdzeń wymagania zostały spełnione.</p></li>\n<li><h3>Walidacja — użytkownicy próbują wykonać swoje zadanie</h3><p>Podczas próby z przedstawicielami firm jedna osoba chce kupić dwie pizze dla pracowników mieszkających pod różnymi adresami i opłacić je razem. Okazuje się, że aplikacja pozwala podać tylko jeden adres na zamówienie. Trzeba składać osobne zamówienia i płacić oddzielnie.</p></li>\n<li><h3>Co robi tester z tą informacją?</h3><p>Obserwuje próbę zamówienia, zapisuje cel użytkownika, ograniczenie aplikacji i konieczne obejście. Przekazuje zespołowi informację, że docelowym klientom potrzebne jest zbiorcze zamówienie z wieloma adresami i jedną płatnością. Zespół potwierdza potrzebę i ustala zmianę wymagań.</p></li>\n</ol>\n<div class="failure"><p><b>Wniosek:</b> aplikacja spełnia zapisane wymagania, ale w tym przykładzie nie odpowiada istotnej potrzebie docelowych użytkowników. Weryfikacja nie zastępuje walidacji.</p></div></div>\n</section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Weryfikacja: zgodność z wymaganiami. Walidacja: zgodność z rzeczywistymi potrzebami użytkowników.</p></div>\n</div>\n', 'sections': 'sekcja 1.1'}, {'id': 9, 'number': '09', 'title': 'Testowanie funkcjonalne a niefunkcjonalne', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Dwie osobne definicje</h2></div>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="functional-title"><div class="definition-label">CO SYSTEM ROBI?</div><h3 id="functional-title">Testowanie funkcjonalne</h3><p class="definition-text">Ocenia funkcje, które komponent lub system powinien wykonywać. Sprawdza ich kompletność, poprawność i przydatność do realizacji określonych zadań.</p><div class="definition-question"><strong>Pytanie pomocnicze</strong><p>„Czy system wykonuje wymagane funkcje poprawnie?”</p></div><div class="definition-mini"><strong>Przykład — sklep internetowy</strong><p>Tester dodaje plecak do koszyka i sprawdza, czy sklep oblicza właściwą kwotę, zapisuje zamówienie i nadaje mu odpowiedni status po płatności.</p></div></section>\n<section class="definition-card validation" aria-labelledby="nonfunctional-title"><div class="definition-label">JAK DOBRZE SYSTEM DZIAŁA?</div><h3 id="nonfunctional-title">Testowanie niefunkcjonalne</h3><p class="definition-text">Ocenia cechy jakości inne niż funkcjonalne, np. wydajność, użyteczność, niezawodność, kompatybilność i zabezpieczenia. Sprawdza jakość działania w określonych warunkach.</p><div class="definition-question"><strong>Pytanie pomocnicze</strong><p>„Jak dobrze system wykonuje swoje zadania?”</p></div><div class="definition-mini"><strong>Przykład — sklep internetowy</strong><p>Tester mierzy czas tworzenia zamówienia przy ustalonym obciążeniu albo ocenia, czy użytkownik potrafi wygodnie obsłużyć formularz.</p></div></section>\n</div>\n<div class="simple"><strong>Prostymi słowami</strong>Funkcjonalne → poprawność i kompletność funkcji. Niefunkcjonalne → cechy jakości jej działania.</div>\n<p class="note" style="margin-top:16px">Ten sam scenariusz zakupu może posłużyć do obu rodzajów sprawdzeń. Różni się cel i oceniany wynik.</p>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Działająca funkcja może mieć problemy jakościowe</h3><p>Zamówienie może zapisać się poprawnie, ale dopiero po tak długim oczekiwaniu, że klient porzuci zakup.</p></div>\n<div class="memory"><h3>Niefunkcjonalne nie oznacza mniej ważne</h3><p>Sprawność, wygoda obsługi i ochrona danych mogą decydować o możliwości korzystania z produktu.</p></div>\n<div class="memory"><h3>Ustal konkretne kryteria</h3><p>„Sklep ma działać szybko” jest nieprecyzyjne. Określ, co mierzysz, pod jakim obciążeniem i jaki wynik jest akceptowalny.</p></div>\n<div class="memory"><h3>Rodzaj testu zależy od celu</h3><p>Samo sprawdzanie logowania nie oznacza automatycznie testowania zabezpieczeń. Sprawdzenie wymaganej funkcji logowania i ocena odporności na atak to różne cele.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — zakup plecaka przez internet</h2></div>\n<div class="example"><h3>Zamówienie ma być poprawne i wygodne do złożenia</h3><p>Kupujesz plecak za <strong>150 zł</strong>. Dostawa kosztuje <strong>15 zł</strong>, nie korzystasz z rabatów, więc do zapłaty jest <strong>165 zł</strong>. Sklep przygotowuje się na promocję i większy ruch.</p>\n<ol class="goal-examples">\n<li><h3>Testowanie funkcjonalne — co sprawdza tester?</h3><p>W środowisku testowym dodaje plecak do koszyka, podaje dane i wykonuje testową płatność. Sprawdza kwotę 165 zł, zapis produktu i adresu oraz potwierdzenie zamówienia. Osobno sprawdza odrzuconą płatność: zamówienie nie powinno zostać oznaczone jako opłacone.</p></li>\n<li><h3>Testowanie niefunkcjonalne — wydajność</h3><p>Przykładowe wymaganie projektu: przy 500 równoczesnych użytkownikach realizujących uzgodniony scenariusz zakupu co najmniej 95% odpowiedzi serwera na żądanie utworzenia zamówienia ma trwać najwyżej 2 sekundy. Tester przygotowuje dane, środowisko i profil obciążenia, wykonuje pomiar i porównuje wyniki z kryterium. Próg 2 sekund jest założeniem tego przykładu, a nie uniwersalną normą.</p></li>\n<li><h3>Testowanie niefunkcjonalne — użyteczność</h3><p>Tester organizuje próbę z reprezentatywnymi użytkownikami. Obserwuje, czy rozumieją pola formularza, potrafią poprawić błędny adres i widzą całkowity koszt przed zapłatą. Zapisuje napotkane trudności i odnosi je do uzgodnionych kryteriów.</p></li>\n</ol>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Ta sama funkcja — różne wyniki sprawdzeń</caption><thead><tr><th scope="col">Obserwacja</th><th scope="col">Co oceniamy?</th></tr></thead><tbody>\n<tr><td>Sklep pobiera 180 zł zamiast wymaganych 165 zł.</td><td>Poprawność funkcjonalną obliczenia kwoty.</td></tr>\n<tr><td>Zamówienia są poprawne, lecz 95. percentyl czasu odpowiedzi wynosi 8 sekund przy ustalonym obciążeniu.</td><td>Wydajność — wynik nie spełnia przykładowego limitu 2 sekund.</td></tr>\n<tr><td>Użytkownicy nie wiedzą, jak poprawić błędny adres, ponieważ komunikat jest niezrozumiały.</td><td>Użyteczność formularza i informacji zwrotnej.</td></tr>\n</tbody></table></div>\n<div class="failure"><p><b>Wniosek:</b> poprawna kwota i zapis zamówienia nie wystarczą, jeśli zakupy są zbyt powolne lub trudne. Tester dostarcza informacji zarówno o funkcjach, jak i jakości ich działania.</p></div></div>\n</section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Funkcjonalne: co system robi? Niefunkcjonalne: jak dobrze działa w określonych warunkach?</p></div>\n</div>\n', 'sections': 'sekcja 2.2.2'}, {'id': 10, 'number': '10', 'title': 'Testowanie statyczne a dynamiczne', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Dwie osobne definicje</h2></div>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="static-title"><div class="definition-label">BEZ URUCHAMIANIA OPROGRAMOWANIA</div><h3 id="static-title">Testowanie statyczne</h3><p class="definition-text">Sprawdzanie produktów pracy bez uruchamiania testowanego oprogramowania, np. poprzez przegląd wymagań lub analizę kodu.</p><div class="definition-question"><strong>Pytanie pomocnicze</strong><p>„Jakie defekty możemy znaleźć bez uruchamiania programu?”</p></div><div class="definition-mini"><strong>Przykład — przelew bankowy</strong><p>Tester czyta wymagania i zauważa sprzeczne zasady dotyczące przelewu całego dostępnego salda. Nie musi wykonywać przelewu, żeby wykryć tę niejasność.</p></div></section>\n<section class="definition-card validation" aria-labelledby="dynamic-title"><div class="definition-label">Z URUCHOMIENIEM OPROGRAMOWANIA</div><h3 id="dynamic-title">Testowanie dynamiczne</h3><p class="definition-text">Sprawdzanie zachowania uruchomionego oprogramowania. Rzeczywiste wyniki porównuje się z oczekiwanymi, aby ocenić działanie i ujawnić niezgodności.</p><div class="definition-question"><strong>Pytanie pomocnicze</strong><p>„Czy uruchomiony program zachowuje się zgodnie z oczekiwaniami?”</p></div><div class="definition-mini"><strong>Przykład — przelew bankowy</strong><p>Tester wykonuje przelew w środowisku testowym i sprawdza jego wynik, zmianę salda oraz zapis operacji.</p></div></section>\n</div>\n<div class="simple"><strong>Prostymi słowami</strong>Statyczne → sprawdzasz bez uruchamiania testowanego programu. Dynamiczne → uruchamiasz program i sprawdzasz jego zachowanie.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Testowanie można rozpocząć wcześnie</h3><p>Przegląd wymagań może ujawnić sprzeczność, zanim powstanie działająca aplikacja.</p></div>\n<div class="memory"><h3>Statyczne nie oznacza tylko dokumentacji</h3><p>Można przeglądać również kod. Analiza statyczna może korzystać z narzędzi; nie uruchamia się przy tym testowanego oprogramowania.</p></div>\n<div class="memory"><h3>Dynamiczne nie oznacza tylko ręcznego klikania</h3><p>Test może być wykonywany ręcznie albo automatycznie. W obu przypadkach sprawdza zachowanie uruchomionego oprogramowania.</p></div>\n<div class="memory"><h3>Oba podejścia uzupełniają się</h3><p>Przegląd pomaga bezpośrednio wykryć defekt produktu pracy. Test dynamiczny może ujawnić awarię, której przyczynę trzeba następnie ustalić.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — przelew całego salda</h2></div>\n<div class="example"><h3>Czy mając 500 zł, możesz przelać całe 500 zł?</h3><p>W przykładowej aplikacji bankowej klient ma <strong>500 zł dostępnego salda</strong>. Zakładamy brak prowizji, blokad i dodatkowych limitów. Testy wykonujemy na fikcyjnych środkach w środowisku testowym.</p>\n<ol class="goal-examples">\n<li><h3>Testowanie statyczne — tester sprawdza dokumentację</h3><p>Jeden zapis mówi: „Klient może przelać kwotę nieprzekraczającą dostępnego salda”. Drugi: „Kwota przelewu musi być mniejsza od dostępnego salda”. Pierwszy dopuszcza przelew 500 zł, drugi go wyklucza. Tester wskazuje sprzeczność i prosi o wyjaśnienie bez uruchamiania aplikacji.</p></li>\n<li><h3>Zespół wyjaśnia wymaganie</h3><p>Ustala, że klient może przelać całe dostępne saldo. Wymaganie zostaje ujednolicone. Tester ma teraz jednoznaczną podstawę do określenia oczekiwanych wyników.</p></li>\n<li><h3>Testowanie dynamiczne — tester wykonuje przelewy</h3><p>W działającej aplikacji wykonuje osobne próby przelewu 499, 500 i 501 zł. Każdy przypadek zaczyna od dostępnego salda 500 zł — nie wykonuje tych przelewów kolejno na malejącym saldzie.</p></li>\n</ol>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Oddzielne przypadki testowe — za każdym razem saldo początkowe 500 zł</caption><thead><tr><th scope="col">Kwota przelewu</th><th scope="col">Oczekiwany wynik</th><th scope="col">Saldo po próbie</th></tr></thead><tbody>\n<tr><th scope="row">499 zł</th><td>Przelew przyjęty i wykonany.</td><td>1 zł</td></tr>\n<tr><th scope="row">500 zł</th><td>Przelew przyjęty i wykonany.</td><td>0 zł</td></tr>\n<tr><th scope="row">501 zł</th><td>Przelew odrzucony z informacją o niewystarczających środkach.</td><td>500 zł — bez zmian</td></tr>\n</tbody></table></div>\n<p>Zakładamy natychmiastowe wykonanie zaakceptowanego przelewu. Tester sprawdza również poprawną kwotę u odbiorcy i zapis operacji; odrzucona próba nie może zostać zapisana jako wykonany przelew.</p>\n<div class="failure"><p><b>Przykładowy problem:</b> aplikacja odrzuca przelew 500 zł pomimo dostępnego salda 500 zł. Tester zgłasza niezgodność z uzgodnionym wymaganiem, zapisując dane początkowe, kroki, wynik oczekiwany i rzeczywisty.</p></div></div>\n</section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Statycznie wykrywasz sprzeczność w wymaganiach. Dynamicznie sprawdzasz przelewy w uruchomionej aplikacji.</p></div>\n</div>\n', 'sections': 'sekcje 1.1 i 3.1'}, {'id': 11, 'number': '11', 'title': 'Produkty pracy badane metodą testowania statycznego', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">CO? — produkty pracy, które możemy ocenić</h2></div>\n<p class="lead"><strong>Produkt pracy</strong> to rezultat działań w projekcie, np. wymagania, model, kod, plan lub przypadek testowy. W testowaniu statycznym oceniamy taki materiał bez wykonywania testowanego programu.</p><div class="simple"><strong>Ten temat odpowiada na pytanie: CO?</strong>Jaki materiał bierzemy do sprawdzenia i czy nadaje się do przeglądu lub analizy statycznej?</div><p class="note" style="margin-top:16px">Efekty i korzyści tych działań opisuje <a href="/temat/12">temat 12 — po co testować statycznie</a>.</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Materiały do sprawdzenia — każdy wiersz to inny produkt pracy</caption><thead><tr><th scope="col">Produkt pracy</th><th scope="col">Co możemy ocenić?</th></tr></thead><tbody>\n<tr><th scope="row">Specyfikacje wymagań</th><td>Jednoznaczność, kompletność i zgodność reguł.</td></tr>\n<tr><th scope="row">Kod źródłowy</th><td>Logikę, strukturę, czytelność oraz zgodność z ustalonymi zasadami.</td></tr>\n<tr><th scope="row">Plany testów</th><td>Zakres, założenia, zasoby i spójność planowanych działań.</td></tr>\n<tr><th scope="row">Przypadki testowe</th><td>Warunki, dane, kroki, oczekiwane wyniki i pokrycie wymagań.</td></tr>\n<tr><th scope="row">Pozycje backlogu produktu</th><td>Zrozumiałość potrzeb oraz sprawdzalność kryteriów akceptacji.</td></tr>\n<tr><th scope="row">Karty opisu testów eksploracyjnych</th><td>Cel, zakres i wskazówki prowadzące testera podczas sesji.</td></tr>\n<tr><th scope="row">Dokumentacja projektu</th><td>Spójność opisów rozwiązania i zgodność z aktualnymi ustaleniami.</td></tr>\n<tr><th scope="row">Umowy</th><td>Jasność zobowiązań i spójność z wymaganiami; z udziałem właściwych specjalistów.</td></tr>\n<tr><th scope="row">Modele</th><td>Spójność stanów, przejść, danych i zależności.</td></tr>\n</tbody></table></div>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="reviewable-title"><div class="definition-label">MATERIAŁ MOŻNA PRZECZYTAĆ I ZROZUMIEĆ</div><h3 id="reviewable-title">Przegląd</h3><p class="definition-text">Przedmiotem przeglądu może być dowolny produkt pracy, który człowiek potrafi przeczytać i zrozumieć. Uczestnicy oceniają jego treść i zapisują uwagi.</p><div class="definition-mini"><strong>Przykład</strong><p>Tester porównuje regułę uprawnień z opisem przypadku testowego i zauważa sprzeczne oczekiwania.</p></div></section>\n<section class="definition-card validation" aria-labelledby="analyzable-title"><div class="definition-label">POTRZEBNA STRUKTURA DO SPRAWDZENIA</div><h3 id="analyzable-title">Analiza statyczna</h3><p class="definition-text">Wymaga struktury, względem której można sprawdzić materiał, np. kodu, modelu lub tekstu z formalną składnią. Zwykle wspierają ją narzędzia.</p><div class="definition-mini"><strong>Przykład</strong><p>Narzędzie analizuje strukturę kodu i wskazuje instrukcję, do której wykonanie nie może dotrzeć.</p></div></section>\n</div>\n<p class="note">Ograniczenia dotyczą m.in. materiałów trudnych do interpretacji przez człowieka oraz takich, których nie wolno analizować narzędziami, np. określonego kodu wykonywalnego firmy trzeciej ze względów prawnych. Nie każdy materiał nadaje się do każdej metody.</p>\n<div class="simple"><strong>Prostymi słowami</strong>Wybierasz konkretny materiał: dokument, model, kod lub opis testu. Następnie dobierasz sposób jego oceny.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Testy również podlegają sprawdzeniu</h3><p>Błędny oczekiwany wynik w przypadku testowym może prowadzić do niewłaściwej oceny aplikacji.</p></div>\n<div class="memory"><h3>Kod można ocenić bez uruchomienia</h3><p>Przegląd kodu i jego analiza statyczna nie wymagają wykonania analizowanego programu.</p></div>\n<div class="memory"><h3>Narzędzie nie rozstrzyga każdej niejasności</h3><p>Sprzeczne uprawnienia w opisach trzeba omówić z właściwymi osobami. Sama formalna poprawność dokumentu nie potwierdza sensu reguły.</p></div>\n<div class="memory"><h3>Dobierz sposób oceny do materiału</h3><p>Ustal, co oceniasz, kto rozumie daną treść i jakie reguły można sprawdzić narzędziem.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — firmowa aplikacja do dokumentów</h2></div>\n<div class="example"><h3>Czy osoba z dostępem „Odczyt” może usunąć dokument?</h3><p>Zespół projektuje udostępnianie dokumentów. Uzgodniona reguła mówi: <strong>osoba z uprawnieniem „Odczyt” może czytać dokument, ale nie może go usunąć</strong>. Tester ocenia materiały przed wykonaniem testów dynamicznych.</p>\n<h3>Co robi tester?</h3><ol class="goal-examples">\n<li><h3>Przegląda wymagania i model uprawnień</h3><p>W specyfikacji znajduje zakaz usuwania dla roli „Odczyt”, ale tabela uprawnień dopuszcza tę operację. Zapisuje sprzeczność z odnośnikami do obu miejsc.</p></li>\n<li><h3>Przegląda przypadek testowy</h3><p>W przypadku dla tej roli zapisano oczekiwane „Dokument usunięty”. Tester wskazuje niezgodność z uzgodnioną regułą i potrzebę zmiany oczekiwania na odmowę oraz zachowanie dokumentu.</p></li>\n<li><h3>Sprawdza kartę testów eksploracyjnych</h3><p>Karta mówi tylko „sprawdź dokumenty”. Tester proponuje konkretny cel sesji: ocena możliwości wykonania operacji przez role „Odczyt” i „Edycja”, na fikcyjnych dokumentach.</p></li>\n<li><h3>Uzgadnia poprawki</h3><p>Autorzy ujednolicają wymagania, model i testy. Tester sprawdza poprawione materiały zgodnie z przydzielonym zadaniem. Nie musi usuwać dokumentu w aplikacji, aby wykryć te niezgodności.</p></li>\n</ol>\n<div class="failure"><p><b>Wniosek:</b> przedmiotem testowania były wymagania, model i materiały testowe. Wszystkie mogły zawierać defekty, mimo że nie są działającą aplikacją.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Przedmiotem testowania statycznego mogą być wymagania, modele, kod i testy — nie tylko działająca aplikacja.</p></div>\n</div>\n', 'sections': 'sekcja 3.1.1'}, {'id': 12, 'number': '12', 'title': 'Korzyści wynikające z testowania statycznego', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">PO CO? — korzyści dla projektu i użytkownika</h2></div>\n<p class="lead"><strong>Korzyści testowania statycznego</strong> to efekty oceny materiałów bez wykonywania testowanego programu: wcześniejsza informacja o problemach, lepsze zrozumienie oczekiwań i ograniczenie późniejszych poprawek.</p>\n<div class="simple"><strong>Ten temat odpowiada na pytanie: PO CO?</strong>Co zyskujemy, gdy ktoś sprawdzi wymagania, projekt, kod lub testy? Każdą korzyść łączymy z konkretnym efektem.</div>\n<p class="note" style="margin-top:16px">Listę materiałów i sposób ich oceny znajdziesz w <a href="/temat/11">temacie 11 — co można badać statycznie</a>.</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Korzyść → konkretny efekt</caption><thead><tr><th scope="col">Korzyść</th><th scope="col">Co zyskujemy?</th></tr></thead><tbody>\n<tr><th scope="row">Wczesne wykrycie defektu</th><td>Możemy poprawić błędną regułę, zanim powstaną oparty na niej kod, testy i instrukcje.</td></tr>\n<tr><th scope="row">Wykrycie problemów niedostępnych testom dynamicznym</th><td>Oceniamy niewykonywalne dokumenty, nieosiągalny kod i sposób realizacji wzorców projektowych.</td></tr>\n<tr><th scope="row">Ocena jakości i budowanie zaufania</th><td>Uzyskujemy informacje o poprawności, spójności i kompletności ocenianych materiałów.</td></tr>\n<tr><th scope="row">Uzgodnienie potrzeb i wspólnego rozumienia</th><td>Interesariusze wyjaśniają, czy zapisane reguły odpowiadają ich potrzebom i tak samo rozumieją oczekiwane działanie.</td></tr>\n<tr><th scope="row">Mniejszy nakład późniejszych poprawek</th><td>Przegląd kosztuje czas, ale może zapobiec większej liczbie przeróbek w dalszych etapach.</td></tr>\n<tr><th scope="row">Efektywne wykrywanie części defektów kodu</th><td>Odpowiednia analiza statyczna może wskazać pewne problemy bez przygotowania i wykonania testów dynamicznych.</td></tr>\n</tbody></table></div>\n<h3>Dlaczego nie wszystko wykryjemy przez uruchomienie?</h3><p>Dokument wymagań nie jest wykonywanym programem. Instrukcji znajdującej się po bezwarunkowym <code>return</code> nie da się wykonać w tej ścieżce — jej nieosiągalność można wskazać, oceniając strukturę kodu. Test dynamiczny może ujawnić skutek brakującego działania, ale nie wykona nieosiągalnej instrukcji.</p>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Korzyść to efekt, a nie nazwa dokumentu</h3><p>„Wymagania” to produkt pracy. „Wykrycie sprzeczności przed implementacją” to wynik sprawdzenia, który może ograniczyć późniejsze poprawki.</p></div>\n<div class="memory"><h3>Wykrycie nie oznacza usunięcia</h3><p>Po znalezieniu problemu ktoś musi wyjaśnić regułę, poprawić materiał i sprawdzić zmianę.</p></div>\n<div class="memory"><h3>Przegląd też wymaga czasu</h3><p>Nie zakładamy stałej oszczędności ani gwarancji sukcesu. Dobieramy zakres do znaczenia materiału i ryzyka.</p></div>\n<div class="memory"><h3>Lepsza dokumentacja nie dowodzi działania kodu</h3><p>Po wdrożeniu funkcji nadal sprawdzamy jej rzeczywiste zachowanie. Statyczne i dynamiczne podejście się uzupełniają.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — budzik uruchamiający się także w sobotę</h2></div>\n<div class="example"><h3>Wymagania można poprawić, zanim budzik zacznie źle działać</h3><p>Zespół tworzy aplikację budzika. Użytkownik chce ustawić alarm na <strong>7:00 od poniedziałku do piątku</strong>, bez soboty i niedzieli. W tym przykładzie nie uwzględniamy kalendarza świąt ani zmian czasu.</p><p>Opis funkcji podaje poniedziałek–piątek, ale tabela przykładowego harmonogramu zawiera również sobotę. Przypadek testowy, napisany na podstawie tej tabeli, oczekuje alarmu w sobotę.</p>\n<h3>Co robi tester i co dzięki temu zyskuje zespół?</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Działanie → wynik sprawdzenia → korzyść</caption><thead><tr><th scope="col">Działanie testera</th><th scope="col">Wynik i korzyść</th></tr></thead><tbody>\n<tr><th scope="row">Porównuje opis funkcji z harmonogramem przed implementacją.</th><td>Znajduje sprzeczność dotyczącą soboty. Zespół może ją rozstrzygnąć przed napisaniem obsługi alarmu.</td></tr>\n<tr><th scope="row">Omawia sprzeczność z przedstawicielem użytkowników i programistą.</th><td>Uzgadniają alarm tylko od poniedziałku do piątku. Wszyscy korzystają z tej samej interpretacji.</td></tr>\n<tr><th scope="row">Wskazuje błędne oczekiwanie w przypadku testowym.</th><td>Test zostaje poprawiony: w sobotę alarm nie powinien się uruchomić. Tester nie uzna błędnego sobotniego alarmu za sukces.</td></tr>\n<tr><th scope="row">Sprawdza poprawione materiały i zapisuje ustalenia.</th><td>Programista i tester otrzymują spójną podstawę pracy. Maleje ryzyko późniejszego poprawiania kodu, testów i instrukcji z tej samej przyczyny.</td></tr>\n</tbody></table></div>\n<div class="failure"><p><b>Najważniejsza korzyść w tym przykładzie:</b> nie trzeba czekać na niechcianą pobudkę użytkownika. Sprzeczność wykryto w materiałach. Po implementacji tester nadal sprawdzi alarm w poniedziałek oraz jego brak w sobotę i niedzielę.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Testowanie statyczne daje wcześniejszą informację o jakości i pomaga ograniczyć późniejsze nieporozumienia oraz poprawki.</p></div>\n</div>\n', 'sections': 'sekcja 3.1.2'}, {'id': 13, 'number': '13', 'title': 'Testowanie potwierdzające a testowanie regresji', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Dwie osobne definicje</h2></div>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="confirmation-title"><div class="definition-label">CZY NAPRAWIONO ZGŁOSZONY PROBLEM?</div><h3 id="confirmation-title">Testowanie potwierdzające</h3><p class="definition-text">Sprawdza, czy konkretny, wcześniej wykryty defekt został skutecznie usunięty. Może obejmować ponowne wykonanie testów, które wcześniej nie przeszły, oraz dodatkowe testy związane z poprawką.</p><div class="definition-question"><strong>Pytanie pomocnicze</strong><p>„Czy naprawiono zgłoszony problem?”</p></div><div class="definition-mini"><strong>Przykład — nazwa pliku</strong><p>Tester ponownie zmienia nazwę pliku i odświeża stronę. Sprawdza, czy nowa nazwa została zachowana.</p></div></section>\n<section class="definition-card validation" aria-labelledby="regression-title"><div class="definition-label">CZY ZMIANA NIE WYWOŁAŁA INNYCH PROBLEMÓW?</div><h3 id="regression-title">Testowanie regresji</h3><p class="definition-text">Sprawdza, czy zmiana nie spowodowała niepożądanych skutków w zmienionym obszarze, innych częściach systemu lub systemach powiązanych. Zakres dobiera się na podstawie wpływu zmiany i ryzyka.</p><div class="definition-question"><strong>Pytanie pomocnicze</strong><p>„Czy po zmianie pozostałe zachowania nadal są prawidłowe?”</p></div><div class="definition-mini"><strong>Przykład — operacje na pliku</strong><p>Tester sprawdza powiązane operacje, np. wyszukiwanie pliku po nowej nazwie, otwieranie, pobieranie i przenoszenie do folderu.</p></div></section>\n</div>\n<div class="simple"><strong>Prostymi słowami</strong>Potwierdzające → sprawdzasz naprawę konkretnego problemu. Regresja → sprawdzasz możliwe skutki zmiany.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Różni je cel sprawdzenia</h3><p>Potwierdzające dotyczy usunięcia zgłoszonego defektu. Regresja dotyczy niepożądanych skutków zmiany.</p></div>\n<div class="memory"><h3>Dobierz zakres do wpływu zmiany</h3><p>Nie trzeba automatycznie sprawdzać całej aplikacji. Ustal, które elementy mogły zostać dotknięte zmianą i jakie wiąże się z tym ryzyko.</p></div>\n<div class="memory"><h3>Oba rodzaje mogą być ręczne lub automatyczne</h3><p>Powtarzane zestawy regresyjne często warto automatyzować. Sposób wykonania nie decyduje o rodzaju testowania.</p></div>\n<div class="memory"><h3>Regresja towarzyszy także nowym funkcjom</h3><p>Nie ogranicza się do poprawek defektów. Dodanie lub zmodyfikowanie funkcji również może wpłynąć na istniejące zachowania.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — zmiana nazwy pliku</h2></div>\n<div class="example"><h3>Nowa nazwa znika po odświeżeniu strony</h3><p>W aplikacji do przechowywania dokumentów zmieniasz nazwę pliku z <strong>„Notatka” na „Plan nauki”</strong>. Na ekranie widać nową nazwę, ale po odświeżeniu wraca stara. Wymaganie mówi, że zatwierdzona nazwa ma być zapisana i widoczna przy kolejnych otwarciach aplikacji.</p>\n<ol class="goal-examples">\n<li><h3>Tester zgłasza defekt, programista przygotowuje poprawkę</h3><p>Tester zapisuje kroki, dane testowego pliku i wyniki: oczekiwane „Plan nauki”, rzeczywiste „Notatka” po odświeżeniu. Programista analizuje przyczynę i poprawia zapisywanie nazwy.</p></li>\n<li><h3>Testowanie potwierdzające — sprawdzenie zgłoszonego problemu</h3><p>Na poprawionej wersji tester ponownie zmienia nazwę z „Notatka” na „Plan nauki”, zatwierdza i odświeża stronę. Sprawdza, czy plik nadal nazywa się „Plan nauki”. Wynik potwierdza naprawę w sprawdzonym przypadku.</p></li>\n<li><h3>Testowanie regresji — sprawdzenie powiązanych operacji</h3><p>Po analizie wpływu poprawki tester wybiera operacje, które mogą korzystać z nazwy lub danych pliku. Sprawdza wyszukiwanie, otwieranie, pobieranie i przenoszenie. Zakres wynika z tego, co mogło zostać zmienione.</p></li>\n</ol>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Co tester sprawdza po zmianie nazwy?</caption><thead><tr><th scope="col">Rodzaj</th><th scope="col">Sprawdzenie</th><th scope="col">Oczekiwany wynik</th></tr></thead><tbody>\n<tr><th scope="row">Potwierdzające</th><td>Odświeżenie po zapisaniu nowej nazwy.</td><td>Nazwa „Plan nauki” pozostaje zapisana.</td></tr>\n<tr><th scope="row">Regresja</th><td>Wyszukiwanie po nowej nazwie.</td><td>Wyniki zawierają właściwy plik.</td></tr>\n<tr><th scope="row">Regresja</th><td>Otwarcie i pobranie pliku.</td><td>Otwiera się i pobiera ten sam dokument, z niezmienioną zawartością; nazwa pobrania jest zgodna z wymaganiem.</td></tr>\n<tr><th scope="row">Regresja</th><td>Przeniesienie do innego folderu.</td><td>Plik trafia do wybranego folderu i zachowuje nową nazwę oraz zawartość.</td></tr>\n</tbody></table></div>\n<div class="failure"><p><b>Wniosek:</b> zapisanie nazwy po odświeżeniu potwierdza naprawę zgłoszonego problemu. Sprawdzenie pozostałych operacji pomaga wykryć ewentualne skutki poprawki.</p></div></div>\n</section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Potwierdź naprawę problemu i sprawdź możliwe skutki zmiany.</p></div>\n</div>\n', 'sections': 'sekcja 2.2.3'}, {'id': 14, 'number': '14', 'title': 'Testowanie czarnoskrzynkowe a białoskrzynkowe', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Dwie osobne definicje</h2></div>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="blackbox-title"><div class="definition-label">PODSTAWA: WYMAGANIA I SPECYFIKACJA</div><h3 id="blackbox-title">Testowanie czarnoskrzynkowe</h3><p class="definition-text">Testy wynikają z wymagań i oczekiwanego zachowania systemu, bez odwoływania się do jego wewnętrznej struktury.</p><div class="definition-question"><strong>Pytanie pomocnicze</strong><p>„Czy system zachowuje się zgodnie ze specyfikacją?”</p></div><div class="definition-mini"><strong>Przykład — wejście do siłowni</strong><p>Tester na podstawie zasad wejścia wybiera karty z różnym statusem karnetu i liczbą wejść. Sprawdza, czy bramka otwiera się zgodnie z wymaganiami.</p></div></section>\n<section class="definition-card validation" aria-labelledby="whitebox-title"><div class="definition-label">PODSTAWA: STRUKTURA ROZWIĄZANIA</div><h3 id="whitebox-title">Testowanie białoskrzynkowe</h3><p class="definition-text">Testy wynikają z wewnętrznej struktury lub implementacji, np. kodu. Sprawdzamy pokrycie wybranych elementów tej struktury.</p><div class="definition-question"><strong>Pytanie pomocnicze</strong><p>„Które elementy kodu lub struktury sprawdziliśmy?”</p></div><div class="definition-mini"><strong>Przykład — wejście do siłowni</strong><p>Tester analizuje warunki w kodzie i dobiera dane pozwalające wykonać poszczególne ścieżki odmowy oraz otwarcia bramki.</p></div></section>\n</div>\n<div class="simple"><strong>Prostymi słowami</strong>Czarna skrzynka → projektujesz testy według specyfikacji. Biała skrzynka → projektujesz testy według struktury rozwiązania.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Różni je podstawa projektowania testów</h3><p>W czarnej skrzynce korzystasz z wymagań i specyfikacji, a w białej — z wewnętrznej struktury rozwiązania.</p></div>\n<div class="memory"><h3>Te same dane mogą służyć obu podejściom</h3><p>Przypadek „aktywny karnet, 3 wejścia” może wynikać zarówno z wymagania, jak i z potrzeby wykonania określonej ścieżki kodu.</p></div>\n<div class="memory"><h3>Znajomość kodu nie przesądza o rodzaju testu</h3><p>Osoba znająca kod może nadal projektować test czarnoskrzynkowy, jeśli podstawą jest specyfikacja. Oba podejścia mogą wymagać uruchomienia programu.</p></div>\n<div class="memory"><h3>Pokrycie struktury nie gwarantuje poprawności</h3><p>Wykonanie wszystkich gałęzi nie dowodzi zgodności z wymaganiami ani braku defektów. Podejścia wzajemnie się uzupełniają.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — wejście do siłowni na kartę</h2></div>\n<div class="example"><h3>Bramka sprawdza karnet i dostępne wejścia</h3><p>Zgodnie z wymaganiami bramka otwiera się tylko wtedy, gdy klient ma <strong>aktywny karnet i co najmniej jedno pozostałe wejście</strong>. Po udanym wejściu licznik zmniejsza się o jeden. Przykład dotyczy karnetu z ograniczoną liczbą wejść, a testy wykonujemy na kartach testowych.</p>\n<h3>Czarna skrzynka — tester korzysta z zasad wejścia</h3><p>Tester nie potrzebuje kodu. Wybiera przypadki na podstawie wymagań i obserwuje wynik:</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Każdy przypadek ma osobno przygotowany stan karty</caption><thead><tr><th scope="col">Karnet</th><th scope="col">Pozostałe wejścia</th><th scope="col">Oczekiwany wynik</th></tr></thead><tbody>\n<tr><th scope="row">Aktywny</th><td>3</td><td>Bramka otwiera się, pozostają 2 wejścia.</td></tr>\n<tr><th scope="row">Aktywny</th><td>0</td><td>Bramka pozostaje zamknięta, licznik pozostaje równy 0.</td></tr>\n<tr><th scope="row">Wygasły</th><td>3</td><td>Bramka pozostaje zamknięta, licznik pozostaje równy 3.</td></tr>\n</tbody></table></div>\n<h3>Biała skrzynka — tester analizuje kod</h3><p>Uproszczona implementacja zawiera następujące warunki:</p>\n<pre class="code-example"><code>if not aktywny_karnet:\n    odmow_wejscia()\nelif pozostale_wejscia &lt;= 0:\n    odmow_wejscia()\nelse:\n    otworz_bramke()\n    odejmij_wejscie()</code></pre>\n<p>Tester dobiera dane, aby wykonać każdą z trzech ścieżek tego fragmentu:</p>\n<ol class="goal-examples">\n<li><h3>Wygasły karnet, 3 wejścia</h3><p>Pierwszy warunek jest prawdziwy. Wykonuje się pierwsza odmowa wejścia.</p></li>\n<li><h3>Aktywny karnet, 0 wejść</h3><p>Pierwszy warunek jest fałszywy, drugi prawdziwy. Wykonuje się druga odmowa wejścia.</p></li>\n<li><h3>Aktywny karnet, 3 wejścia</h3><p>Oba warunki są fałszywe. Wykonuje się otwarcie bramki i odjęcie wejścia.</p></li>\n</ol>\n<div class="failure"><p><b>Wniosek:</b> dane w obu zestawach mogą być takie same. W czarnej skrzynce tester wybrał je, aby sprawdzić zasady wejścia. W białej — aby wykonać wskazane elementy kodu. Te trzy przypadki nie oznaczają sprawdzenia wszystkich możliwych danych, np. aktywnego karnetu z dokładnie jednym wejściem.</p></div></div>\n</section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Czarna skrzynka sprawdza zachowanie według specyfikacji. Biała skrzynka sprawdza strukturę rozwiązania.</p></div>\n</div>\n', 'sections': 'sekcje 2.2.2 i 4.3'}, {'id': 15, 'number': '15', 'title': 'Klasy równoważności', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>Podział na klasy równoważności</strong> to technika czarnoskrzynkowa polegająca na dzieleniu danych na grupy, których elementy powinny być przetwarzane w taki sam sposób. Z każdej grupy wybiera się reprezentanta do testu.</p>\n<div class="definitioncopy"><p>Zakładamy, że wartości w jednej klasie mają podobne znaczenie dla sprawdzanej reguły. Zamiast testować każdą możliwą wartość, projektujemy test obejmujący przynajmniej jednego reprezentanta każdej zidentyfikowanej klasy.</p><p>Klasy mogą zawierać dane poprawne i niepoprawne. Dla analizowanego podziału nie powinny się nakładać ani być puste. Powinny obejmować cały rozpatrywany zakres danych. Pokrycie klas obliczamy jako liczbę sprawdzonych klas podzieloną przez liczbę wszystkich zidentyfikowanych klas, wyrażoną w procentach.</p></div>\n<div class="simple"><strong>Prostymi słowami</strong>Grupujesz dane według oczekiwanego sposobu obsługi i wybierasz przykład z każdej grupy.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Uwzględnij dane poprawne i niepoprawne</h3><p>Sprawdź zarówno przyjmowane wartości, jak i sposób odrzucania wartości niedozwolonych.</p></div>\n<div class="memory"><h3>Jedna wartość reprezentuje jedną klasę</h3><p>To założenie techniki, a nie gwarancja, że wszystkie pozostałe wartości działają poprawnie. Gdy wymagania przewidują różną obsługę, podział trzeba doprecyzować.</p></div>\n<div class="memory"><h3>Klasy i granice to różne techniki</h3><p>Tutaj wybierasz reprezentantów klas. Analiza wartości brzegowych skupia się na granicach klas i ich otoczeniu.</p></div>\n<div class="memory"><h3>Niepoprawne dane sprawdzaj w izolacji</h3><p>Nie łącz kilku niepoprawnych pól w jednym teście, jeśli jedno odrzucenie mogłoby zamaskować problem w drugim polu.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — liczba gości w pokoju</h2></div>\n<div class="example"><h3>Pokój można zarezerwować dla 1–4 osób</h3><p>Hotel pozwala zarezerwować pokój dla <strong>od 1 do 4 osób włącznie</strong>. W tym podziale analizujemy wyłącznie liczby całkowite. Pozostałe dane rezerwacji są poprawne i pokój jest dostępny.</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Trzy klasy dla liczby gości</caption><thead><tr><th scope="col">Klasa</th><th scope="col">Rodzaj</th><th scope="col">Reprezentant</th><th scope="col">Oczekiwany wynik</th></tr></thead><tbody>\n<tr><th scope="row">Mniej niż 1 osoba</th><td>Niepoprawna</td><td>0</td><td>Odrzucenie wartości z odpowiednią informacją; brak utworzonej rezerwacji.</td></tr>\n<tr><th scope="row">Od 1 do 4 osób</th><td>Poprawna</td><td>2</td><td>Zaakceptowanie liczby gości i możliwość kontynuowania rezerwacji.</td></tr>\n<tr><th scope="row">Więcej niż 4 osoby</th><td>Niepoprawna</td><td>6</td><td>Odrzucenie wartości z odpowiednią informacją; brak utworzonej rezerwacji.</td></tr>\n</tbody></table></div>\n<h3>Co robi tester?</h3><ol class="goal-examples">\n<li><h3>Wyznacza klasy z wymagania</h3><p>Rozdziela liczby całkowite na trzy grupy: poniżej minimum, w dozwolonym przedziale oraz powyżej maksimum. Każda liczba całkowita należy do dokładnie jednej z tych klas.</p></li>\n<li><h3>Wybiera reprezentantów i wykonuje testy</h3><p>W oddzielnych przypadkach podaje 0, 2 i 6 gości. Porównuje rzeczywiste reakcje z wynikami w tabeli. Odrzucenie wartości 0 nie zastępuje sprawdzenia wartości 6 — to dwie różne klasy.</p></li>\n<li><h3>Ocenia pokrycie i ograniczenia</h3><p>Po sprawdzeniu 0, 2 i 6 przetestował 3 z 3 zidentyfikowanych klas liczb całkowitych: pokrycie wynosi 100%. Nie oznacza to sprawdzenia wszystkich wartości ani całego formularza. Puste pole, tekst i liczby ułamkowe wymagają osobnego rozpatrzenia według wymagań.</p></li>\n</ol>\n<div class="failure"><p><b>Przykładowy problem:</b> formularz akceptuje 6 osób, mimo limitu 4. Tester zgłasza niezgodność, podając wymaganie, dane wejściowe, wynik oczekiwany i rzeczywisty.</p></div></div>\n</section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Grupuj dane według oczekiwanego sposobu obsługi i sprawdzaj reprezentantów każdej grupy.</p></div>\n</div>\n', 'sections': 'sekcja 4.2.1'}, {'id': 16, 'number': '16', 'title': 'Analiza wartości brzegowych', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>Analiza wartości brzegowych</strong> to technika czarnoskrzynkowa skupiająca się na granicach uporządkowanych klas równoważności i wartościach sąsiednich. Pomaga wykrywać np. nieprawidłowe użycie <code>&lt;</code> zamiast <code>&lt;=</code>.</p>\n<div class="definitioncopy"><p>Najpierw wyznaczamy klasy równoważności oraz miejsca, w których zmienia się oczekiwane zachowanie. Następnie dobieramy wartości graniczne i ich sąsiadów. Trzeba znać porządek danych i ich dokładność, np. jedną noc w przypadku całkowitej liczby noclegów.</p></div>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="bva2-title"><div class="definition-label">WARTOŚĆ GRANICZNA I SĄSIAD Z INNEJ KLASY</div><h3 id="bva2-title">Wariant 2-punktowy</h3><p class="definition-text">Dla wartości granicznej sprawdzamy ją oraz najbliższą wartość należącą do sąsiedniej klasy. Uwzględniamy wszystkie zidentyfikowane granice analizowanego podziału.</p><div class="definition-mini"><strong>Przejście między pobytem 1–3 a 4–7 nocy</strong><p>Sprawdzamy 3 i 4 noce: ostatnią wartość klasy bez rabatu oraz pierwszą wartość klasy z rabatem 10%.</p></div></section>\n<section class="definition-card validation" aria-labelledby="bva3-title"><div class="definition-label">WARTOŚĆ GRANICZNA I OBIE WARTOŚCI SĄSIEDNIE</div><h3 id="bva3-title">Wariant 3-punktowy</h3><p class="definition-text">Dla każdej zidentyfikowanej wartości granicznej sprawdzamy ją oraz jej najbliższych sąsiadów po obu stronach. To dokładniejszy wariant sprawdzania otoczenia granic.</p><div class="definition-mini"><strong>To samo przejście: 3 i 4 noce</strong><p>Dla granicy 3 sprawdzamy 2, 3 i 4. Dla granicy 4 sprawdzamy 3, 4 i 5. Po usunięciu powtórzeń otrzymujemy 2, 3, 4 i 5 — dla tego przejścia.</p></div></section>\n</div>\n<div class="simple"><strong>Prostymi słowami</strong>Nie sprawdzaj tylko środka przedziału. Sprawdź dokładnie miejsca, w których zmienia się sposób działania systemu.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Najpierw klasy, potem granice</h3><p>Ustal przedziały i reguły. Granice dotyczą także przejść pomiędzy różnymi poprawnymi wynikami, np. stawkami rabatu.</p></div>\n<div class="memory"><h3>Ustal najmniejszy krok danych</h3><p>W tym przykładzie liczba noclegów jest całkowita, więc sąsiadem 8 jest 7 lub 9. Dla kwot pieniężnych krok może wynosić jeden grosz.</p></div>\n<div class="memory"><h3>Reprezentant klasy nie zastępuje jej granic</h3><p>Pobyt na 10 nocy może działać poprawnie, mimo że system niewłaściwie nalicza rabat dla dokładnie 8 nocy.</p></div>\n<div class="memory"><h3>Sprawdź obie strony każdej zmiany reguły</h3><p>Uwzględnij dolny i górny limit oraz przejścia pomiędzy przedziałami. Poprawny wynik jednej granicy nie mówi nic pewnego o pozostałych.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — rabat za długość pobytu w hotelu</h2></div>\n<div class="example"><h3>Trzy przedziały cenowe i limit rezerwacji</h3><p>Cena jednej nocy wynosi <strong>200 zł</strong>. Rabat obejmuje cały pobyt. Przyjmujemy całkowitą liczbę noclegów, brak innych opłat i promocji oraz dostępny pokój.</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Wymagania dotyczące rabatów</caption><thead><tr><th scope="col">Liczba noclegów</th><th scope="col">Reguła</th></tr></thead><tbody>\n<tr><th scope="row">1–3</th><td>Bez rabatu</td></tr><tr><th scope="row">4–7</th><td>Rabat 10%</td></tr><tr><th scope="row">8–30</th><td>Rabat 20%</td></tr><tr><th scope="row">0 lub mniej; powyżej 30</th><td>Odrzucenie rezerwacji</td></tr>\n</tbody></table></div>\n<h3>Co robi tester?</h3><p>Wyznacza przejścia pomiędzy klasami: <strong>0/1, 3/4, 7/8 oraz 30/31</strong>. W wariancie 2-punktowym sprawdza następujące wartości, każdą w osobnym przypadku:</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Testy granic i oczekiwane ceny</caption><thead><tr><th scope="col">Noclegi</th><th scope="col">Oczekiwany wynik</th><th scope="col">Obliczenie</th></tr></thead><tbody>\n<tr><th scope="row">0</th><td>Odrzucenie</td><td>Niedozwolona liczba noclegów</td></tr>\n<tr><th scope="row">1</th><td>200 zł, bez rabatu</td><td>1 × 200 zł</td></tr>\n<tr><th scope="row">3</th><td>600 zł, bez rabatu</td><td>3 × 200 zł</td></tr>\n<tr><th scope="row">4</th><td>720 zł, rabat 10%</td><td>4 × 200 zł × 90%</td></tr>\n<tr><th scope="row">7</th><td>1260 zł, rabat 10%</td><td>7 × 200 zł × 90%</td></tr>\n<tr><th scope="row">8</th><td>1280 zł, rabat 20%</td><td>8 × 200 zł × 80%</td></tr>\n<tr><th scope="row">30</th><td>4800 zł, rabat 20%</td><td>30 × 200 zł × 80%</td></tr>\n<tr><th scope="row">31</th><td>Odrzucenie</td><td>Przekroczony limit</td></tr>\n</tbody></table></div>\n<p>Tester porównuje cenę, naliczony rabat i możliwość utworzenia rezerwacji z wymaganiami. Dla niedozwolonych wartości sprawdza komunikat oraz brak utworzonej rezerwacji.</p>\n<h3>Przykładowy defekt — niewłaściwy warunek</h3><p>Po sprawdzeniu, że liczba noclegów jest liczbą całkowitą z zakresu 1–30, programista zastosował poniższe naliczanie rabatu. Błędny jest warunek dla rabatu 20%:</p>\n<pre class="code-example"><code>if liczba_nocy &gt; 8:\n    rabat = 0.20\nelif liczba_nocy &gt;= 4:\n    rabat = 0.10\nelse:\n    rabat = 0.00</code></pre>\n<div class="failure"><p><b>Wynik:</b> dla dokładnie 8 noclegów system nadal stosuje 10% rabatu. Pokazuje <strong>1440 zł zamiast 1280 zł</strong>. Pobyt na 10 nocy mógłby przejść test poprawnie, lecz sprawdzenie granicy 8 ujawnia problem.</p></div>\n<p>Poprawny warunek dla rabatu 20% to <code>liczba_nocy &gt;= 8</code>. Po poprawce tester sprawdza ten przypadek ponownie oraz odpowiednią regresję.</p>\n<p class="report"><strong>Zgłoszenie testera:</strong> 8 noclegów, cena 200 zł za noc, oczekiwany rabat 20% i suma 1280 zł; rzeczywisty rabat 10% i suma 1440 zł. Tester dołącza kroki oraz dowody.</p>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Sprawdzaj dokładnie miejsca, w których zmienia się oczekiwane zachowanie systemu.</p></div>\n</div>\n', 'sections': 'sekcja 4.2.2'}, {'id': 17, 'number': '17', 'title': 'Testowanie w oparciu o tablicę decyzyjną', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>Testowanie w oparciu o tablicę decyzyjną</strong> to technika czarnoskrzynkowa, w której przedstawiamy, jak kombinacje warunków prowadzą do określonych działań systemu. Każda kolumna opisuje jedną regułę, na podstawie której można zaprojektować test.</p>\n<div class="definitioncopy"><p>W wierszach zapisujemy warunki oraz działania. W kolumnach zestawiamy wartości warunków i oczekiwane rezultaty. Dzięki temu łatwiej uporządkować reguły biznesowe, dostrzec pominięte sytuacje i sprzeczności w wymaganiach.</p><p>Testy projektujemy dla wykonalnych reguł. Pełne pokrycie oznacza sprawdzenie każdej z nich. Pokrycie wyrażamy jako procent przetestowanych reguł w stosunku do wszystkich wykonalnych reguł tablicy.</p></div>\n<div class="simple"><strong>Prostymi słowami</strong>Nie pytasz tylko „czy warunek działa?”. Sprawdzasz, co system robi, gdy kilka warunków występuje razem.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Kolumna oznacza regułę</h3><p>Każda reguła łączy konkretną kombinację warunków z oczekiwanym działaniem systemu.</p></div>\n<div class="memory"><h3>Sprawdzaj kombinacje</h3><p>Poprawne sprawdzenie każdego warunku oddzielnie nie wystarcza do oceny wszystkich reguł zależnych od ich połączenia.</p></div>\n<div class="memory"><h3>Ustal, które kombinacje są możliwe</h3><p>Jeżeli pewna sytuacja jest niemożliwa zgodnie z wymaganiami, nie twórz dla niej zwykłego testu wykonalnej reguły. Wyjaśnij i odnotuj ograniczenie.</p></div>\n<div class="memory"><h3>Pokrycie dotyczy reguł tablicy</h3><p>Sprawdzenie wszystkich reguł nie oznacza przetestowania całej aplikacji ani gwarancji braku defektów.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — certyfikat ukończenia kursu</h2></div>\n<div class="example"><h3>Dwa warunki muszą być spełnione jednocześnie</h3><p>Platforma wydaje certyfikat tylko wtedy, gdy użytkownik <strong>ukończył wszystkie lekcje i zdał egzamin końcowy</strong>. W tym przykładzie można podejść do egzaminu przed ukończeniem lekcji, więc wszystkie cztery kombinacje są możliwe.</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Tablica decyzyjna — każda kolumna to osobna reguła</caption><thead><tr><th scope="col">Warunek / działanie</th><th scope="col">Reguła 1</th><th scope="col">Reguła 2</th><th scope="col">Reguła 3</th><th scope="col">Reguła 4</th></tr></thead><tbody>\n<tr><th scope="row">Wszystkie lekcje ukończone?</th><td>Tak</td><td>Tak</td><td>Nie</td><td>Nie</td></tr>\n<tr><th scope="row">Egzamin zdany?</th><td>Tak</td><td>Nie</td><td>Tak</td><td>Nie</td></tr>\n<tr><th scope="row">Wydać certyfikat?</th><td><strong>Tak</strong></td><td><strong>Nie</strong></td><td><strong>Nie</strong></td><td><strong>Nie</strong></td></tr>\n</tbody></table></div>\n<h3>Co robi tester?</h3><ol class="goal-examples">\n<li><h3>Uzgadnia warunki i wynik</h3><p>Potwierdza, co oznacza ukończenie lekcji i zdanie egzaminu. Ustala, że certyfikat ma być wydany wyłącznie przy jednoczesnym spełnieniu obu warunków.</p></li>\n<li><h3>Przygotowuje cztery konta testowe</h3><p>Każde konto reprezentuje jedną kolumnę tablicy. Tester ustawia właściwy stan lekcji i egzaminu, sprawdza go, a następnie uruchamia ocenę uprawnienia do certyfikatu.</p></li>\n<li><h3>Porównuje wyniki z tablicą</h3><p>Sprawdza, czy certyfikat wydano tylko dla reguły 1. Dla pozostałych kont weryfikuje brak wydanego certyfikatu i brak możliwości jego pobrania, a nie jedynie wygląd przycisku.</p></li>\n<li><h3>Ocenia pokrycie</h3><p>Jeśli wykonał testy wszystkich czterech wykonalnych reguł, pokrycie reguł tej tablicy wynosi 4/4, czyli 100%. Wynik nie przesądza, czy testy przeszły — niezgodność nadal oznacza wykonany test i wymaga zgłoszenia.</p></li>\n</ol>\n<div class="failure"><p><b>Przykładowy defekt:</b> konto ze zdanym egzaminem, ale nieukończonymi lekcjami otrzymuje certyfikat. Tester zgłasza naruszenie reguły 3: oczekiwano braku certyfikatu, rzeczywiście został wydany. Możliwą przyczynę, np. pomylenie warunku „i” z „lub”, trzeba dopiero zbadać.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Gdy wynik zależy od kilku warunków, sprawdzaj ich kombinacje.</p></div>\n</div>\n', 'sections': 'sekcja 4.2.3'}, {'id': 18, 'number': '18', 'title': 'Testowanie przejść między stanami', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>Testowanie przejść między stanami</strong> to technika czarnoskrzynkowa, która sprawdza zachowanie systemu poprzez analizę jego stanów, zdarzeń i przejść między stanami. Ten sam krok może dać inny wynik zależnie od aktualnego stanu.</p>\n<div class="definitioncopy"><p><strong>Stan</strong> opisuje aktualną sytuację systemu. <strong>Zdarzenie</strong>, np. przesłanie PIN-u, może uruchomić przejście. Przejście może zależeć od dodatkowego warunku i wiązać się z działaniem, np. wyzerowaniem licznika prób.</p><p>Model można przedstawić jako diagram lub tabelę. Projektując testy, uwzględniamy zarówno dozwolone przejścia, jak i próby zmian niedozwolonych w danym stanie. Ważne są sekwencje zdarzeń, a nie tylko pojedyncze dane wejściowe.</p></div>\n<div class="simple"><strong>Prostymi słowami</strong>Poprawny PIN może zalogować użytkownika przed blokadą, ale po blokadzie ten sam PIN nie powinien umożliwić wejścia.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Stan ma znaczenie</h3><p>Zapisz stan początkowy i oczekiwany stan po każdym zdarzeniu. Te same dane nie zawsze prowadzą do tego samego wyniku.</p></div>\n<div class="memory"><h3>Kolejność działań wpływa na wynik</h3><p>Dwie błędne próby i poprawny PIN to inna sekwencja niż trzy błędne próby i dopiero poprawny PIN.</p></div>\n<div class="memory"><h3>Sprawdzaj także niedozwolone przejścia</h3><p>Próba przejścia od stanu „zablokowane” do „zalogowany” za pomocą samego PIN-u powinna zostać odrzucona zgodnie z wymaganiem.</p></div>\n<div class="memory"><h3>Odwiedzenie stanów nie sprawdza wszystkich przejść</h3><p>Można odwiedzić wszystkie stany, a pominąć np. poprawne logowanie po jednej błędnej próbie. Zakres pokrycia trzeba określić.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — blokada logowania po błędnym PIN-ie</h2></div>\n<div class="example"><h3>Trzy kolejne błędne próby blokują logowanie</h3><p>Przyjmujemy wymagania przykładowej aplikacji: po trzech kolejnych błędnych PIN-ach logowanie zostaje zablokowane. Poprawny PIN przed blokadą loguje i zeruje licznik. Odświeżenie strony ani ponowne otwarcie przeglądarki nie usuwa licznika lub blokady. Po blokadzie wymagane jest odrębne, uprawnione odblokowanie — poza zakresem poniższej tabeli.</p><p>Tester korzysta z kont testowych. Rozróżniamy stany: <strong>S0 — 0 błędnych prób, S1 — 1 błędna próba, S2 — 2 błędne próby, S3 — logowanie zablokowane, S4 — użytkownik zalogowany</strong>.</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Przejścia i działania dla przesłania PIN-u przed zalogowaniem</caption><thead><tr><th scope="col">Stan początkowy</th><th scope="col">Zdarzenie</th><th scope="col">Stan końcowy</th><th scope="col">Działanie / wynik</th></tr></thead><tbody>\n<tr><th scope="row">S0 — 0 błędów</th><td>Błędny PIN</td><td>S1</td><td>Odmowa; licznik = 1.</td></tr>\n<tr><th scope="row">S1 — 1 błąd</th><td>Błędny PIN</td><td>S2</td><td>Odmowa; licznik = 2.</td></tr>\n<tr><th scope="row">S2 — 2 błędy</th><td>Błędny PIN</td><td>S3</td><td>Blokada po trzeciej kolejnej błędnej próbie.</td></tr>\n<tr><th scope="row">S0 — 0 błędów</th><td>Poprawny PIN</td><td>S4</td><td>Zalogowanie; licznik = 0.</td></tr>\n<tr><th scope="row">S1 — 1 błąd</th><td>Poprawny PIN</td><td>S4</td><td>Zalogowanie; licznik = 0.</td></tr>\n<tr><th scope="row">S2 — 2 błędy</th><td>Poprawny PIN</td><td>S4</td><td>Zalogowanie; licznik = 0.</td></tr>\n<tr><th scope="row">S3 — blokada</th><td>Poprawny PIN</td><td>S3</td><td>Odmowa logowania; blokada pozostaje.</td></tr>\n<tr><th scope="row">S3 — blokada</th><td>Błędny PIN</td><td>S3</td><td>Odmowa logowania; blokada pozostaje.</td></tr>\n</tbody></table></div>\n<p class="note">Tabela obejmuje przesłanie PIN-u w stanach S0–S3. Pozostanie w S3 po przesłaniu PIN-u jest prawidłowym zachowaniem — przejściem do tego samego stanu. Niedozwolone jest uzyskanie w ten sposób stanu S4. W dalszych testach przyjmujemy też, że wylogowanie ze stanu S4 prowadzi do S0; nie uwzględniamy tu odblokowania konta ani innych zdarzeń.</p>\n<h3>Co robi tester?</h3><ol class="goal-examples">\n<li><h3>Przygotowuje stan początkowy</h3><p>Każdą niezależną sekwencję zaczyna od konta testowego w S0. Stosuje uzgodniony sposób przywrócenia danych; samo odświeżenie strony nie jest resetem konta.</p></li>\n<li><h3>Sprawdza przejścia prowadzące do blokady</h3><p>Wpisuje błędny PIN trzy razy. Po pierwszej i drugiej próbie logowanie nadal nie jest zablokowane; po trzeciej konto przechodzi do S3. Tester weryfikuje wynik po każdym kroku, a nie tylko końcowy komunikat.</p></li>\n<li><h3>Sprawdza poprawny PIN przed blokadą</h3><p>Na osobnych stanach początkowych wykonuje: od razu poprawny PIN; jeden błędny, potem poprawny; dwa błędne, potem poprawny. Za każdym razem oczekuje S4. Po wylogowaniu jedna błędna próba powinna pozostawić konto w S1 — to pomaga sprawdzić wyzerowanie licznika.</p></li>\n<li><h3>Próbuje zalogować się po blokadzie</h3><p>W stanie S3 przesyła poprawny PIN, a w oddzielnej próbie błędny. System ma pozostać w S3. Tester sprawdza brak dostępu do chronionych funkcji, nie tylko widoczność komunikatu.</p></li>\n<li><h3>Sprawdza trwałość stanu</h3><p>Po dwóch błędnych próbach odświeża stronę i podaje trzeci błędny PIN — oczekuje blokady. Po blokadzie ponownie otwiera stronę, a następnie przeglądarkę i próbuje poprawnego PIN-u. Blokada powinna nadal obowiązywać zgodnie z przyjętym wymaganiem.</p></li>\n</ol>\n<div class="failure"><p><b>Przykładowy defekt:</b> po trzech błędnych próbach poprawny PIN pozwala wejść do aplikacji. Tester zgłasza niedozwolone przejście z S3 do S4, opisując całą sekwencję i dane początkowe.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Sprawdzaj nie tylko dane wejściowe, lecz także stan systemu i kolejność zdarzeń.</p></div>\n</div>\n', 'sections': 'sekcja 4.2.4'}, {'id': 19, 'number': '19', 'title': 'Testowanie eksploracyjne', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>Testowanie eksploracyjne</strong> polega na jednoczesnym poznawaniu produktu, projektowaniu i wykonywaniu testów oraz ocenianiu wyników. Nowa wiedza wpływa na kolejne sprawdzenia.</p>\n<div class="definitioncopy"><p>To technika oparta na doświadczeniu. Tester bada wybrany obszar z określonym celem, obserwuje zachowanie i na tej podstawie dobiera dalsze działania. Może wykorzystywać również inne techniki, np. klasy równoważności.</p><p>Sesja może mieć wyznaczony czas i kartę opisującą jej cel oraz zakres. Tester zapisuje sprawdzenia i odkrycia, a po sesji omawia wyniki. Eksploracja uzupełnia inne techniki i może być szczególnie użyteczna przy niepełnej specyfikacji.</p></div>\n<div class="simple"><strong>Prostymi słowami</strong>Sprawdzasz aplikację, uczysz się jej działania i wykorzystujesz obserwacje do wymyślania następnych testów.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>To świadome badanie produktu</h3><p>Masz cel i analizujesz wyniki. Eksploracja nie oznacza przypadkowego klikania.</p></div>\n<div class="memory"><h3>Ustal zakres sesji</h3><p>Określ obszar, ryzyko i dostępny czas. Limit czasu jest pomocnym sposobem organizacji, a nie definicją całej techniki.</p></div>\n<div class="memory"><h3>Notuj obserwacje na bieżąco</h3><p>Zapisuj dane, kroki, wyniki, pytania i problemy. Notatki pomagają odtworzyć odkrycia i pokazać wykonany zakres.</p></div>\n<div class="memory"><h3>Obserwacja prowadzi do następnego testu</h3><p>Gdy zauważysz opóźnienie zapisu, możesz zbadać przełączenie notatki lub utratę połączenia. Kierunek zmienia się na podstawie zdobytej wiedzy.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — zapisywanie notatki</h2></div>\n<div class="example"><h3>Czy użytkownik może stracić wpisaną treść?</h3><p>Badamy edytor z automatycznym zapisem. W przykładowym projekcie wymagania mówią: komunikat „Zapisano” oznacza trwały zapis, a przy opuszczaniu edytora z niezapisanymi zmianami użytkownik powinien dostać ostrzeżenie.</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Przykładowa karta sesji eksploracyjnej</caption><tbody>\n<tr><th scope="row">Cel</th><td>Zbadać ryzyko utraty treści podczas edycji i automatycznego zapisu.</td></tr>\n<tr><th scope="row">Zakres</th><td>Wpisywanie, odświeżenie strony, zmiana notatki i przerwanie połączenia.</td></tr>\n<tr><th scope="row">Czas</th><td>30 minut — założenie organizacyjne tego przykładu.</td></tr>\n<tr><th scope="row">Dane</th><td>Dwie notatki testowe z rozpoznawalnymi fragmentami tekstu; brak ważnych dokumentów.</td></tr>\n</tbody></table></div>\n<h3>Co robi tester?</h3><ol class="goal-examples">\n<li><h3>Poznaje podstawowy zapis</h3><p>Tworzy notatkę i wpisuje krótki tekst. Obserwuje komunikaty. Po pojawieniu się „Zapisano” odświeża stronę i porównuje treść. Poznaje sposób sygnalizowania zapisu.</p></li>\n<li><h3>Na podstawie obserwacji zmienia sprawdzenie</h3><p>Zauważa opóźnienie pomiędzy wpisaniem tekstu a potwierdzeniem zapisu. Dopisuje dłuższy fragment i szybko przechodzi do drugiej notatki. Sprawdza ostrzeżenie oraz treść po powrocie.</p></li>\n<li><h3>Rozwija badanie o utratę połączenia</h3><p>Skoro zapis nie jest natychmiastowy, bada zachowanie bez sieci. W środowisku testowym przerywa połączenie, dopisuje tekst, obserwuje komunikat, a potem przywraca sieć. Sprawdza, czy aplikacja zgodnie z wymaganiami sygnalizuje stan i zachowuje dane.</p></li>\n<li><h3>Oddziela problem od pytania</h3><p>Utrata tekstu mimo komunikatu „Zapisano” narusza uzgodnione wymaganie. Jeżeli nie wiadomo, czy edytor powinien przechowywać szkic offline, tester zapisuje pytanie do zespołu zamiast samodzielnie przyjmować takie wymaganie.</p></li>\n<li><h3>Podsumowuje sesję</h3><p>Zapisuje wykonane sprawdzenia, dane i zaobserwowane wyniki. Zgłasza odtwarzalne problemy, wskazuje niejasności oraz obszary, których nie zdążył zbadać, np. równoczesną edycję na dwóch urządzeniach.</p></li>\n</ol>\n<div class="failure"><p><b>Przykładowe odkrycie:</b> po szybkiej zmianie notatki ostatni akapit znika bez wymaganego ostrzeżenia. Tester odtwarza sytuację i opisuje zgłoszenie. Zbadanie tego przypadku wynikło z wcześniejszej obserwacji opóźnienia zapisu.</p></div>\n<p class="report">Kroki pokazują przykładowy przebieg sesji, a nie z góry obowiązujący scenariusz. W rzeczywistej eksploracji dalsze testy zależą od obserwacji.</p>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Poznawaj produkt, wyciągaj wnioski i wykorzystuj je do projektowania kolejnych testów.</p></div>\n</div>\n', 'sections': 'sekcja 4.4.2'}, {'id': 20, 'number': '20', 'title': 'Proces przeglądu — od planowania do raportowania', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>Proces przeglądu</strong> to uporządkowane czynności służące ocenie produktu pracy, wykrywaniu problemów, uzgadnianiu działań i sprawdzaniu ich wykonania. Zakres formalności dopasowujemy do sytuacji.</p>\n<p>Przegląd jest formą testowania statycznego. Może dotyczyć wymagań, projektu, kodu lub przypadków testowych. Duży materiał można przeglądać w częściach, powtarzając proces.</p>\n<h3>Pięć etapów procesu przeglądu</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Od ustalenia celu do zakończenia działań</caption><thead><tr><th scope="col">Etap</th><th scope="col">Co się dzieje?</th></tr></thead><tbody>\n<tr><th scope="row">1. Planowanie</th><td>Ustalamy cel, zakres, uczestników, czas i kryteria zakończenia.</td></tr>\n<tr><th scope="row">2. Rozpoczęcie przeglądu</th><td>Zapewniamy materiały, dostęp oraz zrozumienie ról i zadania.</td></tr>\n<tr><th scope="row">3. Przegląd indywidualny</th><td>Przeglądający samodzielnie oceniają materiał i zapisują anomalie, pytania oraz rekomendacje.</td></tr>\n<tr><th scope="row">4. Komunikacja i analiza</th><td>Omawiamy zgłoszenia, ustalamy ich status, odpowiedzialność i dalsze działania. Nie każda anomalia jest defektem.</td></tr>\n<tr><th scope="row">5. Poprawianie i raportowanie</th><td>Śledzimy poprawki, oceniamy kryteria zakończenia i raportujemy wyniki.</td></tr>\n</tbody></table></div>\n<h3>Role w przeglądzie</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Główne odpowiedzialności uczestników</caption><thead><tr><th scope="col">Rola</th><th scope="col">Odpowiedzialność</th></tr></thead><tbody>\n<tr><th scope="row">Kierownik</th><td>Decyduje, co przeglądać, i zapewnia zasoby.</td></tr>\n<tr><th scope="row">Autor</th><td>Tworzy i poprawia materiał.</td></tr>\n<tr><th scope="row">Lider przeglądu</th><td>Odpowiada za organizację całości.</td></tr>\n<tr><th scope="row">Moderator</th><td>Wspiera sprawny i bezpieczny przebieg spotkania.</td></tr>\n<tr><th scope="row">Protokolant</th><td>Zbiera zgłoszenia i zapisuje decyzje.</td></tr>\n<tr><th scope="row">Przeglądający</th><td>Ocenia materiał. Tester może pełnić tę rolę.</td></tr>\n</tbody></table></div>\n<div class="simple"><strong>Prostymi słowami</strong>Nie wystarczy zebrać uwag do dokumentu. Trzeba uzgodnić ich znaczenie, przypisać działania i sprawdzić, co zostało poprawione.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Przegląd to więcej niż spotkanie</h3><p>Pełny, ogólny proces obejmuje przygotowanie, ocenę indywidualną, komunikację i dalsze działania. Zakres dostosowujemy do typu przeglądu: np. w przejrzeniu (walkthrough) ocena indywidualna przed spotkaniem nie jest wymagana. Komunikacja i analiza nie zawsze wymagają spotkania.</p></div>\n<div class="memory"><h3>Oceniamy produkt pracy, nie autora</h3><p>Zgłaszamy konkretną niejasność i jej wpływ. Bezpieczna, konstruktywna rozmowa pomaga ujawniać problemy.</p></div>\n<div class="memory"><h3>Wartość zgłoszenia wymaga analizy</h3><p>Pytanie może ujawnić defekt albo wymagać jedynie wyjaśnienia. Status ustalamy na podstawie materiału i uzgodnień.</p></div>\n<div class="memory"><h3>Uwagi muszą prowadzić do ustaleń</h3><p>Określ odpowiedzialność, potrzebne działania i sposób sprawdzenia ich wykonania. Zakończenie oceń według uzgodnionych kryteriów.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — wymagania przelewu zaplanowanego</h2></div>\n<div class="example"><h3>Co właściwie znaczy „wykonać przelew w wybranym terminie”?</h3><p>Dokument zawiera zapis: <strong>„Przelew zostanie wykonany w wybranym terminie, jeśli klient ma wystarczające środki”.</strong> Zespół przegląda wymagania przed implementacją, aby wyjaśnić sposób realizacji.</p>\n<ol class="goal-examples">\n<li><h3>Planowanie — ustalenie celu i zakończenia</h3><p>Zespół wybiera fragment dotyczący wykonania przelewu. Ustala czas na przygotowanie i zasadę: przed akceptacją trzeba rozstrzygnąć pytania wpływające na pobieranie pieniędzy. Lider organizuje udział autora, testera i osób znających reguły bankowe.</p></li>\n<li><h3>Rozpoczęcie — przygotowanie uczestników</h3><p>Wszyscy otrzymują tę samą wersję dokumentu, informacje o celu i terminie oraz dostęp do powiązanych wymagań. Tester potwierdza, co ma ocenić i gdzie zapisać uwagi.</p></li>\n<li><h3>Przegląd indywidualny — znalezienie niejasności</h3><p>Tester samodzielnie czyta materiał. Zapisuje pytania: o której godzinie sprawdzane jest saldo, co nastąpi przy braku środków, czy system ponawia próbę, do kiedy można anulować przelew i jaki komunikat otrzyma klient. Każde pytanie odnosi do konkretnego zapisu.</p></li>\n<li><h3>Komunikacja i analiza — uzgodnienie działań</h3><p>Uczestnicy analizują pytania. Potwierdzają braki, uzgadniają reguły z właściwą osobą biznesową i przypisują autorowi uzupełnienie dokumentu. Protokolant zapisuje decyzje i otwarte kwestie. Moderator dba o rzeczową rozmowę.</p></li>\n<li><h3>Poprawianie i raportowanie — sprawdzenie ustaleń</h3><p>Autor uzupełnia wymagania. Wyznaczona osoba, np. tester w tym przykładzie, sprawdza poprawioną wersję. Zespół ocenia kryteria zakończenia; jeśli istotne pytania pozostają otwarte, potrzebne są dalsze działania. Raport przedstawia zakres, wyniki i pozostałe kwestie.</p></li>\n</ol>\n<h3>Co robi tester?</h3><p>Przygotowuje się do przeglądu, ocenia jednoznaczność i testowalność wymagań, zapisuje pytania, uczestniczy w analizie oraz sprawdza poprawki zgodnie z przydzielonym zadaniem. Nie ustala samodzielnie zasad biznesowych zamiast ich właściciela.</p>\n<div class="failure"><p><b>Rezultat:</b> uzupełniony dokument opisuje m.in. moment sprawdzania salda, obsługę braku środków i anulowanie. Zapisane decyzje pozwalają programiście wdrożyć uzgodnione zachowanie, a testerowi określić oczekiwane wyniki.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Zaplanuj, przygotuj uczestników, sprawdź materiał, uzgodnij działania i dopilnuj ich zakończenia.</p></div>\n</div>\n', 'sections': 'sekcje 3.2.2, 3.2.3 i 3.2.5'}, {'id': 21, 'number': '21', 'title': 'Rodzaje przeglądów', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Cztery osobne definicje</h2></div>\n<p class="lead"><strong>Rodzaj przeglądu dobieramy do celu, ryzyka i kontekstu.</strong> Przeglądy różnią się formalnością, prowadzeniem i oczekiwanymi rezultatami.</p>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="informal-title"><div class="definition-label">BEZ WYMAGANEGO FORMALNEGO PROCESU</div><h3 id="informal-title">Przegląd nieformalny</h3><p class="definition-text">Nie wymaga określonego procesu ani formalnego raportu. Jego głównym celem jest wykrywanie anomalii.</p><div class="definition-mini"><strong>Przykład</strong><p>Tester prosi analityka o przeczytanie krótkiego opisu komunikatu o braku środków i wskazanie niejasności.</p></div></section>\n<section class="definition-card validation" aria-labelledby="walkthrough-title"><div class="definition-label">PROWADZI AUTOR MATERIAŁU</div><h3 id="walkthrough-title">Przejrzenie — walkthrough</h3><p class="definition-text">Autor prowadzi uczestników przez materiał. Przejrzenie pomaga wyjaśniać rozwiązanie, zbierać uwagi i budować wspólne zrozumienie. Przygotowanie indywidualne może wystąpić, ale nie jest wymagane.</p><div class="definition-mini"><strong>Przykład</strong><p>Analityk przedstawia wymagania przelewu zaplanowanego i odpowiada na pytania uczestników.</p></div></section>\n<section class="definition-card verification" aria-labelledby="technical-title"><div class="definition-label">SPECJALIŚCI I MODERATOR</div><h3 id="technical-title">Przegląd techniczny</h3><p class="definition-text">Wykonują go osoby o odpowiednich kompetencjach technicznych, a prowadzi moderator. Służy m.in. uzgadnianiu rozwiązań, podejmowaniu decyzji technicznych i wykrywaniu anomalii.</p><div class="definition-mini"><strong>Przykład</strong><p>Specjaliści analizują projekt zabezpieczenia przed dwukrotnym wykonaniem tego samego przelewu.</p></div></section>\n<section class="definition-card validation" aria-labelledby="inspection-title"><div class="definition-label">NAJBARDZIEJ FORMALNY RODZAJ</div><h3 id="inspection-title">Inspekcja</h3><p class="definition-text">Wykorzystuje pełny ogólny proces przeglądu, określone role i zbieranie metryk. Głównym celem jest wykrycie możliwie największej liczby anomalii. Autor nie może być liderem przeglądu ani protokolantem.</p><div class="definition-mini"><strong>Przykład</strong><p>Zespół formalnie ocenia specyfikację realizacji przelewów, dokumentuje anomalie i śledzi poprawki.</p></div></section>\n</div>\n<div class="simple"><strong>Prostymi słowami</strong>Możesz poprosić o szybką opinię, przejść z autorem przez dokument, uzgodnić rozwiązanie techniczne lub przeprowadzić formalną inspekcję.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Cel i ryzyko wpływają na wybór</h3><p>Większa formalność nie zawsze oznacza lepszy wybór. Dobierz podejście do materiału, potrzeb i dostępnych zasobów.</p></div>\n<div class="memory"><h3>Ten sam materiał można przeglądać wielokrotnie</h3><p>Dokument może najpierw otrzymać nieformalne uwagi, a po dopracowaniu przejść bardziej formalny przegląd.</p></div>\n<div class="memory"><h3>Rozróżniaj osobę prowadzącą</h3><p>Przejrzenie prowadzi autor. Przegląd techniczny prowadzi moderator. Sama obecność programistów nie określa jeszcze rodzaju przeglądu.</p></div>\n<div class="memory"><h3>Inspekcja ma szczególne zasady</h3><p>Obejmuje pełny proces. Autor nie pełni w niej roli lidera przeglądu ani protokolanta; metryki służą doskonaleniu procesu.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — dokumentacja przelewów bankowych</h2></div>\n<div class="example"><h3>Różne potrzeby, różne rodzaje przeglądów</h3><p>Zespół tworzy przelewy zaplanowane. Chce sprawdzić komunikaty, zrozumieć reguły, uzgodnić zabezpieczenie techniczne i ocenić gotową specyfikację. Poniższe sytuacje ilustrują wybór rodzaju przeglądu — nie są obowiązkową kolejnością dla każdego projektu.</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Jak wyglądają cztery rodzaje przeglądów w praktyce?</caption><thead><tr><th scope="col">Rodzaj</th><th scope="col">Sytuacja i przebieg</th><th scope="col">Przykładowy rezultat</th></tr></thead><tbody>\n<tr><th scope="row">Nieformalny</th><td>Tester przesyła analitykowi opis komunikatu o braku środków i prosi o uwagi. Nie ustalono formalnego procesu ani raportu.</td><td>Uwaga: komunikat nie wyjaśnia, czy system ponowi próbę wykonania przelewu.</td></tr>\n<tr><th scope="row">Przejrzenie</th><td>Autor pokazuje krok po kroku wymagania przelewu zaplanowanego. Tester pyta o godzinę realizacji i anulowanie.</td><td>Uczestnicy lepiej rozumieją zasady; autor zapisuje niejasności do wyjaśnienia.</td></tr>\n<tr><th scope="row">Techniczny</th><td>Specjaliści z udziałem moderatora oceniają projekt ochrony przed podwójną realizacją. Tester przedstawia scenariusz dwóch równoczesnych żądań.</td><td>Uzgodnione rozwiązanie i działania dotyczące wykrytych luk projektu.</td></tr>\n<tr><th scope="row">Inspekcja</th><td>Zespół planuje formalną ocenę specyfikacji, przygotowuje materiały, wykonuje indywidualne przeglądy, analizuje anomalie, śledzi poprawki i raportuje wyniki.</td><td>Raport, status ustaleń, ocena kryteriów zakończenia i metryki. Potrzebny może być kolejny przegląd.</td></tr>\n</tbody></table></div>\n<h3>Co robi tester?</h3><ol class="goal-examples">\n<li><h3>Rozumie cel i własną rolę</h3><p>Ustala, co jest oceniane i czego oczekuje się od niego jako przeglądającego. Odpowiednio przygotowuje się do wybranego rodzaju przeglądu.</p></li>\n<li><h3>Wskazuje konkretne problemy i pytania</h3><p>Sprawdza jednoznaczność i testowalność wymagań, analizuje ryzyka oraz zapisuje odniesienia do fragmentów materiału. Nie traktuje każdej uwagi automatycznie jako potwierdzonego defektu.</p></li>\n<li><h3>Uczestniczy w analizie i sprawdza ustalenia</h3><p>Wyjaśnia wpływ problemów, pomaga uzgodnić działania i sprawdza poprawki zgodnie z przydzielonym zadaniem. Decyzje i sposób dokumentowania zależą od przyjętej formy przeglądu.</p></li>\n</ol>\n<div class="failure"><p><b>Wniosek:</b> innego podejścia wymaga szybka opinia o komunikacie, a innego formalna ocena specyfikacji istotnej dla realizacji przelewów. Nie każdy przegląd musi być inspekcją.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Dobierz rodzaj przeglądu do celu i ryzyka ocenianego materiału.</p></div>\n</div>\n', 'sections': 'sekcje 3.2.4 i 3.2.5'}, {'id': 22, 'number': '22', 'title': 'Poziomy testów', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i pięć poziomów</h2></div>\n<p class="lead"><strong>Poziomy testów</strong> to grupy czynności testowych organizowanych i zarządzanych razem. Różnią się m.in. przedmiotem, celem i podstawą testów — od komponentu po ocenę gotowości rozwiązania do użycia.</p>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="component-title"><div class="definition-label">POJEDYNCZY ELEMENT W IZOLACJI</div><h3 id="component-title">Testowanie komponentowe</h3><p class="definition-text">Sprawdza komponenty w izolacji, np. pojedynczą funkcję lub moduł. Nazywane także testowaniem jednostkowym; zwykle wykonują je programiści.</p><div class="definition-mini"><strong>Pytanie pomocnicze</strong><p>„Czy ten element działa poprawnie samodzielnie?”</p></div></section>\n<section class="definition-card validation" aria-labelledby="component-integration-title"><div class="definition-label">WSPÓŁPRACA CZĘŚCI ROZWIĄZANIA</div><h3 id="component-integration-title">Testowanie integracji komponentów</h3><p class="definition-text">Koncentruje się na interfejsach i interakcjach między komponentami.</p><div class="definition-mini"><strong>Pytanie pomocnicze</strong><p>„Czy połączone elementy poprawnie wymieniają dane?”</p></div></section>\n<section class="definition-card verification" aria-labelledby="system-title"><div class="definition-label">CAŁY SYSTEM</div><h3 id="system-title">Testowanie systemowe</h3><p class="definition-text">Ocenia ogólne zachowanie i możliwości całego systemu w odniesieniu do jego specyfikacji. Może obejmować testy funkcjonalne i niefunkcjonalne.</p><div class="definition-mini"><strong>Pytanie pomocnicze</strong><p>„Czy cały system realizuje wymagane zadania?”</p></div></section>\n<section class="definition-card validation" aria-labelledby="system-integration-title"><div class="definition-label">WSPÓŁPRACA ODRĘBNYCH SYSTEMÓW</div><h3 id="system-integration-title">Testowanie integracji systemów</h3><p class="definition-text">Sprawdza interfejsy i interakcje testowanego systemu z innymi systemami i usługami zewnętrznymi.</p><div class="definition-mini"><strong>Pytanie pomocnicze</strong><p>„Czy nasz system poprawnie współpracuje z otoczeniem?”</p></div></section>\n<section class="definition-card verification" aria-labelledby="acceptance-title" style="grid-column:1/-1"><div class="definition-label">POTRZEBY I GOTOWOŚĆ DO WDROŻENIA</div><h3 id="acceptance-title">Testowanie akceptacyjne</h3><p class="definition-text">Koncentruje się na walidacji i wykazaniu gotowości do wdrożenia, w tym spełnieniu potrzeb biznesowych użytkowników. W jego wykonanie warto angażować docelowych użytkowników.</p><div class="definition-mini"><strong>Pytanie pomocnicze</strong><p>„Czy rozwiązanie spełnia uzgodnione potrzeby i jest gotowe do użycia?”</p></div></section>\n</div>\n<div class="simple"><strong>Prostymi słowami</strong>Sprawdzamy pojedyncze części, ich połączenia, cały system, współpracę z otoczeniem i przydatność dla użytkowników.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Poziom to inne pojęcie niż typ testów</h3><p>„Systemowe” określa poziom, a „funkcjonalne” lub „niefunkcjonalne” — typ. Można je łączyć, np. systemowe testowanie wydajności.</p></div>\n<div class="memory"><h3>Rozróżniaj dwie integracje</h3><p>Integracja komponentów dotyczy współpracy części rozwiązania. Integracja systemów dotyczy współpracy odrębnych systemów. Ustal granice architektury projektu.</p></div>\n<div class="memory"><h3>Poziomy mogą nakładać się w czasie</h3><p>Nie muszą tworzyć jednej sztywnej kolejki. Sposób organizacji zależy od cyklu wytwarzania i kontekstu.</p></div>\n<div class="memory"><h3>Akceptacja wymaga perspektywy użytkownika</h3><p>Tester może przygotować dane i wspierać próby, ale istotny jest udział właściwych interesariuszy oraz uzgodnione kryteria akceptacji.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — aplikacja do zamawiania taksówki</h2></div>\n<div class="example"><h3>Od wyliczenia ceny do przejazdu użytecznego dla pasażera</h3><p>Przyjmujemy, że moduły zamawiania, wyceny i przydzielania kierowcy są częściami jednego systemu. Operator płatności jest usługą zewnętrzną. Przykład służy nauce; korzystamy z testowych danych i płatności.</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Jedna aplikacja — pięć różnych celów sprawdzenia</caption><thead><tr><th scope="col">Poziom</th><th scope="col">Przykładowe sprawdzenie</th><th scope="col">Oczekiwany rezultat</th></tr></thead><tbody>\n<tr><th scope="row">Komponentowe</th><td>Sprawdzenie funkcji wyceny w izolacji. Przykładowa reguła: 10 zł opłaty początkowej i 3 zł za kilometr, bez innych opłat.</td><td>Dla 4 km funkcja zwraca 22 zł. Nie trzeba zamawiać prawdziwego kursu.</td></tr>\n<tr><th scope="row">Integracji komponentów</th><td>Połączenie modułu zamawiania z modułem wyceny.</td><td>Dystans 4 km jest przekazany w poprawnej jednostce i cena 22 zł wraca do właściwego zamówienia.</td></tr>\n<tr><th scope="row">Systemowe</th><td>Sprawdzenie pełnego przebiegu wewnątrz systemu: trasa, zamówienie, przydział kierowcy i zakończenie kursu. Usługi zewnętrzne można kontrolowanie symulować.</td><td>Dane i statusy kursu pozostają zgodne ze specyfikacją całego systemu.</td></tr>\n<tr><th scope="row">Integracji systemów</th><td>Wymiana danych z operatorem płatności w jego środowisku testowym, w tym przyjęta i odrzucona płatność.</td><td>Żądania i odpowiedzi są prawidłowo obsługiwane; odrzucona płatność nie zostaje oznaczona jako opłacona.</td></tr>\n<tr><th scope="row">Akceptacyjne</th><td>Reprezentatywni pasażerowie i kierowcy wykonują uzgodnione zadania: wskazanie odbioru, przyjęcie zlecenia, rozpoznanie pojazdu i zakończenie przejazdu.</td><td>Zespół ocenia spełnienie potrzeb i uzgodnionych kryteriów gotowości, zbierając wyniki i uwagi użytkowników.</td></tr>\n</tbody></table></div>\n<h3>Co robi tester?</h3><ol class="goal-examples">\n<li><h3>Ustala przedmiot i cel</h3><p>Wyjaśnia, czy sprawdzany jest pojedynczy moduł, interfejs, cały system czy potrzeba biznesowa. Ten sam ekran aplikacji nie oznacza automatycznie tego samego poziomu testów.</p></li>\n<li><h3>Dobiera podstawę, środowisko i dane</h3><p>Dla funkcji wyceny korzysta z reguły obliczeń, dla integracji z umowy interfejsu, dla systemu ze specyfikacji, a dla akceptacji z uzgodnionych potrzeb i kryteriów. Ustala, co jest rzeczywiste, a co symulowane.</p></li>\n<li><h3>Współpracuje i przekazuje wyniki</h3><p>W zależności od poziomu współpracuje m.in. z programistami, zespołem integracji i użytkownikami. Wykonuje przydzielone sprawdzenia, opisuje niezgodności i dostarcza informacje do decyzji. Nie musi osobiście wykonywać wszystkich testów na każdym poziomie.</p></li>\n</ol>\n<div class="failure"><p><b>Przykładowy problem integracji:</b> funkcja poprawnie liczy cenę dla kilometrów, ale moduł zamawiania przekazuje metry jako kilometry. Poprawny test komponentu nie wykazałby tej niezgodności połączenia.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Sprawdzaj części, ich współpracę, cały system i jego przydatność dla użytkownika.</p></div>\n</div>\n', 'sections': 'sekcje 2.2 i 2.2.1'}, {'id': 23, 'number': '23', 'title': 'Ryzyko produktowe a ryzyko projektowe', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Dwie osobne definicje</h2></div>\n<p class="lead"><strong>Ryzyko</strong> dotyczy możliwego zdarzenia lub sytuacji o niekorzystnych skutkach. Ryzyko produktowe i projektowe różnią się tym, czego dotyczy zagrożenie.</p>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="product-risk-title"><div class="definition-label">JAKOŚĆ ROZWIĄZANIA</div><h3 id="product-risk-title">Ryzyko produktowe</h3><p class="definition-text">Dotyczy możliwości wystąpienia problemów z jakością produktu, np. błędnych obliczeń, utraty danych, niewystarczającej wydajności lub luk w zabezpieczeniach.</p><div class="definition-question"><strong>Pytanie pomocnicze</strong><p>„Co może działać źle i jakie będą skutki?”</p></div><div class="definition-mini"><strong>Przykład — kopia zdjęć</strong><p>Aplikacja może potwierdzić utworzenie kopii, mimo że nie zapisała wszystkich zdjęć. Użytkownik może stracić część danych.</p></div></section>\n<section class="definition-card validation" aria-labelledby="project-risk-title"><div class="definition-label">REALIZACJA PROJEKTU</div><h3 id="project-risk-title">Ryzyko projektowe</h3><p class="definition-text">Dotyczy zagrożeń dla realizacji projektu, np. niedostępności pracowników, opóźnień dostaw, niewłaściwych oszacowań lub problemów z narzędziami. Może wpłynąć na termin, budżet i zakres.</p><div class="definition-question"><strong>Pytanie pomocnicze</strong><p>„Co może utrudnić osiągnięcie celów projektu?”</p></div><div class="definition-mini"><strong>Przykład — środowisko testowe</strong><p>Środowisko może zostać dostarczone z opóźnieniem, przez co zabraknie czasu na zaplanowane sprawdzenia kopii.</p></div></section>\n</div>\n<div class="definitioncopy"><p>Przy ocenie ryzyka uwzględniamy <strong>prawdopodobieństwo</strong> wystąpienia i <strong>skutek</strong>. Ocena pomaga dobrać priorytety i działania. Sposób wyznaczenia poziomu ryzyka może być ilościowy lub jakościowy.</p></div>\n<div class="simple"><strong>Prostymi słowami</strong>Produktowe → co może być nie tak z produktem? Projektowe → co może utrudnić jego dostarczenie?</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Rozróżniaj obszar zagrożenia</h3><p>Produktowe dotyczy jakości rozwiązania, a projektowe — realizacji celów projektu.</p></div>\n<div class="memory"><h3>Ryzyko to możliwość, nie potwierdzony defekt</h3><p>„Kopia może być niekompletna” opisuje ryzyko. Jeżeli test już wykazał brak zdjęć, mamy także zaobserwowany problem do zgłoszenia.</p></div>\n<div class="memory"><h3>Uwzględniaj prawdopodobieństwo i skutek</h3><p>Nie oceniaj ryzyka wyłącznie na podstawie częstotliwości. Rzadki problem może powodować dotkliwe konsekwencje.</p></div>\n<div class="memory"><h3>Oba rodzaje ryzyka mogą się łączyć</h3><p>Opóźnione środowisko utrudnia testy, a mniejszy zakres sprawdzeń pozostawia więcej niepewności co do bezpieczeństwa kopii zdjęć.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — kopia zapasowa zdjęć</h2></div>\n<div class="example"><h3>Czy komunikat „Kopia gotowa” oznacza, że zdjęcia da się odzyskać?</h3><p>Zespół przygotowuje funkcję tworzenia kopii zapasowej. Użytkownik może zaufać komunikatowi o zakończeniu i usunąć oryginały. Dlatego kompletność zapisu i możliwość odtworzenia są istotne dla jakości produktu.</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Rozróżnienie zagrożeń i przykładowych działań</caption><thead><tr><th scope="col">Rodzaj</th><th scope="col">Możliwe zdarzenie</th><th scope="col">Skutek</th><th scope="col">Przykładowa reakcja</th></tr></thead><tbody>\n<tr><th scope="row">Produktowe</th><td>Aplikacja ogłosi ukończenie niepełnej kopii.</td><td>Użytkownik po usunięciu oryginałów może stracić zdjęcia.</td><td>Testy kompletności, odtwarzania i obsługi przerwanego zapisu; analiza wykrytych problemów.</td></tr>\n<tr><th scope="row">Projektowe</th><td>Środowisko testowe zostanie dostarczone za późno.</td><td>Opóźnienie testów, zmiana harmonogramu lub brak czasu na część sprawdzeń.</td><td>Wczesne zgłoszenie zagrożenia i uzgodnienie z zespołem planu dostępności środowiska oraz priorytetów.</td></tr>\n</tbody></table></div>\n<h3>Co robi tester?</h3><ol class="goal-examples">\n<li><h3>Opisuje ryzyko produktowe</h3><p>Wskazuje możliwą utratę zdjęć i warunki, które mogą do niej doprowadzić, np. przerwanie połączenia podczas zapisu. Wspólnie z interesariuszami ocenia prawdopodobieństwo oraz skutek.</p></li>\n<li><h3>Proponuje konkretne sprawdzenia</h3><p>Przygotowuje rozpoznawalny zestaw testowych zdjęć. Tworzy kopię, odtwarza ją do oddzielnego miejsca i porównuje listę plików oraz ich zawartość. Bada również przerwane połączenie i wznowienie zapisu. Nie usuwa ważnych prywatnych oryginałów.</p></li>\n<li><h3>Zgłasza ryzyko projektowe</h3><p>Informuje o zagrożeniu opóźnieniem środowiska, wskazując, jakie testy i terminy mogą ucierpieć. Pomaga ustalić działania z osobami odpowiedzialnymi za środowisko i harmonogram, zamiast samodzielnie zmieniać zakres projektu.</p></li>\n<li><h3>Przekazuje pozostałe ryzyko</h3><p>Raportuje wykonane sprawdzenia, wyniki, wykryte defekty i pominięte scenariusze. Zespół monitoruje skuteczność działań oraz podejmuje decyzje na podstawie pozostałej niepewności.</p></li>\n</ol>\n<div class="failure"><p><b>Przykładowe odkrycie:</b> aplikacja pokazuje „Kopia gotowa”, lecz po odtworzeniu brakuje części testowych zdjęć. Tester zgłasza defekt. Wcześniejsze ryzyko utraty danych uzyskało konkretne potwierdzenie w sprawdzonym scenariuszu.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Ryzyko produktowe dotyczy jakości produktu, a projektowe — powodzenia projektu.</p></div>\n</div>\n', 'sections': 'sekcje 5.2.1–5.2.4'}, {'id': 24, 'number': '24', 'title': 'Kryteria wejścia a kryteria wyjścia', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Dwie osobne definicje</h2></div>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="entry-title"><div class="definition-label">GOTOWOŚĆ DO ROZPOCZĘCIA</div><h3 id="entry-title">Kryteria wejścia</h3><p class="definition-text">Warunki wstępne potrzebne do rozpoczęcia określonej czynności testowej. Dotyczą np. dostępności środowiska, danych, wymagań i odpowiedniej jakości wersji aplikacji.</p><div class="definition-question"><strong>Pytanie pomocnicze</strong><p>„Czy jesteśmy przygotowani, żeby rozpocząć testowanie?”</p></div><div class="definition-mini"><strong>Przykład — magazyn</strong><p>Testowy skaner rozpoznaje kody, działa właściwa wersja aplikacji i przygotowano produkt z ustalonym zapasem.</p></div></section>\n<section class="definition-card validation" aria-labelledby="exit-title"><div class="definition-label">WARUNKI ZAKOŃCZENIA</div><h3 id="exit-title">Kryteria wyjścia</h3><p class="definition-text">Warunki określające, co trzeba osiągnąć, aby uznać daną czynność testową za zakończoną. Mogą dotyczyć pokrycia, wykonanych testów, ich wyników i otwartych defektów.</p><div class="definition-question"><strong>Pytanie pomocnicze</strong><p>„Czy osiągnęliśmy uzgodnione cele i możemy zakończyć testowanie?”</p></div><div class="definition-mini"><strong>Przykład — magazyn</strong><p>Wykonano uzgodnione sprawdzenia i spełniono wymagane kryteria dotyczące wyników oraz pozostałych defektów.</p></div></section>\n</div>\n<div class="definitioncopy"><p>Kryteria definiujemy podczas planowania, odpowiednio do celów i poziomu testów. Rozpoczęcie bez spełnienia kryteriów wejścia zwiększa ryzyko, koszt i trudność pracy. Niespełnienie kryteriów wyjścia wymaga przedstawienia statusu oraz uzgodnienia dalszych działań.</p></div>\n<div class="simple"><strong>Prostymi słowami</strong>Wejście → czy możemy sensownie zacząć? Wyjście → czy spełniliśmy warunki zakończenia?</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Ustal kryteria przed oceną wyników</h3><p>Kryteria mają być konkretne i sprawdzalne. Nie dobieraj ich dopiero na końcu tak, aby pasowały do otrzymanych rezultatów.</p></div>\n<div class="memory"><h3>Wykonanie testu i jego powodzenie to różne rzeczy</h3><p>Można wykonać wszystkie przypadki, a nie spełnić kryterium dotyczącego wyników testów krytycznych lub otwartych defektów.</p></div>\n<div class="memory"><h3>Koniec testowania nie dowodzi braku defektów</h3><p>Raportuj sprawdzony zakres, ograniczenia i pozostałe ryzyko. Spełnienie kryteriów nie jest gwarancją idealnego produktu.</p></div>\n<div class="memory"><h3>Brak czasu nie usuwa ryzyka</h3><p>Jeśli testowanie ma się zakończyć mimo niespełnienia części kryteriów, właściwi interesariusze muszą poznać i zaakceptować ryzyko. Tester dostarcza informacje do tej decyzji.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — wydawanie towaru z magazynu</h2></div>\n<div class="example"><h3>System nie może pozwolić na wydanie niedostępnego towaru</h3><p>Firma wdraża nową wersję aplikacji obsługiwanej skanerem kodów. Magazynier skanuje produkt, wpisuje ilość i zatwierdza wydanie. Zgodnie z wymaganiem nie wolno wydać więcej sztuk, niż jest dostępnych. Sprawdzenia dotyczą magazynu testowego.</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Przykładowe kryteria uzgodnione dla tego wdrożenia</caption><thead><tr><th scope="col">Wejścia — przed rozpoczęciem</th><th scope="col">Wyjścia — przed zakończeniem</th></tr></thead><tbody>\n<tr><td>Właściwa wersja działa na testowym skanerze.</td><td>Wykonano wszystkie zaplanowane testy przyjęcia i wydania towaru.</td></tr>\n<tr><td>Przygotowano konta, produkty i lokalizacje testowe.</td><td>Wszystkie uzgodnione scenariusze ochrony przed ujemnym stanem zakończyły się powodzeniem.</td></tr>\n<tr><td>Produkt ma 10 dostępnych sztuk; znane są zasady obsługi braku towaru.</td><td>Nie pozostały otwarte defekty krytyczne ani wysokiej ważności.</td></tr>\n<tr><td>Działają logowanie i odczyt kodu produktu.</td><td>Udokumentowano wyniki, pozostałe problemy i ryzyko.</td></tr>\n</tbody></table></div>\n<h3>Co robi tester?</h3><ol class="goal-examples">\n<li><h3>Sprawdza kryteria wejścia</h3><p>Potwierdza wersję, dostęp i przygotowanie danych. Jeżeli skaner nie rozpoznaje kodów, zgłasza przeszkodę. Testy zależne od skanowania są zablokowane; niezależne sprawdzenia mogą być kontynuowane, jeżeli ma to sens.</p></li>\n<li><h3>Wykonuje scenariusz wydania</h3><p>Przygotowuje 10 sztuk produktu. Wydaje 7 sztuk i sprawdza, że pozostały 3. Następnie próbuje wydać kolejne 4. Oczekuje odmowy, braku dokumentu skutecznego wydania i niezmienionego stanu 3 sztuk.</p></li>\n<li><h3>Zgłasza problem i ocenia kryteria wyjścia</h3><p>Aplikacja przyjmuje drugie wydanie i pokazuje −1 sztukę. Tester zapisuje kroki oraz dowody i zgłasza defekt. Kryterium poprawnego działania ochrony przed ujemnym stanem nie jest spełnione, nawet jeśli wszystkie przypadki zostały wykonane.</p></li>\n<li><h3>Po poprawce ponownie ocenia gotowość zakończenia</h3><p>Powtarza problematyczny scenariusz, sprawdza przyjęcie dostawy i wydanie całego zapasu w odpowiednim zakresie regresji. Aktualizuje wyniki i statusy zgłoszeń. Dopiero na tej podstawie ponownie porównuje stan testowania z kryteriami wyjścia.</p></li>\n</ol>\n<div class="failure"><p><b>Wniosek:</b> gotowy skaner, dane i aplikacja pozwalają rozpocząć testy. Samo wykonanie przypadków nie wystarcza do zakończenia zgodnie z planem, jeśli ważny warunek dotyczący wyników pozostaje niespełniony.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Kryteria wejścia określają gotowość do rozpoczęcia, a kryteria wyjścia — warunki zakończenia.</p></div>\n</div>\n', 'sections': 'sekcja 5.1.3'}, {'id': 25, 'number': '25', 'title': 'Plan testów — co zawiera i do czego służy?', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>Plan testów</strong> opisuje cele, zasoby i sposób organizacji testowania. Pomaga ustalić zakres pracy, odpowiedzialności, terminy oraz sposób oceny wyników. Służy komunikacji z zespołem i interesariuszami.</p>\n<p>Przygotowanie planu pozwala wcześniej rozważyć ryzyka, koszty, harmonogram i ograniczenia. Jego szczegółowość oraz forma powinny pasować do projektu.</p>\n<h3>Co zawiera plan testów?</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Typowe elementy planu</caption><thead><tr><th scope="col">Element</th><th scope="col">Co ustalamy?</th></tr></thead><tbody>\n<tr><th scope="row">Zakres i cele</th><td>Co testujemy, co pozostaje poza zakresem i po co wykonujemy testy.</td></tr>\n<tr><th scope="row">Podejście</th><td>Poziomy, typy, techniki, priorytety i potrzebne pokrycie.</td></tr>\n<tr><th scope="row">Zasoby i odpowiedzialności</th><td>Ludzie, narzędzia, środowiska, dane i podział zadań.</td></tr>\n<tr><th scope="row">Harmonogram i budżet</th><td>Terminy, nakład pracy, zależności i dostępne środki.</td></tr>\n<tr><th scope="row">Ryzyka, założenia i ograniczenia</th><td>Co może utrudnić pracę i na jakich założeniach oparto plan.</td></tr>\n<tr><th scope="row">Kryteria wejścia i wyjścia</th><td>Warunki rozpoczęcia oraz zakończenia.</td></tr>\n<tr><th scope="row">Komunikacja i rezultaty</th><td>Komu, jak i kiedy raportujemy oraz jakie materiały powstaną.</td></tr>\n</tbody></table></div>\n<div class="simple"><strong>Prostymi słowami</strong>Plan odpowiada na pytania: co chcemy osiągnąć, jak to sprawdzimy, kto się tym zajmie i czego potrzebujemy.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Plan nie jest listą przypadków testowych</h3><p>Określa organizację i podejście. Szczegółowe kroki oraz oczekiwane wyniki należą do przypadków testowych.</p></div>\n<div class="memory"><h3>Dopasuj plan do projektu</h3><p>Nie każda zmiana wymaga rozbudowanego dokumentu. Ważne są potrzebne ustalenia i ich dostępność dla zespołu.</p></div>\n<div class="memory"><h3>Aktualizuj ustalenia</h3><p>Zmiana zakresu, terminu lub dostępności środowiska może wymagać zmiany planu i ponownego uzgodnienia priorytetów.</p></div>\n<div class="memory"><h3>Planowanie ujawnia braki</h3><p>Może pokazać, że nie przygotowano danych, brakuje kompetencji albo termin zależy od dostawcy innego systemu.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — rezerwowanie książek w bibliotece</h2></div>\n<div class="example"><h3>Nowa funkcja: rezerwacja książki przez internet</h3><p>Biblioteka chce umożliwić czytelnikom rezerwowanie dostępnych książek, anulowanie i zapis do kolejki. Przy jednym wolnym egzemplarzu tylko jedna osoba może uzyskać rezerwację do odbioru; pozostałe trafiają do kolejki zgodnie z uzgodnioną regułą.</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Przykładowe ustalenia planu testów</caption><thead><tr><th scope="col">Element</th><th scope="col">Ustalenie dla biblioteki</th></tr></thead><tbody>\n<tr><th scope="row">Zakres</th><td>Rezerwacja, anulowanie i kolejka oczekujących. Poza zakresem: naliczanie kar.</td></tr>\n<tr><th scope="row">Cel i ryzyko</th><td>Sprawdzenie poprawności przydziału. Ryzyko: dwie osoby otrzymają rezerwację do odbioru tego samego egzemplarza.</td></tr>\n<tr><th scope="row">Dane i środowisko</th><td>Testowy katalog, konta czytelników, książki z zerową, jedną i kilkoma dostępnymi kopiami. Bez zmian w prawdziwych rezerwacjach.</td></tr>\n<tr><th scope="row">Podejście</th><td>Testy funkcjonalne, integracji z katalogiem oraz równoczesnych rezerwacji. Priorytet: pojedynczy dostępny egzemplarz.</td></tr>\n<tr><th scope="row">Harmonogram i zasoby</th><td>Przykładowo: tester, wsparcie programisty i bibliotekarza; trzy dni na wykonanie uzgodnionego zakresu, z zaplanowaną dostępnością katalogu i czasem na sprawdzenie poprawek. To założenie przykładu, nie standardowa wycena.</td></tr>\n<tr><th scope="row">Kryteria wejścia</th><td>Wdrożona wersja, działające logowanie i połączenie z katalogiem, uzgodnione reguły kolejki, przygotowane dane.</td></tr>\n<tr><th scope="row">Kryteria wyjścia</th><td>Zaplanowane testy wykonane, wszystkie scenariusze oznaczone jako krytyczne poprawne, pozostałe problemy i ryzyko udokumentowane.</td></tr>\n<tr><th scope="row">Raportowanie</th><td>Codzienny status, zgłoszenia defektów oraz podsumowanie wyników i ograniczeń dla zespołu i przedstawiciela biblioteki.</td></tr>\n</tbody></table></div>\n<h3>Co robi tester?</h3><ol class="goal-examples">\n<li><h3>Pomaga określić zakres i ryzyka</h3><p>Pyta o reguły przydziału i kolejki. Proponuje sprawdzenie dwóch równoczesnych prób rezerwacji jedynego egzemplarza oraz skutków anulowania.</p></li>\n<li><h3>Ustala potrzeby i szacuje pracę</h3><p>Wskazuje konta, dane i dostęp do testowego katalogu. Rozbija pracę na przygotowanie, wykonanie i sprawdzenie poprawek, a oszacowanie uzgadnia z zespołem.</p></li>\n<li><h3>Zgłasza zależności i aktualizuje plan</h3><p>Jeśli dostawca katalogu przesuwa dostępność środowiska, tester opisuje wpływ na testy integracyjne. Zespół uzgadnia zmianę harmonogramu lub inne działania. Symulacja katalogu może pomóc w części sprawdzeń, ale nie zastąpi sprawdzenia rzeczywistej integracji.</p></li>\n<li><h3>Przekazuje wyniki w uzgodniony sposób</h3><p>Informuje o wykonanym zakresie, defektach i kryteriach zakończenia. Na koniec pokazuje także, czego nie sprawdzono i jakie ryzyko pozostało.</p></li>\n</ol>\n<div class="failure"><p><b>Wniosek:</b> przed klikaniem w aplikacji zespół wie, co sprawdzić, jakich danych potrzebuje i od czego zależy termin. Plan jest podstawą organizacji pracy i rozmowy o zmianach.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Plan testów ustala, co chcemy osiągnąć, jak to sprawdzimy i czego potrzebujemy.</p></div>\n</div>\n', 'sections': 'sekcje 5.1.1 i 5.1.2'}, {'id': 26, 'number': '26', 'title': 'Proces testowy od początku do końca', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>Proces testowy</strong> to zbiór powiązanych czynności, które pomagają osiągnąć cele testowania: od zaplanowania pracy, przez przygotowanie i wykonanie testów, po ocenę wyników i zakończenie.</p>\n<p>Nie jest to sztywna kolejka kroków. Czynności mogą się powtarzać, nakładać i przebiegać równolegle. Monitorowanie i nadzór towarzyszą pracy przez cały proces.</p>\n<h3>Siedem grup czynności</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Pytania i zadania w procesie testowym</caption><thead><tr><th scope="col">Czynność</th><th scope="col">Najważniejsze pytanie</th><th scope="col">Co obejmuje?</th></tr></thead><tbody>\n<tr><th scope="row">1. Planowanie testów</th><td>Co chcemy osiągnąć?</td><td>Cele, podejście, zakres, zasoby i harmonogram.</td></tr>\n<tr><th scope="row">2. Monitorowanie i nadzór nad testami</th><td>Czy realizujemy plan?</td><td>Porównywanie postępu z planem i podejmowanie działań korygujących.</td></tr>\n<tr><th scope="row">3. Analiza testów</th><td>Co testować?</td><td>Ocena podstawy testów, określenie warunków testowych i priorytetów.</td></tr>\n<tr><th scope="row">4. Projektowanie testów</th><td>Jak testować?</td><td>Opracowanie przypadków oraz wymagań dotyczących danych i środowiska.</td></tr>\n<tr><th scope="row">5. Implementacja testów</th><td>Czy wszystko jest przygotowane?</td><td>Przygotowanie danych, procedur, skryptów, zestawów i środowiska.</td></tr>\n<tr><th scope="row">6. Wykonywanie testów</th><td>Czy wyniki są zgodne z oczekiwaniami?</td><td>Uruchamianie testów, porównywanie wyników i zgłaszanie niezgodności.</td></tr>\n<tr><th scope="row">7. Zakończenie testów</th><td>Co ustaliliśmy i co przekazujemy dalej?</td><td>Raport, obsługa otwartych problemów, zachowanie materiałów i wnioski.</td></tr>\n</tbody></table></div>\n<div class="simple"><strong>Ważne rozróżnienie</strong>Implementacja testów oznacza przygotowanie ich do wykonania — nie implementację funkcji aplikacji.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Testowanie to więcej niż wykonywanie testów</h3><p>Przygotowanie, analiza wyników i podsumowanie również należą do procesu.</p></div>\n<div class="memory"><h3>Analiza: co? Projektowanie: jak?</h3><p>Najpierw określasz, co wymaga sprawdzenia, następnie opracowujesz sposób oraz oczekiwane wyniki.</p></div>\n<div class="memory"><h3>Wracaj do wcześniejszych czynności, gdy potrzeba</h3><p>Nowe wymaganie lub odkryty problem może wymagać zmiany analizy, przypadków, danych i planu. Monitorowanie i nadzór nie kończą się przed wykonaniem testów.</p></div>\n<div class="memory"><h3>Zakończenie nie oznacza braku defektów</h3><p>Przekaż informacje o wynikach, otwartych problemach i pozostałym ryzyku. Zachowaj materiały przydatne w przyszłości.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — aplikacja do zgłaszania usterek w mieście</h2></div>\n<div class="example"><h3>Zgłoszenie niedziałającej latarni</h3><p>Mieszkaniec ma móc wskazać lokalizację, opisać problem i dodać zdjęcie. Po wysłaniu powinien otrzymać numer zapisanego zgłoszenia. Tester korzysta ze środowiska testowego i fikcyjnych zgłoszeń, nie wysyła ich do rzeczywistych służb.</p>\n<h3>Co robi tester w całym procesie?</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Jedna funkcja — przykład każdej grupy czynności</caption><thead><tr><th scope="col">Czynność</th><th scope="col">Przykład działania</th></tr></thead><tbody>\n<tr><th scope="row">Planowanie</th><td>Pomaga ustalić zakres: tworzenie zgłoszenia i potwierdzenie. Wskazuje ryzyko utraty zgłoszenia oraz potrzebę testowego konta i środowiska.</td></tr>\n<tr><th scope="row">Monitorowanie i nadzór</th><td>Informuje, że niedostępna usługa zdjęć blokuje część testów. Zespół uzgadnia zmianę kolejności sprawdzeń i dalsze działania. Status jest aktualizowany także podczas kolejnych czynności.</td></tr>\n<tr><th scope="row">Analiza</th><td>Zauważa brak limitu wielkości zdjęcia. Prosi o wyjaśnienie i wskazuje obszary do sprawdzenia: lokalizację, załącznik i zapis zgłoszenia.</td></tr>\n<tr><th scope="row">Projektowanie</th><td>Tworzy przypadki dla poprawnego zgłoszenia, brakującej lokalizacji, za dużego zdjęcia i przerwanego połączenia. Określa oczekiwane wyniki na podstawie uzgodnionych wymagań.</td></tr>\n<tr><th scope="row">Implementacja</th><td>Przygotowuje pliki zdjęć o odpowiednich rozmiarach, konta, dane i zestaw testów. Sprawdza gotowość środowiska.</td></tr>\n<tr><th scope="row">Wykonywanie</th><td>Wysyła testowe zgłoszenie. Odkrywa, że aplikacja pokazuje sukces, ale nie zapisuje usterki. Dokumentuje niezgodność. Po poprawce sprawdza naprawę i odpowiednią regresję.</td></tr>\n<tr><th scope="row">Zakończenie</th><td>Podsumowuje wyniki, pozostałe problemy i ryzyko. Otwarte kwestie przekazuje do dalszej obsługi, zachowuje przydatne testy, porządkuje środowisko do uzgodnionego stanu i zapisuje wnioski na kolejne wydanie.</td></tr>\n</tbody></table></div>\n<h3>Jakie materiały pozostają po pracy?</h3><p>Przykładowo: uzgodniony plan, warunki i przypadki testowe, przygotowane dane, wyniki wykonań, zgłoszenia defektów oraz raport końcowy. Powiązania między wymaganiami, testami i wynikami pomagają pokazać, co sprawdzono.</p>\n<div class="failure"><p><b>Przykładowy problem:</b> komunikat o sukcesie bez zapisanego zgłoszenia nie spełnia wymagania. Tester zapisuje kroki, dane, wersję aplikacji, oczekiwane trwałe zapisanie zgłoszenia z unikalnym numerem i rzeczywisty rezultat, dołączając dowody.</p></div>\n<p class="report"><strong>Odpowiedzialność:</strong> podział zadań zależy od zespołu. Tester nie musi sam zarządzać całym procesem ani samodzielnie podejmować decyzji o wydaniu.</p>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Zaplanuj, ustal co i jak sprawdzić, przygotuj testy, wykonaj je i podsumuj — przez cały czas obserwując postęp i ryzyko.</p></div>\n</div>\n', 'sections': 'sekcje 1.4.1, 1.4.3 i 1.4.5'}, {'id': 27, 'number': '27', 'title': 'Analiza testów a projektowanie testów', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Dwie osobne definicje</h2></div>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="analysis-title"><div class="definition-label">CO TESTOWAĆ?</div><h3 id="analysis-title">Analiza testów</h3><p class="definition-text">Polega na badaniu podstawy testów, np. wymagań, aby określić warunki testowe, ocenić testowalność i wskazać priorytety z uwzględnieniem ryzyka.</p><div class="definition-question"><strong>Pytanie pomocnicze</strong><p>„Jakie zachowania i reguły wymagają sprawdzenia?”</p></div><div class="definition-mini"><strong>Przykład — adres przesyłki</strong><p>Tester ustala, że trzeba sprawdzić zakaz zmiany adresu po wydaniu paczki do doręczenia.</p></div></section>\n<section class="definition-card validation" aria-labelledby="design-title"><div class="definition-label">JAK TESTOWAĆ?</div><h3 id="design-title">Projektowanie testów</h3><p class="definition-text">Polega na przekształcaniu warunków testowych w przypadki testowe i inne materiały. Obejmuje dobór danych, oczekiwanych wyników oraz określenie potrzeb dotyczących środowiska.</p><div class="definition-question"><strong>Pytanie pomocnicze</strong><p>„Jak konkretnie sprawdzimy wybrane zachowanie?”</p></div><div class="definition-mini"><strong>Przykład — adres przesyłki</strong><p>Tester opisuje przypadek dla przesyłki wydanej do doręczenia: dane adresowe, próbę zmiany i oczekiwaną odmowę.</p></div></section>\n</div>\n<div class="simple"><strong>Prostymi słowami</strong>Analiza wskazuje, co sprawdzić. Projektowanie przekłada to na konkretne testy.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Warunek testowy to jeszcze nie cały przypadek</h3><p>„Odmowa zmiany po wydaniu paczki” określa obszar sprawdzenia. Przypadek zawiera już warunki wstępne, dane, działania i oczekiwania.</p></div>\n<div class="memory"><h3>Wyjaśniaj niejasności w wymaganiach</h3><p>Nie wymyślaj samodzielnie reguły biznesowej, aby uzyskać oczekiwany wynik. Zapisz pytanie i uzgodnij zachowanie z właściwą osobą.</p></div>\n<div class="memory"><h3>Obie czynności mogą się przeplatać</h3><p>Podczas projektowania możesz odkryć nową niejasność lub brakujący warunek i wrócić do analizy.</p></div>\n<div class="memory"><h3>Projektowanie różni się od przygotowania i wykonania</h3><p>Określenie potrzebnych danych i środowiska należy do projektowania. Ich utworzenie to implementacja testów, a użycie podczas sprawdzenia — wykonywanie testów.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — zmiana adresu dostawy przesyłki</h2></div>\n<div class="example"><h3>Kiedy odbiorca może zmienić adres?</h3><p>Firma kurierska dodaje zmianę adresu w aplikacji. W tym projekcie odbiorca może zmienić adres <strong>przed wydaniem paczki do doręczenia</strong>. Później system powinien odmówić. To reguła przykładowego projektu, a nie opis usług konkretnej firmy.</p>\n<h3>Co robi tester podczas analizy?</h3><p>Czyta wymagania i wskazuje warunki testowe:</p>\n<ul class="list"><li>zmiana adresu przed wydaniem paczki do doręczenia,</li><li>odmowa zmiany po wydaniu,</li><li>odrzucenie niekompletnego adresu,</li><li>zapis nowego adresu i przekazanie go do systemu obsługującego dostawy,</li><li>brak możliwości zmiany adresu cudzej przesyłki.</li></ul>\n<p>Zauważa też niejasność: <strong>co, jeśli status paczki zmieni się właśnie podczas zapisywania adresu?</strong> Zapisuje pytanie do zespołu, zamiast zakładać odpowiedź. Powstaje lista tego, co należy przetestować.</p>\n<h3>Co robi tester podczas projektowania?</h3><p>Dla warunku „odmowa zmiany po wydaniu paczki” opracowuje konkretny przypadek:</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Przypadek testowy — zakaz zmiany adresu</caption><thead><tr><th scope="col">Element</th><th scope="col">Ustalenie</th></tr></thead><tbody>\n<tr><th scope="row">Warunki wstępne</th><td>Zalogowany odbiorca. Jego testowa przesyłka ma status „Wydana do doręczenia”.</td></tr>\n<tr><th scope="row">Dane</th><td>Dotychczasowy adres: Leśna 10. Nowy, poprawny adres: Leśna 20, w tym samym mieście. Pozostałe wymagane dane adresowe są kompletne.</td></tr>\n<tr><th scope="row">Kroki</th><td>Otwórz przesyłkę i spróbuj zapisać nowy adres przy użyciu dostępnego mechanizmu zmiany.</td></tr>\n<tr><th scope="row">Oczekiwany wynik</th><td>System odmawia zmiany i wyjaśnia przyczynę. W danych przesyłki pozostaje Leśna 10; do obsługi dostawy nie trafia nowy adres.</td></tr>\n<tr><th scope="row">Potrzeby dotyczące środowiska</th><td>Możliwość przygotowania przesyłki z odpowiednim statusem i sprawdzenia zapisanych danych oraz komunikacji z obsługą dostawy.</td></tr>\n</tbody></table></div>\n<p>Jeżeli interfejs ukrywa możliwość edycji po wydaniu paczki, tester uwzględnia to w projekcie testu. Osobno może zaprojektować kontrolowane sprawdzenie odrzucenia żądania zmiany przez API, jeśli taki mechanizm występuje. Ukrycie przycisku nie dowodzi samo w sobie ochrony danych.</p>\n<div class="failure"><p><b>Wniosek:</b> analiza określiła potrzebę sprawdzenia zakazu. Projektowanie opisało konkretny stan, dane, działania i wynik. Dopiero później tester przygotuje te dane i wykona test na środowisku testowym.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Analiza wskazuje, co sprawdzić. Projektowanie przekłada to na konkretne testy.</p></div>\n</div>\n', 'sections': 'sekcja 1.4.1'}, {'id': 28, 'number': '28', 'title': 'Śledzenie powiązań między wymaganiami, testami i defektami', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>Śledzenie powiązań (traceability)</strong> polega na ustanawianiu i utrzymywaniu zależności między elementami podstawy testów, np. wymaganiami, a warunkami testowymi, przypadkami testowymi, wynikami oraz defektami.</p>\n<div class="definitioncopy"><p><strong>Podstawa testów</strong> to materiały i informacje wykorzystywane do analizy i projektowania testów, np. wymagania, historyjki użytkownika i kryteria akceptacji. Powiązania pozwalają przejść od wymagania do sprawdzających je testów i wyników, a także od testu lub zgłoszenia defektu wrócić do wymagania.</p><p>Pomagają oceniać pokrycie, analizować wpływ zmian, dobierać regresję oraz przedstawiać postęp i jakość w zrozumiały sposób. Wspierają również audyty. Jedno wymaganie może potrzebować wielu testów, a jeden test może sprawdzać kilka wymagań. Powiązania można utrzymywać w narzędziu lub prostej tabeli.</p></div>\n<div class="simple"><strong>Prostymi słowami</strong>Wiemy, dlaczego powstał dany test, co sprawdza i jakiego wymagania dotyczy jego wynik.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Powiązanie nie oznacza wykonania</h3><p>Przypisany przypadek testowy pokazuje, jak planujemy sprawdzić wymaganie. Dopiero wynik konkretnego wykonania mówi, co wydarzyło się w danej wersji i środowisku.</p></div>\n<div class="memory"><h3>Pokrycie nie oznacza spełnienia wymagania</h3><p>Test może zostać wykonany i zakończyć się niepowodzeniem. Wysokie pokrycie nie jest dowodem braku defektów ani kompletności zaprojektowanych testów.</p></div>\n<div class="memory"><h3>Aktualizuj powiązania po zmianach</h3><p>Po zmianie wymagania sprawdź powiązane warunki, przypadki i dane. Zachowuj kontekst wyników: wersję produktu, środowisko oraz konkretne wykonanie.</p></div>\n<div class="memory"><h3>Używaj powiązań w obie strony</h3><p>Od wymagania przejdź do testów i defektów. Od defektu wróć do wyniku testu i reguły, której problem dotyczy. To pomaga ocenić wpływ problemu.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — rezerwacja wizyty w warsztacie</h2></div>\n<div class="example"><h3>Anulowana wymiana opon nadal blokuje termin</h3><p>Warsztat udostępnia internetową rezerwację wymiany opon. Przyjmujemy, że jeden termin jest przeznaczony dla jednego klienta. Potwierdzona rezerwacja zajmuje termin, a jej skuteczne anulowanie ponownie go udostępnia. Tester korzysta ze środowiska testowego i fikcyjnych klientów.</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Powiązania w przykładowym wykonaniu testów</caption><thead><tr><th scope="col">Wymaganie</th><th scope="col">Powiązany test</th><th scope="col">Wynik i defekt</th></tr></thead><tbody>\n<tr><th scope="row">R1: Potwierdzona rezerwacja zajmuje wybrany termin.</th><td>T1: Zarezerwuj wolny termin. W oddzielnej sesji innego klienta sprawdź dostępność i spróbuj zarezerwować ten sam termin.</td><td>Zaliczone: termin jest zajęty; druga rezerwacja nie powstaje.</td></tr>\n<tr><th scope="row">R2: Anulowanie rezerwacji ponownie udostępnia termin.</th><td>T2: Przygotuj potwierdzoną rezerwację, anuluj ją i spróbuj zarezerwować zwolniony termin jako inny klient.</td><td>Niezaliczone: anulowanie jest zapisane, ale termin pozostaje zajęty. Zgłoszenie D1.</td></tr>\n</tbody></table></div>\n<h3>Co robi tester?</h3><ol class="goal-examples">\n<li><h3>Łączy wymagania z testami</h3><p>Przypisuje T1 do R1, a T2 do R2. Sprawdza, czy zaplanowane testy odpowiadają treści wymagań. Ta tabela pokazuje wybrany fragment zakresu, a nie pełny zestaw testów rezerwacji.</p></li>\n<li><h3>Zapisuje wyniki konkretnego wykonania</h3><p>Przy wyniku podaje wersję aplikacji, środowisko i dane testowe. Dla T2 zachowuje identyfikator anulowanej rezerwacji, wybrany termin oraz dowody, że termin nadal jest zajęty.</p></li>\n<li><h3>Wiąże defekt z testem i wymaganiem</h3><p>Zgłasza D1: „Termin pozostaje zajęty po anulowaniu wizyty”. Łączy zgłoszenie z niezaliczonym wykonaniem T2 i wymaganiem R2. Zespół widzi, jakiej reguły dotyczy problem i że inni klienci nie mogą wykorzystać zwolnionego terminu.</p></li>\n<li><h3>Wykorzystuje powiązania po poprawce i zmianach</h3><p>Po poprawce wykonuje T2 ponownie jako testowanie potwierdzające. Dobiera również regresję, np. T1, aby sprawdzić, czy nadal nie można zająć już zarezerwowanego terminu. Powiązania są punktem wyjścia; zakres regresji zależy także od analizy wpływu i ryzyka.</p></li>\n</ol>\n<div class="failure"><p><b>Ważne:</b> oba pokazane wymagania mają przypisany i wykonany test: 2 z 2. Nie oznacza to spełnienia obu wymagań — T2 nie został zaliczony. Te liczby nie dowodzą też pełnego pokrycia wszystkich zachowań aplikacji.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Każdy test powinien mieć uzasadnienie, a jego wynik dać się powiązać z tym, co sprawdzamy.</p></div>\n</div>\n', 'sections': 'sekcja 1.4.4'}, {'id': 29, 'number': '29', 'title': 'Testalia — produkty pracy w testowaniu', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>Testalia (testware)</strong> to produkty pracy powstające podczas procesu testowego, potrzebne do planowania, projektowania, przygotowywania, wykonywania i podsumowywania testów.</p>\n<div class="definitioncopy"><p>Obejmują dokumenty, dane, skrypty, wyniki oraz przygotowane na potrzeby testowania elementy środowiska. Ich forma i szczegółowość zależą od projektu. Mogą być zapisane w narzędziu do zarządzania testami, repozytorium kodu albo prostym pliku. Nie każdy element wymaga osobnego dokumentu.</p><p>Testalia pomagają organizować pracę, powtarzać sprawdzenia i przekazywać informacje o jakości. Warto utrzymywać ich powiązania z wymaganiami oraz zachowywać kontekst wyników: wersję aplikacji, środowisko i konkretne wykonanie.</p></div>\n<div class="simple"><strong>Prostymi słowami</strong>Testalia to materiały, które przygotowujemy podczas testowania, aby przeprowadzić sprawdzenia, zapisać wyniki i wykorzystać je później.</div>\n<h3 style="margin-top:24px">Najważniejsze pojęcia</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Co oznaczają poszczególne materiały?</caption><thead><tr><th scope="col">Pojęcie</th><th scope="col">Znaczenie</th></tr></thead><tbody>\n<tr><th scope="row">Warunek testowy</th><td>Aspekt przedmiotu testów, który można sprawdzić, np. zgodność miejsca w rezerwacji i na karcie pokładowej.</td></tr>\n<tr><th scope="row">Przypadek testowy</th><td>Opis sprawdzenia obejmujący warunki wstępne, dane wejściowe, działania, oczekiwane wyniki i — gdy mają zastosowanie — warunki końcowe.</td></tr>\n<tr><th scope="row">Dane testowe</th><td>Dane potrzebne do wykonania testu, np. fikcyjny pasażer, rezerwacja i dostępne miejsce.</td></tr>\n<tr><th scope="row">Procedura testowa</th><td>Ustalona kolejność wykonania testów oraz potrzebnych działań przygotowawczych i końcowych.</td></tr>\n<tr><th scope="row">Skrypt testowy</th><td>Instrukcje wykonania testu. Mogą być przeznaczone dla człowieka lub zapisane jako kod wykonywany automatycznie.</td></tr>\n<tr><th scope="row">Wynik wykonania testu</th><td>Zapis rezultatu konkretnego wykonania, uwzględniający obserwacje i ocenę względem oczekiwań. Ten sam przypadek może mieć wiele wyników z różnych wykonań.</td></tr>\n<tr><th scope="row">Zgłoszenie defektu</th><td>Opis wykrytego problemu, zawierający informacje potrzebne do jego zrozumienia i dalszej analizy, np. kroki, dane, oczekiwany i rzeczywisty wynik oraz dowody.</td></tr>\n</tbody></table></div>\n<h3>Jakie testalia powstają w procesie?</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Przykłady produktów pracy według czynności testowych</caption><thead><tr><th scope="col">Czynność</th><th scope="col">Przykładowe testalia</th></tr></thead><tbody>\n<tr><th scope="row">Planowanie</th><td>Plan, harmonogram, rejestr ryzyka, kryteria wejścia i wyjścia.</td></tr>\n<tr><th scope="row">Monitorowanie i nadzór</th><td>Raporty postępu, informacje o ryzyku i zapis działań korygujących.</td></tr>\n<tr><th scope="row">Analiza</th><td>Warunki testowe z priorytetami i zgłoszenia defektów podstawy testów.</td></tr>\n<tr><th scope="row">Projektowanie</th><td>Przypadki, karty testów eksploracyjnych, wymagania dotyczące danych i środowiska.</td></tr>\n<tr><th scope="row">Implementacja</th><td>Dane, procedury, skrypty, zestawy testów i przygotowane elementy środowiska.</td></tr>\n<tr><th scope="row">Wykonywanie</th><td>Dzienniki i wyniki wykonania oraz zgłoszenia defektów.</td></tr>\n<tr><th scope="row">Zakończenie</th><td>Raport podsumowujący, propozycje usprawnień i udokumentowane wnioski.</td></tr>\n</tbody></table></div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Testalia to więcej niż przypadki</h3><p>Należą do nich także dane, skrypty, wyniki, raporty i materiały przygotowane na potrzeby środowiska testowego.</p></div>\n<div class="memory"><h3>Opis testu i wynik to różne materiały</h3><p>Przypadek opisuje sprawdzenie. Wynik dokumentuje konkretne wykonanie. Po ponownym teście zachowaj nowy wynik wraz z jego kontekstem.</p></div>\n<div class="memory"><h3>Skrypt nie musi być automatyczny</h3><p>Może zawierać instrukcje dla testera. Skrypt automatyczny zapisuje działania w formie wykonywanej przez narzędzie.</p></div>\n<div class="memory"><h3>Aktualizuj i zachowuj przydatne materiały</h3><p>Po zmianie wymagań sprawdź przypadki, dane i skrypty. Materiały przydatne w przyszłości uporządkuj i przekaż lub zarchiwizuj, np. do regresji.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — odprawa online przed podróżą samolotem</h2></div>\n<div class="example"><h3>Wybrane miejsce 12A, ale na karcie pokładowej jest 18C</h3><p>Pasażer wybiera dostępne miejsce <strong>12A przy oknie</strong>. Aplikacja potwierdza wybór. Po zakończeniu odprawy na karcie pokładowej widnieje jednak <strong>18C</strong>.</p><p><strong>Wymaganie w tym projekcie:</strong> potwierdzone miejsce ma być zgodnie zapisane w rezerwacji i na karcie pokładowej. Zakładamy brak późniejszej zmiany samolotu lub operacyjnej zmiany miejsca. Tester używa środowiska testowego i fikcyjnej rezerwacji; nie odprawia prawdziwego pasażera.</p>\n<h3>Co robi tester i jakie testalia powstają?</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Od przygotowania do zgłoszenia problemu</caption><thead><tr><th scope="col">Działanie testera</th><th scope="col">Powstające testalia</th></tr></thead><tbody>\n<tr><th scope="row">Wskazuje ryzyko otrzymania karty z miejscem innym niż potwierdzone.</th><td>Wpis w rejestrze ryzyka.</td></tr>\n<tr><th scope="row">Określa potrzebę sprawdzenia zgodności wybranego miejsca, rezerwacji i karty.</th><td>Warunek testowy.</td></tr>\n<tr><th scope="row">Opisuje wybór 12A, potwierdzenie, zakończenie odprawy i porównanie danych. Oczekuje wszędzie 12A.</th><td>Przypadek testowy z oczekiwanym wynikiem.</td></tr>\n<tr><th scope="row">Przygotowuje fikcyjnego pasażera, rezerwację dostępną do odprawy i lot z wolnym miejscem 12A.</th><td>Dane testowe.</td></tr>\n<tr><th scope="row">Przygotowuje kolejność działań i sposób przywrócenia rezerwacji oraz dostępności miejsca przed kolejnym wykonaniem.</th><td>Procedura testowa.</td></tr>\n<tr><th scope="row">Wykonuje test: potwierdzenie i rezerwacja wskazują 12A, ale karta pokazuje 18C. Zapisuje identyfikator wykonania, wersję aplikacji i dowody.</th><td>Wynik wykonania i dowody.</td></tr>\n<tr><th scope="row">Zgłasza rozbieżność z krokami, danymi oraz oczekiwanym i rzeczywistym wynikiem. Nie zakłada przyczyny bez analizy.</th><td>Zgłoszenie defektu powiązane z testem i wymaganiem.</td></tr>\n</tbody></table></div>\n<h3>Co dzieje się po poprawce?</h3>\n<p>Programista informuje, że poprawił problem z miejscem na karcie pokładowej. Tester musi sprawdzić, czy naprawa działa.</p>\n<ol class="goal-examples">\n<li><h3>Przygotowuje ponownie warunki testu</h3><p>Korzysta z fikcyjnej rezerwacji przed odprawą i upewnia się, że miejsce <strong>12A</strong> jest dostępne.</p></li>\n<li><h3>Powtarza sprawdzenie, które wcześniej ujawniło problem</h3><p>Wybiera 12A, potwierdza wybór, kończy odprawę i otwiera kartę pokładową.</p></li>\n<li><h3>Porównuje wyniki</h3><p>W potwierdzeniu wyboru, rezerwacji i na karcie powinno widnieć <strong>12A</strong>. Jeśli karta nadal pokazuje 18C, zgłasza, że problem pozostał. To <strong>testowanie potwierdzające</strong> — sprawdzenie konkretnej naprawy.</p></li>\n<li><h3>Zapisuje nowy wynik</h3><p>Dokumentuje rezultat, wersję aplikacji i dowody. Zachowuje wcześniejszy wynik, aby było wiadomo, kiedy problem występował i co wykazało ponowne sprawdzenie.</p></li>\n<li><h3>Sprawdza, czy poprawka nie spowodowała innych problemów</h3><p>Na przykład w osobnym teście wybiera 12A, następnie zmienia je na dostępne <strong>14F</strong> i kończy odprawę. Sprawdza, czy rezerwacja i karta pokazują już 14F. To przykład <strong>testowania regresji</strong>, jeśli aplikacja obsługuje taką zmianę.</p></li>\n</ol>\n<p class="note"><strong>Zapamiętaj:</strong> najpierw sprawdzamy, czy naprawiono zgłoszony problem, a następnie — czy zmiana nie pogorszyła innych zachowań aplikacji.</p>\n<div class="failure"><h3>Ten sam test — cztery różne rodzaje materiałów</h3>\n<ul class="list">\n<li><strong>Przypadek testowy opisuje, jak przeprowadzić sprawdzenie i czego oczekiwać.</strong> Przykład: wybierz 12A, zakończ odprawę i sprawdź, czy rezerwacja oraz karta pokładowa wskazują 12A. Określa też potrzebne warunki początkowe i dane.</li>\n<li><strong>Dane testowe pozwalają wykonać ten przypadek.</strong> W przykładzie są to fikcyjny pasażer, jego rezerwacja dostępna do odprawy i lot z wolnym miejscem 12A.</li>\n<li><strong>Wynik wykonania pokazuje, co rzeczywiście wydarzyło się podczas konkretnego testu.</strong> Przykład: w rezerwacji zapisano 12A, ale karta pokładowa pokazała 18C — test niezaliczony. Wynik zapisujemy również wtedy, gdy test przejdzie poprawnie.</li>\n<li><strong>Zgłoszenie defektu przekazuje zespołowi opis wykrytego problemu.</strong> W tym przypadku opisuje rozbieżność 12A/18C, warunki i kroki jej odtworzenia, oczekiwany oraz rzeczywisty wynik i dołączone dowody. Może odwoływać się do przypadku i zapisanego wyniku wykonania.</li>\n</ul>\n<p><b>Zapamiętaj:</b> przed testem przygotowujesz opis sprawdzenia i dane. Podczas wykonania zapisujesz wynik. Jeśli wykryjesz problem, dokumentujesz go zgodnie z procesem zespołu. Wszystkie te materiały są testaliami.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Testalia pozwalają przygotować sprawdzenie, odtworzyć problem i udokumentować wynik.</p></div>\n</div>\n', 'sections': 'sekcja 1.4.3'}, {'id': 30, 'number': '30', 'title': 'Siedem zasad testowania', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Siedem zasad i ich znaczenie</h2></div>\n<p class="lead"><strong>Zasady testowania</strong> to ogólne wskazówki pomagające podejmować decyzje o zakresie, sposobie i interpretacji wyników testów.</p>\n<ol class="goal-examples" aria-label="Siedem zasad testowania">\n<li><h3>Testowanie ujawnia defekty, ale nie dowodzi ich braku</h3><p>Brak znalezionych problemów nie potwierdza bezbłędności produktu. Wyniki dotyczą sprawdzonego zakresu.</p></li>\n<li><h3>Testowanie wyczerpujące jest niemożliwe</h3><p>Poza trywialnymi przypadkami nie sprawdzimy wszystkiego. Dobieramy testy według ryzyka, priorytetów i technik.</p></li>\n<li><h3>Wczesne testowanie oszczędza czas i pieniądze</h3><p>Wczesne usunięcie defektu ogranicza późniejsze poprawki. Zaczynamy możliwie wcześnie, statycznie i dynamicznie.</p></li>\n<li><h3>Defekty występują w skupiskach</h3><p>Niewielka część komponentów często skupia większość wykrytych defektów lub odpowiada za większość awarii.</p></li>\n<li><h3>Testy ulegają zużyciu</h3><p>Te same testy coraz słabiej wykrywają nowe defekty. Rozwijamy je, zachowując przydatną regresję.</p></li>\n<li><h3>Testowanie zależy od kontekstu</h3><p>Podejście dobieramy do produktu, użytkowników, ryzyka i warunków używania. Nie istnieje uniwersalny zestaw testów.</p></li>\n<li><h3>Przekonanie o braku defektów jest błędne</h3><p>Zgodność z wymaganiami nie zapewnia sukcesu produktu. Potrzebna jest także walidacja rzeczywistych potrzeb interesariuszy.</p></li>\n</ol>\n<div class="simple"><strong>Prostymi słowami</strong>Testuj świadomie: wybieraj ważne sprawdzenia i oceniaj znaczenie wyników dla użytkownika.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Zasada 1 i zasada 7 dotyczą różnych wniosków</h3><p>Pierwsza: po zaliczonych testach nie ogłaszaj, że nie ma defektów. Siódma: nawet poprawnie zrealizowana specyfikacja może opisywać rozwiązanie, które nie pomaga pasażerowi w podróży.</p></div>\n<div class="memory"><h3>Skupiska pomagają wybierać kolejne sprawdzenia</h3><p>Jeśli problemy powracają przy zmianach bramki, sprawdź dokładniej pobieranie i prezentację tych zmian. Nie pomijaj przy tym innych ważnych obszarów.</p></div>\n<div class="memory"><h3>Rozwijanie testów nie oznacza usunięcia regresji</h3><p>Zachowaj sprawdzenie podstawowego wyświetlenia lotu, ale dodaj nowe sytuacje, np. zmianę bramki podczas przerwy w połączeniu.</p></div>\n<div class="memory"><h3>Przykład opisuje konkretny projekt</h3><p>Wymagania aplikacji podróżnej trzeba uzgodnić z zespołem. Poniższy scenariusz nie opisuje zasad działania wszystkich linii lotniczych ani lotnisk.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — zmiana bramki przed odlotem</h2></div>\n<div class="example"><h3>Pasażer czeka przy bramce 12, a lot przeniesiono do bramki 24</h3><p>Zespół tworzy aplikację z informacjami o podróży. W pierwszej wersji wymagania przewidują pobranie aktualnej bramki po otwarciu ekranu lotu lub ręcznym odświeżeniu. Nie przewidują automatycznego powiadomienia o zmianie.</p><p>Tester używa fikcyjnego lotu i kontrolowanego źródła danych w środowisku testowym. Może zmienić bramkę z <strong>12 na 24</strong>, opóźnić odpowiedź oraz przerwać połączenie. Nie zmienia danych prawdziwego lotu.</p>\n<h3>Jak tester stosuje każdą zasadę?</h3>\n<ol class="goal-examples" aria-label="Siedem zasad w przykładzie podróży">\n<li><h3>Nie utożsamia zaliczonych testów z brakiem problemów</h3><p>Otworzył ekran i poprawnie zobaczył bramkę 12. W raporcie zapisuje, co sprawdził. Nie stwierdza, że cała obsługa zmian bramki działa — nie sprawdził jeszcze aktualizacji ani utraty połączenia.</p></li>\n<li><h3>Wybiera sprawdzenia zamiast wszystkich kombinacji</h3><p>Nie próbuje sprawdzić każdego lotu na każdym telefonie. Wybiera ważne sytuacje: zmiana 12 na 24, odświeżenie przy braku internetu, odzyskanie połączenia i opóźniona odpowiedź. Uwzględnia obsługiwane urządzenia oraz ryzyko pokazania starej informacji.</p></li>\n<li><h3>Wyjaśnia reguły przed wdrożeniem</h3><p>Już podczas przeglądu wymagań zauważa brak opisu sytuacji bez internetu. Pyta, jak pasażer rozpozna, że informacja jest nieaktualna. Zespół uzgadnia oznaczenie braku połączenia i czas ostatniej aktualizacji, zanim powstanie ekran.</p></li>\n<li><h3>Korzysta z informacji o skupiskach defektów</h3><p>W tym przykładowym projekcie kolejne problemy dotyczą zapisu i odświeżania bramki. Tester rozszerza sprawdzenia tego obszaru, np. o starszą odpowiedź serwera przychodzącą po nowszej. Nadal uwzględnia inne istotne funkcje.</p></li>\n<li><h3>Rozwija dotychczasowe testy</h3><p>Dotąd test zaczynał się od lotu, którego bramka się nie zmieniała. Tester zachowuje ten test, ale dodaje zmianę bramki przy już otwartym ekranie, ponowne odświeżenie i odzyskanie połączenia. Nowe scenariusze sprawdzają zachowania pomijane wcześniej.</p></li>\n<li><h3>Dostosowuje sprawdzenia do podróży</h3><p>Sprawdza aplikację na telefonie i przy słabym połączeniu, a nie tylko na komputerze z szybkim internetem. Ocenia, czy nowa bramka i czas aktualizacji są czytelne dla osoby korzystającej z telefonu podczas przemieszczania się po lotnisku.</p></li>\n<li><h3>Sprawdza rzeczywistą przydatność rozwiązania</h3><p>Otwarcie ekranu i ręczne odświeżenie działają zgodnie z wymaganiami. Podczas próby z przedstawicielem użytkowników okazuje się jednak, że pasażer odkłada telefon i nie wie o zmianie. Tester opisuje tę potrzebę zespołowi. Zespół rozważa automatyczne powiadomienie; nie traktuje go jako istniejącego wymagania bez uzgodnienia.</p></li>\n</ol>\n<div class="failure"><p><b>Wniosek dla zespołu:</b> poprawne pokazanie bramki w jednym teście to tylko część informacji. Tester przekazuje wyniki, pominięte sytuacje i zaobserwowane potrzeby pasażera, aby zespół mógł ustalić dalsze działania.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Zaliczone testy dostarczają dowodów w sprawdzonym zakresie. Oceniaj także ryzyko i to, czy rozwiązanie pomaga użytkownikowi.</p></div>\n</div>\n', 'sections': 'sekcja 1.3'}, {'id': 31, 'number': '31', 'title': 'Pokrycie instrukcji a pokrycie gałęzi', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Dwie osobne definicje</h2></div>\n<p class="lead">Pokrycie instrukcji i pokrycie gałęzi to miary wykorzystywane w testowaniu białoskrzynkowym. Pokazują, jakie elementy struktury kodu wykonano podczas testów.</p>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="statement-title"><div class="definition-label">WYKONYWALNE INSTRUKCJE</div><h3 id="statement-title">Pokrycie instrukcji</h3><p class="definition-text">Procent wykonywalnych instrukcji programu wykonanych podczas testów. Pełne pokrycie oznacza wykonanie każdej instrukcji przynajmniej raz.</p><div class="definition-question"><strong>Wzór</strong><p>Wykonane instrukcje ÷ wszystkie wykonywalne instrukcje × 100%.</p></div><div class="definition-mini"><strong>Co pokazuje?</strong><p>Które instrukcje zostały uruchomione. Nie dowodzi sprawdzenia wszystkich danych lub wszystkich sposobów przebiegu programu.</p></div></section>\n<section class="definition-card validation" aria-labelledby="branch-title"><div class="definition-label">PRZEPŁYW STEROWANIA</div><h3 id="branch-title">Pokrycie gałęzi</h3><p class="definition-text">Procent gałęzi przepływu sterowania wykonanych podczas testów. Gałąź to przejście między punktami w grafie przepływu sterowania; może być warunkowa lub bezwarunkowa.</p><div class="definition-question"><strong>Wzór</strong><p>Wykonane gałęzie ÷ wszystkie gałęzie × 100%.</p></div><div class="definition-mini"><strong>Co pokazuje?</strong><p>Dla prostego <code>if</code> uwzględniamy wynik True i False. Pełne pokrycie gałęzi obejmuje również przejścia bezwarunkowe w przyjętym modelu.</p></div></section>\n</div>\n<div class="simple"><strong>Prostymi słowami</strong>Możesz wykonać każdą instrukcję, a mimo to nie sprawdzić, co program zrobi, gdy warunek nie zostanie spełniony.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Pełne pokrycie gałęzi obejmuje instrukcje</h3><p>W tej samej analizowanej strukturze 100% pokrycia gałęzi zapewnia 100% pokrycia instrukcji. Odwrotna zależność nie zachodzi.</p></div>\n<div class="memory"><h3>Wykonanie nie oznacza poprawności</h3><p>Test musi także porównywać wynik z oczekiwaniem. Sam raport pokrycia nie pokazuje, czy sprawdzenia są trafne ani czy wykryto wszystkie defekty.</p></div>\n<div class="memory"><h3>Instrukcje to nie wiersze pliku</h3><p>Puste linie, komentarze i sposób formatowania nie określają liczby wykonywalnych instrukcji. Miarę interpretuj zgodnie z modelem i raportem narzędzia.</p></div>\n<div class="memory"><h3>Gałęzie to nie wszystkie ścieżki</h3><p>Nawet pełne pokrycie gałęzi nie oznacza wykonania wszystkich sekwencji przejść ani kombinacji danych. Pokrycie warunków składowych to również odrębne zagadnienie.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — opłata za dodatkowy bagaż</h2></div>\n<div class="example"><h3>Jedna dodatkowa sztuka bagażu kosztuje 100 zł</h3><p>To reguła przykładowego systemu, a nie cennik konkretnej linii lotniczej. Bez dodatkowego bagażu opłata wynosi 0 zł. Zakładamy, że funkcja otrzymuje poprawną, nieujemną liczbę całkowitą; walidacja danych jest poza zakresem tego przykładu.</p>\n<pre class="code-example"><code>def oplata_za_bagaz(dodatkowe_sztuki):\n    oplata = 0\n\n    if dodatkowe_sztuki &gt; 0:\n        oplata = dodatkowe_sztuki * 100\n\n    return oplata</code></pre>\n<h3>Pierwszy test — jedna dodatkowa sztuka</h3>\n<pre class="code-example"><code>oplata_za_bagaz(1)  # oczekiwane: 100</code></pre>\n<p>Warunek jest prawdziwy. Program ustawia początkową opłatę, sprawdza warunek, nalicza 100 zł i zwraca wynik. Wykonano wszystkie wykonywalne instrukcje funkcji: <strong>100% pokrycia instrukcji</strong>. Nie sprawdzono jednak wyjścia z warunku z wynikiem False.</p>\n<h3>Drugi test — brak dodatkowego bagażu</h3>\n<pre class="code-example"><code>oplata_za_bagaz(0)  # oczekiwane: 0</code></pre>\n<p>Warunek jest fałszywy. Program pomija naliczanie opłaty i zwraca 0 zł. Razem te dwa testy wykonują obie możliwości prostego warunku oraz wszystkie przejścia tej funkcji.</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Wyniki warunku w dwóch testach</caption><thead><tr><th scope="col">Dane</th><th scope="col">Wynik warunku</th><th scope="col">Oczekiwany rezultat</th></tr></thead><tbody>\n<tr><th scope="row">1 dodatkowa sztuka</th><td>True — nalicz opłatę.</td><td>100 zł.</td></tr>\n<tr><th scope="row">0 dodatkowych sztuk</th><td>False — pomiń naliczanie.</td><td>0 zł.</td></tr>\n</tbody></table></div>\n<h3>Co robi tester?</h3><ol class="goal-examples">\n<li><h3>Analizuje strukturę kodu</h3><p>Wskazuje warunek <code>dodatkowe_sztuki &gt; 0</code> i zauważa, że można zarówno wykonać naliczanie, jak i je pominąć.</p></li>\n<li><h3>Dobiera dane dla obu możliwości</h3><p>Używa 1, aby uzyskać True, oraz 0, aby uzyskać False. Na podstawie wymagania określa oczekiwane opłaty: 100 zł i 0 zł.</p></li>\n<li><h3>Sprawdza wyniki i raport pokrycia</h3><p>Nie ogranicza się do uruchomienia funkcji. Porównuje zwracane wartości z oczekiwaniami i analizuje, jakie elementy kodu wykonano.</p></li>\n</ol>\n<div class="failure"><p><b>Ważne:</b> pierwszy test sam osiąga pełne pokrycie instrukcji, lecz pomija zachowanie bez dodatkowego bagażu. Po dodaniu drugiego testu mamy także pełne pokrycie gałęzi tej prostej funkcji. Nadal nie sprawdziliśmy wszystkich liczb ani możliwych błędów.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Wykonanie całego kodu przynajmniej raz nie oznacza sprawdzenia wszystkich sposobów jego działania.</p></div>\n</div>\n', 'sections': 'sekcje 4.3.1–4.3.2'}, {'id': 32, 'number': '32', 'title': 'Zgadywanie błędów a testowanie oparte na liście kontrolnej', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Dwie osobne definicje</h2></div>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="guessing-title"><div class="definition-label">PRZEWIDUJESZ PRAWDOPODOBNE PROBLEMY</div><h3 id="guessing-title">Zgadywanie błędów</h3><p class="definition-text">Technika oparta na przewidywaniu możliwych błędów, defektów i awarii na podstawie wiedzy testera, historii aplikacji oraz problemów występujących w podobnych systemach.</p><div class="definition-mini"><strong>Jak pracuje tester?</strong><p>Wykorzystuje przewidywania do zaprojektowania konkretnych sprawdzeń. Może przygotować listę potencjalnych problemów i testy, które pozwolą je ujawnić.</p></div><div class="definition-question"><strong>Prostymi słowami</strong><p>„Z doświadczenia wiem, gdzie może wystąpić problem, więc przygotowuję test, który pozwoli go ujawnić”.</p></div></section>\n<section class="definition-card validation" aria-labelledby="checklist-title"><div class="definition-label">SPRAWDZASZ WARUNKI Z UPORZĄDKOWANEJ LISTY</div><h3 id="checklist-title">Testowanie oparte na liście kontrolnej</h3><p class="definition-text">Technika polegająca na projektowaniu, przygotowywaniu i wykonywaniu testów obejmujących warunki zapisane na liście kontrolnej.</p><div class="definition-mini"><strong>Jak pracuje tester?</strong><p>Lista przypomina o istotnych sprawdzeniach. Jej punkty powinny być konkretne i sprawdzalne osobno. Zwykle nie opisuje wszystkich kroków tak szczegółowo jak przypadki testowe.</p></div><div class="definition-question"><strong>Prostymi słowami</strong><p>„Mam uporządkowaną listę rzeczy do sprawdzenia i wykorzystuję ją podczas testowania”.</p></div></section>\n</div>\n<div class="simple"><strong>Najważniejsza różnica</strong>W zgadywaniu błędów punktem wyjścia jest podejrzenie konkretnego problemu. W testowaniu opartym na liście kontrolnej punktem wyjścia są zapisane warunki do sprawdzenia. Techniki mogą się uzupełniać.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Zgadywanie błędów wykorzystuje wiedzę</h3><p>Przewidywanie problemów ma uzasadnienie w doświadczeniu i informacjach o produkcie. Nie polega na przypadkowym klikaniu ani zakładaniu przyczyny bez dowodów.</p></div>\n<div class="memory"><h3>Odhaczenie punktu nie zastępuje oceny</h3><p>Zapisz, co rzeczywiście sprawdzono i jaki był wynik. „Wykonano” i „zaliczono” to różne informacje.</p></div>\n<div class="memory"><h3>Lista wymaga aktualizacji</h3><p>Dodawaj istotne wnioski z wykrytych problemów, usuwaj zbędne powtórzenia i unikaj ogólników typu „sprawdź wszystko”.</p></div>\n<div class="memory"><h3>Lista nie zawsze daje identyczne wykonanie</h3><p>Jeżeli punkt jest ogólny, różni testerzy mogą dobrać inne dane i kroki. Zapisuj szczegóły potrzebne do zrozumienia i powtórzenia ważnych sprawdzeń.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — bilet w telefonie podczas kontroli</h2></div>\n<div class="example"><h3>Kontroler podchodzi, ale telefon nie ma internetu</h3><p>Pasażer jedzie tramwajem i chce otworzyć bilet. <strong>Wymaganie w tym przykładowym projekcie:</strong> wcześniej pobrany, aktywny bilet ma być dostępny do okazania bez internetu, również po ponownym uruchomieniu aplikacji. Ekran ma zawierać wymagane dane biletu i czytelny kod kontrolny.</p><p>To ustalenia fikcyjnego projektu, a nie opis zasad konkretnego przewoźnika. Tester korzysta z konta i biletu testowego, który pozostaje aktywny przez całe sprawdzenie.</p>\n<h3>Co robi tester, stosując zgadywanie błędów?</h3><p>Z wcześniejszych projektów pamięta problemy z utratą danych po zamknięciu aplikacji. Podejrzewa, że dostęp do biletu może zależeć od danych przechowywanych wyłącznie w pamięci działającego programu. To hipoteza, którą sprawdzi.</p>\n<ol class="goal-examples">\n<li><h3>Przygotowuje bilet</h3><p>Przy aktywnym połączeniu pobiera bilet testowy i potwierdza, że można go otworzyć.</p></li>\n<li><h3>Przygotowuje podejrzewaną sytuację</h3><p>Całkowicie zamyka aplikację, a następnie wyłącza transmisję danych i Wi-Fi. Nie usuwa danych aplikacji ani biletu.</p></li>\n<li><h3>Sprawdza działanie</h3><p>Ponownie uruchamia aplikację bez połączenia i próbuje otworzyć bilet. Zgodnie z wymaganiem oczekuje dostępnego biletu z kompletem informacji.</p></li>\n<li><h3>Zapisuje problem</h3><p>Zamiast biletu pojawia się ekran ładowania. Tester zgłasza kroki, dane, wersję aplikacji oraz oczekiwany i rzeczywisty wynik. Podejrzenie dotyczące pamięci programu nadal wymaga analizy — sam test nie potwierdza przyczyny.</p></li>\n</ol>\n<h3>Co robi tester, korzystając z listy kontrolnej?</h3><p>Przygotowuje dane odpowiednie do każdego punktu, wykonuje sprawdzenie i zapisuje wynik. Przykładowa lista obejmuje:</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Warunki do sprawdzenia na ekranie biletu</caption><thead><tr><th scope="col">Punkt listy kontrolnej</th><th scope="col">Co ocenia tester?</th></tr></thead><tbody>\n<tr><th scope="row">Dostępność pobranego biletu bez internetu</th><td>Czy można otworzyć aktywny bilet po utracie połączenia?</td></tr>\n<tr><th scope="row">Dostępność po ponownym uruchomieniu</th><td>Czy po całkowitym zamknięciu aplikacji i uruchomieniu offline bilet nadal można okazać?</td></tr>\n<tr><th scope="row">Kompletność danych</th><td>Czy ekran zawiera informacje wymagane w tym projekcie, np. numer biletu i okres ważności?</td></tr>\n<tr><th scope="row">Czytelność kodu kontrolnego</th><td>Czy kod jest wyświetlony w całości i niezasłonięty na obsługiwanych ekranach, także przy większym rozmiarze tekstu?</td></tr>\n</tbody></table></div>\n<div class="failure"><p><b>Jak techniki się łączą?</b> Doświadczenie podsunęło testerowi sprawdzenie ponownego uruchomienia bez internetu. Jeśli nie było go na dotychczasowej liście, zespół może ją uzupełnić. Przy kolejnych testach lista przypomni o tej sytuacji także innej osobie.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Doświadczenie podpowiada, gdzie szukać problemów, a lista kontrolna pomaga uporządkować sprawdzenia.</p></div>\n</div>\n', 'sections': 'sekcje 4.4.1 i 4.4.3'}, {'id': 33, 'number': '33', 'title': 'TDD, ATDD i BDD — testy jako wsparcie tworzenia oprogramowania', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Trzy osobne definicje</h2></div>\n<p class="lead"><strong>TDD, ATDD i BDD</strong> to podejścia do wytwarzania, w których testy i przykłady określane przed implementacją pomagają kierować tworzeniem rozwiązania.</p>\n<section class="definition-card verification" aria-labelledby="tdd-title" style="margin:22px 0"><div class="definition-label">TEST-DRIVEN DEVELOPMENT</div><h3 id="tdd-title">TDD — wytwarzanie sterowane testami</h3><p class="definition-text">Test powstaje przed kodem realizującym sprawdzane zachowanie. Praca przebiega w krótkich cyklach: Red — test nie przechodzi; Green — powstaje kod wystarczający do zaliczenia testu; Refactor — kod i testy są porządkowane z zachowaniem sprawdzanego zachowania.</p><div class="definition-mini"><strong>Prostymi słowami</strong><p>Test pomaga kierować pisaniem kodu. Przed zmianą upewniamy się, że nowy test nie przechodzi z oczekiwanego powodu.</p></div></section>\n<section class="definition-card validation" aria-labelledby="atdd-title" style="margin:22px 0"><div class="definition-label">ACCEPTANCE TEST-DRIVEN DEVELOPMENT</div><h3 id="atdd-title">ATDD — wytwarzanie sterowane testami akceptacyjnymi</h3><p class="definition-text">Testy wywodzimy z kryteriów akceptacji przed implementacją funkcji. Przedstawiciel biznesu, programista i tester współpracują, uzgadniając przykłady pokazujące, kiedy rozwiązanie będzie akceptowalne.</p><div class="definition-mini"><strong>Prostymi słowami</strong><p>Najpierw wspólnie ustalamy, jak sprawdzimy spełnienie oczekiwań, a następnie tworzymy rozwiązanie.</p></div></section>\n<section class="definition-card verification" aria-labelledby="bdd-title" style="margin:22px 0"><div class="definition-label">BEHAVIOR-DRIVEN DEVELOPMENT</div><h3 id="bdd-title">BDD — wytwarzanie sterowane zachowaniem</h3><p class="definition-text">Oczekiwane zachowanie opisujemy przykładami zrozumiałymi dla interesariuszy, zwykle w formacie Given–When–Then: sytuacja początkowa, działanie lub zdarzenie i oczekiwany rezultat. Scenariusze łączymy z kodem automatyzacji, aby wykonywać je jako testy.</p><div class="definition-mini"><strong>Prostymi słowami</strong><p>Wspólnie opisujemy na przykładach, jak aplikacja ma się zachowywać. Sam tekst scenariusza nie wykonuje sprawdzenia.</p></div></section>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Na czym skupiają się te podejścia?</caption><thead><tr><th scope="col">Podejście</th><th scope="col">Najważniejszy akcent</th></tr></thead><tbody>\n<tr><th scope="row">TDD</th><td>Krótkie cykle test–kod–refaktoryzacja kierujące tworzeniem kodu.</td></tr>\n<tr><th scope="row">ATDD</th><td>Wspólne uzgodnienie testów akceptacyjnych przed implementacją.</td></tr>\n<tr><th scope="row">BDD</th><td>Wspólne rozumienie zachowania przez zrozumiałe przykłady.</td></tr>\n</tbody></table></div>\n<div class="simple"><strong>Prostymi słowami</strong>Testy i przykłady pomagają ustalić oraz tworzyć zachowanie, zamiast pojawiać się dopiero po napisaniu funkcji. Podejścia mogą się łączyć.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>To podejścia do wytwarzania</h3><p>Nie są trzema kolejnymi poziomami testów ani obowiązkową sekwencją etapów. Ten sam zespół może łączyć ich praktyki.</p></div>\n<div class="memory"><h3>Refaktoryzacja zachowuje zachowanie</h3><p>W TDD po zaliczeniu testu porządkujemy rozwiązanie. Ponowne wykonanie testów pomaga wykryć niezamierzone skutki zmian.</p></div>\n<div class="memory"><h3>ATDD wymaga wspólnego zrozumienia</h3><p>Tester pomaga doprecyzować oczekiwania i brakujące sytuacje. Samodzielne zapisanie testu po wdrożeniu nie realizuje tego podejścia.</p></div>\n<div class="memory"><h3>Given–When–Then to jeszcze nie automatyzacja</h3><p>Scenariusz wymaga powiązania z wykonywalnymi krokami oraz sprawdzeniami wyników. BDD obejmuje także rozmowę i uzgodnienie zachowania.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — limit wypożyczonych książek</h2></div>\n<div class="example"><h3>Pięć książek można wypożyczyć, szóstej już nie</h3><p><strong>Reguła w tym przykładowym projekcie:</strong> czytelnik może mieć maksymalnie 5 aktywnych wypożyczeń. Próba wypożyczenia szóstej książki ma zostać odrzucona. Zakładamy dostępny egzemplarz, uprawnionego czytelnika i brak innych blokad.</p>\n<h3>Jak wygląda TDD?</h3><p>Programista zaczyna od testu funkcji oceniającej możliwość kolejnego wypożyczenia. Przed implementacją sprawdza, że test nie przechodzi, następnie dodaje kod i porządkuje rozwiązanie. W kolejnym cyklu dodaje następny przypadek, np. odmowę przy osiągniętym limicie.</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Przykładowe oczekiwania dla funkcji sprawdzającej limit</caption><thead><tr><th scope="col">Aktywne wypożyczenia</th><th scope="col">Czy można wypożyczyć kolejną książkę?</th></tr></thead><tbody>\n<tr><th scope="row">4</th><td>Tak — będzie to piąta książka.</td></tr>\n<tr><th scope="row">5</th><td>Nie — byłaby to szósta książka.</td></tr>\n</tbody></table></div>\n<p><strong>Rola testera:</strong> może pomóc wskazać istotne przypadki, zwłaszcza granicę 4/5. Test samej funkcji limitu nie sprawdza jeszcze całego procesu wypożyczenia.</p>\n<h3>Jak wygląda ATDD?</h3><p>Przed implementacją tester, programista i bibliotekarz uzgadniają testy akceptacyjne:</p>\n<ul class="list"><li>Czytelnik z czterema wypożyczeniami może wypożyczyć dostępną książkę; liczba wypożyczeń rośnie do pięciu.</li><li>Czytelnik z pięcioma wypożyczeniami otrzymuje odmowę z wyjaśnieniem limitu.</li><li>Po odmowie liczba wypożyczeń nadal wynosi pięć, a wybrany egzemplarz pozostaje dostępny.</li></ul>\n<p><strong>Rola testera:</strong> zauważa, że sam komunikat odmowy nie wystarczy. Wskazuje potrzebę sprawdzenia, czy system mimo odmowy nie zapisał wypożyczenia. Uzgodnione przykłady kierują implementacją.</p>\n<h3>Jak wygląda BDD?</h3><p>Zespół opisuje jeden z uzgodnionych przykładów w języku zrozumiałym dla bibliotekarza, testera i programisty:</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Scenariusz — odmowa wypożyczenia szóstej książki</caption><thead><tr><th scope="col">Część scenariusza</th><th scope="col">Opis zachowania</th></tr></thead><tbody>\n<tr><th scope="row">Given — Zakładając</th><td>Czytelnik ma 5 aktywnych wypożyczeń, a wybrany egzemplarz jest dostępny.</td></tr>\n<tr><th scope="row">When — Gdy</th><td>Próbuje wypożyczyć ten egzemplarz.</td></tr>\n<tr><th scope="row">Then — Wtedy</th><td>System odmawia i informuje o osiągnięciu limitu.</td></tr>\n<tr><th scope="row">And — Oraz</th><td>Nie tworzy nowego wypożyczenia i pozostawia egzemplarz dostępny.</td></tr>\n</tbody></table></div>\n<p><strong>Rola testera:</strong> pomaga doprecyzować scenariusz, dane i oczekiwane rezultaty. Zespół wiąże kroki z kodem, który przygotowuje stan, wykonuje próbę i sprawdza wynik. Automatyzacja może działać na odpowiedniej warstwie systemu; nie musi używać interfejsu przeglądarki.</p>\n<div class="failure"><p><b>Jak podejścia się łączą?</b> Ten sam scenariusz może wspierać ATDD jako uzgodniony test akceptacyjny i BDD jako opis zachowania. Programista może równocześnie rozwijać funkcję limitu w cyklach TDD.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Testy i przykłady mogą pomagać ustalać oraz tworzyć właściwe zachowanie, zanim powstanie kod.</p></div>\n</div>\n', 'sections': 'sekcja 2.1.3; ATDD również w sekcji 4.5.3'}, {'id': 34, 'number': '34', 'title': 'Kryteria akceptacji — kiedy funkcja spełnia oczekiwania?', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>Kryteria akceptacji</strong> to warunki, które implementacja historyjki użytkownika musi spełnić, aby została zaakceptowana przez interesariuszy.</p>\n<div class="definitioncopy"><p>Pomagają uzgodnić zakres, opisać oczekiwane zachowania i stanowią podstawę testów akceptacyjnych. Mogą obejmować zarówno poprawny przebieg, jak i sytuacje wyjątkowe. Powinny być jednoznaczne i umożliwiać ocenę spełnienia.</p><p>Tester pomaga je doprecyzować, wskazuje niejasności i projektuje sprawdzenia. Oczekiwanych reguł biznesowych nie ustala samodzielnie — uzgadnia je z właściwymi interesariuszami.</p></div>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="rules-title"><div class="definition-label">KONKRETNE WARUNKI</div><h3 id="rules-title">Zapis jako reguły</h3><p class="definition-text">Lista warunków określających akceptowalne zachowanie, np. w punktach lub tabeli łączącej sytuacje z wynikami.</p><div class="definition-mini"><strong>Przykład</strong><p>Po skutecznym cofnięciu dostępu każde kolejne żądanie otwarcia drzwi tej osoby zostaje odrzucone.</p></div></section>\n<section class="definition-card validation" aria-labelledby="scenario-title"><div class="definition-label">SYTUACJA, DZIAŁANIE I WYNIK</div><h3 id="scenario-title">Zapis jako scenariusze</h3><p class="definition-text">Przykłady opisujące stan początkowy, działanie lub zdarzenie i oczekiwany rezultat, np. w formacie Given–When–Then.</p><div class="definition-mini"><strong>Przykład</strong><p>Zakładając cofnięty dostęp, gdy użytkownik próbuje otworzyć drzwi, wtedy system odrzuca żądanie i drzwi pozostają zamknięte.</p></div></section>\n</div>\n<div class="simple"><strong>Prostymi słowami</strong>Kryteria akceptacji mówią, jakie zachowanie jest akceptowalne. Przypadek testowy określa, jak konkretnie sprawdzić wybrany warunek.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Opisuj obserwowalne zachowanie</h3><p>„Cofnięcie dostępu działa poprawnie” nie precyzuje wyniku. Wskaż odrzucenie żądania, brak otwarcia drzwi i informację dla użytkownika.</p></div>\n<div class="memory"><h3>Uwzględniaj również odmowę i wyjątki</h3><p>Uzgodnij nie tylko udane otwarcie drzwi, lecz także zachowanie po cofnięciu uprawnień i w już działającej sesji.</p></div>\n<div class="memory"><h3>Kryterium to nie cały przypadek testowy</h3><p>Jedno kryterium może wymagać kilku testów. Konkretne konto, dane, stan urządzenia i kroki doprecyzowujesz podczas projektowania.</p></div>\n<div class="memory"><h3>Oddziel akceptację funkcji od zakończenia testów</h3><p>Kryteria akceptacji dotyczą oczekiwań wobec rozwiązania. Kryteria wyjścia określają warunki zakończenia danej działalności testowej; mogą odwoływać się do wyników, pokrycia i ryzyka.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — cofnięcie dostępu do drzwi w bloku</h2></div>\n<div class="example"><h3>Były mieszkaniec nadal ma otwartą aplikację</h3><p>Administrator odbiera mieszkańcowi dostęp do budynku. Ta osoba nadal ma aplikację i jest w niej zalogowana. Ogólne wymaganie <strong>„administrator może odebrać dostęp”</strong> nie wyjaśnia, czy cofnięcie zadziała także w już otwartej aplikacji.</p><p><strong>Założenie naszego projektu:</strong> po potwierdzeniu cofnięcia uprawnienia przez system każde kolejne żądanie otwarcia drzwi tej osoby ma być odrzucane. Testujemy żądania wysłane po tym potwierdzeniu. Sytuacje równoczesne i żądania już przetwarzane wymagają osobnych ustaleń.</p>\n<h3>Kryteria akceptacji zapisane jako reguły</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Uzgodnione zachowania w przykładowym projekcie</caption><thead><tr><th scope="col">Sytuacja</th><th scope="col">Oczekiwane zachowanie</th></tr></thead><tbody>\n<tr><th scope="row">Mieszkaniec ma aktywne uprawnienie.</th><td>Może otworzyć przypisane drzwi przy sprawnym połączeniu i urządzeniu.</td></tr>\n<tr><th scope="row">Administrator skutecznie cofnął uprawnienie.</th><td>Kolejne żądanie otwarcia zostaje odrzucone.</td></tr>\n<tr><th scope="row">Aplikacja była otwarta podczas cofania dostępu.</th><td>Stara sesja nie pozwala otworzyć drzwi po cofnięciu uprawnienia.</td></tr>\n<tr><th scope="row">System odrzuca próbę otwarcia.</th><td>Drzwi pozostają zamknięte, a aplikacja informuje o braku uprawnienia.</td></tr>\n</tbody></table></div>\n<h3>To samo zachowanie zapisane jako scenariusz</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Scenariusz — otwarcie drzwi po cofnięciu dostępu</caption><thead><tr><th scope="col">Część</th><th scope="col">Opis</th></tr></thead><tbody>\n<tr><th scope="row">Given — Zakładając</th><td>Mieszkaniec jest zalogowany, a administrator skutecznie cofnął jego dostęp do wskazanych drzwi.</td></tr>\n<tr><th scope="row">When — Gdy</th><td>Mieszkaniec bez ponownego logowania wysyła nowe żądanie otwarcia tych drzwi.</td></tr>\n<tr><th scope="row">Then — Wtedy</th><td>System odrzuca żądanie.</td></tr>\n<tr><th scope="row">And — Oraz</th><td>Drzwi pozostają zamknięte, a aplikacja informuje o braku uprawnienia.</td></tr>\n</tbody></table></div>\n<h3>Co robi tester?</h3><ol class="goal-examples">\n<li><h3>Pomaga doprecyzować kryteria</h3><p>Pyta, od którego momentu dostęp ma przestać działać i co z już otwartą aplikacją. Uzgadnia zachowanie z zespołem, zanim zapisze oczekiwane wyniki testów.</p></li>\n<li><h3>Przygotowuje stanowisko testowe</h3><p>Korzysta z fikcyjnego konta, aplikacji i kontrolera zamka na stanowisku testowym. Przy aktywnym uprawnieniu potwierdza działające otwarcie, a następnie przywraca drzwi do stanu zamkniętego.</p></li>\n<li><h3>Sprawdza cofnięcie uprawnienia</h3><p>Administrator cofa dostęp i otrzymuje potwierdzenie. Tester nie wylogowuje mieszkańca ani nie odświeża jego sesji. Wysyła kolejne żądanie otwarcia.</p></li>\n<li><h3>Weryfikuje efekt, a nie tylko ekran</h3><p>Sprawdza odrzucenie żądania, informację w aplikacji, brak polecenia otwarcia na kontrolerze oraz stan zamka. Zapisuje wynik i dowody. Jeśli zamek dostaje polecenie mimo odmowy na ekranie, zgłasza problem.</p></li>\n</ol>\n<div class="failure"><p><b>Zapamiętaj:</b> sam komunikat „Brak dostępu” nie dowodzi spełnienia kryterium, jeśli zamek mimo to otrzyma polecenie otwarcia. Dobre kryteria wskazują rzeczywisty efekt działania systemu.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Kryteria akceptacji zamieniają ogólne oczekiwanie w konkretne zachowania, które można sprawdzić.</p></div>\n</div>\n', 'sections': 'sekcja 4.5.2'}, {'id': 35, 'number': '35', 'title': 'Niezależność testowania i podejście całego zespołu', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Dwie osobne definicje</h2></div>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="independence-title"><div class="definition-label">INNA PERSPEKTYWA NIŻ AUTORA</div><h3 id="independence-title">Niezależność testowania</h3><p class="definition-text">Stopień oddzielenia testowania od autora ocenianego produktu pracy. Inna osoba może zauważyć inne problemy i zakwestionować założenia autora dzięki odmiennemu doświadczeniu i spojrzeniu.</p><div class="definition-mini"><strong>Prostymi słowami</strong><p>Osoba, która nie napisała danego fragmentu, może sprawdzić go z innej perspektywy. Nie oznacza to, że autor nie powinien testować własnej pracy.</p></div></section>\n<section class="definition-card validation" aria-labelledby="whole-team-title"><div class="definition-label">WSPÓŁPRACA I ODPOWIEDZIALNOŚĆ ZA JAKOŚĆ</div><h3 id="whole-team-title">Podejście całego zespołu</h3><p class="definition-text">Wszyscy członkowie zespołu odpowiadają za jakość. Współpracują, dzielą się wiedzą i podejmują zadania zgodnie z potrzebnymi umiejętnościami, zamiast przekazywać całą odpowiedzialność testerowi.</p><div class="definition-mini"><strong>Prostymi słowami</strong><p>Tester, programista i przedstawiciel biznesu wnoszą różne kompetencje, aby wspólnie tworzyć właściwe rozwiązanie.</p></div></section>\n</div>\n<h3>Stopnie niezależności</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Kto testuje produkt pracy?</caption><thead><tr><th scope="col">Wykonawca</th><th scope="col">Stopień niezależności</th></tr></thead><tbody>\n<tr><th scope="row">Autor produktu pracy</th><td>Brak niezależności.</td></tr>\n<tr><th scope="row">Inna osoba z tego samego zespołu</th><td>Pewien stopień niezależności.</td></tr>\n<tr><th scope="row">Tester spoza zespołu autora, ale z tej samej organizacji</th><td>Wysoki stopień niezależności.</td></tr>\n<tr><th scope="row">Tester spoza organizacji</th><td>Bardzo wysoki stopień niezależności.</td></tr>\n</tbody></table></div>\n<p class="note">Stopień niezależności dobieramy do kontekstu. Możemy łączyć różne stopnie; niezależność nie zastępuje znajomości produktu.</p>\n<div class="simple"><strong>Prostymi słowami</strong>Niezależne spojrzenie pomaga zauważyć inne problemy. Współpraca pomaga je zrozumieć i rozwiązać.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Niezależność nie oznacza izolacji</h3><p>Oddzielny tester potrzebuje wymagań, dostępu do wiedzy i kontaktu z zespołem. Izolacja grozi nieporozumieniami i opóźnieniami.</p></div>\n<div class="memory"><h3>Autor nadal testuje własny kod</h3><p>Programista może skutecznie znaleźć wiele problemów dzięki znajomości implementacji. Praca innej osoby uzupełnia te sprawdzenia.</p></div>\n<div class="memory"><h3>Jakość nie jest wyłącznie zadaniem testera</h3><p>Wspólna odpowiedzialność wymaga konkretnych działań każdego uczestnika. Nie oznacza, że wszyscy wykonują identyczne zadania.</p></div>\n<div class="memory"><h3>Organizacja zależy od kontekstu</h3><p>Niektóre projekty wymagają większego oddzielenia testowania od wytwarzania. Sposób współpracy i odpowiedzialności trzeba do tego dostosować.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — nocny dyżur pielęgniarki w szpitalu</h2></div>\n<div class="example"><h3>Dyżur zaczyna się wieczorem, a kończy rano</h3><p>Szpital wdraża aplikację do rejestrowania dyżurów. <strong>Wymaganie w tym projekcie:</strong> system obsługuje dyżury przechodzące przez północ i oblicza czas między datą i godziną rozpoczęcia a datą i godziną zakończenia.</p><p>Pielęgniarka rozpoczyna dyżur <strong>10 listopada o 19:00</strong>, a kończy <strong>11 listopada o 7:00</strong>. Przyjmujemy zwykłą noc bez zmiany czasu i brak przerw. Oczekiwany czas to <strong>12 godzin</strong>. Aplikacja odrzuca jednak wpis: „Godzina zakończenia musi być późniejsza od rozpoczęcia”. To przykład fikcyjnego projektu; testy wykorzystują fikcyjne dane personelu.</p>\n<h3>Jak przykład pokazuje niezależność testowania?</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Różne osoby wnoszą różne perspektywy</caption><thead><tr><th scope="col">Kto sprawdza?</th><th scope="col">Co robi?</th></tr></thead><tbody>\n<tr><th scope="row">Programista — autor kodu</th><td>Sprawdza dyżur 7:00–19:00 tego samego dnia. Aplikacja poprawnie oblicza 12 godzin. Ten sprawdzony przypadek nie obejmuje przejścia przez północ.</td></tr>\n<tr><th scope="row">Tester z tego samego zespołu</th><td>Sprawdza także 19:00–7:00 następnego dnia i ujawnia problem. Ma pewien stopień niezależności i kwestionuje założenie, że dyżur zawsze kończy się tego samego dnia.</td></tr>\n<tr><th scope="row">Pielęgniarka oddziałowa — przedstawicielka użytkowników</th><td>Podczas uzgodnionych prób ocenia, czy wprowadzanie dat i godzin odpowiada rzeczywistemu planowaniu dyżurów. Jej rola wnosi wiedzę dziedzinową; sama nazwa stanowiska nie określa stopnia niezależności organizacyjnej.</td></tr>\n</tbody></table></div>\n<h3>Jak działa podejście całego zespołu?</h3><ol class="goal-examples">\n<li><h3>Tester opisuje zaobserwowany problem</h3><p>Podaje daty i godziny, oczekiwane 12 godzin, komunikat odmowy, wersję aplikacji i kroki. Nie przypisuje przyczyny bez analizy.</p></li>\n<li><h3>Przedstawicielka użytkowników wyjaśnia potrzebę</h3><p>Pielęgniarka oddziałowa potwierdza, że zapis nocnych dyżurów jest potrzebny. Pomaga uzgodnić inne istotne sytuacje.</p></li>\n<li><h3>Analityk i programista doprecyzowują rozwiązanie</h3><p>Analityk doprecyzowuje wymagania. Programista ustala przyczynę i poprawia obsługę dat oraz uzupełnia odpowiednie testy kodu.</p></li>\n<li><h3>Zespół uzgadnia dalsze sprawdzenia</h3><p>Tester powtarza dyżur 19:00–7:00 i sprawdza oczekiwane 12 godzin. Dobiera regresję, np. dyżur dzienny, oraz dodatkowe scenariusze, np. przejście przez koniec miesiąca. Wyniki omawia z zespołem.</p></li>\n</ol>\n<div class="failure"><p><b>Wniosek:</b> tester nie musiał pracować poza zespołem, aby dostrzec pominiętą sytuację. Odmienne spojrzenie pomogło ujawnić problem, a współpraca pozwoliła wyjaśnić potrzebę i sprawdzić poprawkę.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Różne perspektywy pomagają wykrywać problemy, a wspólna praca pomaga zapewnić właściwe działanie rozwiązania.</p></div>\n</div>\n', 'sections': 'sekcje 1.5.2–1.5.3'}, {'id': 36, 'number': '36', 'title': 'Wpływ modelu wytwarzania na testowanie — podejście sekwencyjne, iteracyjne i przyrostowe', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Model wytwarzania i trzy podejścia</h2></div>\n<p class="lead"><strong>Model cyklu wytwarzania oprogramowania</strong> opisuje organizację działań związanych z tworzeniem systemu oraz zależności między nimi. Wpływa na moment rozpoczęcia testów, dokumentację, automatyzację i zadania testera.</p>\n<section class="definition-card verification" aria-labelledby="sequential-title" style="margin:22px 0"><div class="definition-label">KOLEJNE FAZY</div><h3 id="sequential-title">Podejście sekwencyjne</h3><p class="definition-text">Działania organizujemy w następujących po sobie fazach, np. wymagania, projektowanie i implementacja.</p><div class="definition-mini"><strong>Wpływ na testowanie</strong><p>Tester wcześnie przegląda materiały i projektuje testy. Testowanie dynamiczne wymaga dostępnego kodu, więc zwykle pojawia się później.</p></div></section>\n<section class="definition-card validation" aria-labelledby="iterative-title" style="margin:22px 0"><div class="definition-label">KOLEJNE UDOSKONALENIA</div><h3 id="iterative-title">Podejście iteracyjne</h3><p class="definition-text">Rozwiązanie rozwijamy i udoskonalamy w kolejnych cyklach. Informacje zwrotne pomagają zmieniać wcześniejszą wersję.</p><div class="definition-mini"><strong>Wpływ na testowanie</strong><p>Tester wielokrotnie ocenia kolejne wersje i skutki zmian.</p></div></section>\n<section class="definition-card verification" aria-labelledby="incremental-title" style="margin:22px 0"><div class="definition-label">KOLEJNE CZĘŚCI FUNKCJONALNOŚCI</div><h3 id="incremental-title">Podejście przyrostowe</h3><p class="definition-text">System powstaje przez dodawanie kolejnych części funkcjonalności do istniejącego rozwiązania.</p><div class="definition-mini"><strong>Wpływ na testowanie</strong><p>Sprawdzamy nową część, jej współpracę z wcześniejszymi oraz odpowiednią regresję.</p></div></section>\n<div class="simple"><strong>Najważniejsza różnica</strong>Sekwencyjnie organizujemy fazy. Iteracyjnie ulepszamy rozwiązanie. Przyrostowo rozszerzamy jego możliwości. Iteracje i przyrosty mogą występować razem.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Testowanie zaczyna się przed gotową aplikacją</h3><p>W każdym podejściu można wcześnie oceniać wymagania i projektować sprawdzenia.</p></div>\n<div class="memory"><h3>Iteracja i przyrost to różne pojęcia</h3><p>Poprawa komunikatów istniejącego formularza ilustruje iteracyjne ulepszanie. Dodanie śledzenia zgłoszenia ilustruje rozszerzenie funkcjonalności.</p></div>\n<div class="memory"><h3>Te podejścia mogą się łączyć</h3><p>W jednym projekcie można przyrostowo dodawać funkcje i iteracyjnie je udoskonalać.</p></div>\n<div class="memory"><h3>Regresję dobieramy do zmian i ryzyka</h3><p>Nowa wersja lub funkcja może wpłynąć na wcześniejsze działanie. Samo sprawdzenie nowości nie wystarcza.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — system zgłaszania awarii prądu</h2></div>\n<div class="example"><h3>Mieszkaniec chce zgłosić brak prądu i wiedzieć, co dalej</h3><p>Firma energetyczna tworzy aplikację umożliwiającą zgłoszenie braku prądu pod wskazanym adresem, sprawdzenie statusu i otrzymanie powiadomienia o zakończeniu obsługi awarii. To fikcyjny projekt. Tester korzysta z fikcyjnych adresów i zgłoszeń.</p><p>Poniżej pokazujemy <strong>trzy możliwe sposoby organizacji tego samego projektu</strong>, a nie trzy obowiązkowe etapy.</p>\n<h3>Podejście sekwencyjne — praca w kolejnych fazach</h3><p>Zespół najpierw opracowuje wymagania dla zgłoszeń, statusów i powiadomień, następnie projektuje rozwiązanie i je implementuje.</p><p><strong>Co robi tester?</strong> Już w wymaganiach zauważa brak ustalenia: co ma się wydarzyć, gdy mieszkaniec zgłosi awarię już zarejestrowaną dla tego adresu? Pomaga uzgodnić regułę i przygotowuje przypadki testowe. Gdy odpowiednie fragmenty kodu są dostępne, wykonuje testy dynamiczne.</p><p class="note"><strong>Co pokazuje przykład?</strong> Tester uczestniczy w pracy przed powstaniem kodu. Nie czeka bezczynnie na gotowy system.</p>\n<h3>Podejście iteracyjne — ulepszanie formularza</h3><p>Pierwsza wersja formularza umożliwia wysłanie zgłoszenia. Podczas prób użytkownicy mają jednak problem z wpisaniem adresu i zrozumieniem informacji o brakujących danych.</p><p>W kolejnej iteracji zespół poprawia opisy pól i komunikaty walidacji. Funkcja nadal służy temu samemu celowi, lecz jest łatwiejsza w użyciu.</p><p><strong>Co robi tester?</strong> Sprawdza poprawione komunikaty, zachowanie wpisanych danych po błędzie i wysłanie prawidłowego zgłoszenia. Ocenia, czy poprawki nie zepsuły wcześniejszego działania. Przekazuje wyniki i obserwacje użytkowników.</p><p class="note"><strong>Co pokazuje przykład?</strong> Wracamy do istniejącego rozwiązania i udoskonalamy je na podstawie informacji zwrotnych.</p>\n<h3>Podejście przyrostowe — dodawanie kolejnych funkcji</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Kolejne rozszerzenia możliwości produktu</caption><thead><tr><th scope="col">Przyrost</th><th scope="col">Co otrzymuje użytkownik?</th></tr></thead><tbody>\n<tr><th scope="row">1</th><td>Wysłanie zgłoszenia i otrzymanie jego numeru.</td></tr>\n<tr><th scope="row">2</th><td>Sprawdzanie statusu zgłoszenia.</td></tr>\n<tr><th scope="row">3</th><td>Powiadomienie o zakończeniu obsługi awarii.</td></tr>\n</tbody></table></div>\n<p><strong>Co robi tester?</strong> Przy dodawaniu statusów sprawdza przypisanie właściwego statusu do właściwego zgłoszenia i nadal działające tworzenie zgłoszeń. Przy powiadomieniach sprawdza odbiorcę i moment wysłania oraz odpowiednią regresję wcześniejszych funkcji. Wymagane zachowania uzgadnia z zespołem, zamiast zakładać je samodzielnie.</p><p class="note"><strong>Co pokazuje przykład?</strong> Każdy przyrost rozszerza możliwości produktu. Formularz z pierwszego przyrostu można równocześnie ulepszać w kolejnych iteracjach.</p>\n<div class="failure"><p><b>Wniosek:</b> sposób organizacji pracy zmienia to, kiedy i co tester sprawdza. W każdym wariancie tester analizuje oczekiwania, projektuje sprawdzenia i dostarcza wyniki potrzebne zespołowi.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Sekwencyjnie organizujemy fazy, iteracyjnie ulepszamy rozwiązanie, a przyrostowo rozszerzamy jego możliwości.</p></div>\n</div>\n', 'sections': 'sekcje 2.1 i 2.1.1–2.1.2'}, {'id': 37, 'number': '37', 'title': 'Shift left — wcześniejsze rozpoczynanie testowania', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>Shift left</strong> to podejście polegające na podejmowaniu działań testowych wcześniej w cyklu wytwarzania oprogramowania.</p>\n<div class="definitioncopy"><p>Zamiast czekać na gotową aplikację, zespół ocenia wymagania, projektuje testy przed implementacją i sprawdza dostępne komponenty. Celem jest wcześniejsza informacja o problemach i ograniczenie późniejszych poprawek.</p><p>Wczesna praca może wymagać dodatkowych nakładów, np. przygotowania testów lub rozwijania umiejętności zespołu. Nie oznacza pomijania późniejszych sprawdzeń.</p></div>\n<div class="simple"><strong>Prostymi słowami</strong>Sprawdzamy to, co już można ocenić, zanim powstanie cały system.</div>\n<h3 style="margin-top:24px">Jak można stosować shift left?</h3>\n<ul class="list"><li>Przeglądać wymagania pod kątem niejasności i braków.</li><li>Przygotowywać przypadki testowe przed napisaniem kodu.</li><li>Wcześnie wykonywać analizę statyczną i testy komponentowe.</li><li>Uruchamiać odpowiednie testy automatyczne podczas integracji zmian.</li><li>Sprawdzać właściwości niefunkcjonalne już na poziomie komponentów, gdy jest to możliwe.</li></ul>\n<p class="note"><strong>Ważne:</strong> wcześniejsze testowanie nie oznacza rezygnacji z późniejszych testów całego systemu.</p>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Chodzi o moment podejmowania działań</h3><p>Shift left obejmuje testowanie statyczne i odpowiednio wczesne testy dynamiczne. Nie oznacza wyłącznie przeglądu dokumentacji.</p></div>\n<div class="memory"><h3>Gotowy interfejs nie jest warunkiem rozpoczęcia</h3><p>Można ocenić zapis wymagania i sprawdzić funkcję walidującą, zanim powstanie formularz.</p></div>\n<div class="memory"><h3>Potrzebna jest współpraca</h3><p>Tester wskazuje niejasności i proponuje sprawdzenia. Reguły uzgadnia z programistą oraz właściwymi interesariuszami.</p></div>\n<div class="memory"><h3>Wczesne testy nie zastępują późniejszych</h3><p>Po sprawdzeniu komponentu nadal trzeba ocenić jego współpracę z innymi częściami, cały system i spełnienie potrzeb użytkowników.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — przesyłanie CV w portalu rekrutacyjnym</h2></div>\n<div class="example"><h3>CV ma właściwy rozmiar, ale zostaje odrzucone</h3><p>Firma tworzy formularz aplikowania na ofertę pracy. Początkowe wymaganie brzmi: <strong>„Kandydat może przesłać CV w formacie PDF, maksymalnie 5 MB”.</strong> Tester nie czeka na gotowy formularz. To fikcyjny projekt; sprawdzenia wykorzystują pliki i dane testowe.</p>\n<h3>1. Sprawdza wymaganie przed implementacją</h3><p>Zauważa niejasności: ile dokładnie bajtów oznacza 5 MB, czy plik równy limitowi jest dozwolony, co pokaże aplikacja po odrzuceniu pliku i czy zachowa wpisane dane.</p><p>Zespół uzgadnia: <strong>limit wynosi 5 000 000 bajtów i jest włącznie</strong>. Odrzucenie pliku ma być wyjaśnione i nie może usuwać pozostałych danych formularza.</p>\n<h3>2. Projektuje sprawdzenia przed powstaniem funkcji</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Sprawdzenia rozmiaru — pozostałe warunki pliku są spełnione</caption><thead><tr><th scope="col">Rozmiar poprawnego pliku PDF</th><th scope="col">Oczekiwany wynik kontroli rozmiaru</th></tr></thead><tbody>\n<tr><th scope="row">4 999 999 bajtów</th><td>Plik mieści się w limicie.</td></tr>\n<tr><th scope="row">5 000 000 bajtów</th><td>Plik mieści się w limicie.</td></tr>\n<tr><th scope="row">5 000 001 bajtów</th><td>Plik przekracza limit i powinien zostać odrzucony z wyjaśnieniem.</td></tr>\n</tbody></table></div>\n<p>Tester osobno uwzględnia sprawdzenie formatu i zachowania danych formularza. Poprawny rozmiar sam w sobie nie dowodzi poprawności całego pliku.</p>\n<h3>3. Zespół sprawdza regułę bez gotowego interfejsu</h3><p>Programista tworzy testy komponentowe funkcji sprawdzającej rozmiar. Test dla dokładnego limitu ujawnia błędne użycie <code>&lt;</code> zamiast <code>&lt;=</code>.</p><p><strong>Przykładowy problem:</strong> 5 000 000 bajtów zostaje odrzucone, choć wymaganie dopuszcza tę wartość. Zespół poprawia warunek i ponownie uruchamia testy, zanim kandydaci zaczną korzystać z formularza.</p>\n<h3>4. Tester później sprawdza cały formularz</h3><p>Po udostępnieniu formularza tester przesyła pliki testowe, sprawdza komunikaty i zachowanie wpisanych danych po odrzuceniu pliku. Dla zaakceptowanego CV sprawdza również jego powiązanie z właściwą aplikacją rekrutacyjną.</p>\n<div class="failure"><p><b>Dlaczego te testy nadal są potrzebne?</b> Poprawna funkcja sprawdzająca rozmiar nie dowodzi, że formularz przekazuje właściwy rozmiar, pokazuje komunikat i poprawnie zapisuje załącznik. Shift left daje wcześniejszą informację, a dalsze testy oceniają całość.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Wcześniej sprawdzaj to, co już można ocenić — i nadal testuj całość, gdy będzie dostępna.</p></div>\n</div>\n', 'sections': 'sekcja 2.1.5'}, {'id': 38, 'number': '38', 'title': 'DevOps i testowanie — współpraca, automatyzacja i szybka informacja zwrotna', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>DevOps</strong> to podejście organizacyjne łączące współpracę osób odpowiedzialnych za wytwarzanie oprogramowania — w tym testowanie — oraz jego utrzymanie i eksploatację.</p>\n<div class="definitioncopy"><p>Wspiera wspólne cele, szybką informację zwrotną i automatyzację budowania, sprawdzania oraz dostarczania zmian. Obejmuje kulturę współpracy i praktyki techniczne, a nie tylko zestaw narzędzi.</p></div>\n<section class="definition-card verification" aria-labelledby="devops-testing-title" style="margin:22px 0"><div class="definition-label">OCENA JAKOŚCI PRZY CZĘSTYCH ZMIANACH</div><h3 id="devops-testing-title">Testowanie w DevOps</h3><p class="definition-text">To zbiór czynności służących wykrywaniu defektów i ocenie jakości oprogramowania oraz powiązanych produktów pracy, włączonych w sposób współpracy i dostarczania zmian przyjęty w DevOps. Dostarcza zespołowi szybkiej informacji o jakości zmian i związanym z nimi ryzyku.</p><div class="definition-mini"><strong>Co obejmuje?</strong><p>Obejmuje planowanie i przygotowanie sprawdzeń, ich wykonywanie, analizę oraz przekazywanie wyników. Łączy testowanie statyczne i dynamiczne, manualne i automatyczne. Automatyzacja wspiera częste sprawdzanie zmian, a tester współpracuje z programistami i osobami utrzymującymi system.</p><p>To opis testowania w kontekście DevOps, a nie odrębny poziom testów. Wyniki pomagają podejmować decyzje o dalszym dostarczaniu zmian; nie gwarantują braku defektów.</p></div></section>\n<div class="simple"><strong>Prostymi słowami</strong>Zespół współpracuje, aby sprawnie dostarczać zmiany i utrzymywać właściwą jakość działającego systemu.</div>\n<h3 style="margin-top:24px">Co zmienia się w testowaniu?</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Wpływ DevOps na pracę testową</caption><thead><tr><th scope="col">Obszar</th><th scope="col">Znaczenie</th></tr></thead><tbody>\n<tr><th scope="row">Szybka informacja zwrotna</th><td>Wyniki sprawdzeń pomagają wcześniej zauważyć problem po zmianie kodu.</td></tr>\n<tr><th scope="row">Automatyczna regresja</th><td>Powtarzalne testy sprawdzają, czy zmiana nie pogorszyła wcześniejszego działania.</td></tr>\n<tr><th scope="row">Środowiska testowe</th><td>Automatyzacja pomaga przygotowywać i utrzymywać środowiska.</td></tr>\n<tr><th scope="row">Jakość niefunkcjonalna</th><td>Zespół zwraca uwagę także na wydajność, niezawodność i inne właściwości.</td></tr>\n<tr><th scope="row">Współpraca</th><td>Tester współpracuje z programistami i osobami utrzymującymi system.</td></tr>\n</tbody></table></div>\n<p class="note">W dalszym przykładzie zautomatyzowany proces wykonuje kolejne uzgodnione działania: budowanie aplikacji i testy. Reguła blokowania przejścia po niezaliczonym teście jest ustaleniem tego projektu.</p>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>DevOps to współpraca, nie jedno narzędzie</h3><p>Samo zainstalowanie narzędzia do uruchamiania testów nie tworzy współpracy między wytwarzaniem i utrzymaniem.</p></div>\n<div class="memory"><h3>Tester nadal analizuje i ocenia</h3><p>Pomaga ustalać właściwe sprawdzenia, przygotowuje je i interpretuje wyniki. Uruchomienie testu to tylko część pracy.</p></div>\n<div class="memory"><h3>Automatyzacja wymaga utrzymania</h3><p>Testy, dane, konfiguracja środowisk i proces dostarczania zmian wymagają pracy. Niestabilne wyniki utrudniają ocenę produktu.</p></div>\n<div class="memory"><h3>Zaliczone testy nie dają gwarancji</h3><p>Sprawdzenia obejmują określony zakres. Nadal potrzebne jest testowanie manualne, szczególnie z perspektywy użytkownika.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — aplikacja do słuchania audiobooków</h2></div>\n<div class="example"><h3>Po ponownym otwarciu nagranie zaczyna się od początku</h3><p>Użytkownik zatrzymuje audiobook w miejscu <strong>12 minut i 30 sekund</strong>. Po ponownym uruchomieniu aplikacji chce kontynuować od tego momentu.</p><p><strong>Wymaganie naszego projektu:</strong> zapisana pozycja ma być zachowana po zamknięciu i ponownym uruchomieniu aplikacji. Tester korzysta z testowego konta i nagrania. Przed zamknięciem aplikacji potwierdza zakończenie zapisu pozycji.</p><p>Programista zmienia sposób zapisywania pozycji odsłuchu. Zespół sprawdza zmianę przed udostępnieniem użytkownikom.</p>\n<h3>Jak wygląda praca zespołu?</h3><ol class="goal-examples">\n<li><h3>Tester pomaga ustalić sprawdzenia</h3><p>Uwzględnia zatrzymanie nagrania, zapis pozycji, zamknięcie aplikacji i wznowienie odsłuchu. Oczekiwany wynik wynika z uzgodnionego wymagania.</p></li>\n<li><h3>Programista przekazuje zmianę do repozytorium</h3><p>Zautomatyzowany proces buduje aplikację i uruchamia przygotowane sprawdzenia. Wyniki są dostępne dla zespołu.</p></li>\n<li><h3>Test integracyjny ujawnia problem</h3><p>Sprawdzenie współpracy zapisu i odczytu pozycji nie przechodzi: zamiast wznowienia od <strong>12:30</strong> odtwarzanie zaczyna się od <strong>0:00</strong>. W tym projekcie taki wynik blokuje przejście zmiany do kolejnego etapu. Sam wynik nie przesądza jeszcze o przyczynie.</p></li>\n<li><h3>Zespół analizuje wynik i poprawia rozwiązanie</h3><p>Programista ustala przyczynę. Tester pomaga odtworzyć sytuację i ocenić zakres dalszych sprawdzeń. Osoby utrzymujące system pomagają zapewnić właściwą konfigurację środowiska i dostęp do informacji potrzebnych do analizy.</p></li>\n<li><h3>Sprawdzenia są uruchamiane ponownie</h3><p>Zespół sprawdza naprawę oraz odpowiednią regresję. Tester ocenia też działającą aplikację: czy komunikaty są zrozumiałe i czy użytkownik może wygodnie wznowić odsłuch. Przekazuje wyniki potrzebne do dalszych decyzji.</p></li>\n</ol>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="devops-benefit-title"><div class="definition-label">KORZYŚĆ</div><h3 id="devops-benefit-title">Problem ujawniony wcześniej</h3><p>Sprawdzenie może wykryć utratę pozycji przed udostępnieniem zmiany użytkownikom. Zespół otrzymuje szybki sygnał do analizy.</p></section>\n<section class="definition-card validation" aria-labelledby="devops-risk-title"><div class="definition-label">OGRANICZENIE</div><h3 id="devops-risk-title">Proces wymaga przygotowania</h3><p>Niepoprawne dane, niestabilny test lub niewłaściwe środowisko mogą utrudnić interpretację wyniku. Automatyzacja wymaga zasobów i utrzymania.</p></section>\n</div>\n<div class="failure"><p><b>Wniosek:</b> wartość daje połączenie współpracy, odpowiednich sprawdzeń i szybkich wyników. Sam fakt automatycznego uruchomienia testów nie dowodzi, że produkt spełnia wszystkie oczekiwania.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>W DevOps szybkie wyniki testów pomagają zespołowi podejmować decyzje o zmianach i jakości.</p></div>\n</div>\n', 'sections': 'sekcja 2.1.4'}, {'id': 39, 'number': '39', 'title': 'Testowanie pielęgnacyjne', 'content': '<div class="body">\n<section aria-labelledby="definition-title">\n<div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>Testowanie pielęgnacyjne</strong> dotyczy zmian w systemie, który został już wdrożony i jest użytkowany. Pozwala ocenić poprawność zmian oraz wykryć ich niepożądany wpływ na dotychczasowe działanie.</p>\n<div class="definitioncopy"><p>Jest potrzebne również przy zmianie środowiska, migracji danych i wycofywaniu systemu z użytkowania.</p></div>\n<div class="simple"><strong>Prostymi słowami</strong>System już działa, ale coś w nim lub w jego otoczeniu się zmienia — sprawdzamy skutki tej zmiany.</div>\n<h3 style="margin-top:24px">Kiedy jest potrzebne?</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Sytuacje wymagające testowania pielęgnacyjnego</caption><thead><tr><th scope="col">Sytuacja</th><th scope="col">Przykład</th></tr></thead><tbody>\n<tr><th scope="row">Modyfikacja systemu</th><td>Poprawka defektu albo rozbudowa istniejącej funkcji.</td></tr>\n<tr><th scope="row">Aktualizacja lub migracja środowiska</th><td>Przeniesienie aplikacji na nowy serwer lub aktualizacja bazy danych.</td></tr>\n<tr><th scope="row">Migracja danych</th><td>Przeniesienie danych i sprawdzenie poprawności ich przekształcenia.</td></tr>\n<tr><th scope="row">Wycofanie systemu</th><td>Sprawdzenie archiwizacji danych i możliwości ich późniejszego odczytu.</td></tr>\n</tbody></table></div>\n<p class="note">Zakres zależy od <strong>ryzyka, wielkości zmiany i rozmiaru systemu</strong>. Analiza wpływu pomaga ustalić, które obszary wymagają sprawdzenia.</p>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div>\n<div class="memory-grid">\n<div class="memory"><h3>Testowanie pielęgnacyjne</h3><p>Opisuje kontekst: sprawdzamy użytkowany system w związku ze zmianą.</p></div>\n<div class="memory"><h3>Testowanie potwierdzające</h3><p>Sprawdza skuteczność poprawki konkretnego defektu.</p></div>\n<div class="memory"><h3>Testowanie regresji</h3><p>Sprawdza, czy zmiana nie pogorszyła wcześniejszego działania.</p></div>\n<div class="memory"><h3>Szerszy zakres niż naprawy</h3><p>Testowanie pielęgnacyjne może obejmować testy potwierdzające i regresję. Nie ogranicza się do naprawiania defektów.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — aktualizacja systemu parkingowego</h2></div>\n<div class="example"><h3>Nowy cennik na działającym parkingu</h3>\n<p>Parking przy centrum sportowym ma działający system biletów i opłat. Od poniedziałku zmienia się cennik. W naszym przykładzie ustalono następujące zasady:</p>\n<ul class="list"><li>Bilety pobrane <strong>przed poniedziałkiem o 00:00</strong> są rozliczane według starego cennika.</li><li>Bilety pobrane <strong>od poniedziałku o 00:00</strong> są rozliczane według nowego.</li><li>Abonamenty miesięczne zachowują ważność.</li></ul>\n<h3>Co robi tester?</h3>\n<ol class="goal-examples">\n<li><h3>Doprecyzowuje zasady zmiany</h3><p>Sprawdza, czy dokumentacja jasno określa sposób rozliczania biletów pobranych przed zmianą.</p></li>\n<li><h3>Sprawdza moment przejścia</h3><p>Przygotowuje bilety z niedzieli o 23:59 i poniedziałku o 00:00, a następnie porównuje opłaty z oczekiwaniami.</p></li>\n<li><h3>Sprawdza trwający postój</h3><p>Weryfikuje rozliczenie kierowcy, który wjechał w niedzielę, a wyjechał w poniedziałek.</p></li>\n<li><h3>Wykonuje regresję</h3><p>Sprawdza abonamenty, płatności i otwieranie szlabanu po opłaceniu biletu.</p></li>\n<li><h3>Przekazuje wyniki</h3><p>Dokumentuje wykryte problemy oraz obszary, których nie udało się sprawdzić.</p></li>\n</ol>\n<div class="failure"><p><b>Wykryty problem:</b> system nalicza nową cenę także za bilet pobrany w niedzielę. Tester zgłasza defekt, podając godzinę wjazdu, godzinę płatności oraz oczekiwaną i rzeczywistą kwotę.</p></div>\n</div></section>\n</div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Sprawdzamy, czy zmiana działa poprawnie i jaki ma wpływ na użytkowany system.</p></div>\n</div>\n', 'sections': 'sekcja 2.3'}, {'id': 40, 'number': '40', 'title': 'Piramida testów', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicja i znaczenie</h2></div>\n<p class="lead"><strong>Piramida testów</strong> to model przedstawiający grupy testów o różnym zakresie sprawdzanej funkcjonalności. Pomaga zespołowi planować automatyzację i rozkładać wysiłek testowy.</p>\n<div class="definitioncopy"><p>U podstawy znajdują się liczne, małe, szybkie i dobrze odizolowane testy. Wyżej testy obejmują większą część systemu, zależą od większej liczby elementów i zwykle wykonują się dłużej. Na szczycie jest mniej rozbudowanych testów całych przepływów.</p></div>\n<div class="simple"><strong>Prostymi słowami</strong>Wiele szczegółów sprawdzamy małymi testami, a wybrane kluczowe scenariusze — od początku do końca.</div>\n<h3 style="margin-top:24px">Jakie warstwy wyróżniamy?</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Popularny wariant piramidy testów</caption><thead><tr><th scope="col">Warstwa</th><th scope="col">Co sprawdza?</th><th scope="col">Charakterystyka</th></tr></thead><tbody>\n<tr><th scope="row">Podstawa — testy komponentowe</th><td>Pojedyncze elementy, np. funkcję obliczającą wynik.</td><td>Liczne, szybkie, z niewieloma zależnościami.</td></tr>\n<tr><th scope="row">Środek — testy integracyjne</th><td>Współpracę elementów, np. usługi z bazą danych.</td><td>Obejmują połączenia i wymianę danych.</td></tr>\n<tr><th scope="row">Szczyt — testy od początku do końca (E2E)</th><td>Pełny przepływ przez współpracujące części systemu.</td><td>Zwykle wolniejsze i bardziej złożone.</td></tr>\n</tbody></table></div>\n<p class="note">Liczba i nazwy warstw mogą być różne. ISTQB nie narzuca jednego podziału ani obowiązkowych proporcji procentowych.</p>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div>\n<div class="memory-grid">\n<div class="memory"><h3>Warstwy uzupełniają się</h3><p>Poprawny wynik małego testu nie potwierdza całego przepływu.</p></div>\n<div class="memory"><h3>To model rozłożenia testów</h3><p>Piramida nie określa kolejności wykonywania testów.</p></div>\n<div class="memory"><h3>Bez sztywnych proporcji</h3><p>Dobór testów zależy od systemu i ryzyka, a nie od sztywnej proporcji.</p></div>\n<div class="memory"><h3>Liczy się zakres sprawdzeń</h3><p>Sama liczba testów nie świadczy o jakości — istotne jest to, co sprawdzają.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — rozliczanie wspólnego wyjazdu</h2></div>\n<div class="example"><h3>Jeden wydatek, czterech uczestników</h3><p>Czworo znajomych korzysta z aplikacji, która dzieli wspólne wydatki. Jedna osoba płaci <strong>240 zł za paliwo</strong>, a koszt ma zostać podzielony równo między wszystkich.</p><p>Każdemu przypada <strong>60 zł</strong>. Osoba płacąca powinna otrzymać od pozostałych łącznie <strong>180 zł</strong>.</p>\n<h3>Jak sprawdzamy funkcję na poszczególnych warstwach?</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Ta sama funkcja sprawdzana w różnym zakresie</caption><thead><tr><th scope="col">Warstwa</th><th scope="col">Praktyczne sprawdzenie</th></tr></thead><tbody>\n<tr><th scope="row">Testy komponentowe</th><td>Sprawdzamy samą funkcję obliczeniową: 240 zł ÷ 4 = 60 zł. Osobne testy obejmują inne kwoty, liczbę uczestników i zaokrąglenia.</td></tr>\n<tr><th scope="row">Testy integracyjne</th><td>Sprawdzamy, czy usługa zapisuje wydatek w bazie i po ponownym odczycie zwraca właściwą kwotę, płatnika oraz uczestników.</td></tr>\n<tr><th scope="row">Test E2E</th><td>Użytkownik otwiera wyjazd, dodaje wydatek 240 zł, wskazuje cztery osoby i zapisuje. Sprawdzamy wyświetlone rozliczenie, a następnie odświeżamy stronę i potwierdzamy zachowanie danych.</td></tr>\n</tbody></table></div>\n<h3>Co robi tester?</h3><ol class="goal-examples">\n<li><h3>Uzgadnia reguły rozliczania</h3><p>Doprecyzowuje szczególnie sposób zaokrąglania kwot.</p></li>\n<li><h3>Pomaga wybrać warstwy</h3><p>Współpracuje z programistami przy wyborze warstw, na których najlepiej sprawdzić poszczególne ryzyka.</p></li>\n<li><h3>Przygotowuje scenariusze integracyjne i E2E</h3><p>Uwzględnia zapis oraz ponowny odczyt danych.</p></li>\n<li><h3>Analizuje wyniki</h3><p>Poprawne obliczenie w teście komponentowym nie oznacza jeszcze, że aplikacja prawidłowo zapisuje i pokazuje rozliczenie.</p></li>\n</ol><div class="failure"><p><b>Wykryty problem:</b> funkcja poprawnie oblicza 60 zł na osobę, ale podczas zapisu pomijany jest jeden uczestnik. Testy obliczeń przechodzą, natomiast sprawdzenie współpracy z bazą ujawnia problem.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Wiele małych testów sprawdza szczegóły, a wybrane testy całościowe sprawdzają, czy elementy działają razem.</p></div>\n</div>\n', 'sections': 'sekcja 5.1.6'}, {'id': 41, 'number': '41', 'title': 'Monitorowanie testów i nadzór nad testami', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Dwie osobne definicje</h2></div>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="monitoring-title"><div class="definition-label">INFORMACJE O PRZEBIEGU</div><h3 id="monitoring-title">Monitorowanie testów</h3><p class="definition-text">To zbieranie informacji o przebiegu testowania, aby oceniać postęp, porównywać go z planem i sprawdzać spełnienie kryteriów wyjścia.</p></section>\n<section class="definition-card validation" aria-labelledby="control-title"><div class="definition-label">REAKCJA I DZIAŁANIA</div><h3 id="control-title">Nadzór nad testami</h3><p class="definition-text">To wykorzystywanie zebranych informacji do kierowania testowaniem i podejmowania działań korygujących, np. zmiany priorytetów, harmonogramu lub przydziału zasobów.</p></section>\n</div>\n<div class="simple"><strong>Prostymi słowami</strong>Monitorowanie pokazuje, jak przebiega praca. Nadzór oznacza reagowanie na to, czego się dowiedzieliśmy.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Informacje i działania</h3><p>Monitorowanie dostarcza informacji, a nadzór prowadzi do działań.</p></div>\n<div class="memory"><h3>Obserwacja to początek</h3><p>Samo zauważenie opóźnienia nie usuwa jego przyczyny.</p></div>\n<div class="memory"><h3>Uzgodnione odpowiedzialności</h3><p>Zmiany planu wymagają uzgodnienia zgodnie z odpowiedzialnościami w zespole.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — odbieranie przesyłki z automatu</h2></div>\n<div class="example"><h3>Postęp odbiega od planu</h3><p>Zespół testuje nową wersję aplikacji. Klient powinien otworzyć właściwą skrytkę, odebrać przesyłkę i zobaczyć potwierdzenie odbioru.</p>\n<p>Do końca środy zaplanowano wykonanie <strong>60 przypadków testowych</strong>. Wykonano <strong>40</strong>, a część pozostałych jest zablokowana z powodu niedostępności testowego automatu.</p>\n<p>Dodatkowo wykryto problem: <strong>aplikacja potwierdza odbiór, mimo że skrytka się nie otworzyła</strong>.</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Od informacji o testach do działania</caption><thead><tr><th scope="col">Monitorowanie — co ustalono?</th><th scope="col">Nadzór — jak zareagowano?</th></tr></thead><tbody>\n<tr><th scope="row">Wykonano 40 zamiast planowanych 60 przypadków.</th><td>Zaktualizowano harmonogram, uwzględniając zaległe sprawdzenia.</td></tr>\n<tr><th scope="row">Brak automatu blokuje część testów.</th><td>Uzgodniono termin udostępnienia urządzenia i odpowiedzialną osobę.</td></tr>\n<tr><th scope="row">Potwierdzenie odbioru może być nieprawidłowe.</th><td>Nadano pierwszeństwo sprawdzeniom otwierania skrytki i potwierdzania odbioru.</td></tr>\n<tr><th scope="row">Część sprawdzeń można wykonać bez urządzenia.</th><td>Do czasu jego udostępnienia zespół wykonuje te testy, zaznaczając ich ograniczenia.</td></tr>\n</tbody></table></div>\n<h3>Co robi tester?</h3><ol class="goal-examples">\n<li><h3>Aktualizuje stan testów</h3><p>Zapisuje wyniki i wskazuje zablokowane przypadki.</p></li>\n<li><h3>Wyjaśnia odchylenie od planu</h3><p>Przedstawia przyczynę opóźnienia oraz jego wpływ na zakres testów.</p></li>\n<li><h3>Proponuje najważniejsze sprawdzenia</h3><p>Wskazuje testy dotyczące problemu z potwierdzaniem odbioru.</p></li>\n<li><h3>Realizuje uzgodnione zmiany</h3><p>Po uzgodnieniu zmian realizuje nowy plan i sprawdza, czy przeszkody zostały usunięte.</p></li>\n</ol>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Obserwujemy postęp, oceniamy odchylenia i reagujemy, aby osiągnąć cele testowania.</p></div>\n</div>\n', 'sections': 'sekcja 5.3'}, {'id': 42, 'number': '42', 'title': 'Metryki, raporty i komunikowanie wyników testowania', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicje i znaczenie</h2></div>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="metrics-title"><div class="definition-label">MIARY</div><h3 id="metrics-title">Metryki testowania</h3><p class="definition-text">To miary wykorzystywane do oceny postępu, jakości produktu i skuteczności testowania. Mogą dotyczyć wyników, pokrycia, defektów, ryzyka, czasu oraz kosztów.</p></section>\n<section class="definition-card validation" aria-labelledby="reporting-title"><div class="definition-label">INFORMACJE DLA ODBIORCÓW</div><h3 id="reporting-title">Raportowanie testów</h3><p class="definition-text">To podsumowywanie i przekazywanie informacji o testowaniu, aby wspierać decyzje interesariuszy.</p></section>\n</div>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Dwa rodzaje raportów</caption><thead><tr><th scope="col">Rodzaj raportu</th><th scope="col">Zastosowanie</th></tr></thead><tbody>\n<tr><th scope="row">Raport z postępu testów</th><td>Przedstawia bieżący stan, przeszkody, ryzyka i dalszy plan.</td></tr>\n<tr><th scope="row">Raport z zakończenia testów</th><td>Podsumowuje wyniki, realizację celów, odstępstwa i pozostałe ryzyko.</td></tr>\n</tbody></table></div><p class="note">Treść, forma i częstotliwość komunikacji zależą od odbiorców.</p>\n<div class="simple"><strong>Prostymi słowami</strong>Liczby pokazują część sytuacji. Raport wyjaśnia, co te liczby oznaczają dla zespołu i użytkowników.</div>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Wynik testów a jakość</h3><p>90% zaliczonych testów nie oznacza 90% jakości aplikacji.</p></div>\n<div class="memory"><h3>Wpływ ma znaczenie</h3><p>Jeden poważny problem może mieć większe znaczenie niż wiele zaliczonych przypadków.</p></div>\n<div class="memory"><h3>Przypadek a defekt</h3><p>Liczba niezaliczonych przypadków nie musi odpowiadać liczbie defektów.</p></div>\n<div class="memory"><h3>Pokaż ograniczenia</h3><p>Raport powinien jasno pokazywać, czego jeszcze nie wiemy.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — czy możemy udostępnić aplikację?</h2></div>\n<div class="example"><h3>Podsumowanie testów automatu paczkowego</h3><p>Kontynuujemy przykład z <a href="/temat/41">tematu 41 — monitorowanie i nadzór</a>. Na piątek przygotowano zestaw <strong>100 przypadków testowych</strong>. W podsumowaniu każdy przypadek ma jeden aktualny status:</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Stan zestawu na moment raportowania</caption><thead><tr><th scope="col">Status</th><th scope="col">Liczba przypadków</th></tr></thead><tbody>\n<tr><th scope="row">Zaliczone</th><td>72</td></tr><tr><th scope="row">Niezaliczone</th><td>8</td></tr><tr><th scope="row">Zablokowane</th><td>10</td></tr><tr><th scope="row">Nierozpoczęte</th><td>10</td></tr><tr><th scope="row">Łącznie</th><td><strong>100</strong></td></tr>\n</tbody></table></div>\n<p>Wykonano <strong>80 ze 100 przypadków</strong>, czyli <strong>80% zaplanowanego zestawu</strong>. Spośród wykonanych zaliczono <strong>72 z 80</strong>, czyli <strong>90%</strong>.</p><p>Jednak nadal występuje problem z potwierdzaniem odbioru bez otwarcia skrytki.</p>\n<h3>Przykładowy komunikat testera</h3><div class="failure"><p>„Wykonaliśmy 80 ze 100 zaplanowanych przypadków. 72 zaliczono, a 8 zakończyło się niepowodzeniem. Dziesięć jest zablokowanych, a dziesięciu jeszcze nie rozpoczęto. Nadal występuje problem z potwierdzaniem odbioru bez otwarcia skrytki. Uzgodnione kryterium wyjścia dotyczące tego problemu nie zostało spełnione. Potrzebujemy poprawki, sprawdzenia jej skuteczności i dokończenia pozostałych testów”.</p></div>\n<h3>Co robi tester?</h3><ol class="goal-examples">\n<li><h3>Sprawdza aktualność danych</h3><p>Weryfikuje wyniki i wskazuje badaną wersję aplikacji.</p></li>\n<li><h3>Wyjaśnia wskaźniki</h3><p>Podaje sposób obliczenia wskaźników: 80/100 dotyczy wykonania zestawu, a 72/80 — zaliczenia wykonanych przypadków.</p></li>\n<li><h3>Pokazuje znaczenie wyników</h3><p>Łączy liczby z konkretnymi problemami i ryzykiem.</p></li>\n<li><h3>Dostosowuje komunikat do odbiorcy</h3><p>Programiście przekazuje szczegóły odtworzenia, a osobie decydującej o wydaniu — wpływ na odbiór przesyłek i niespełnione kryteria.</p></li>\n<li><h3>Wskazuje ograniczenia</h3><p>W podsumowaniu zapisuje także ograniczenia i niewykonane sprawdzenia.</p></li>\n</ol></div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Przekazujemy liczby wraz z ich znaczeniem, ograniczeniami i pozostałym ryzykiem.</p></div>\n</div>\n', 'sections': 'sekcje 5.3.1–5.3.3'}, {'id': 43, 'number': '43', 'title': 'Agile i testowanie w podejściu zwinnym', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Dwie osobne definicje</h2></div>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="agile-title"><div class="definition-label">PODEJŚCIE DO WYTWARZANIA</div><h3 id="agile-title">Agile</h3><p class="definition-text">To podejście do wytwarzania oprogramowania oparte na wartościach i zasadach wspierających współpracę, dostarczanie działającego produktu oraz reagowanie na zmiany. Zespół wykorzystuje doświadczenia i informacje od użytkowników do dostosowywania dalszej pracy.</p><div class="definition-mini"><strong>Plan i dokumentacja nadal pomagają</strong><p>Planowanie, dokumentacja i narzędzia pozostają potrzebne — powinny wspierać realizację celu.</p></div></section>\n<section class="definition-card validation" aria-labelledby="agile-testing-title"><div class="definition-label">OCENA JAKOŚCI PRZY KOLEJNYCH ZMIANACH</div><h3 id="agile-testing-title">Testowanie w podejściu zwinnym</h3><p class="definition-text">To testowanie dostosowane do zwinnego sposobu wytwarzania. Tester współpracuje z zespołem podczas doprecyzowywania potrzeb, przygotowania i sprawdzania kolejnych zmian. Szybka informacja zwrotna oraz regresja pomagają oceniać wpływ częstych modyfikacji.</p></section>\n</div>\n<div class="simple"><strong>Prostymi słowami</strong>Rozwijamy produkt małymi krokami, sprawdzamy efekty i wykorzystujemy to, czego się nauczyliśmy.</div>\n<p class="note">Kontekst testowania: ISTQB CTFL 4.0.1, sekcja 2.1.1. Wartości Agile: <a href="https://agilemanifesto.org/iso/pl/manifesto.html" target="_blank" rel="noopener noreferrer">Manifest programowania zwinnego</a>.</p>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Agile a Scrum</h3><p>Agile i Scrum to różne pojęcia. Podstawy Scrum opisuje <a href="/temat/44">temat 44</a>.</p></div>\n<div class="memory"><h3>Testowanie podczas tworzenia</h3><p>Testowanie towarzyszy tworzeniu produktu.</p></div>\n<div class="memory"><h3>Oceń wpływ zmiany</h3><p>Zmiana wymaga oceny wpływu na wcześniejsze działanie.</p></div>\n<div class="memory"><h3>Tempo i jakość</h3><p>Szybkie dostarczanie wymaga dbałości o jakość.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — zapisy wolontariuszy w schronisku</h2></div>\n<div class="example"><h3>Informacja od użytkowników zmienia rozwiązanie</h3><p>Schronisko chce zastąpić telefoniczne zapisy na spacery z psami prostą aplikacją.</p><p>Pierwsza wersja pozwala wyświetlić wolne terminy i zapisać się na spacer. Podczas sprawdzania jej z wolontariuszami okazuje się, że <strong>sama godzina nie wystarcza — użytkownik musi wiedzieć, jak długo potrwa spacer</strong>.</p><p>Zespół doprecyzowuje potrzebę i dodaje godzinę zakończenia. Przypomnienia SMS pozostawia jako możliwe późniejsze rozszerzenie.</p>\n<h3>Co robi tester?</h3><ol class="goal-examples">\n<li><h3>Doprecyzowuje potrzebę przed implementacją</h3><p>Pyta, co oznacza „wolny termin” i jakie informacje są potrzebne wolontariuszowi.</p></li>\n<li><h3>Uzgadnia przykłady podczas tworzenia funkcji</h3><p>Omawia wolne miejsce, pełny termin i rezygnację uczestnika.</p></li>\n<li><h3>Sprawdza zmianę</h3><p>Weryfikuje godziny rozpoczęcia i zakończenia oraz poprawność zapisów.</p></li>\n<li><h3>Wykonuje regresję</h3><p>Sprawdza, czy wcześniejsza możliwość anulowania zapisu nadal działa.</p></li>\n<li><h3>Przekazuje wyniki</h3><p>Pomaga zespołowi ocenić, czy rozwiązanie odpowiada potrzebie schroniska.</p></li>\n</ol></div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Sprawdzamy kolejne zmiany i wykorzystujemy informację zwrotną do rozwijania produktu.</p></div>\n</div>\n', 'sections': 'sekcja 2.1.1'}, {'id': 44, 'number': '44', 'title': 'Scrum — podstawy i praca testera w Sprincie', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Definicje i podstawy</h2></div>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="scrum-title"><div class="definition-label">RAMY POSTĘPOWANIA</div><h3 id="scrum-title">Scrum</h3><p class="definition-text">To lekkie ramy postępowania pomagające zespołowi dostarczać wartość przy rozwiązywaniu złożonych problemów. Opiera się na przejrzystości, inspekcji i adaptacji.</p></section>\n<section class="definition-card validation" aria-labelledby="sprint-title"><div class="definition-label">PRACA WOKÓŁ WSPÓLNEGO CELU</div><h3 id="sprint-title">Sprint</h3><p class="definition-text">To wydarzenie o stałej długości, maksymalnie jednego miesiąca, w którym zespół pracuje nad Celem Sprintu i tworzy użyteczny Przyrost. Obejmuje również potrzebne sprawdzenia jakości.</p></section>\n</div>\n<h3 style="margin-top:24px">Kto tworzy Scrum Team?</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Trzy odpowiedzialności w Scrum Team</caption><thead><tr><th scope="col">Odpowiedzialność</th><th scope="col">Znaczenie</th></tr></thead><tbody>\n<tr><th scope="row">Product Owner</th><td>Maksymalizacja wartości produktu i skuteczne zarządzanie Product Backlogiem.</td></tr>\n<tr><th scope="row">Scrum Master</th><td>Wspieranie skuteczności zespołu i stosowania Scrum.</td></tr>\n<tr><th scope="row">Developers</th><td>Tworzenie użytecznego Przyrostu — obejmuje także kompetencje testowe.</td></tr>\n</tbody></table></div>\n<p class="note">Scrum nie wyróżnia osobnej odpowiedzialności „tester”. Osoba wykonująca testy przy tworzeniu Przyrostu należy do Developers; to określenie obejmuje więcej niż programistów.</p>\n<h3>Podstawowe pojęcia</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Artefakty i wymagania ukończenia</caption><thead><tr><th scope="col">Pojęcie</th><th scope="col">Znaczenie</th></tr></thead><tbody>\n<tr><th scope="row">Product Backlog</th><td>Uporządkowana lista potrzeb dotyczących rozwoju produktu.</td></tr>\n<tr><th scope="row">Sprint Backlog</th><td>Cel Sprintu, wybrane elementy i plan ich realizacji.</td></tr>\n<tr><th scope="row">Przyrost</th><td>Użyteczny rezultat spełniający Definition of Done.</td></tr>\n<tr><th scope="row">Definition of Done</th><td>Wspólne wymagania jakościowe określające ukończenie Przyrostu.</td></tr>\n</tbody></table></div>\n<p class="note">Praktyczne rozszerzenie kontekstu ISTQB CTFL 4.0.1. Definicje i zasady Scrum opracowano na podstawie <a href="https://scrumguides.org/scrum-guide.html" target="_blank" rel="noopener noreferrer">oficjalnego Scrum Guide (2020)</a>. Przykład jest autorski.</p>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Cel Daily Scrum</h3><p>Daily Scrum służy ocenie postępu do celu i dostosowaniu planu.</p></div>\n<div class="memory"><h3>Testowanie w Sprincie</h3><p>Testowanie odbywa się w Sprincie.</p></div>\n<div class="memory"><h3>Wspólna definicja ukończenia</h3><p>Niespełnienie Definition of Done oznacza, że praca nie jest częścią ukończonego Przyrostu.</p></div>\n<div class="memory"><h3>Ocena i dalsze kierunki</h3><p>Sprint Review służy wspólnej ocenie rezultatu i dalszych kierunków.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — ostatnie miejsce na spacer</h2></div>\n<div class="example"><h3>Wspólny cel i równoczesne zapisy</h3><p>Zespół rozwija aplikację schroniska w dwutygodniowym Sprincie.</p><p><strong>Cel Sprintu:</strong> wolontariusz może samodzielnie zapisać się na dostępny spacer i zrezygnować z udziału.</p><p>Na jeden termin pozostało jedno miejsce. Tester sprawdza sytuację, w której <strong>dwie osoby próbują zająć je jednocześnie</strong>.</p>\n<h3>Co robi tester?</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Praca testera podczas Sprintu</caption><thead><tr><th scope="col">Moment pracy</th><th scope="col">Co robi tester w naszym przykładzie?</th></tr></thead><tbody>\n<tr><th scope="row">Sprint Planning</th><td>Wskazuje ryzyko podwójnego zapisu i potrzebę dwóch kont testowych.</td></tr>\n<tr><th scope="row">Praca w Sprincie</th><td>Z programistą sprawdza równoczesne zapisy. Oczekiwany wynik: jedno potwierdzenie, druga osoba otrzymuje informację o braku miejsca.</td></tr>\n<tr><th scope="row">Daily Scrum</th><td>Informuje, że problem z podwójnym zapisem zagraża osiągnięciu celu. Wspólnie z Developers dostosowuje plan pracy.</td></tr>\n<tr><th scope="row">Sprint Review</th><td>Pomaga przedstawić schronisku działającą funkcję i zebrać informacje o dalszych potrzebach.</td></tr>\n<tr><th scope="row">Sprint Retrospective</th><td>Proponuje wcześniejsze przygotowywanie danych do testów równoczesnych operacji.</td></tr>\n</tbody></table></div>\n<div class="failure"><p><b>Wykryty problem:</b> obie osoby otrzymują potwierdzenie. Po poprawce tester ponawia sprawdzenie i wykonuje regresję rezygnacji oraz ponownego udostępnienia miejsca.</p></div>\n</div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Zespół wspólnie tworzy i sprawdza użyteczny Przyrost, a wyniki pomagają dostosowywać dalszą pracę.</p></div>\n</div>\n', 'sections': 'sekcja 2.1 (kontekst); rozszerzenie: Scrum Guide'}, {'id': 45, 'number': '45', 'title': 'Analiza i kontrolowanie ryzyka produktowego', 'content': '<div class="body">\n<section aria-labelledby="definition-title"><div class="sectionhead"><span class="index" aria-hidden="true">01</span><h2 id="definition-title">Dwie osobne definicje</h2></div>\n<div class="definition-pair">\n<section class="definition-card verification" aria-labelledby="risk-analysis-title"><div class="definition-label">ROZPOZNANIE I OCENA</div><h3 id="risk-analysis-title">Analiza ryzyka produktowego</h3><p class="definition-text">To identyfikowanie i ocenianie zagrożeń związanych z jakością produktu. Obejmuje rozpoznanie możliwych problemów, określenie ich prawdopodobieństwa i skutków, ustalenie poziomu ryzyka oraz priorytetów postępowania.</p><div class="definition-mini"><strong>Do czego służy?</strong><p>Pomaga zdecydować, co, jak dokładnie i w jakiej kolejności testować.</p></div></section>\n<section class="definition-card validation" aria-labelledby="risk-control-title"><div class="definition-label">DZIAŁANIA I OCENA SKUTECZNOŚCI</div><h3 id="risk-control-title">Kontrolowanie ryzyka produktowego</h3><p class="definition-text">To działania podejmowane w odpowiedzi na rozpoznane ryzyko.</p><div class="definition-mini"><strong>Co obejmuje?</strong><p><strong>Ograniczanie ryzyka</strong> — wdrażanie uzgodnionych działań zmniejszających jego poziom.</p><p><strong>Monitorowanie ryzyka</strong> — sprawdzanie skuteczności działań, aktualizowanie oceny i wykrywanie nowych zagrożeń.</p></div></section>\n</div>\n<div class="definitioncopy"><p>Możliwą odpowiedzią jest także świadoma akceptacja ryzyka, jego przeniesienie lub przygotowanie planu awaryjnego.</p></div>\n<div class="simple"><strong>Prostymi słowami</strong>Najpierw ustalamy, co może pójść źle i jakie będą konsekwencje. Następnie podejmujemy działania i sprawdzamy ich skuteczność.</div>\n<h3 style="margin-top:24px">Jak rozróżnić te czynności?</h3>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Od rozpoznania zagrożenia do oceny działań</caption><thead><tr><th scope="col">Czynność</th><th scope="col">Najważniejsze pytanie</th></tr></thead><tbody>\n<tr><th scope="row">Identyfikacja</th><td>Co może pójść źle?</td></tr>\n<tr><th scope="row">Ocena</th><td>Jak prawdopodobny i dotkliwy jest problem?</td></tr>\n<tr><th scope="row">Ograniczanie</th><td>Co zrobimy, aby zmniejszyć ryzyko?</td></tr>\n<tr><th scope="row">Monitorowanie</th><td>Czy działania pomagają i czy pojawiły się nowe zagrożenia?</td></tr>\n</tbody></table></div><p class="note">Wyniki analizy wpływają m.in. na zakres, techniki, pokrycie, priorytety i pracochłonność testowania.</p>\n</section>\n<div class="lower goals-layout">\n<section aria-labelledby="remember-title"><div class="sectionhead"><span class="index" aria-hidden="true">02</span><h2 id="remember-title">Zapamiętaj</h2></div><div class="memory-grid">\n<div class="memory"><h3>Ryzyko a defekt</h3><p>Ryzyko nie jest tym samym co wykryty defekt.</p></div>\n<div class="memory"><h3>Aktualizuj ocenę</h3><p>Ocena może się zmieniać wraz z nowymi informacjami.</p></div>\n<div class="memory"><h3>Test a poprawka</h3><p>Samo wykonanie testów nie usuwa defektu.</p></div>\n<div class="memory"><h3>Świadoma decyzja</h3><p>Odpowiedzialne osoby podejmują decyzję o akceptacji pozostałego ryzyka.</p></div>\n</div></section>\n<section aria-labelledby="example-title"><div class="sectionhead"><span class="index" aria-hidden="true">03</span><h2 id="example-title">Przykład z życia — mapa szlaków działająca bez internetu</h2></div>\n<div class="example"><h3>Czy pobrana mapa rzeczywiście będzie dostępna?</h3><p>Zespół rozwija aplikację turystyczną. Użytkownik przed wyjazdem pobiera mapę wybranego obszaru, aby korzystać z niej w górach bez dostępu do internetu.</p><p><strong>Najważniejsze ryzyko:</strong> aplikacja pokaże „Mapa pobrana”, ale po utracie połączenia część mapy będzie niedostępna.</p>\n<h3>1. Identyfikacja ryzyka</h3><p>Tester pyta:</p><ul class="list"><li>Co się stanie, jeśli internet zniknie podczas pobierania?</li><li>Czy komunikat potwierdza pobranie całego wybranego obszaru?</li><li>Czy mapa pozostanie dostępna po zamknięciu i ponownym uruchomieniu aplikacji?</li></ul>\n<h3>2. Ocena ryzyka</h3><p>Zespół uznaje problem za istotny: pobieranie przez niestabilną sieć jest realistyczne, a brak mapy może utrudnić orientację w terenie.</p><p>Dla porównania niewłaściwy odstęp między ikonami na ekranie pobierania ma w tym przykładzie mniejsze znaczenie. Dlatego <strong>sprawdzenia kompletności mapy otrzymują pierwszeństwo</strong>.</p>\n<h3>3. Ograniczanie ryzyka</h3><p>Zespół uzgadnia, że aplikacja powinna potwierdzać ukończenie dopiero po sprawdzeniu kompletności pobranych danych. Przerwane pobieranie ma być wyraźnie oznaczone.</p><p>Tester przygotowuje sprawdzenia:</p>\n<div class="qa-table-wrap"><table class="qa-table"><caption>Sprawdzenia dobrane do zidentyfikowanego ryzyka</caption><thead><tr><th scope="col">Sytuacja</th><th scope="col">Oczekiwane zachowanie w naszym przykładzie</th></tr></thead><tbody>\n<tr><th scope="row">Internet znika w połowie pobierania.</th><td>Aplikacja nie pokazuje, że cała mapa jest gotowa.</td></tr>\n<tr><th scope="row">Pobieranie zostaje wznowione i ukończone.</th><td>Wybrany obszar jest dostępny bez internetu.</td></tr>\n<tr><th scope="row">Użytkownik ponownie uruchamia aplikację offline.</th><td>Wcześniej pobrana mapa nadal się otwiera.</td></tr>\n<tr><th scope="row">Użytkownik przesuwa i powiększa mapę w pobranym obszarze.</th><td>Potrzebne fragmenty mapy są dostępne.</td></tr>\n</tbody></table></div>\n<h3>4. Monitorowanie ryzyka</h3><p>Pierwsze testy ujawniają, że po przerwaniu pobierania aplikacja błędnie pokazuje „Gotowe”. Po poprawce tester ponawia scenariusz i sprawdza pozostałe zachowania.</p><p>Informuje również, że <strong>nie sprawdzono jeszcze sytuacji, w której podczas pobierania zabraknie miejsca na urządzeniu</strong>. Ten obszar pozostaje do oceny i dalszych testów.</p>\n<h3>Co robi tester?</h3><ol class="goal-examples">\n<li><h3>Pomaga rozpoznać i ocenić zagrożenia</h3><p>Współpracuje z zespołem przy rozpoznawaniu i ocenianiu zagrożeń.</p></li>\n<li><h3>Dobiera sprawdzenia</h3><p>Przygotowuje testy odpowiadające konkretnym sytuacjom.</p></li>\n<li><h3>Pokazuje skuteczność działań</h3><p>Dostarcza wyniki pokazujące skuteczność działań.</p></li>\n<li><h3>Przekazuje ograniczenia</h3><p>Wyraźnie wskazuje ograniczenia testów i pozostałe ryzyko.</p></li>\n</ol></div></section></div>\n<div class="takeaway"><span>NAJWAŻNIEJSZA MYŚL</span><p>Rozpoznajemy zagrożenia, dobieramy działania i sprawdzamy, jakie ryzyko nadal pozostaje.</p></div>\n</div>\n', 'sections': 'sekcje 5.2.3–5.2.4'}]

