    '</body></html>\n'
)

def render_topic(topic_id):
    topic = next((item for item in TOPICS if item["id"] == topic_id), None)
    if topic is None:
        abort(404)
    search_data = [{"id": item["id"], "text": item["title"] + " " + re.sub(r"<[^>]+>", " ", item["content"])} for item in TOPICS]
    return render_template_string(PAGE, topic=topic, topics=TOPICS,
                                  search_data=search_data, query=request.args.get("q", ""), syllabus_url=SOURCE)

@app.get("/")
def index():
    return render_topic(1)

@app.get("/temat/<int:topic_id>")
def lesson(topic_id):
    return render_topic(topic_id)

