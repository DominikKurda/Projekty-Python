            const name = voice.name.toLowerCase();
            let score = voice.lang.toLowerCase() === 'pl-pl' ? 50 : 30;
            if (['natural', 'neural', 'premium', 'online'].some((word) => name.includes(word))) score += 40;
            preferredNames.forEach((preferred, position) => {
                if (name.includes(preferred.toLowerCase())) score += 30 - position;
            });
            if (voice.localService) score += 5;
            return score;
        }

        polishVoice = polishVoices.sort((a, b) => voiceScore(b) - voiceScore(a))[0] || null;
        narratorButton.title = polishVoice
            ? `Polski głos: ${polishVoice.name}`
            : 'Czytaj treść aktualnego slajdu po polsku';
    }

    function normalizeSpeechText(text) {
        return text
            .replace(/[\p{Extended_Pictographic}\uFE0F]/gu, '')
            .replace(/ISTQB(?:®)?/g, 'I, es, te, ku, be')
            .replace(/A\/B/g, 'A B')
            .replace(/\bBVA\b/g, 'be fał a')
            .replace(/\bEP\b/g, 'e pe')
            .replace(/\bN\/A\b/g, 'nie dotyczy')
            .replace(/Each Choice/gi, 'każdy wybór')
            .replace(/>=/g, ' większe lub równe ')
            .replace(/==/g, ' równa się ')
            .replace(/×/g, ' razy ')
            .replace(/\bdef\b/g, 'definicja funkcji')
            .replace(/\bassert\b/g, 'sprawdzenie')
            .replace(/_/g, ' ')
            .replace(/\b3C\b/g, 'trzy ce')
            .replace(/\bSDLC\b/g, 'cykl życia oprogramowania')
            .replace(/\bAPI\b/g, 'a, pe, i')
            .replace(/\bUI\b/g, 'interfejs użytkownika')
            .replace(/\bQA\b/g, 'zapewnianie jakości')
            .replace(/\bATDD\b/g, 'a, te, de, de')
            .replace(/Definition of Ready/gi, 'definicja gotowości')
            .replace(/Definition of Done/gi, 'definicja ukończenia')
            .replace(/Wideband Delphi/gi, 'szerokopasmowa metoda Delficka')
            .replace(/Planning Poker/gi, 'poker planistyczny')
            .replace(/\bFAIL\b/g, 'wynik negatywny')
            .replace(/\bSD\b/g, 'odchylenie standardowe')
            .replace(/\bBLIK\b/g, 'blik')
            .replace(/(\d+)\s*%/g, '$1 procent')
            .replace(/(\d+)\s*zł\b/g, '$1 złotych')
            .replace(/\s+/g, ' ')
            .replace(/\s+([,.!?;:])/g, '$1')
            .trim();
    }

    function splitForNaturalSpeech(text, limit = 230) {
        const sentences = text.match(/[^.!?]+[.!?]+|[^.!?]+$/g) || [text];
        const chunks = [];

        sentences.forEach((sentence) => {
            const cleanSentence = sentence.trim();
            if (cleanSentence.length <= limit) {
                chunks.push(cleanSentence);
                return;
            }

            const phrases = cleanSentence.split(/(?<=[,;:])\s+/);
            let chunk = '';
            phrases.forEach((phrase) => {
                const candidate = `${chunk} ${phrase}`.trim();
                if (chunk && candidate.length > limit) {
                    chunks.push(chunk);
                    chunk = phrase;
                } else {
                    chunk = candidate;
                }
            });
            if (chunk) chunks.push(chunk);
        });

        return chunks.filter(Boolean);
    }

    function narrationParts(slide) {
        const copy = slide.cloneNode(true);
        copy.querySelectorAll('.eyebrow, .step-number, .principle-chip b, .phone .icon')
            .forEach((element) => element.remove());

        const selectors = [
            'h2',
            '.intro-definition',
            '.definition',
            '.note',
            '.principle-chip span',
            '.principle-card',
            '.example-card',
            '.vs-card',
            '.comparison-table th',
            '.comparison-table td',
            '.remember-card span:last-child',
            '.step span:last-child',
            '.phone b',
            '.code-sample',
        ].join(', ');

        return [...copy.querySelectorAll(selectors)]
            .map((element) => normalizeSpeechText(element.innerText))
            .filter(Boolean)
            .flatMap((part) => splitForNaturalSpeech(part));
    }

    function stopNarration() {
        narrationGeneration += 1;
        window.clearTimeout(narrationTimer);
        window.speechSynthesis.cancel();
        currentUtterance = null;
        narrationQueue = [];
        narrationPosition = 0;
    }

    function speakNextPart(generation) {
        if (!narratorEnabled || generation !== narrationGeneration) return;

        if (narrationPosition >= narrationQueue.length) {
            currentUtterance = null;
            updateNarratorButton('ready');
            return;
        }

        currentUtterance = new SpeechSynthesisUtterance(narrationQueue[narrationPosition]);
        currentUtterance.lang = 'pl-PL';
        currentUtterance.rate = 0.86;
        currentUtterance.pitch = 1.0;
        currentUtterance.volume = 1.0;
        if (polishVoice) currentUtterance.voice = polishVoice;

        currentUtterance.onend = () => {
            if (generation !== narrationGeneration) return;
            narrationPosition += 1;
            narrationTimer = window.setTimeout(() => speakNextPart(generation), 210);
        };

        currentUtterance.onerror = (event) => {
            if (generation !== narrationGeneration || event.error === 'canceled' || event.error === 'interrupted') return;
            currentUtterance = null;
            updateNarratorButton('ready');
        };

        window.speechSynthesis.speak(currentUtterance);
    }

    function readCurrentSlide() {
        if (!narratorEnabled || !activeSlides[index]) return;

        stopNarration();
        narrationQueue = narrationParts(activeSlides[index]);
        const generation = narrationGeneration;
        updateNarratorButton('speaking');
        speakNextPart(generation);
    }

    function scheduleNarration() {
        stopNarration();
        narrationTimer = window.setTimeout(readCurrentSlide, 300);
    }

    function updateNarratorButton(state = 'ready') {
        narratorButton.classList.toggle('active', narratorEnabled);
        narratorButton.setAttribute('aria-pressed', String(narratorEnabled));
        if (!narratorEnabled) {
            narratorButton.textContent = '🔊 Lektor: włącz';
        } else if (state === 'speaking') {
            narratorButton.textContent = '⏹ Lektor: czytam…';
        } else {
            narratorButton.textContent = '🔊 Lektor: włączony';
        }
    }

    function showSlide(newIndex) {
        index = Math.max(0, Math.min(newIndex, activeSlides.length - 1));
        slides.forEach((slide) => slide.classList.remove('active'));
        activeSlides[index].classList.add('active');
        current.textContent = index + 1;
        total.textContent = activeSlides.length;
        progress.style.width = `${((index + 1) / activeSlides.length) * 100}%`;
        previous.disabled = index === 0;
        next.disabled = index === activeSlides.length - 1;
        if (narratorEnabled) scheduleNarration();
    }

    function showTopic(newTopic) {
        topic = newTopic;
        activeSlides = slides.filter((slide) => slide.dataset.topic === topic);
        topicButtons.forEach((button) => {
            button.classList.toggle('active', button.dataset.topicButton === topic);
        });
        showSlide(0);
    }

    previous.addEventListener('click', () => showSlide(index - 1));
    next.addEventListener('click', () => showSlide(index + 1));
    topicButtons.forEach((button) => {
        button.addEventListener('click', () => showTopic(button.dataset.topicButton));
    });

    narratorButton.addEventListener('click', () => {
        if (!('speechSynthesis' in window)) {
            window.alert('Ta przeglądarka nie obsługuje lektora. Otwórz aplikację w Microsoft Edge lub Google Chrome.');
            return;
        }

        narratorEnabled = !narratorEnabled;
        updateNarratorButton();

        if (narratorEnabled) {
            selectPolishVoice();
            readCurrentSlide();
        } else {
            stopNarration();
        }
    });

    if ('speechSynthesis' in window) {
        selectPolishVoice();
        window.speechSynthesis.onvoiceschanged = selectPolishVoice;
    }

    document.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') showSlide(index - 1);
        if (event.key === 'ArrowRight' || event.key === ' ') showSlide(index + 1);
    });

    fullscreen.addEventListener('click', async () => {
        if (!document.fullscreenElement) {
            await document.querySelector('#presentation').requestFullscreen();
        } else {
            await document.exitFullscreen();
        }
    });

    document.addEventListener('visibilitychange', () => {
        if (document.hidden && narratorEnabled) {
            stopNarration();
            updateNarratorButton('ready');
        }
    });

    window.addEventListener('beforeunload', stopNarration);

    showTopic('definition');
</script>
</body>
</html>
